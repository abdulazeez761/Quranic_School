@{
    ViewData["Title"] = "الشهادة غير متاحة";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<div class="container py-5 text-center" dir="rtl">
    <div class="card shadow-sm border-0 mx-auto p-5" style="max-width: 540px; border-radius: 16px;">
        <div style="width: 72px; height: 72px; border-radius: 50%; background: #fef2f2; color: #dc2626; display: flex; align-items: center; justify-content: center; font-size: 36px; margin: 0 auto 16px auto;">
            <i class='bx bx-error-circle'></i>
        </div>
        <h3 class="fw-bold mb-2">الشهادة غير متاحة حالياً</h3>
        <p class="text-muted mb-4">
            @(TempData["ErrorMessage"] ?? "لم يتم استيفاء شروط إصدار الشهادة لهذا السجل بعد (يتطلب إتمام الحفظ أو دراسة المتن).")
        </p>
        <div>
            <a href="javascript:history.back()" class="t-btn t-btn-primary px-4">
                <i class='bx bx-right-arrow-alt me-1'></i> العودة
            </a>
        </div>
    </div>
</div>
