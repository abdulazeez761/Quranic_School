@model Hafiz.Application.DTO.Certificate.CertificateModel
@{
    Layout = null;
    ViewData["Title"] = $"{Model.CertificateTitle} - {Model.StudentName}";
}

<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Boxicons Icons -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

    <!-- Certificate Styles -->
    <link rel="stylesheet" href="~/css/certificates/certificate.css" asp-append-version="true" />
</head>
<body class="cert-body">

    <!-- Floating Action Toolbar (Hidden in Print) -->
    <div class="cert-toolbar">
        <button type="button" class="cert-btn cert-btn-gold" onclick="window.print()">
            <i class='bx bx-printer'></i>
            <span>طباعة الشهادة</span>
        </button>
        <button type="button" class="cert-btn cert-btn-dark" onclick="window.close(); if(window.opener) window.opener.focus(); else history.back();">
            <i class='bx bx-arrow-back'></i>
            <span>العودة</span>
        </button>
    </div>

    @if (Model.IsExistingCertificate)
    {
        <div class="cert-existing-notice" style="position: fixed; top: 16px; left: 50%; transform: translateX(-50%); z-index: 1000; background: #fffbeb; border: 1.5px solid #fcd34d; border-radius: 99px; padding: 6px 18px; box-shadow: 0 4px 14px rgba(180, 83, 9, 0.15); display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 700; color: #92400e;">
            <i class='bx bx-check-shield' style="font-size: 18px; color: #d97706;"></i>
            <span>تنبيه: هذه شهادة معتمدة ومسجلة مسبقاً لهذا الطالب (الرقم: @Model.CertificateNumber - تاريخ الإصدار: @Model.IssueDateFormatted)</span>
        </div>

        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'تنبيه: شهادة معتمدة مسبقاً',
                        html: `<div style="text-align: right; font-size: 14px; line-height: 1.8; color: #334155;">
                                 <p style="margin-bottom: 10px;">هذه الشهادة مسجلة ومعتمدة مسبقاً في سجلات المركز:</p>
                                 <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 10px 14px; margin-bottom: 10px;">
                                    <div>🏷️ <strong>رقم الشهادة:</strong> <code style="font-weight:700; color:#047857;">@Model.CertificateNumber</code></div>
                                    <div>📅 <strong>تاريخ الإصدار:</strong> @Model.IssueDateFormatted</div>
                                    <div>👤 <strong>الطالب:</strong> @Model.StudentName</div>
                                 </div>
                                 <p style="font-size: 12.5px; color: #64748b; margin: 0;">الشهادة أصلية وسارية الصلاحية ومحمية برمز التحقق QR.</p>
                               </div>`,
                        icon: 'info',
                        confirmButtonColor: '#059669',
                        confirmButtonText: '<i class="bx bx-check-circle me-1"></i> حسناً، معاينة الشهادة',
                        backdrop: 'rgba(15, 23, 42, 0.35)'
                    });
                }
            });
        </script>
    }

    <!-- Certificate Stage -->
    <div class="cert-stage">
        @await Html.PartialAsync("Components/_CertificateDynamic", Model)
    </div>

</body>
</html>
