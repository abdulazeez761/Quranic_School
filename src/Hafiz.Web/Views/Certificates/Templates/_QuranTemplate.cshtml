@model Hafiz.Application.DTO.Certificate.CertificateModel

<div class="cert-outer-border">
    <div class="cert-inner-border">
        <!-- Corner Ornaments -->
        <div class="cert-corner cert-corner-tl"></div>
        <div class="cert-corner cert-corner-tr"></div>
        <div class="cert-corner cert-corner-bl"></div>
        <div class="cert-corner cert-corner-br"></div>

        <!-- Watermark Background -->
        <div class="cert-watermark">
            <i class='bx bx-book-open'></i>
        </div>

        <!-- Header -->
        <div class="cert-header">
            <div>
                <h2 class="cert-institute-title">@Model.InstituteName</h2>
                <div class="cert-sub-institute">
                    @(string.IsNullOrEmpty(Model.ClassName) ? "شؤون حلقات القرآن الكريم" : $"حلقة: {Model.ClassName}")
                </div>
            </div>
            <div class="cert-basmalah">
                بِسْمِ اللَّـهِ الرَّحْمَـٰنِ الرَّحِيمِ
            </div>
            <div class="cert-number-box">
                <span class="cert-serial">@Model.CertificateNumber</span>
            </div>
        </div>

        <!-- Certificate Title -->
        <div class="cert-title-container">
            <h1 class="cert-main-title">@Model.CertificateTitle</h1>
            <div class="cert-title-line"></div>
        </div>

        <!-- Quranic Verse Header Banner -->
        <div style="text-align: center; margin-bottom: 8px;">
            <span style="font-family: 'Amiri', serif; font-size: 1.15rem; color: #047857; font-style: italic;">
                ﴿ إِنَّ هَـٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ ﴾
            </span>
        </div>

        <!-- Body Content -->
        <div class="cert-body-content">
            <p class="cert-intro-text">
                @Model.AchievementDescription
            </p>

            <div>
                <div class="cert-student-name">
                    @Model.StudentName
                </div>
            </div>

            <div class="cert-achievement-box">
                <span class="cert-subject-name">@Model.SubjectName</span>
                @if (!string.IsNullOrEmpty(Model.SubtitleOrAuthor))
                {
                    <div class="cert-author-name">@Model.SubtitleOrAuthor</div>
                }
                @if (!string.IsNullOrEmpty(Model.ScopeDetails))
                {
                    <div class="cert-scope-text">@Model.ScopeDetails</div>
                }
            </div>

            @if (!string.IsNullOrEmpty(Model.ExamResultText))
            {
                <div>
                    <div class="cert-rating-badge">
                        <i class='bx bxs-star cert-rating-star'></i>
                        <span>@Model.ExamResultText</span>
                    </div>
                </div>
            }
        </div>

        <!-- Footer & Signatures -->
        <div class="cert-footer">
            <div class="cert-sign-col">
                <div class="cert-sign-title">معلم الحلقة</div>
                <div class="cert-sign-name">@Model.TeacherName</div>
                <div class="cert-sign-line"></div>
                <small class="text-muted">التوقيع والاعتماد</small>
            </div>

            <div class="cert-seal-box">
                <div class="cert-official-seal">
                    <i class='bx bxs-check-shield'></i>
                </div>
                <div class="cert-date-text">
                    صدرت بتاريخ: @Model.IssueDateFormatted
                </div>
            </div>

            <div class="cert-sign-col">
                <div class="cert-sign-title">إدارة المركز</div>
                <div class="cert-sign-name">@Model.DirectorName</div>
                <div class="cert-sign-line"></div>
                <small class="text-muted">الختم الرسمي</small>
            </div>
        </div>
    </div>
</div>
