@using Hafiz.Application.DTO.Certificate.TemplateConfiguration
@using Hafiz.Application.Services
@model Hafiz.Application.DTO.Certificate.CertificateModel
@{
    var section = ViewData["Section"] as SectionConfig;
    var config = section?.GetConfig<QrVerificationSectionConfig>();

    var size = config?.Size is > 0 ? config.Size : 80;
    var showLabel = config?.ShowLabel ?? true;
    var label = string.IsNullOrWhiteSpace(config?.LabelText)
        ? "رمز التحقق الإلكتروني"
        : CertificateTokenResolver.Resolve(config!.LabelText, Model);
}
<div class="cert-qr">
    <img src="@Model.QrCodeDataUrl" alt="@label" width="@size" height="@size" />
    @if (showLabel)
    {
        <div class="cert-qr-label">@label</div>
    }
</div>
