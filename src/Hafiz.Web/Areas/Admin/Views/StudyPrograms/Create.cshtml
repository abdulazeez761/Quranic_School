@model Hafiz.DTOs.StudyProgram.CreateStudyProgramDto
@using Hafiz.Domain.Enums
@{
    ViewData["Title"] = "إضافة برنامج تعليمي";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 pb-2">
                    <h3 class="h5 font-weight-bold mb-1">إضافة برنامج تعليمي جديد</h3>
                    <p class="text-muted small">قم بتحديد مسار ونوع البرنامج وربطه بالمتن المناسب إن وُجد.</p>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label fw-bold">اسم البرنامج <span class="text-danger">*</span></label>
                            <input asp-for="Name" class="form-control" placeholder="مثال: برنامج تحفيظ القرآن للكبار، دورة متن الجزرية" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Type" class="form-label fw-bold">نوع المسار التعليمي <span class="text-danger">*</span></label>
                                <select asp-for="Type" id="programTypeSelect" class="form-select" required>
                                    <option value="@((int)ProgramType.Quran)">تحفيظ القرآن الكريم (الافتراضي)</option>
                                    <option value="@((int)ProgramType.Matn)">المتون والعلوم الشرعية</option>
                                    <option value="@((int)ProgramType.Sanad)">السند الغيبي</option>
                                    <option value="@((int)ProgramType.Ijaza)">الإجازة القرآنية</option>
                                </select>
                                <span asp-validation-for="Type" class="text-danger small"></span>
                            </div>

                            <div class="col-md-6" id="matnSelectContainer" style="display: none;">
                                <label asp-for="MatnId" class="form-label fw-bold">المتن المخصص لهذا البرنامج</label>
                                <select asp-for="MatnId" asp-items="ViewBag.Matns" class="form-select">
                                    <option value="">-- اختر المتن من المكتبة --</option>
                                </select>
                                <div class="form-text small">تدرس جميع حلقات هذا البرنامج المتن المختار.</div>
                                <span asp-validation-for="MatnId" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Description" class="form-label fw-bold">وصف أو أهداف البرنامج</label>
                            <textarea asp-for="Description" class="form-control" rows="3" placeholder="تفاصيل المنهج، الشريحة المستهدفة، أو الخطة الزمنية..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4">حفظ البرنامج</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeSelect = document.getElementById('programTypeSelect');
            const matnContainer = document.getElementById('matnSelectContainer');

            function toggleMatnField() {
                // Matn value is 2
                if (typeSelect.value === '2') {
                    matnContainer.style.display = 'block';
                } else {
                    matnContainer.style.display = 'none';
                }
            }

            typeSelect.addEventListener('change', toggleMatnField);
            toggleMatnField();
        });
    </script>
}
