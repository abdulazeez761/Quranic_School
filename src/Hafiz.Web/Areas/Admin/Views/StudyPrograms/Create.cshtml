@model Hafiz.DTOs.StudyProgram.CreateStudyProgramDto
@using Hafiz.Domain.Enums
@{
    ViewData["Title"] = "إضافة برنامج تعليمي";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="admin-form-container">
    <!-- رأس الصفحة -->
    <div class="d-flex justify-between align-center mb-lg flex-wrap gap-md">
        <div>
            <h2 class="section-title mb-xs">
                <i class='bx bx-book-add' style="color: var(--primary-green);"></i>
                إضافة برنامج تعليمي جديد
            </h2>
            <p class="text-medium">تحديد مسار ونوع البرنامج التعليمي وإمكانية إسناد المتون العلمية تحته.</p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline btn-sm">
                <i class='bx bx-arrow-back'></i>
                <span>العودة للبرامج</span>
            </a>
        </div>
    </div>

    <div class="card card-standard">
        <div class="card-header">
            <h3 class="card-title">
                <i class='bx bx-slider-alt'></i>
                بيانات وإعدادات البرنامج
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-md" role="alert"></div>

                <div class="form-group mb-md">
                    <label asp-for="Name" class="form-label" style="font-weight: 600;">اسم البرنامج التعليمي <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-input" placeholder="مثال: برنامج تحفيظ القرآن للكبار، دورة المتون والعلوم الشرعية..." required />
                    <span asp-validation-for="Name" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                </div>

                <div class="form-row mb-md" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-md);">
                    <div class="form-group">
                        <label asp-for="Type" class="form-label" style="font-weight: 600;">نوع المسار التعليمي <span class="text-danger">*</span></label>
                        <select asp-for="Type" id="programTypeSelect" class="form-select" required>
                            <option value="@((int)ProgramType.Quran)">تحفيظ القرآن الكريم (الافتراضي)</option>
                            <option value="@((int)ProgramType.Matn)">المتون والعلوم الشرعية</option>
                            <option value="@((int)ProgramType.Sanad)">السند الغيبي</option>
                            <option value="@((int)ProgramType.Ijaza)">الإجازة القرآنية</option>
                        </select>
                        <span asp-validation-for="Type" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                    </div>

                    <div class="form-group" id="matnNoticeContainer" style="display: none;">
                        <div class="alert alert-info d-flex align-center gap-sm" style="margin: 0; padding: 12px; font-size: 13px;">
                            <i class='bx bx-info-circle' style="font-size: 1.25rem;"></i>
                            <span>يدعم هذا البرنامج إضافة عدة متون علمية وترتيبها وتفعيلها بعد إنشاء البرنامج مباشرة في شاشة التعديل.</span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-lg">
                    <label asp-for="Description" class="form-label" style="font-weight: 600;">وصف البرنامج أو الأهداف والمنهج</label>
                    <textarea asp-for="Description" class="form-input" rows="3" placeholder="تفاصيل المنهج، الشريحة المستهدفة، أو الخطة الزمنية..."></textarea>
                    <span asp-validation-for="Description" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                </div>

                <div class="form-actions form-actions-right border-top pt-md mt-md">
                    <button type="submit" class="btn btn-primary">
                        <i class='bx bx-check'></i>
                        <span>حفظ البرنامج ومتابعة الإعداد</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline">إلغاء</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const typeSelect = document.getElementById('programTypeSelect');
            const matnNotice = document.getElementById('matnNoticeContainer');

            function toggleMatnField() {
                // ProgramType.Matn is 1 in domain enum
                if (typeSelect.value === '1') {
                    matnNotice.style.display = 'block';
                } else {
                    matnNotice.style.display = 'none';
                }
            }

            typeSelect.addEventListener('change', toggleMatnField);
            toggleMatnField();
        });
    </script>
}
