@model IEnumerable<Hafiz.DTOs.StudyProgram.StudyProgramDto>
@using Hafiz.Domain.Enums
@{
    ViewData["Title"] = "البرامج التعليمية";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var selectedType = ViewBag.SelectedType as ProgramType?;

    var totalPrograms = Model.Count();
    var activePrograms = Model.Count(p => p.IsActive);
    var quranPrograms = Model.Count(p => p.Type == ProgramType.Quran);
    var matnPrograms = Model.Count(p => p.Type == ProgramType.Matn);
    var totalClasses = Model.Sum(p => p.ClassesCount);
}

<link rel="stylesheet" href="~/css/admin/study-programs.css" asp-append-version="true" />

<div class="prog-page">
    <!-- رأس الصفحة -->
    <div class="prog-header">
        <div>
            <h2 class="prog-header-title">
                <i class='bx bx-book-open'></i>
                البرامج التعليمية والعلمية
            </h2>
            <p class="text-medium">إدارة المسارات والمناهج الدراسية للمركز (قرآن كريم، متون علمية، إجازات وأسانيد).</p>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-primary" style="display: inline-flex; align-items: center; gap: 8px;">
                <i class='bx bx-plus-circle'></i>
                <span>إضافة برنامج جديد</span>
            </a>
        </div>
    </div>

    <!-- الإشعارات -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-center gap-sm">
            <i class='bx bx-check-circle' style="font-size: 1.25rem;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-center gap-sm">
            <i class='bx bx-error-circle' style="font-size: 1.25rem;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- البطاقات الإحصائية السريعة -->
    <div class="prog-kpi-grid">
        <div class="prog-kpi-card">
            <div class="prog-kpi-icon --emerald">
                <i class='bx bx-folder'></i>
            </div>
            <div class="prog-kpi-info">
                <span class="prog-kpi-label">إجمالي البرامج</span>
                <span class="prog-kpi-value">@totalPrograms</span>
            </div>
        </div>
        <div class="prog-kpi-card">
            <div class="prog-kpi-icon --teal">
                <i class='bx bx-check-circle'></i>
            </div>
            <div class="prog-kpi-info">
                <span class="prog-kpi-label">البرامج النشطة</span>
                <span class="prog-kpi-value">@activePrograms</span>
            </div>
        </div>
        <div class="prog-kpi-card">
            <div class="prog-kpi-icon --blue">
                <i class='bx bx-book-bookmark'></i>
            </div>
            <div class="prog-kpi-info">
                <span class="prog-kpi-label">برامج القرآن</span>
                <span class="prog-kpi-value">@quranPrograms</span>
            </div>
        </div>
        <div class="prog-kpi-card">
            <div class="prog-kpi-icon --purple">
                <i class='bx bx-library'></i>
            </div>
            <div class="prog-kpi-info">
                <span class="prog-kpi-label">برامج المتون</span>
                <span class="prog-kpi-value">@matnPrograms</span>
            </div>
        </div>
        <div class="prog-kpi-card">
            <div class="prog-kpi-icon --gold">
                <i class='bx bx-group'></i>
            </div>
            <div class="prog-kpi-info">
                <span class="prog-kpi-label">الحلقات التابعة</span>
                <span class="prog-kpi-value">@totalClasses</span>
            </div>
        </div>
    </div>

    <!-- فلاتر نوع البرنامج -->
    <div class="prog-filter-bar">
        <a asp-action="Index" class="prog-filter-chip @(selectedType == null ? "active" : "")">
            <i class='bx bx-grid-alt'></i>
            <span>كل البرامج</span>
        </a>
        <a asp-action="Index" asp-route-type="@ProgramType.Quran" class="prog-filter-chip @(selectedType == ProgramType.Quran ? "active" : "")">
            <i class='bx bx-book-bookmark'></i>
            <span>القرآن الكريم</span>
        </a>
        <a asp-action="Index" asp-route-type="@ProgramType.Matn" class="prog-filter-chip @(selectedType == ProgramType.Matn ? "active" : "")">
            <i class='bx bx-book'></i>
            <span>المتون العلمية</span>
        </a>
        <a asp-action="Index" asp-route-type="@ProgramType.Sanad" class="prog-filter-chip @(selectedType == ProgramType.Sanad ? "active" : "")">
            <i class='bx bx-award'></i>
            <span>السند الغيبي</span>
        </a>
        <a asp-action="Index" asp-route-type="@ProgramType.Ijaza" class="prog-filter-chip @(selectedType == ProgramType.Ijaza ? "active" : "")">
            <i class='bx bx-certification'></i>
            <span>الإجازة بالسند</span>
        </a>
    </div>

    <!-- شبكة بطاقات البرامج -->
    <div class="prog-grid">
        @if (!Model.Any())
        {
            <div class="prog-empty">
                <div class="prog-empty-icon">
                    <i class='bx bx-folder-open'></i>
                </div>
                <div>
                    <h3 style="font-weight: 700; color: var(--text-dark); margin: 0 0 var(--space-xs);">لا توجد برامج مسجلة</h3>
                    <p class="text-medium" style="font-size: var(--font-size-sm); margin: 0;">يمكنك البدء بإنشاء برنامج تعليمي جديد لتنظيم وإسناد الحلقات تحته.</p>
                </div>
                <a asp-action="Create" class="btn btn-primary btn-sm mt-sm">
                    <i class='bx bx-plus'></i> إضافة برنامج جديد
                </a>
            </div>
        }
        else
        {
            @foreach (var prog in Model)
            {
                var cardTypeClass = prog.Type switch
                {
                    ProgramType.Quran => "--quran",
                    ProgramType.Matn => "--matn",
                    ProgramType.Sanad => "--sanad",
                    ProgramType.Ijaza => "--ijaza",
                    _ => ""
                };

                <div class="prog-card @cardTypeClass">
                    <div class="prog-card-head">
                        <span class="prog-type-badge">
                            @if (prog.Type == ProgramType.Quran)
                            {
                                <i class='bx bx-book-bookmark'></i>
                            }
                            else if (prog.Type == ProgramType.Matn)
                            {
                                <i class='bx bx-book'></i>
                            }
                            else if (prog.Type == ProgramType.Sanad)
                            {
                                <i class='bx bx-award'></i>
                            }
                            else
                            {
                                <i class='bx bx-certification'></i>
                            }
                            <span>@prog.TypeName</span>
                        </span>

                        <span class="prog-status-chip @(prog.IsActive ? "--active" : "--inactive")">
                            @if (prog.IsActive)
                            {
                                <span class="prog-status-dot"></span>
                                <span>نشط</span>
                            }
                            else
                            {
                                <span>معطل</span>
                            }
                        </span>
                    </div>

                    <div class="prog-card-body">
                        <h4 class="prog-title">@prog.Name</h4>

                        @if (prog.Type == ProgramType.Matn)
                        {
                            <div class="prog-matn-pill" style="display: inline-flex; align-items: center; gap: 6px; background: #f3e8ff; color: #7e22ce; padding: 3px 10px; border-radius: 9999px; font-size: 12px; margin-bottom: 8px;">
                                <i class='bx bx-library'></i>
                                <span>@(prog.MatunsCount > 0 ? $"المتون ({prog.MatunsCount}): {prog.MatnTitle}" : "لا توجد متون مخصصة بعد")</span>
                            </div>
                        }

                        <p class="prog-desc">
                            @(string.IsNullOrEmpty(prog.Description) ? "لا يوجد وصف محدد لهذا البرنامج." : prog.Description)
                        </p>
                    </div>

                    <div class="prog-card-foot">
                        <span class="prog-classes-count">
                            <i class='bx bx-group'></i>
                            <span>@prog.ClassesCount شعب/حلقات</span>
                        </span>

                        <div class="prog-actions">
                            <a asp-action="Edit" asp-route-id="@prog.Id" class="prog-action-btn" title="تعديل البرنامج">
                                <i class='bx bx-edit-alt'></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@prog.Id" method="post" style="display: inline;"
                                  onsubmit="return confirm('هل أنت متأكد من رغبتك في حذف هذا البرنامج التعليمي؟');">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="prog-action-btn --delete" title="حذف البرنامج">
                                    <i class='bx bx-trash'></i>
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</div>
