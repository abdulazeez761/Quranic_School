@model Hafiz.DTOs.StudyProgram.UpdateStudyProgramDto
@using Hafiz.Domain.Enums
@using Hafiz.DTOs.StudyProgram
@{
    ViewData["Title"] = "تعديل برنامج تعليمي";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var program = ViewBag.Program as StudyProgramDto;
    var matuns = program?.Matuns?.OrderBy(m => m.Order).ToList() ?? new List<MatnSummaryDto>();
    var availableMatns = ViewBag.AvailableMatns as List<SelectListItem> ?? new List<SelectListItem>();
}

<link rel="stylesheet" href="~/css/admin/study-programs.css" asp-append-version="true" />

<div class="admin-form-container">
    <!-- رأس الصفحة متجاوب -->
    <div class="prog-edit-header">
        <div>
            <h2 class="section-title mb-xs" style="display: flex; align-items: center; gap: 8px;">
                <i class='bx bx-edit' style="color: var(--primary-green);"></i>
                <span>تعديل البرنامج التعليمي: @Model.Name</span>
            </h2>
            <p class="text-medium" style="margin: 0; font-size: var(--font-size-sm);">
                تحديث بيانات وإعدادات البرنامج وإدارة قائمة المتون المقررة وترتيب أولوياتها.
            </p>
        </div>
        <div>
            <a asp-action="Index" class="btn btn-outline btn-sm" style="display: inline-flex; align-items: center; gap: 6px;">
                <i class='bx bx-arrow-back'></i>
                <span>العودة للبرامج</span>
            </a>
        </div>
    </div>

    <!-- الإشعارات -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success d-flex align-center gap-sm mb-md">
            <i class='bx bx-check-circle' style="font-size: 1.25rem;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger d-flex align-center gap-sm mb-md">
            <i class='bx bx-error-circle' style="font-size: 1.25rem;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- بطاقة الإعدادات الأساسية -->
    <div class="card card-standard mb-lg">
        <div class="card-header">
            <h3 class="card-title">
                <i class='bx bx-slider-alt'></i>
                إعدادات البرنامج الأساسية
            </h3>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-md" role="alert"></div>

                <div class="form-group mb-md">
                    <label asp-for="Name" class="form-label" style="font-weight: 600;">اسم البرنامج <span class="text-danger">*</span></label>
                    <input asp-for="Name" class="form-input" required />
                    <span asp-validation-for="Name" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                </div>

                <div class="form-row mb-md" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr)); gap: var(--space-md);">
                    <div class="form-group">
                        <label asp-for="Type" class="form-label" style="font-weight: 600;">نوع المسار التعليمي <span class="text-danger">*</span></label>
                        <select asp-for="Type" id="programTypeSelect" class="form-select" required>
                            <option value="@((int)ProgramType.Quran)">تحفيظ القرآن الكريم</option>
                            <option value="@((int)ProgramType.Matn)">المتون والعلوم الشرعية</option>
                            <option value="@((int)ProgramType.Sanad)">السند الغيبي</option>
                            <option value="@((int)ProgramType.Ijaza)">الإجازة القرآنية</option>
                        </select>
                        <span asp-validation-for="Type" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label" style="font-weight: 600;">عدد الحلقات المرتبطة</label>
                        <div class="form-input" style="background: #f8fafc; color: var(--text-dark); display: flex; align-items: center; gap: 8px; min-height: 42px;">
                            <i class='bx bx-group' style="color: var(--primary-green); font-size: 1.15rem;"></i>
                            <span>@(program?.ClassesCount ?? 0) حلقة تعليمية</span>
                        </div>
                    </div>
                </div>

                <div class="form-group mb-md">
                    <label asp-for="Description" class="form-label" style="font-weight: 600;">الوصف</label>
                    <textarea asp-for="Description" class="form-input" rows="3" placeholder="وصف موجز لأهداف ومخرجات هذا البرنامج..."></textarea>
                    <span asp-validation-for="Description" class="form-error text-danger" style="font-size: var(--font-size-xs);"></span>
                </div>

                <div class="form-group mb-lg" style="display: flex; align-items: center; gap: 12px; background: #f8fafc; padding: 14px 16px; border-radius: var(--radius-md); border: 1px solid var(--border-color); cursor: pointer;">
                    <input type="checkbox" asp-for="IsActive" id="isActiveSwitch" style="width: 22px; height: 22px; cursor: pointer; accent-color: var(--primary-green);" />
                    <label for="isActiveSwitch" style="font-weight: 600; cursor: pointer; color: var(--text-dark); margin: 0; user-select: none;">
                        البرنامج نشط ومتاح لربط الحلقات وإسناد الأوراد
                    </label>
                </div>

                <div class="form-actions form-actions-right border-top pt-md mt-md d-flex gap-sm flex-wrap">
                    <button type="submit" class="btn btn-primary" style="min-width: 150px; display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                        <i class='bx bx-check'></i>
                        <span>حفظ بيانات البرنامج</span>
                    </button>
                    <a asp-action="Index" class="btn btn-outline" style="min-width: 100px; display: inline-flex; align-items: center; justify-content: center;">إلغاء</a>
                </div>
            </form>
        </div>
    </div>

    <!-- قسم إدارة المتون التابعة للبرنامج (يظهر فقط إذا كان البرنامج للمتون) -->
    @if (Model.Type == ProgramType.Matn)
    {
        <div class="card card-standard">
            <div class="card-header d-flex justify-between align-center flex-wrap gap-sm">
                <div>
                    <h3 class="card-title">
                        <i class='bx bx-library' style="color: var(--primary-green);"></i>
                        منهج المتون العلمية المقررة في هذا البرنامج (@matuns.Count متون)
                    </h3>
                    <p class="text-muted" style="font-size: 12px; margin: 4px 0 0;">
                        يمكنك إضافة عدة متون وترتيب أولويتها في المنهج وتفعيلها للتقييم والتسميع.
                    </p>
                </div>
            </div>

            <div class="card-body">
                <!-- شريط إضافة متن من المكتبة (متجاوب للهواتف) -->
                <div class="prog-add-matn-box">
                    <h4 class="prog-add-matn-title">
                        <i class='bx bx-plus-circle'></i>
                        <span>إضافة متن من المكتبة إلى هذا البرنامج</span>
                    </h4>
                    <form asp-action="AddMatn" method="post" class="prog-add-matn-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="programId" value="@Model.Id" />
                        <div class="prog-add-matn-select-wrap">
                            <select name="matnId" class="form-select" required style="width: 100%; min-height: 42px;">
                                <option value="">-- اختر المتن المطلوب إضافته للمنهج --</option>
                                @foreach (var item in availableMatns)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>
                        <div class="prog-add-matn-btns">
                            <button type="submit" class="btn btn-primary btn-sm" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                <i class='bx bx-plus'></i>
                                <span>إضافة المتن للبرنامج</span>
                            </button>
                            <a asp-controller="Matns" asp-action="Create" asp-route-studyProgramId="@Model.Id" class="btn btn-outline btn-sm" style="display: inline-flex; align-items: center; justify-content: center; gap: 6px;">
                                <i class='bx bx-book-add'></i>
                                <span>إنشاء متن جديد بالمكتبة</span>
                            </a>
                        </div>
                    </form>
                </div>

                <!-- قائمة المتون المقررة -->
                @if (!matuns.Any())
                {
                    <div class="text-center p-xl" style="background: #fafafa; border-radius: var(--radius-md); border: 1px dashed #e2e8f0;">
                        <i class='bx bx-book-open' style="font-size: 3rem; color: #94a3b8;"></i>
                        <h4 style="margin: 12px 0 4px; color: #475569; font-weight: 700;">لا توجد متون مقررة في هذا البرنامج حالياً</h4>
                        <p class="text-muted" style="font-size: 13px;">اختر متناً من القائمة أعلاه لإضافته كأول متن في منهج هذا البرنامج.</p>
                    </div>
                }
                else
                {
                    <!-- جدول الشاشات الكبيرة (Desktop Table) -->
                    <div class="prog-syllabus-table-wrapper table-responsive">
                        <table class="table table-hover" style="width: 100%; border-collapse: collapse;">
                            <thead>
                                <tr style="border-bottom: 2px solid var(--border-color); text-align: right; background: #f8fafc;">
                                    <th style="padding: 12px; width: 70px;">الترتيب</th>
                                    <th style="padding: 12px;">اسم المتن</th>
                                    <th style="padding: 12px;">المؤلف</th>
                                    <th style="padding: 12px;">الفن / التخصص</th>
                                    <th style="padding: 12px; text-align: center;">الحالة</th>
                                    <th style="padding: 12px; text-align: center; width: 220px;">الإجراءات</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < matuns.Count; i++)
                                {
                                    var m = matuns[i];
                                    <tr style="border-bottom: 1px solid var(--border-color);">
                                        <td style="padding: 12px; vertical-align: middle;">
                                            <span class="badge" style="background: #e2e8f0; color: #334155; font-weight: 800; font-size: 13px; padding: 4px 10px; border-radius: 9999px;">
                                                @(i + 1)
                                            </span>
                                        </td>
                                        <td style="padding: 12px; vertical-align: middle; font-weight: 700; color: var(--text-dark);">
                                            @m.Title
                                        </td>
                                        <td style="padding: 12px; vertical-align: middle; color: var(--text-medium);">
                                            @(string.IsNullOrEmpty(m.Author) ? "—" : m.Author)
                                        </td>
                                        <td style="padding: 12px; vertical-align: middle;">
                                            <span class="badge" style="background: #f1f5f9; color: #475569; font-size: 11.5px; padding: 4px 8px; border-radius: 4px;">
                                                @m.CategoryName
                                            </span>
                                        </td>
                                        <td style="padding: 12px; vertical-align: middle; text-align: center;">
                                            <form asp-action="ToggleMatnActive" method="post" style="display: inline;">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="programId" value="@Model.Id" />
                                                <input type="hidden" name="matnId" value="@m.Id" />
                                                <button type="submit" class="btn btn-sm @(m.IsActive ? "btn-success" : "btn-outline")" style="font-size: 11px; padding: 3px 8px;" title="تبديل حالة التفعيل">
                                                    @(m.IsActive ? "مفعّل" : "معطل")
                                                </button>
                                            </form>
                                        </td>
                                        <td style="padding: 12px; vertical-align: middle; text-align: center;">
                                            <div class="d-flex justify-center gap-xs align-center">
                                                @if (i > 0)
                                                {
                                                    <form asp-action="MoveMatnUp" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="programId" value="@Model.Id" />
                                                        <input type="hidden" name="matnId" value="@m.Id" />
                                                        <button type="submit" class="btn btn-outline btn-sm" title="تحريك للأعلى" style="padding: 4px 8px;">
                                                            <i class='bx bx-up-arrow-alt'></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (i < matuns.Count - 1)
                                                {
                                                    <form asp-action="MoveMatnDown" method="post" style="display: inline;">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="programId" value="@Model.Id" />
                                                        <input type="hidden" name="matnId" value="@m.Id" />
                                                        <button type="submit" class="btn btn-outline btn-sm" title="تحريك للأسفل" style="padding: 4px 8px;">
                                                            <i class='bx bx-down-arrow-alt'></i>
                                                        </button>
                                                    </form>
                                                }
                                                <form asp-action="RemoveMatn" method="post" style="display: inline;" onsubmit="return confirm('هل أنت متأكد من فك ارتباط هذا المتن من البرنامج؟ لن يتم حذف المتن من المكتبة العامة.');">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="programId" value="@Model.Id" />
                                                    <input type="hidden" name="matnId" value="@m.Id" />
                                                    <button type="submit" class="btn btn-outline btn-sm text-danger" title="إزالة من البرنامج" style="padding: 4px 8px; border-color: #fca5a5;">
                                                        <i class='bx bx-trash'></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <!-- بطاقات الهواتف والأجهزة اللوحية (Mobile & Tablet Cards) - تجربة مستخدم لمسية متطورة -->
                    <div class="prog-syllabus-mobile-cards">
                        @for (int i = 0; i < matuns.Count; i++)
                        {
                            var m = matuns[i];
                            <div class="prog-syllabus-card @(m.IsActive ? "" : "is-inactive")">
                                <div class="prog-syllabus-card-top">
                                    <div class="prog-syllabus-rank">
                                        <span class="prog-syllabus-order-pill">
                                            <i class='bx bx-hash'></i>
                                            <span>الترتيب @(i + 1)</span>
                                        </span>
                                        <span class="badge @(m.IsActive ? "badge-success-subtle" : "badge-secondary-subtle")">
                                            <i class='bx @(m.IsActive ? "bx-check-circle" : "bx-pause-circle")'></i>
                                            @(m.IsActive ? "مفعّل للدراسة" : "معطل مؤقتاً")
                                        </span>
                                    </div>
                                    <div class="prog-syllabus-info">
                                        <h4 class="prog-syllabus-title">@m.Title</h4>
                                        <div class="prog-syllabus-meta">
                                            <span class="prog-syllabus-author">
                                                <i class='bx bx-pen'></i>
                                                @(string.IsNullOrEmpty(m.Author) ? "المؤلف: غير محدد" : m.Author)
                                            </span>
                                            <span class="prog-syllabus-category">
                                                <i class='bx bx-bookmark-alt'></i>
                                                @m.CategoryName
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="prog-syllabus-card-bottom">
                                    <!-- تبديل حالة التفعيل -->
                                    <form asp-action="ToggleMatnActive" method="post" style="display: block; width: 100%;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="programId" value="@Model.Id" />
                                        <input type="hidden" name="matnId" value="@m.Id" />
                                        <button type="submit" class="btn btn-sm @(m.IsActive ? "btn-outline-warning" : "btn-outline-success") prog-syllabus-toggle-btn"
                                                title="@(m.IsActive ? "تعطيل المتن مؤقتاً" : "تفعيل المتن للدراسة")">
                                            <i class='bx @(m.IsActive ? "bx-pause" : "bx-play")'></i>
                                            <span>@(m.IsActive ? "تعطيل المتن في البرنامج مؤقتاً" : "تفعيل المتن في المنهج")</span>
                                        </button>
                                    </form>

                                    <!-- أزرار الترتيب والحذف اللمسية -->
                                    <div class="prog-syllabus-actions">
                                        @if (i > 0)
                                        {
                                            <form asp-action="MoveMatnUp" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="programId" value="@Model.Id" />
                                                <input type="hidden" name="matnId" value="@m.Id" />
                                                <button type="submit" class="prog-order-btn" title="تقديم للأعلى (ترتيب أسبق)">
                                                    <i class='bx bx-up-arrow-alt'></i>
                                                    <span>تقديم للأعلى</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div></div>
                                        }

                                        @if (i < matuns.Count - 1)
                                        {
                                            <form asp-action="MoveMatnDown" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="programId" value="@Model.Id" />
                                                <input type="hidden" name="matnId" value="@m.Id" />
                                                <button type="submit" class="prog-order-btn" title="تأخير للأسفل (ترتيب لاحق)">
                                                    <i class='bx bx-down-arrow-alt'></i>
                                                    <span>تأخير للأسفل</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <div></div>
                                        }

                                        <form asp-action="RemoveMatn" method="post" onsubmit="return confirm('هل أنت متأكد من فك ارتباط هذا المتن من البرنامج؟ لن يتم حذف المتن من المكتبة العامة.');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="programId" value="@Model.Id" />
                                            <input type="hidden" name="matnId" value="@m.Id" />
                                            <button type="submit" class="prog-delete-btn" title="إزالة من البرنامج">
                                                <i class='bx bx-trash'></i>
                                                <span>فك ارتباط المتن من البرنامج</span>
                                            </button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
