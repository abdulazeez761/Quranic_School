@using Hafiz.Common.Helper
@using Hafiz.DTOs
@model Hafiz.Application.Common.PagedResult<Hafiz.Models.Class>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Title"];
    bool isArchived = ViewBag.IsArchived == true;
    int activeCount = ViewBag.ActiveCount ?? 0;
    int archivedCount = ViewBag.ArchivedCount ?? 0;
}

<!-- Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success mb-md d-flex align-center gap-sm">
        <i class='bx bx-check-circle' style="font-size: 1.25rem;"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger mb-md d-flex align-center gap-sm">
        <i class='bx bx-error-circle' style="font-size: 1.25rem;"></i>
        <span>@TempData["ErrorMessage"]</span>
    </div>
}

<!-- Page Header -->
<div class="d-flex justify-between align-center mb-lg flex-wrap gap-md">
    <div>
        <h2 class="section-title mb-sm">
            <i class='bx bx-book' style="color: var(--primary-green);"></i>
            @Localizer["Title"]
        </h2>
        <p class="text-medium">@Localizer["PageDescription"]</p>
    </div>
    <div class="btn-group">
        <a asp-action="Create" class="btn btn-primary">
            <i class='bx bx-plus-circle'></i>
            <span>@Localizer["AddNewClass"]</span>
        </a>
        <button class="btn btn-outline" id="exportBtn">
            <i class='bx bx-download'></i>
            <span>@Localizer["Export"]</span>
        </button>
    </div>
</div>

<!-- Statistics Cards -->
@{
    var totalClasses = ViewBag.TotalClasses ?? Model?.TotalCount ?? 0;
    var maleClasses = ViewBag.MaleClasses ?? 0;
    var femaleClasses = ViewBag.FemaleClasses ?? 0;
    var totalTeachers = ViewBag.TotalTeachers ?? 0;
    var selectedGender = ViewBag.Gender as string ?? "";
    var currentSearch = ViewBag.Search as string ?? "";
}

<div class="grid-auto-fit mb-lg">
    <div class="card card-stat">
        <div class="card-stat-icon">
            <i class='bx bx-book-open'></i>
        </div>
        <div class="card-stat-content">
            <div class="card-stat-label">@(isArchived ? Localizer["ArchivedRecords"] : Localizer["TotalClasses"])</div>
            <div class="card-stat-value">@totalClasses</div>
        </div>
    </div>

    <div class="card card-stat" style="--icon-bg: var(--info);">
        <div class="card-stat-icon" style="background: var(--info);">
            <i class='bx bx-male'></i>
        </div>
        <div class="card-stat-content">
            <div class="card-stat-label">@Localizer["MaleClasses"]</div>
            <div class="card-stat-value">@maleClasses</div>
        </div>
    </div>

    <div class="card card-stat" style="--icon-bg: var(--warning);">
        <div class="card-stat-icon" style="background: var(--warning);">
            <i class='bx bx-female'></i>
        </div>
        <div class="card-stat-content">
            <div class="card-stat-label">@Localizer["FemaleClasses"]</div>
            <div class="card-stat-value">@femaleClasses</div>
        </div>
    </div>

    <div class="card card-stat" style="--icon-bg: var(--success);">
        <div class="card-stat-icon" style="background: var(--success);">
            <i class='bx bx-group'></i>
        </div>
        <div class="card-stat-content">
            <div class="card-stat-label">@Localizer["TotalTeachers"]</div>
            <div class="card-stat-value">@totalTeachers</div>
        </div>
    </div>
</div>

<!-- Archive Navigation Tabs -->
<div class="archive-nav-tabs">
    <a asp-action="Index" asp-route-archived="false" class="archive-nav-tab @(!isArchived ? "active" : "")">
        <i class='bx bx-check-circle'></i>
        <span>@Localizer["ActiveRecords"]</span>
        <span class="tab-count-pill">@activeCount</span>
    </a>
    <a asp-action="Index" asp-route-archived="true" class="archive-nav-tab @(isArchived ? "active" : "")">
        <i class='bx bx-archive'></i>
        <span>@Localizer["ArchivedRecords"]</span>
        <span class="tab-count-pill @(archivedCount > 0 ? "tab-count-pill--warning" : "")">@archivedCount</span>
    </a>
</div>

<!-- Table Container -->
<div class="table-container">

    <!-- Search and Filter Toolbar -->
    <form method="get" asp-action="Index" class="table-toolbar">
        <input type="hidden" name="archived" value="@isArchived.ToString().ToLower()" />
        <div class="table-search">
            <input type="text" name="search" id="searchInput" value="@currentSearch" placeholder="@Localizer["SearchPlaceholder"]">
            <i class='bx bx-search'></i>
        </div>
        <div class="table-filters">
            <select id="genderFilter" name="gender" class="form-select form-input-sm" onchange="this.form.submit()">
                <option value="">@Localizer["AllTypes"]</option>
                <option value="male" selected="@(selectedGender == "male")">@Localizer["Gender_male"]</option>
                <option value="female" selected="@(selectedGender == "female")">@Localizer["Gender_female"]</option>
            </select>
            <button type="submit" class="btn btn-primary btn-sm">
                <i class='bx bx-filter-alt'></i>
                <span class="d-none d-md-inline">@Localizer["Search"]</span>
            </button>
            <a asp-action="Index" asp-route-archived="@isArchived.ToString().ToLower()" id="clearFilters" class="btn btn-outline btn-sm">
                <i class='bx bx-refresh'></i>
                <span class="d-none d-md-inline">@Localizer["Reset"]</span>
            </a>
        </div>
    </form>

    <!-- Records grid -->
    <div class="record-grid" id="classesGrid">
        @if (Model != null && Model.Items.Any())
        {
            int index = 0;
            foreach (var cl in Model.Items)
            {
                var teacherNames = string.Join("، ", cl.Teachers.Select(t => t.TeacherInfo.FirstName));
                var hasTeachers = cl.Teachers.Any();
                var days = string.Join("، ", cl.ClassDays.Select(d => Formatting.GetLocalizedDayName(d)));
                var avatarVariant = index % 5;
                var isFemale = cl.Gender.ToString().ToLower() == "female";
                var badgeVariant = isFemale ? "record-badge--green" : "record-badge--gold";

                <div class="record-card" data-name="@cl.Name.ToLower()" data-gender="@cl.Gender.ToString().ToLower()">

                    <div class="record-card-header">
                        <div class="record-avatar record-avatar--@avatarVariant">
                            @cl.Name.Substring(0, 1)
                        </div>
                        <div class="record-identity">
                            <span class="record-name">@cl.Name</span>
                            @if (isArchived)
                            {
                                <span class="record-badge record-badge--archived">
                                    <i class='bx bx-archive'></i>
                                    <span>@Localizer["Archived"]</span>
                                </span>
                            }
                            else
                            {
                                <span class="record-badge @badgeVariant">
                                    <i class='bx @(isFemale ? "bx-female" : "bx-male")'></i>
                                    <span>@Localizer[$"Gender_{cl.Gender}"]</span>
                                </span>
                            }
                        </div>
                    </div>

                    <div class="record-info">
                        <div class="record-info-row">
                            <i class='bx bx-chalkboard'></i>
                            @if (hasTeachers)
                            {
                                <span title="@teacherNames">@teacherNames</span>
                            }
                            else
                            {
                                <span>@Localizer["NoTeachers"]</span>
                            }
                        </div>
                        <div class="record-info-row">
                            <i class='bx bx-calendar'></i>
                            <span title="@days">@days</span>
                        </div>
                        <div class="record-info-row">
                            <i class='bx bx-time-five'></i>
                            <span class="record-info-value">@cl.ClassTime.ToString("hh:mm tt")</span>
                        </div>
                        <div class="record-info-row">
                            <i class='bx bx-group'></i>
                            <span class="record-info-value">@cl.Students.Count @Localizer["Students"]</span>
                        </div>
                        @if (isArchived && cl.DeletedAt.HasValue)
                        {
                            <div class="record-info-row text-muted" style="font-size: 12.5px;">
                                <i class='bx bx-time'></i>
                                <span>@Localizer["ArchivedAt"]: @cl.DeletedAt.Value.ToString("yyyy/MM/dd")</span>
                            </div>
                        }
                    </div>

                    <div class="record-actions">
                        @if (isArchived)
                        {
                            <form asp-action="Restore" asp-route-id="@cl.Id" method="post" class="restore-form">
                                <button type="submit" class="record-btn record-btn-restore"
                                        data-confirm-restore="@string.Format(Localizer["RestoreConfirmation"].Value, cl.Name)"
                                        data-tooltip="@Localizer["Restore"]">
                                    <i class='bx bx-undo'></i>
                                    <span>@Localizer["Restore"]</span>
                                </button>
                            </form>
                        }
                        else
                        {
                            <a asp-action="Edit" asp-route-id="@cl.Id" class="record-btn record-btn-edit">
                                <i class='bx bx-edit'></i>
                                <span>@Localizer["Edit"]</span>
                            </a>
                            <form asp-action="Delete" asp-route-id="@cl.Id" method="post" class="delete-form">
                                <button type="submit" class="record-btn record-btn-delete"
                                        data-confirm-delete="@string.Format(Localizer["DeleteConfirmation"].Value, cl.Name)"
                                        data-tooltip="@Localizer["Delete"]">
                                    <i class='bx bx-trash'></i>
                                </button>
                            </form>
                        }
                    </div>
                </div>
                index++;
            }
        }
        else
        {
            if (isArchived)
            {
                <div class="record-empty">
                    <i class='bx bx-archive'></i>
                    <h3 class="record-empty-title">@Localizer["NoArchivedDataAvailable"]</h3>
                    <p class="text-medium">@Localizer["NoArchivedClasses"]</p>
                    <a asp-action="Index" asp-route-archived="false" class="btn btn-outline mt-md">
                        <i class='bx bx-arrow-back'></i> @Localizer["ActiveRecords"]
                    </a>
                </div>
            }
            else
            {
                <div class="record-empty">
                    <i class='bx bx-book'></i>
                    <h3 class="record-empty-title">@Localizer["NoClasses"]</h3>
                    <p class="text-medium">@Localizer["NoClassesDescription"]</p>
                    <a asp-action="Create" class="btn btn-primary mt-md">
                        <i class='bx bx-plus-circle'></i> @Localizer["AddNewClass"]
                    </a>
                </div>
            }
        }
    </div>

    <!-- Table Footer with Pagination -->
    @await Html.PartialAsync("_Pagination", Model)
</div>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/classes/search.js" asp-append-version="true"></script>
    <script src="~/js/confirmModal.js" asp-append-version="true"></script>
}