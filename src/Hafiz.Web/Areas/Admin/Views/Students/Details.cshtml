@model Hafiz.DTOs.Student.AdminStudentDetailsViewModel
@using Hafiz.Common.Helper
@using Hafiz.Models
@using Hafiz.Domain.Enums
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["StudentDetails"];
    var student = Model.Student;
    var attendance = Model.Attendance;
    var paginatedWirds = Model.PaginatedWirds;
    var parentNotes = Model.ParentNotes;

    var totalMemorizedPages = WirdPageCalculator.TotalMemorizedPages(student);
    var (memorizedJuzDisplay, memorizedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(totalMemorizedPages);
    var reviewedPages = student.ReviewedPages;
    var (reviewedJuzDisplay, reviewedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(reviewedPages);
    var totalTajwidPages = WirdPageCalculator.TotalTajwidPages(student);
    var isHafiz = WirdPageCalculator.IsHafiz(student);
    var activeTab = Model.ActiveTab;

    var isArchivedStudent = student.IsDeleted;
    var referer = Context.Request.Headers["Referer"].ToString();
    var backUrl = string.IsNullOrEmpty(referer) 
        ? Url.Action("Index", "Students", new { area = "Admin", archived = isArchivedStudent }) 
        : referer;
    var availableMatns = ViewBag.AvailableMatns as IEnumerable<Hafiz.DTOs.Matn.MatnDto> ?? Enumerable.Empty<Hafiz.DTOs.Matn.MatnDto>();
    var studentFullName = $"{student.StudentInfo?.FirstName} {student.StudentInfo?.SecondName}".Trim();
}

<link rel="stylesheet" href="~/css/teacher/matn-progress.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/student-details-matns.css" asp-append-version="true" />

<div class="admin-student-details">
    @if (isArchivedStudent)
    {
        <div class="archive-alert-banner" style="background: rgba(234, 88, 12, 0.08); border: 1px solid rgba(234, 88, 12, 0.25); border-radius: 10px; padding: 12px 18px; margin-bottom: 20px; display: flex; align-items: center; justify-content: space-between; gap: 12px;">
            <div style="display: flex; align-items: center; gap: 10px; color: #c2410c;">
                <i class='bx bx-archive-in' style="font-size: 24px;"></i>
                <span style="font-size: 14px;"><strong>سجل مؤرشف:</strong> هذا الطالب مؤرشف حالياً. يمكنك تصفح كامل سجلاته وإحصائياته وأوراده السابقة، أو استعادته للنظام في أي وقت.</span>
            </div>
            <form asp-action="Restore" asp-route-id="@student.UserId" method="post" style="margin: 0;">
                <button type="submit" class="btn btn-sm btn-success"
                        data-confirm-restore="@string.Format(Localizer["RestoreConfirmation"]?.Value ?? "هل أنت متأكد من استعادة الطالب {0} {1}؟", student.StudentInfo.FirstName, student.StudentInfo.SecondName)"
                        style="height: 36px; display: inline-flex; align-items: center; gap: 6px; padding: 0 14px; font-weight: 600;">
                    <i class='bx bx-undo'></i>
                    <span>@Localizer["Restore"]</span>
                </button>
            </form>
        </div>
    }

    <!-- Header -->
    <div class="student-detail-header">
        <div class="student-detail-avatar">
            <i class='bx bx-user'></i>
        </div>
        <div class="student-detail-info">
            <h1 class="student-detail-name">
                @student.StudentInfo.FirstName @student.StudentInfo.SecondName
                @if (isHafiz)
                {
                    <span class="hafiz-badge" title="@Localizer["HafizTitle"]">
                        <i class='bx bxs-award'></i> @Localizer["Hafiz"]
                    </span>
                }
                @if (isArchivedStudent)
                {
                    <span class="record-badge record-badge--archived" style="margin-inline-start: 8px; font-size: 13px;">
                        <i class='bx bx-archive'></i> @Localizer["Archived"]
                    </span>
                }
            </h1>
            <p class="student-detail-username">@@@student.StudentInfo.Username</p>
            <p class="student-detail-class">
                <i class='bx bx-book'></i>
                @if (student.Classes?.Any() == true)
                {
                    @string.Join(", ", student.Classes.Select(c => c.Name))
                }
                else
                {
                    @Localizer["NoClass"]
                }
            </p>
        </div>
        <div class="header-actions" style="display: flex; gap: 8px; align-items: center;">
            @if (isArchivedStudent)
            {
                <form asp-action="Restore" asp-route-id="@student.UserId" method="post" style="margin: 0;">
                    <button type="submit" class="btn btn-sm btn-success"
                            data-confirm-restore="@string.Format(Localizer["RestoreConfirmation"]?.Value ?? "هل أنت متأكد من استعادة الطالب {0} {1}؟", student.StudentInfo.FirstName, student.StudentInfo.SecondName)"
                            style="height: 38px; display: inline-flex; align-items: center; gap: 6px; padding: 0 14px; font-weight: 600;">
                        <i class='bx bx-undo'></i>
                        <span>@Localizer["Restore"]</span>
                    </button>
                </form>
            }
            <a href="/Certificates/Quran/@student.UserId" target="_blank" class="btn btn-outline" style="height: 38px; display: inline-flex; align-items: center; gap: 6px; padding: 0 14px; font-weight: 600; border-color: #10b981; color: #047857;" title="تصدير وطباعة شهادة إتمام القرآن الكريم أو أجزاء منه">
                <i class='bx bx-award' style="font-size: 1.15rem;"></i>
                <span>تصدير شهادة القرآن</span>
            </a>
            <a href="@backUrl" class="back-btn">
                <i class='bx bx-arrow-back'></i>
                @Localizer["BackToList"]
            </a>
        </div>
    </div>

    <!-- Tabs -->
    <div class="tabs-container">
        <div class="tabs-header">
            <button class="tab-btn @(activeTab == "overview" ? "active" : "")" onclick="openTab(event, 'overview')">
                <i class='bx bx-grid-alt'></i> @Localizer["Overview"]
            </button>
            <button class="tab-btn @(activeTab == "personal" ? "active" : "")" onclick="openTab(event, 'personal')">
                <i class='bx bx-info-circle'></i> @Localizer["PersonalInformation"]
            </button>
            <button class="tab-btn @(activeTab == "attendance" ? "active" : "")" onclick="openTab(event, 'attendance')">
                <i class='bx bx-calendar'></i> @Localizer["AttendanceHistory"]
            </button>
            <button class="tab-btn @(activeTab == "wirds" ? "active" : "")" onclick="openTab(event, 'wirds')">
                <i class='bx bx-book-bookmark'></i> @Localizer["WirdAssignments"]
            </button>
            <button class="tab-btn @(activeTab == "notes" ? "active" : "")" onclick="openTab(event, 'notes')">
                <i class='bx bx-note'></i> @Localizer["Notes"]
                @if (parentNotes.Any())
                {
                    <span class="tab-badge">@parentNotes.Count()</span>
                }
            </button>
            <button class="tab-btn @(activeTab == "matns" ? "active" : "")" onclick="openTab(event, 'matns')">
                <i class='bx bx-bookmarks'></i> المتون العلمية
                @if (Model.MatnProgresses.Any())
                {
                    <span class="tab-badge">@Model.MatnProgresses.Count</span>
                }
            </button>
        </div>

        <!-- Overview Tab -->
        <div id="overview" class="tab-content @(activeTab == "overview" ? "active" : "")">
            <div class="overview-cards">
                <div class="overview-card">
                    <div class="card-icon attendance-icon">
                        <i class='bx bx-calendar-check'></i>
                    </div>
                    <div class="card-content">
                        <h3>@Model.AttendanceRate%</h3>
                        <p>@Localizer["AttendanceRate"]</p>
                    </div>
                </div>
                <div class="overview-card">
                    <div class="card-icon completion-icon">
                        <i class='bx bx-task'></i>
                    </div>
                    <div class="card-content">
                        <h3>@paginatedWirds.CompletedCount</h3>
                        <p>@Localizer["CompletedWirds"]</p>
                    </div>
                </div>
                <div class="overview-card">
                    <div class="card-icon juz-icon">
                        <i class='bx bx-book-open'></i>
                    </div>
                    <div class="card-content">
                        <h3>@memorizedJuzDisplay<span class="card-total">/30</span></h3>
                        <p>@Localizer["MemorizedJuz"]</p>
                    </div>
                </div>
                <div class="overview-card">
                    <div class="card-icon tajwid-icon">
                        <i class='bx bx-star'></i>
                    </div>
                    <div class="card-content">
                        <h3>@Localizer[$"TajwidLevel_{student.TajwidLevel}"]</h3>
                        <p>@Localizer["TajwidLevel"]</p>
                    </div>
                </div>
            </div>

            <!-- Memorization & Review -->
            <div class="overview-cards">
                <div class="overview-card">
                    <div class="card-icon memorized-icon">
                        <i class='bx bx-bookmark-heart'></i>
                    </div>
                    <div class="card-content">
                        <h3>@totalMemorizedPages.ToString("0.##")</h3>
                        <p>
                            @Localizer["MemorizedPages"]
                            <small style="display:block; opacity:0.75;">
                                @memorizedJuzDisplay @Localizer["JuzShort"]
                                @if (memorizedPagesRemainder > 0)
                                {
                                    <text>+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                                }
                            </small>
                        </p>
                    </div>
                </div>
                <div class="overview-card">
                    <div class="card-icon reviewed-icon">
                        <i class='bx bx-revision'></i>
                    </div>
                    <div class="card-content">
                        <h3>@reviewedPages.ToString("0.##")</h3>
                        <p>
                            @Localizer["ReviewedPages"]
                            <small style="display:block; opacity:0.75;">
                                @reviewedJuzDisplay @Localizer["JuzShort"]
                                @if (reviewedPagesRemainder > 0)
                                {
                                    <text>+ @reviewedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                                }
                            </small>
                        </p>
                    </div>
                </div>
                <div class="overview-card">
                    <div class="card-icon collection-icon">
                        <i class='bx bx-collection'></i>
                    </div>
                    <div class="card-content">
                        <h3>@reviewedJuzDisplay</h3>
                        <p>@Localizer["ReviewedJuz"]</p>
                    </div>
                </div>
            </div>

            <!-- Attendance Summary -->
            @if (attendance.Count > 0)
            {
                var totalAtt = attendance.Count;
                <div class="section-card attendance-summary-card">
                    <div class="section-header">
                        <h2><i class='bx bx-pie-chart-alt-2'></i> @Localizer["AttendanceSummary"]</h2>
                    </div>
                    <div class="section-content">
                        <div class="attendance-bar-chart">
                            <div class="att-bar-row">
                                <span class="att-bar-label">@Localizer["AttendanceStatus_Present"]</span>
                                <div class="att-bar-track">
                                    <div class="att-bar-fill att-present"
                                         style="width: @(totalAtt > 0 ? Math.Round((double)Model.PresentCount / totalAtt * 100) : 0)%">
                                    </div>
                                </div>
                                <span class="att-bar-count">@Model.PresentCount</span>
                            </div>
                            <div class="att-bar-row">
                                <span class="att-bar-label">@Localizer["AttendanceStatus_Late"]</span>
                                <div class="att-bar-track">
                                    <div class="att-bar-fill att-late"
                                         style="width: @(totalAtt > 0 ? Math.Round((double)Model.LateCount / totalAtt * 100) : 0)%">
                                    </div>
                                </div>
                                <span class="att-bar-count">@Model.LateCount</span>
                            </div>
                            <div class="att-bar-row">
                                <span class="att-bar-label">@Localizer["AttendanceStatus_Absent"]</span>
                                <div class="att-bar-track">
                                    <div class="att-bar-fill att-absent"
                                         style="width: @(totalAtt > 0 ? Math.Round((double)Model.AbsentCount / totalAtt * 100) : 0)%">
                                    </div>
                                </div>
                                <span class="att-bar-count">@Model.AbsentCount</span>
                            </div>
                            <div class="att-bar-row">
                                <span class="att-bar-label">@Localizer["AttendanceStatus_Excused"]</span>
                                <div class="att-bar-track">
                                    <div class="att-bar-fill att-excused"
                                         style="width: @(totalAtt > 0 ? Math.Round((double)Model.ExcusedCount / totalAtt * 100) : 0)%">
                                    </div>
                                </div>
                                <span class="att-bar-count">@Model.ExcusedCount</span>
                            </div>
                        </div>
                        <div class="att-total-label">
                            @Localizer["TotalRecords"]: <strong>@totalAtt</strong>
                        </div>
                    </div>
                </div>
            }

            <!-- Memorization Progress Circle -->
            <div class="section-card">
                <div class="section-header">
                    <h2><i class='bx bx-book-open'></i> @Localizer["MemorizationProgress"]</h2>
                </div>
                <div class="section-content">
                    <div class="memorization-progress">
                        <div class="progress-circle-container">
                            <div class="progress-circle"
                                 style="--progress: @(Math.Min(100, Math.Round((double)totalMemorizedPages / WirdPageCalculator.TotalQuranPages * 100)))">
                                <span class="progress-circle-value">@memorizedJuzDisplay/30</span>
                                <span class="progress-circle-label">@Localizer["Juz"]</span>
                            </div>
                        </div>
                        <div class="progress-details">
                            <div class="progress-detail-item">
                                <i class='bx bx-check-circle'></i>
                                <span>@memorizedJuzDisplay @Localizer["JuzMemorized"]</span>
                            </div>
                            @if (memorizedPagesRemainder > 0)
                            {
                                <div class="progress-detail-item">
                                    <i class='bx bx-plus-circle'></i>
                                    <span>+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</span>
                                </div>
                            }
                            <div class="progress-detail-item">
                                <i class='bx bx-loader-circle'></i>
                                <span>@(Math.Max(0, 30 - memorizedJuzDisplay)) @Localizer["JuzRemaining"]</span>
                            </div>
                            <div class="progress-detail-item">
                                <i class='bx bx-revision'></i>
                                <span>@reviewedPages.ToString("0.##") @Localizer["PagesReviewed"]</span>
                            </div>
                            <div class="progress-detail-item">
                                <i class='bx bx-collection'></i>
                                <span>@reviewedJuzDisplay @Localizer["JuzReviewed"]</span>
                            </div>
                            <div class="progress-detail-item">
                                <i class='bx bx-microphone'></i>
                                <span>@totalTajwidPages.ToString("0.##") @Localizer["TajwidPages"]</span>
                            </div>
                            <div class="progress-detail-item">
                                <i class='bx bx-star'></i>
                                <span>@Localizer["TajwidLevel"]: @Localizer[$"TajwidLevel_{student.TajwidLevel}"]</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Personal Info Tab -->
        <div id="personal" class="tab-content @(activeTab == "personal" ? "active" : "")">
            <div class="section-card">
                <div class="section-header">
                    <h2><i class='bx bx-info-circle'></i> @Localizer["PersonalInformation"]</h2>
                </div>
                <div class="section-content">
                    <div class="info-grid">
                        <div class="info-item">
                            <label><i class='bx bx-envelope'></i> @Localizer["Email"]</label>
                            <span>@(string.IsNullOrEmpty(student.StudentInfo.Email) ? Localizer["NotProvided"].Value :
                                                                student.StudentInfo.Email)</span>
                            </div>
                            <div class="info-item">
                                <label><i class='bx bx-phone'></i> @Localizer["PhoneNumber"]</label>
                                <span>@(string.IsNullOrEmpty(student.StudentInfo.PhoneNumber) ?
                                                                    Localizer["NotProvided"].Value : student.StudentInfo.PhoneNumber)</span>
                                </div>
                                <div class="info-item">
                                    <label><i class='bx bx-calendar'></i> @Localizer["DateOfBirth"]</label>
                                    <span>@student.DateOfBirth.ToString("yyyy-MM-dd")</span>
                                </div>
                                <div class="info-item">
                                    <label><i class='bx bx-user'></i> @Localizer["Gender"]</label>
                                    <span>@Localizer[$"Gender_{student.sex}"]</span>
                                </div>
                                <div class="info-item">
                                    <label><i class='bx bx-group'></i> @Localizer["Parent"]</label>
                                    <span>
                                        @if (student.Parent != null)
                                        {
                                            @($"{student.Parent.ParentInfo.FirstName} {student.Parent.ParentInfo.SecondName}")
                                        }
                                        else
                                        {
                                            @Localizer["NotProvided"]
                                        }
                                    </span>
                                </div>
                                <div class="info-item">
                                    <label><i class='bx bx-book'></i> @Localizer["ClassesEnrolled"]</label>
                                    <span>
                                        @if (student.Classes?.Any() == true)
                                        {
                                            @string.Join(", ", student.Classes.Select(c => c.Name))
                                        }
                                        else
                                        {
                                            @Localizer["NoClass"]
                                        }
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Attendance Tab -->
                <div id="attendance" class="tab-content @(activeTab == "attendance" ? "active" : "")">
                    <div class="section-card">
                        <div class="section-header">
                            <h2><i class='bx bx-calendar'></i> @Localizer["AttendanceHistory"]</h2>
                            @if (attendance.Count > 0)
                            {
                                <span class="header-badge badge-green">@Model.AttendanceRate% @Localizer["AttendanceRate"]</span>
                            }
                        </div>
                        <div class="section-content">
                            <!-- Date Filter -->
                            <form method="get" class="filter-form mb-lg">
                                <input type="hidden" name="id" value="@student.UserId" />
                                <input type="hidden" name="tab" value="attendance" />
                                <div class="filter-row">
                                    <div class="filter-group">
                                        <label>@Localizer["FromDate"]</label>
                                        <input type="date" name="fromDate"
                                               value="@Model.AttendanceFromDate?.ToString("yyyy-MM-dd")" class="form-input" />
                                    </div>
                                    <div class="filter-group">
                                        <label>@Localizer["ToDate"]</label>
                                        <input type="date" name="toDate" value="@Model.AttendanceToDate?.ToString("yyyy-MM-dd")"
                                               class="form-input" />
                                    </div>
                                    <div class="filter-actions">
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            <i class='bx bx-filter'></i> @Localizer["Filter"]
                                        </button>
                                        <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="attendance"
                                           class="btn btn-outline btn-sm">
                                            <i class='bx bx-reset'></i> @Localizer["Clear"]
                                        </a>
                                    </div>
                                </div>
                            </form>

                            <!-- Attendance Stats -->
                            @if (attendance.Count > 0)
                            {
                                <div class="att-stats-grid mb-lg">
                                    <div class="att-stat-card att-stat-present">
                                        <span class="att-stat-count">@Model.PresentCount</span>
                                        <span class="att-stat-label">@Localizer["AttendanceStatus_Present"]</span>
                                    </div>
                                    <div class="att-stat-card att-stat-late">
                                        <span class="att-stat-count">@Model.LateCount</span>
                                        <span class="att-stat-label">@Localizer["AttendanceStatus_Late"]</span>
                                    </div>
                                    <div class="att-stat-card att-stat-absent">
                                        <span class="att-stat-count">@Model.AbsentCount</span>
                                        <span class="att-stat-label">@Localizer["AttendanceStatus_Absent"]</span>
                                    </div>
                                    <div class="att-stat-card att-stat-excused">
                                        <span class="att-stat-count">@Model.ExcusedCount</span>
                                        <span class="att-stat-label">@Localizer["AttendanceStatus_Excused"]</span>
                                    </div>
                                </div>
                            }

                            @if (attendance.Any())
                            {
                                <div class="table-responsive">
                                    <table class="attendance-table">
                                        <thead>
                                            <tr>
                                                <th>@Localizer["Date"]</th>
                                                <th>@Localizer["Class"]</th>
                                                <th>@Localizer["Status"]</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var record in attendance.OrderByDescending(a => a.Date))
                                            {
                                                <tr>
                                                    <td>
                                                        <div class="date-cell">
                                                            <i class='bx bx-calendar'></i>
                                                            @record.Date.ToString("yyyy-MM-dd")
                                                        </div>
                                                    </td>
                                                    <td>@record.Class?.Name</td>
                                                    <td>
                                                        <span class="status-badge status-@record.Status.ToString().ToLower()">
                                                            @Localizer[$"AttendanceStatus_{record.Status}"]
                                                        </span>
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                            else
                            {
                                <div class="no-data">
                                    <i class='bx bx-calendar-x'></i>
                                    <p>@Localizer["NoAttendanceRecords"]</p>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Wirds Tab -->
                <div id="wirds" class="tab-content @(activeTab == "wirds" ? "active" : "")">
                    <div class="section-card">
                        <div class="section-header">
                            <h2><i class='bx bx-book-bookmark'></i> @Localizer["WirdAssignments"]</h2>
                            <div class="wird-stats-badges">
                                <span class="header-badge badge-green">@paginatedWirds.CompletedCount
                                    @Localizer["Completed"]</span>
                                    <span class="header-badge badge-orange">@paginatedWirds.PendingCount
                                        @Localizer["Pending"]</span>
                                    </div>
                                </div>
                                <div class="section-content">
                                    <!-- Filters -->
                                    <div class="wird-filters mb-lg">
                                        <div class="filter-tabs">
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               class="filter-tab @(string.IsNullOrEmpty(Model.WirdStatus) ? "active" : "")">
                                                @Localizer["All"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="pending" asp-route-type="@Model.WirdType"
                                               class="filter-tab @(Model.WirdStatus == "pending" ? "active" : "")">
                                                @Localizer["Pending"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="completed" asp-route-type="@Model.WirdType"
                                               class="filter-tab @(Model.WirdStatus == "completed" ? "active" : "")">
                                                @Localizer["Completed"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="upcoming" asp-route-type="@Model.WirdType"
                                               class="filter-tab @(Model.WirdStatus == "upcoming" ? "active" : "")">
                                                @Localizer["Upcoming"]
                                            </a>
                                        </div>
                                        <div class="filter-tabs">
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="@Model.WirdStatus"
                                               class="filter-tab @(string.IsNullOrEmpty(Model.WirdType) ? "active" : "")">
                                                @Localizer["AllTypes"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="@Model.WirdStatus" asp-route-type="Memorization"
                                               class="filter-tab @(Model.WirdType == "Memorization" ? "active" : "")">
                                                @Localizer["AssignmentType_Memorization"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="@Model.WirdStatus" asp-route-type="Revision"
                                               class="filter-tab @(Model.WirdType == "Revision" ? "active" : "")">
                                                @Localizer["AssignmentType_Revision"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="@Model.WirdStatus" asp-route-type="Tajwid"
                                               class="filter-tab @(Model.WirdType == "Tajwid" ? "active" : "")">
                                                @Localizer["AssignmentType_Tajwid"]
                                            </a>
                                            <a asp-action="Details" asp-route-id="@student.UserId" asp-route-tab="wirds"
                                               asp-route-status="@Model.WirdStatus" asp-route-type="Tafsir"
                                               class="filter-tab @(Model.WirdType == "Tafsir" ? "active" : "")">
                                                @Localizer["AssignmentType_Tafsir"]
                                            </a>
                                        </div>
                                    </div>

                                    @if (paginatedWirds.Wirds.Any())
                                    {
                                        <div class="wirds-list">
                                            @foreach (var wird in paginatedWirds.Wirds)
                                            {
                                                <div
                                                    class="wird-item @(wird.IsCompleted ? "completed" : "") @(wird.IsUpcoming ? "is-upcoming" : "")">
                                                    <div class="wird-header">
                                                        <div class="wird-type">
                                                            <i class='bx bx-file'></i>
                                                            @Localizer[$"AssignmentType_{wird.Type}"]
                                                        </div>
                                                        <div class="wird-header-right">
                                                            @if (wird.IsUpcoming)
                                                            {
                                                                @await Html.PartialAsync("_UpcomingBadge")
                                                            }
                                                            <div class="wird-date">
                                                                <i class='bx bx-calendar'></i>
                                                                @wird.AssignedDate.ToString("yyyy-MM-dd")
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div class="wird-content">
                                                        <div class="wird-range">
                                                            <span class="range-label">@Localizer["From"]:</span>
                                                            <span class="range-value">
                                                                @Formatting.GetLocalizedSurahName(wird.FromSurah ?? Surah.NONE) (@wird.FromAyah)
                                                                - @Localizer["Page"] @wird.FromPage
                                                            </span>
                                                        </div>
                                                        <div class="wird-range">
                                                            <span class="range-label">@Localizer["To"]:</span>
                                                            <span class="range-value">
                                                                @Formatting.GetLocalizedSurahName(wird.ToSurah ?? Surah.NONE) (@wird.ToAyah)
                                                                - @Localizer["Page"] @wird.ToPage
                                                            </span>
                                                        </div>
                                                        @if (!string.IsNullOrEmpty(wird.Note))
                                                        {
                                                            <div class="wird-note">
                                                                <i class='bx bx-note'></i>
                                                                <span>@wird.Note</span>
                                                            </div>
                                                        }
                                                    </div>
                                                    <div class="wird-footer">
                                                        <span class="status-badge status-@wird.Status.ToString().ToLower()">
                                                            @Localizer[$"AssignmentStatus_{wird.Status}"]
                                                        </span>
                                                        @if (wird.IsCompleted)
                                                        {
                                                            <span class="completion-badge">
                                                                <i class='bx bx-check-circle'></i>
                                                                @Localizer["Completed"]
                                                            </span>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>

                                        <!-- Pagination -->
                                        <div class="pagination-controls">
                                            <div class="pagination-info">
                                                <span>@Localizer["Page"] @paginatedWirds.PageNumber @Localizer["Of"]
                                                    @paginatedWirds.TotalPages
                                                    (@paginatedWirds.TotalCount @Localizer["TotalRecords"])</span>
                                                </div>
                                                <div class="pagination-buttons">
                                                    @if (paginatedWirds.HasPreviousPage)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@student.UserId"
                                                           asp-route-page="@(paginatedWirds.PageNumber - 1)" asp-route-tab="wirds"
                                                           asp-route-status="@Model.WirdStatus" asp-route-type="@Model.WirdType"
                                                           class="pagination-btn prev-btn">
                                                            <i class='bx bx-chevron-left'></i>
                                                            @Localizer["Previous"]
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="pagination-btn prev-btn" disabled>
                                                            <i class='bx bx-chevron-left'></i>
                                                            @Localizer["Previous"]
                                                        </button>
                                                    }

                                                    <div class="page-numbers">
                                                        @for (int i = 1; i <= paginatedWirds.TotalPages; i++)
                                                        {
                                                            if (i == paginatedWirds.PageNumber)
                                                            {
                                                                <span class="page-num active">@i</span>
                                                            }
                                                            else if (i == 1 || i == paginatedWirds.TotalPages ||
                                                            (i >= paginatedWirds.PageNumber - 1 && i <= paginatedWirds.PageNumber + 1))
                                                            {
                                                                <a asp-action="Details" asp-route-id="@student.UserId" asp-route-page="@i"
                                                                   asp-route-tab="wirds" asp-route-status="@Model.WirdStatus"
                                                                   asp-route-type="@Model.WirdType" class="page-num">@i</a>
                                                            }
                                                            else if (i == 2 || i == paginatedWirds.TotalPages - 1)
                                                            {
                                                                <span class="page-num dots">...</span>
                                                            }
                                                        }
                                                    </div>

                                                    @if (paginatedWirds.HasNextPage)
                                                    {
                                                        <a asp-action="Details" asp-route-id="@student.UserId"
                                                           asp-route-page="@(paginatedWirds.PageNumber + 1)" asp-route-tab="wirds"
                                                           asp-route-status="@Model.WirdStatus" asp-route-type="@Model.WirdType"
                                                           class="pagination-btn next-btn">
                                                            @Localizer["Next"]
                                                            <i class='bx bx-chevron-right'></i>
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <button class="pagination-btn next-btn" disabled>
                                                            @Localizer["Next"]
                                                            <i class='bx bx-chevron-right'></i>
                                                        </button>
                                                    }
                                                </div>
                                            </div>
                                        }
                    else
                                        {
                                            <div class="no-data">
                                                <i class='bx bx-book-alt'></i>
                                                <p>@Localizer["NoWirdAssignments"]</p>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>

                            <!-- Notes Tab -->
                            <div id="notes" class="tab-content @(activeTab == "notes" ? "active" : "")">
                                <div class="section-card">
                                    <div class="section-header">
                                        <h2><i class='bx bx-note'></i> @Localizer["ParentNotes"]</h2>
                                        @{
                                            var unreadCount = parentNotes.Count(n => !n.IsRead);
                                        }
                                        @if (unreadCount > 0)
                                        {
                                            <span class="header-badge badge-red"><span class="unread-count">@unreadCount</span>
                                                @Localizer["UnreadNotes"]</span>
                                            }
                                        </div>
                                        <div class="section-content">
                                            @if (parentNotes.Any())
                                            {
                                                <div class="notes-list">
                                                    @foreach (var note in parentNotes.OrderByDescending(n => n.CreatedAt))
                                                    {
                                                        <div class="note-item @(note.IsRead ? "note-read" : "note-unread")" data-note-id="@note.Id">
                                                            <div class="note-header">
                                                                <div class="note-author">
                                                                    <i class='bx bx-user-circle'></i>
                                                                    <span>@note.CreatedByUser.FirstName @note.CreatedByUser.SecondName</span>
                                                                </div>
                                                                <div class="note-meta">
                                                                    <span class="note-status-badge note-badge-unread"
                                                                          style="@(note.IsRead ? "display:none" : "")">
                                                                        <i class='bx bx-bell'></i> @Localizer["NewNote"]
                                                                    </span>
                                                                    <span class="note-status-badge note-badge-read"
                                                                          style="@(note.IsRead ? "" : "display:none")">
                                                                        <i class='bx bx-check-double'></i> @Localizer["ReadNote"]
                                                                    </span>
                                                                    <span class="note-date">
                                                                        <i class='bx bx-time-five'></i>
                                                                        @note.CreatedAt.ToUserTime(Context).ToString("MMM dd, yyyy HH:mm")
                                                                    </span>
                                                                </div>
                                                            </div>
                                                            <div class="note-content">
                                                                @note.Content
                                                            </div>
                                                            <div class="note-footer" style="@(note.IsRead ? "display:none" : "")">
                                                                <button type="button" class="mark-read-btn" onclick="markNoteAsRead(this, '@note.Id')">
                                                                    <i class='bx bx-check'></i> @Localizer["MarkAsRead"]
                                                                </button>
                                                            </div>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                            else
                                            {
                                                <div class="no-data">
                                                    <i class='bx bx-notepad'></i>
                                                    <p>@Localizer["NoParentNotes"]</p>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

        <!-- Matns Tab -->
        <div id="matns" class="tab-content @(activeTab == "matns" ? "active" : "")">
            <div class="admin-matn-kpis mb-lg">
                <div class="admin-matn-kpi-card">
                    <div class="admin-matn-kpi-icon" style="background: #eff6ff; color: #0284c7;">
                        <i class='bx bx-bookmarks'></i>
                    </div>
                    <div class="admin-matn-kpi-info">
                        <span class="admin-matn-kpi-label">إجمالي المتون المسجلة</span>
                        <span class="admin-matn-kpi-val">@Model.MatnProgresses.Count</span>
                    </div>
                </div>
                <div class="admin-matn-kpi-card">
                    <div class="admin-matn-kpi-icon" style="background: #ecfdf5; color: #10b981;">
                        <i class='bx bx-book-open'></i>
                    </div>
                    <div class="admin-matn-kpi-info">
                        <span class="admin-matn-kpi-label">مكتملة المدارسة</span>
                        <span class="admin-matn-kpi-val">@Model.MatnProgresses.Count(p => p.StudyStatus == StudyStatus.Completed)</span>
                    </div>
                </div>
                <div class="admin-matn-kpi-card">
                    <div class="admin-matn-kpi-icon" style="background: #f5f3ff; color: #7c3aed;">
                        <i class='bx bx-check-double'></i>
                    </div>
                    <div class="admin-matn-kpi-info">
                        <span class="admin-matn-kpi-label">مكتملة الحفظ</span>
                        <span class="admin-matn-kpi-val">@Model.MatnProgresses.Count(p => p.MemorizationStatus == MemorizationStatus.Memorized)</span>
                    </div>
                </div>
                <div class="admin-matn-kpi-card">
                    <div class="admin-matn-kpi-icon" style="background: #fef2f2; color: #dc2626;">
                        <i class='bx bx-award'></i>
                    </div>
                    <div class="admin-matn-kpi-info">
                        <span class="admin-matn-kpi-label">اجتاز الاختبار</span>
                        <span class="admin-matn-kpi-val">@Model.MatnProgresses.Count(p => p.ExamStatus == ExamStatus.Passed && (!p.Score.HasValue || p.Score.Value >= (p.PassingGrade > 0 ? p.PassingGrade : 60m)))</span>
                    </div>
                </div>
            </div>

            <div class="admin-matn-table-card">
                <div class="admin-matn-table-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
                    <div style="display: flex; align-items: center; gap: 10px;">
                        <h3 style="margin: 0; font-size: 1.05rem; font-weight: 700; color: #1e293b;">
                            <i class='bx bx-book-reader' style="color: #0284c7;"></i>
                            <span>سجل إنجاز واختبارات المتون العلمية للطالب</span>
                        </h3>
                        @if (Model.MatnProgresses.Any())
                        {
                            <span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 9999px;">
                                @Model.MatnProgresses.Count متون
                            </span>
                        }
                    </div>
                    <div>
                        <button type="button" class="btn-primary-gradient" onclick="openAdminNewMatnModal()">
                            <i class='bx bx-plus-circle' style="font-size: 16px;"></i>
                            <span>رصد أو إسناد متن جديد للطالب</span>
                        </button>
                    </div>
                </div>

                @if (!Model.MatnProgresses.Any())
                {
                    <div class="no-data" style="text-align: center; padding: 48px 20px;">
                        <i class='bx bx-book-open' style="font-size: 48px; color: #94a3b8;"></i>
                        <p style="color: #64748b; margin-top: 12px; font-size: 14px;">لا توجد متون مقررة مسجلة لهذا الطالب حتى الآن في برنامجه التعليمي.</p>
                        <button type="button" class="btn-primary-gradient mt-2" onclick="openAdminNewMatnModal()">
                            <i class='bx bx-plus-circle'></i>
                            <span>رصد أو إسناد أول متن للطالب الآن</span>
                        </button>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="admin-matn-table">
                            <thead>
                                <tr>
                                    <th style="min-width: 180px; text-align: right;">المتن المقرر</th>
                                    <th style="min-width: 130px; text-align: center;">حالة المدارسة</th>
                                    <th style="min-width: 130px; text-align: center;">حالة الحفظ</th>
                                    <th style="min-width: 150px; text-align: center;">الاختبار والدرجة</th>
                                    <th style="min-width: 150px; text-align: right;">ملاحظات</th>
                                    <th style="min-width: 160px; text-align: center;">الإجراء</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var prog in Model.MatnProgresses)
                                {
                                    var passGrade = prog.PassingGrade > 0 ? prog.PassingGrade : 60m;
                                    var isActuallyPassed = prog.ExamStatus == ExamStatus.Passed && (!prog.Score.HasValue || prog.Score.Value >= passGrade);
                                    var isActuallyFailed = prog.ExamStatus == ExamStatus.Failed || (prog.Score.HasValue && prog.Score.Value < passGrade);

                                    <tr class="admin-matn-row"
                                        data-student-id="@student.UserId"
                                        data-student-name="@studentFullName"
                                        data-matn-id="@prog.MatnId"
                                        data-matn-title="@prog.MatnTitle"
                                        data-study-status="@((int)prog.StudyStatus)"
                                        data-mem-status="@((int)prog.MemorizationStatus)"
                                        data-exam-status="@((int)prog.ExamStatus)"
                                        data-score="@(prog.Score?.ToString() ?? "")"
                                        data-exam-date="@(prog.ExamDate?.ToString("yyyy-MM-dd") ?? "")"
                                        data-notes="@(prog.TeacherNotes ?? "")"
                                        data-passing-grade="@passGrade">
                                        <td>
                                            <div style="font-weight: 700; color: #1e293b; font-size: 0.95rem;">
                                                <span style="display: inline-block; background: #e0f2fe; color: #0284c7; padding: 2px 6px; border-radius: 4px; font-size: 11px; margin-left: 4px;">#@prog.MatnOrder</span>
                                                @prog.MatnTitle
                                            </div>
                                            @if (!string.IsNullOrEmpty(prog.MatnAuthor))
                                            {
                                                <div style="font-size: 12px; color: #64748b; margin-top: 2px;">@prog.MatnAuthor</div>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @if (prog.StudyStatus == StudyStatus.Completed)
                                            {
                                                <span class="record-badge" style="background: #dcfce7; color: #166534; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-check-circle'></i> مكتمل
                                                </span>
                                            }
                                            else if (prog.StudyStatus == StudyStatus.InProgress)
                                            {
                                                <span class="record-badge" style="background: #fef3c7; color: #92400e; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-loader-circle'></i> قيد الدراسة
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="record-badge" style="background: #f1f5f9; color: #64748b; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-minus'></i> لم يبدأ
                                                </span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @if (prog.MemorizationStatus == MemorizationStatus.Memorized)
                                            {
                                                <span class="record-badge" style="background: #dcfce7; color: #166534; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-check-double'></i> تم الحفظ
                                                </span>
                                            }
                                            else if (prog.MemorizationStatus == MemorizationStatus.InProgress)
                                            {
                                                <span class="record-badge" style="background: #f5f3ff; color: #6b21a8; font-weight: 700; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-bookmarks'></i> قيد الحفظ
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="record-badge" style="background: #f1f5f9; color: #64748b; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-minus'></i> لم يبدأ
                                                </span>
                                            }
                                        </td>
                                        <td style="text-align: center;">
                                            @if (isActuallyPassed)
                                            {
                                                <span class="record-badge" style="background: #dcfce7; color: #166534; font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-award'></i> ناجح @(prog.Score.HasValue ? $"({prog.Score:0.##}%)" : "")
                                                </span>
                                            }
                                            else if (isActuallyFailed)
                                            {
                                                <span class="record-badge" style="background: #fee2e2; color: #991b1b; font-weight: 800; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-x'></i> راسب @(prog.Score.HasValue ? $"({prog.Score:0.##}%)" : "")
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="record-badge" style="background: #f8fafc; color: #94a3b8; border: 1px solid #e2e8f0; font-size: 12px; padding: 4px 10px; border-radius: 6px;"
                                                      onclick="openAdminRowProgressModal(this)" title="انقر لتحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-minus'></i> لم يختبر
                                                </span>
                                            }
                                            @if (prog.ExamDate.HasValue)
                                            {
                                                <div style="font-size: 11px; color: #64748b; margin-top: 3px;">
                                                    <i class='bx bx-calendar'></i> @prog.ExamDate.Value.ToString("yyyy-MM-dd")
                                                </div>
                                            }
                                        </td>
                                        <td style="font-size: 13px; color: #475569;">
                                            @(string.IsNullOrEmpty(prog.TeacherNotes) ? "—" : prog.TeacherNotes)
                                        </td>
                                        <td style="text-align: center;">
                                            <div style="display: inline-flex; align-items: center; justify-content: center; gap: 6px; flex-wrap: wrap;">
                                                <button type="button" class="btn-admin-grade" onclick="openAdminRowProgressModal(this)" title="تحديد الحالة ورصد الدرجة">
                                                    <i class='bx bx-slider-alt'></i>
                                                    <span>تحديد ورصد</span>
                                                </button>
                                                @if (prog.Id != Guid.Empty && (prog.StudyStatus == StudyStatus.Completed || prog.MemorizationStatus == MemorizationStatus.Memorized || isActuallyPassed))
                                                {
                                                    <a href="/Certificates/Matn/@prog.Id" target="_blank" class="btn-admin-cert"
                                                       title="تصدير وطباعة شهادة إتمام المتن">
                                                        <i class='bx bx-award'></i>
                                                        <span>تصدير الشهادة</span>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>

        <!-- =================================================================== -->
        <!-- النافذة المنبثقة: تحديد حالة الطالب مع المتن ورصد الدرجة للإدارة          -->
        <!-- =================================================================== -->
        <div class="matn-modal-overlay" id="adminMatnModal" tabindex="-1" aria-hidden="true" dir="rtl" style="display: none;" onclick="if(event.target === this) closeAdminMatnModal()">
            <div class="matn-modal-dialog">
                <div class="matn-modal-card">
                    <div class="matn-modal-header admin-modal-header">
                        <h5 class="matn-modal-title">
                            <i class='bx bx-award fs-5'></i>
                            <span id="adminModalMainTitle">تحديد حالة المتن ورصد الدرجة للطالب</span>
                        </h5>
                        <button type="button" class="matn-modal-close" aria-label="Close" onclick="closeAdminMatnModal()">
                            <i class='bx bx-x'></i>
                        </button>
                    </div>
                    <form id="adminMatnForm" onsubmit="saveAdminMatnProgress(event)">
                        @Html.AntiForgeryToken()
                        <div class="matn-modal-body">
                            <input type="hidden" id="adminModalStudentId" name="studentId" value="@student.UserId" />
                            <input type="hidden" id="adminModalMatnId" name="matnId" />

                            <!-- بطاقة سياق الطالب والمتن ودرجة النجاح -->
                            <div class="matn-context-banner">
                                <div class="matn-context-row">
                                    <span class="matn-context-label">اسم الطالب:</span>
                                    <span class="matn-context-val" id="adminModalStudentName">@studentFullName</span>
                                </div>
                                
                                <!-- عند التعديل على متن مسجل مسبقاً -->
                                <div class="matn-context-row" id="adminModalMatnTitleRow">
                                    <span class="matn-context-label">المتن المقرر:</span>
                                    <span class="matn-context-val text-primary fw-bold" id="adminModalMatnTitle">-</span>
                                </div>

                                <!-- عند رصد أو اختيار متن جديد -->
                                <div class="matn-context-row" id="adminModalMatnSelectRow" style="display: none;">
                                    <span class="matn-context-label">اختر المتن:</span>
                                    <select id="adminModalMatnSelect" class="matn-select" style="max-width: 320px; font-weight: 600;" onchange="onAdminMatnSelectChanged(this)">
                                        <option value="">-- اختر المتن المراد رصده للطالب --</option>
                                        @foreach (var m in availableMatns)
                                        {
                                            var pGrade = m.PassingGrade > 0 ? m.PassingGrade : 60m;
                                            <option value="@m.Id" data-title="@m.Title" data-passing-grade="@pGrade">
                                                @m.Title @(!string.IsNullOrEmpty(m.Author) ? $"({m.Author})" : "")
                                            </option>
                                        }
                                    </select>
                                </div>

                                <div class="matn-context-row">
                                    <span class="matn-context-label">علامة النجاح المعتمدة:</span>
                                    <span class="matn-context-val badge bg-info text-white" id="adminModalPassingGrade">60%</span>
                                </div>
                            </div>

                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="matn-label">
                                        <i class='bx bx-book-open text-success'></i>
                                        <span>حالة المدارسة</span>
                                    </label>
                                    <select id="adminModalStudyStatus" name="studyStatus" class="matn-select">
                                        <option value="0">لم يبدأ</option>
                                        <option value="1">قيد الدراسة</option>
                                        <option value="2">مكتمل</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="matn-label">
                                        <i class='bx bx-bookmarks text-primary'></i>
                                        <span>حالة الحفظ</span>
                                    </label>
                                    <select id="adminModalMemorizationStatus" name="memorizationStatus" class="matn-select">
                                        <option value="0">لم يبدأ</option>
                                        <option value="1">قيد الحفظ</option>
                                        <option value="2">تم الحفظ</option>
                                    </select>
                                </div>

                                <div class="col-md-6">
                                    <label class="matn-label">
                                        <i class='bx bx-check-shield text-warning'></i>
                                        <span>نتيجة الاختبار</span>
                                    </label>
                                    <select id="adminModalExamStatus" name="examStatus" class="matn-select" onchange="onAdminExamStatusChanged(this.value)">
                                        <option value="0">لم يختبر بعد</option>
                                        <option value="1">اجتاز بنجاح (ناجح)</option>
                                        <option value="2">لم يجتز (راسب)</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <label class="matn-label mb-0">
                                            <i class='bx bx-calendar-event text-secondary'></i>
                                            <span>تاريخ الاختبار</span>
                                        </label>
                                        <button type="button" class="btn-today-date" onclick="setAdminExamToday()">اليوم</button>
                                    </div>
                                    <input type="date" id="adminModalExamDate" name="examDate" class="matn-input" />
                                </div>

                                <!-- عنصر تفاعلي ذكي لرصد درجة الاختبار -->
                                <div class="col-12">
                                    <div class="p-3 bg-light rounded-3 border">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <label class="matn-label mb-0">
                                                <i class='bx bx-award text-primary'></i>
                                                <span>درجة الاختبار (من 100)</span>
                                            </label>
                                            <span id="adminScoreRatingPill" class="score-rating-pill" style="display: none;">
                                                <i class='bx bx-award'></i> <span id="adminScoreRatingText">-</span>
                                            </span>
                                        </div>
                                        <div class="input-group">
                                            <input type="number" id="adminModalScore" name="score" class="form-control"
                                                   min="0" max="100" step="0.5" placeholder="مثال: 95.5"
                                                   oninput="updateAdminScoreFeedback(this.value)" />
                                            <span class="input-group-text bg-white fw-bold">%</span>
                                        </div>
                                        <div class="score-presets mt-2">
                                            <span class="small text-muted me-1">درجات سريعة:</span>
                                            <button type="button" class="score-preset-btn" onclick="setAdminScorePreset(100)">100% ممتاز</button>
                                            <button type="button" class="score-preset-btn" onclick="setAdminScorePreset(95)">95% ممتاز</button>
                                            <button type="button" class="score-preset-btn" onclick="setAdminScorePreset(85)">85% ج.جداً</button>
                                            <button type="button" class="score-preset-btn" onclick="setAdminScorePreset(75)">75% جيد</button>
                                            <button type="button" class="score-preset-btn" onclick="setAdminScorePreset(60)">60% مقبول</button>
                                            <button type="button" class="score-preset-btn" style="border-color: #fca5a5; color: #b91c1c; background: #fff5f5;" onclick="setAdminScorePreset(40)">40% راسب</button>
                                            <button type="button" class="score-preset-btn preset-clear" onclick="clearAdminScore()">مسح الدرجة</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <label class="matn-label">
                                        <i class='bx bx-comment-detail text-muted'></i>
                                        <span>ملاحظات الإدارة</span>
                                    </label>
                                    <textarea id="adminModalTeacherNotes" name="teacherNotes" class="matn-input" rows="2"
                                              placeholder="ملاحظات الإدارة حول مستوى الطالب، الإتقان، أو الاستدراك..."></textarea>
                                </div>
                            </div>
                        </div>
                        <div class="matn-modal-footer">
                            <button type="button" class="matn-control-btn" onclick="closeAdminMatnModal()">إلغاء</button>
                            <button type="submit" class="btn-grade-action px-4" id="saveAdminProgressBtn" style="background: #0284c7;">
                                <i class='bx bx-save'></i>
                                <span>حفظ التعديلات والدرجة</span>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <script>
            let currentAdminPassingGrade = 60;

            function setAdminExamToday() {
                const today = new Date().toISOString().split('T')[0];
                const dateInput = document.getElementById('adminModalExamDate');
                if (dateInput) dateInput.value = today;
            }

            function clearAdminScore() {
                const input = document.getElementById('adminModalScore');
                if (input) {
                    input.value = '';
                    updateAdminScoreFeedback('');
                }
            }

            function updateAdminScoreFeedback(scoreVal) {
                const pill = document.getElementById('adminScoreRatingPill');
                const txt = document.getElementById('adminScoreRatingText');
                if (!pill || !txt) return;
                if (!scoreVal || isNaN(scoreVal)) {
                    pill.style.display = 'none';
                    return;
                }
                const s = parseFloat(scoreVal);
                pill.style.display = 'inline-flex';
                const examStatus = document.getElementById('adminModalExamStatus');

                if (s < currentAdminPassingGrade) {
                    pill.style.background = '#fef2f2';
                    pill.style.borderColor = '#fecaca';
                    pill.style.color = '#991b1b';
                    txt.textContent = `راسب (أقل من علامة النجاح ${currentAdminPassingGrade}%)`;
                    if (examStatus) examStatus.value = '2'; // Failed
                } else {
                    if (examStatus) examStatus.value = '1'; // Passed
                    if (s >= 90) {
                        pill.style.background = '#ecfdf5';
                        pill.style.borderColor = '#86efac';
                        pill.style.color = '#065f46';
                        txt.textContent = 'ناجح - ممتاز 🌟';
                    } else if (s >= 80) {
                        pill.style.background = '#eff6ff';
                        pill.style.borderColor = '#bfdbfe';
                        pill.style.color = '#1e40af';
                        txt.textContent = 'ناجح - جيد جداً';
                    } else if (s >= 65) {
                        pill.style.background = '#f0fdf4';
                        pill.style.borderColor = '#bbf7d0';
                        pill.style.color = '#166534';
                        txt.textContent = 'ناجح - جيد';
                    } else {
                        pill.style.background = '#fffbeb';
                        pill.style.borderColor = '#fde68a';
                        pill.style.color = '#92400e';
                        txt.textContent = 'ناجح - مقبول';
                    }
                }
            }

            function setAdminScorePreset(val) {
                const input = document.getElementById('adminModalScore');
                if (input) {
                    input.value = val;
                    updateAdminScoreFeedback(val);
                }
            }

            function onAdminExamStatusChanged(statusVal) {
                const scoreInput = document.getElementById('adminModalScore');
                if (!scoreInput) return;
                if (statusVal === '1' && (!scoreInput.value || parseFloat(scoreInput.value) < currentAdminPassingGrade)) {
                    scoreInput.value = Math.max(85, currentAdminPassingGrade);
                    updateAdminScoreFeedback(scoreInput.value);
                } else if (statusVal === '2' && (!scoreInput.value || parseFloat(scoreInput.value) >= currentAdminPassingGrade)) {
                    scoreInput.value = Math.max(0, currentAdminPassingGrade - 15);
                    updateAdminScoreFeedback(scoreInput.value);
                }
            }

            function openAdminNewMatnModal() {
                const studentId = '@student.UserId';
                const studentName = '@studentFullName';

                document.getElementById('adminModalMatnTitleRow').style.display = 'none';
                document.getElementById('adminModalMatnSelectRow').style.display = 'flex';
                document.getElementById('adminModalMainTitle').textContent = 'رصد أو إسناد متن جديد للطالب';

                const select = document.getElementById('adminModalMatnSelect');
                if (select) {
                    select.selectedIndex = 0;
                }

                openAdminMatnModal(studentId, studentName, '', '', 0, 0, 0, '', '', '', 60);
            }

            function onAdminMatnSelectChanged(sel) {
                const opt = sel.options[sel.selectedIndex];
                if (!opt || !opt.value) {
                    document.getElementById('adminModalMatnId').value = '';
                    return;
                }
                document.getElementById('adminModalMatnId').value = opt.value;
                const passGrade = parseFloat(opt.getAttribute('data-passing-grade')) || 60;
                currentAdminPassingGrade = passGrade;
                const passEl = document.getElementById('adminModalPassingGrade');
                if (passEl) passEl.textContent = currentAdminPassingGrade + '%';

                const scoreVal = document.getElementById('adminModalScore').value;
                updateAdminScoreFeedback(scoreVal);
            }

            function openAdminRowProgressModal(el) {
                const row = el.closest('tr');
                if (!row) return;
                const studentId = row.getAttribute('data-student-id');
                const studentName = row.getAttribute('data-student-name');
                const matnId = row.getAttribute('data-matn-id');
                const matnTitle = row.getAttribute('data-matn-title');
                const studyStatus = parseInt(row.getAttribute('data-study-status')) || 0;
                const memStatus = parseInt(row.getAttribute('data-mem-status')) || 0;
                const examStatus = parseInt(row.getAttribute('data-exam-status')) || 0;
                const score = row.getAttribute('data-score');
                const examDate = row.getAttribute('data-exam-date');
                const notes = row.getAttribute('data-notes');
                const passingGrade = parseFloat(row.getAttribute('data-passing-grade')) || 60;

                document.getElementById('adminModalMatnTitleRow').style.display = 'flex';
                document.getElementById('adminModalMatnSelectRow').style.display = 'none';
                document.getElementById('adminModalMainTitle').textContent = 'تحديد حالة المتن ورصد الدرجة للطالب';

                openAdminMatnModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade);
            }

            function openAdminMatnModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade = 60) {
                const modalEl = document.getElementById('adminMatnModal');
                if (!modalEl) return;

                currentAdminPassingGrade = parseFloat(passingGrade) || 60;
                document.getElementById('adminModalStudentId').value = studentId || '';
                document.getElementById('adminModalMatnId').value = matnId || '';
                document.getElementById('adminModalStudentName').textContent = studentName || '-';
                document.getElementById('adminModalMatnTitle').textContent = matnTitle || '-';
                const passEl = document.getElementById('adminModalPassingGrade');
                if (passEl) passEl.textContent = currentAdminPassingGrade + '%';

                document.getElementById('adminModalStudyStatus').value = (studyStatus !== undefined && studyStatus !== null) ? studyStatus : 0;
                document.getElementById('adminModalMemorizationStatus').value = (memStatus !== undefined && memStatus !== null) ? memStatus : 0;
                document.getElementById('adminModalExamStatus').value = (examStatus !== undefined && examStatus !== null) ? examStatus : 0;
                document.getElementById('adminModalScore').value = score || '';
                document.getElementById('adminModalExamDate').value = examDate || '';
                document.getElementById('adminModalTeacherNotes').value = notes || '';

                updateAdminScoreFeedback(score);

                modalEl.classList.add('show', 'is-open');
                modalEl.style.setProperty('display', 'flex', 'important');
                document.body.style.overflow = 'hidden';
            }

            function closeAdminMatnModal() {
                const modalEl = document.getElementById('adminMatnModal');
                if (!modalEl) return;

                modalEl.classList.remove('show', 'is-open');
                modalEl.style.setProperty('display', 'none', 'important');
                document.body.style.overflow = '';
            }

            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape') {
                    closeAdminMatnModal();
                }
            });

            async function saveAdminMatnProgress(e) {
                e.preventDefault();
                const studentId = document.getElementById('adminModalStudentId').value;
                const matnId = document.getElementById('adminModalMatnId').value;

                if (!matnId) {
                    alert('يرجى تحديد المتن أولاً من القائمة.');
                    return;
                }

                const btn = document.getElementById('saveAdminProgressBtn');
                btn.disabled = true;
                btn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> جارٍ الحفظ...';

                const payload = {
                    studentId: studentId,
                    matnId: matnId,
                    studyStatus: parseInt(document.getElementById('adminModalStudyStatus').value),
                    memorizationStatus: parseInt(document.getElementById('adminModalMemorizationStatus').value),
                    examStatus: parseInt(document.getElementById('adminModalExamStatus').value),
                    score: document.getElementById('adminModalScore').value ? parseFloat(document.getElementById('adminModalScore').value) : null,
                    examDate: document.getElementById('adminModalExamDate').value ? document.getElementById('adminModalExamDate').value : null,
                    teacherNotes: document.getElementById('adminModalTeacherNotes').value
                };

                try {
                    const tokenInput = document.querySelector('input[name="__RequestVerificationToken"]');
                    const token = tokenInput ? tokenInput.value : '';
                    const headers = {
                        'Content-Type': 'application/json'
                    };
                    if (token) {
                        headers['RequestVerificationToken'] = token;
                    }

                    const res = await fetch('/Teacher/StudentMatnProgress/CreateOrUpdate', {
                        method: 'POST',
                        headers: headers,
                        body: JSON.stringify(payload)
                    });

                    if (!res.ok) {
                        const errText = await res.text();
                        throw new Error(errText || ('HTTP ' + res.status));
                    }

                    const data = await res.json();
                    if (data.success) {
                        const url = new URL(window.location.href);
                        url.searchParams.set('tab', 'matns');
                        window.location.href = url.toString();
                    } else {
                        alert(data.message || 'تعذر حفظ البيانات.');
                        btn.disabled = false;
                        btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
                    }
                } catch (err) {
                    console.error(err);
                    alert('حدث خطأ في الاتصال بالخادم: ' + (err.message || ''));
                    btn.disabled = false;
                    btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
                }
            }
        </script>

                        <!-- Toast notification -->
                        <div id="toast" class="toast" role="status" aria-live="polite" data-read-message='@Localizer["NoteMarkedAsRead"]'>
                            <i class='bx bx-check-circle'></i>
                            <span id="toast-message"></span>
                        </div>

                        @Html.AntiForgeryToken()

                        @{
                            var markReadUrl = Url.Action("MarkNoteAsRead", "Students", new { area = "Admin" });
                        }

                        <script>
                            const markReadUrl = '@markReadUrl';
                            const markedReadText = document.getElementById('toast').dataset.readMessage;

                            function showToast(message) {
                                const toast = document.getElementById('toast');
                                document.getElementById('toast-message').textContent = message;
                                toast.classList.add('show');
                                clearTimeout(window.__toastTimer);
                                window.__toastTimer = setTimeout(() => toast.classList.remove('show'), 3000);
                            }

                            function markNoteAsRead(btn, noteId) {
                                btn.disabled = true;
                                const formData = new FormData();
                                formData.append('noteId', noteId);
                                const tokenEl = document.querySelector('input[name="__RequestVerificationToken"]');
                                if (tokenEl) formData.append('__RequestVerificationToken', tokenEl.value);

                                fetch(markReadUrl, {
                                    method: 'POST',
                                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                                    body: formData
                                })
                                    .then(r => r.json())
                                    .then(data => {
                                        if (data && data.success) {
                                            const item = document.querySelector('.note-item[data-note-id="' + noteId + '"]');
                                            if (item) {
                                                item.classList.remove('note-unread');
                                                item.classList.add('note-read');
                                                const unreadBadge = item.querySelector('.note-badge-unread');
                                                const readBadge = item.querySelector('.note-badge-read');
                                                const footer = item.querySelector('.note-footer');
                                                if (unreadBadge) unreadBadge.style.display = 'none';
                                                if (readBadge) readBadge.style.display = '';
                                                if (footer) footer.style.display = 'none';
                                            }
                                            updateUnreadHeaderBadge();
                                            showToast(markedReadText);
                                        } else {
                                            btn.disabled = false;
                                        }
                                    })
                                    .catch(() => { btn.disabled = false; });
                            }

                            function updateUnreadHeaderBadge() {
                                const remaining = document.querySelectorAll('.note-item.note-unread').length;
                                const badge = document.querySelector('#notes .badge-red');
                                if (badge) {
                                    if (remaining > 0) {
                                        const countEl = badge.querySelector('.unread-count');
                                        if (countEl) countEl.textContent = remaining;
                                    } else {
                                        badge.style.display = 'none';
                                    }
                                }
                            }

                            function openTab(evt, tabName) {
                                var tabContent = document.getElementsByClassName("tab-content");
                                for (var i = 0; i < tabContent.length; i++) {
                                    tabContent[i].style.display = "none";
                                    tabContent[i].classList.remove("active");
                                }

                                var tabBtn = document.getElementsByClassName("tab-btn");
                                for (var i = 0; i < tabBtn.length; i++) {
                                    tabBtn[i].classList.remove("active");
                                }

                                document.getElementById(tabName).style.display = "block";
                                setTimeout(() => {
                                    document.getElementById(tabName).classList.add("active");
                                }, 10);

                                evt.currentTarget.classList.add("active");
                                evt.currentTarget.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
                            }

                            // On small screens the tab bar scrolls horizontally; keep the active tab visible
                            document.addEventListener('DOMContentLoaded', function () {
                                var activeTab = document.querySelector('.tabs-header .tab-btn.active');
                                if (activeTab) activeTab.scrollIntoView({ inline: 'center', block: 'nearest' });
                            });
                        </script>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/confirmModal.js" asp-append-version="true"></script>
}
