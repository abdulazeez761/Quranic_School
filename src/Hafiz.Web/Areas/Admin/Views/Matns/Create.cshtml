@model Hafiz.DTOs.Matn.CreateMatnDto
@using Hafiz.Domain.Enums
@{
    ViewData["Title"] = "إضافة متن جديد";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-transparent border-0 pt-4 pb-2">
                    <h3 class="h5 font-weight-bold mb-1">إضافة متن جديد إلى مكتبة المعهد</h3>
                    <p class="text-muted small">سيكون هذا المتن متاحاً للاختيار عند إنشاء برامج المتون في معهدك.</p>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label fw-bold">اسم المتن <span class="text-danger">*</span></label>
                            <input asp-for="Title" class="form-control" placeholder="مثال: متن البيقونية، تحفة الأطفال، عمدة الفقه" required />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <label asp-for="Author" class="form-label fw-bold">المؤلف / الناظم</label>
                                <input asp-for="Author" class="form-control" placeholder="مثال: ابن مالك، ابن الجزري، النووي" />
                                <span asp-validation-for="Author" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Category" class="form-label fw-bold">الفن / التخصص <span class="text-danger">*</span></label>
                                <select asp-for="Category" class="form-select">
                                    <option value="@((int)MatnCategory.Tajweed)">تجويد وقراءات</option>
                                    <option value="@((int)MatnCategory.Aqeedah)">عقيدة وتوحيد</option>
                                    <option value="@((int)MatnCategory.Hadith)">حديث ومصطلح</option>
                                    <option value="@((int)MatnCategory.Fiqh)">فقه وأصوله</option>
                                    <option value="@((int)MatnCategory.NahwAndLanguage)">نحو ولغة</option>
                                    <option value="@((int)MatnCategory.Seerah)">سيرة وتاريخ</option>
                                    <option value="@((int)MatnCategory.Adab)">آداب وتزكية</option>
                                    <option value="@((int)MatnCategory.General)">عام / أخرى</option>
                                </select>
                                <span asp-validation-for="Category" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-4">
                                <label asp-for="DefaultUnit" class="form-label fw-bold">الوحدة الافتراضية للتسميع</label>
                                <select asp-for="DefaultUnit" class="form-select">
                                    <option value="@((int)MatnUnit.Verses)">أبيات (منظومات)</option>
                                    <option value="@((int)MatnUnit.Lines)">سطور</option>
                                    <option value="@((int)MatnUnit.Pages)">صفحات</option>
                                    <option value="@((int)MatnUnit.Chapters)">أبواب / فصول</option>
                                    <option value="@((int)MatnUnit.Hadiths)">أحاديث نبوية</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TotalVerses" class="form-label fw-bold">إجمالي الأبيات (إن وُجد)</label>
                                <input asp-for="TotalVerses" type="number" min="1" class="form-control" placeholder="مثلاً: 107" />
                                <span asp-validation-for="TotalVerses" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="TotalChapters" class="form-label fw-bold">عدد الأبواب / الفصول</label>
                                <input asp-for="TotalChapters" type="number" min="1" class="form-control" placeholder="مثلاً: 12" />
                                <span asp-validation-for="TotalChapters" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 border-top pt-3">
                            <a asp-action="Index" class="btn btn-outline-secondary">إلغاء</a>
                            <button type="submit" class="btn btn-primary px-4">إضافة المتن</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
