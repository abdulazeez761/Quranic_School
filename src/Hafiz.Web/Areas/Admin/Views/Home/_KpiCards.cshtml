@model Hafiz.DTOs.Dashboard.DashboardStatsDto

@{
    int totalStudents = Model.MaleStudentsCount + Model.FemaleStudentsCount;
}

<!-- الصف الأول: المؤشرات الرئيسية العليا -->
<div class="dashboard-overview-strip">
    <div class="dashboard-overview-card --green">
        <div class="overview-card-icon">
            <i class='bx bx-user'></i>
        </div>
        <div class="overview-card-details">
            <span class="overview-card-title">إجمالي الطلاب</span>
            <div class="overview-card-num">@totalStudents</div>
            <div class="overview-card-sub">
                <span><i class='bx bx-male'></i> @Model.MaleStudentsCount ذكور</span>
                <span class="sep">•</span>
                <span><i class='bx bx-female'></i> @Model.FemaleStudentsCount إناث</span>
            </div>
        </div>
    </div>

    <div class="dashboard-overview-card --sage">
        <div class="overview-card-icon">
            <i class='bx bx-chalkboard'></i>
        </div>
        <div class="overview-card-details">
            <span class="overview-card-title">كادر المعلمين</span>
            <div class="overview-card-num">@Model.TeachersCount</div>
            <div class="overview-card-sub">معلم ومعلمة معتمدون</div>
        </div>
    </div>

    <div class="dashboard-overview-card --purple">
        <div class="overview-card-icon">
            <i class='bx bx-group'></i>
        </div>
        <div class="overview-card-details">
            <span class="overview-card-title">الحلقات والصفوف</span>
            <div class="overview-card-num">@Model.CirclesCount</div>
            <div class="overview-card-sub">حلقة قرآنية وعلمية</div>
        </div>
    </div>

    <div class="dashboard-overview-card --gold">
        <div class="overview-card-icon">
            <i class='bx bx-book-open'></i>
        </div>
        <div class="overview-card-details">
            <span class="overview-card-title">البرامج التعليمية</span>
            <div class="overview-card-num">@Model.ActiveStudyProgramsCount <span class="total-ref">/ @Model.StudyProgramsCount</span></div>
            <div class="overview-card-sub">برنامج تعليمي نشط</div>
        </div>
    </div>
</div>

<!-- الصف الثاني: إنجازات القرآن الكريم (حفظ، مراجعة، تجويد) -->
<div class="dashboard-section-card">
    <div class="dashboard-section-header">
        <div class="d-flex align-center gap-sm">
            <div class="section-icon-box --emerald">
                <i class='bx bx-book-heart'></i>
            </div>
            <div>
                <h3 class="dashboard-section-title">إنجازات القرآن الكريم للفترة المختارة</h3>
                <p class="dashboard-section-sub">تفاصيل الحفظ والمراجعة والتجويد بالصفحات والأجزاء المحسوبة</p>
            </div>
        </div>
    </div>
    <div class="dashboard-section-body">
        <div class="quran-metrics-grid">
            <!-- الحفظ -->
            <div class="metric-pillar --pillar-memorization">
                <div class="pillar-header">
                    <span class="pillar-tag --tag-gold"><i class='bx bx-bookmark'></i> مسار الحفظ</span>
                    <span class="pillar-badge">إتقان جديد</span>
                </div>
                <div class="pillar-main-val">
                    <span class="num">@Model.MemorizationPages.ToString("0.##")</span>
                    <span class="unit">صفحة</span>
                </div>
                <div class="pillar-meta">
                    <div class="meta-row">
                        <span>إجمالي الأجزاء المحفوظة:</span>
                        <span class="fw-bold">@Model.MemorizationParts.ToString("0.##") جزء</span>
                    </div>
                    <div class="pillar-progress-track">
                        <div class="pillar-progress-fill --gold" style="width: @(Math.Min(100, Model.MemorizationParts / 30.0 * 100))%"></div>
                    </div>
                </div>
            </div>

            <!-- المراجعة -->
            <div class="metric-pillar --pillar-revision">
                <div class="pillar-header">
                    <span class="pillar-tag --tag-teal"><i class='bx bx-rotate-left'></i> مسار المراجعة</span>
                    <span class="pillar-badge">تثبيت واستذكار</span>
                </div>
                <div class="pillar-main-val">
                    <span class="num">@Model.RevisionPages.ToString("0.##")</span>
                    <span class="unit">صفحة</span>
                </div>
                <div class="pillar-meta">
                    <div class="meta-row">
                        <span>إجمالي المراجعة:</span>
                        <span class="fw-bold">@Model.RevisionParts.ToString("0.##") جزء</span>
                    </div>
                    <div class="meta-row text-muted fs-xs">
                        <span>منها أجزاء مستقلة:</span>
                        <span>@Model.RevisionJuzParts.ToString("0.##") جزء</span>
                    </div>
                </div>
            </div>

            <!-- التجويد والإتقان -->
            <div class="metric-pillar --pillar-tajwid">
                <div class="pillar-header">
                    <span class="pillar-tag --tag-indigo"><i class='bx bx-microphone'></i> التجويد والتلاوة</span>
                    <span class="pillar-badge">ضبط مخارج وصفات</span>
                </div>
                <div class="pillar-main-val">
                    <span class="num">@Model.TajwidPages.ToString("0.##")</span>
                    <span class="unit">صفحة</span>
                </div>
                <div class="pillar-meta">
                    <div class="meta-row">
                        <span>إجمالي أجزاء التجويد:</span>
                        <span class="fw-bold">@Model.TajwidParts.ToString("0.##") جزء</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- الصف الثالث: المتون العلمية والمناهج المصاحبة -->
<div class="dashboard-section-card">
    <div class="dashboard-section-header">
        <div class="d-flex align-center gap-sm">
            <div class="section-icon-box --teal">
                <i class='bx bx-library'></i>
            </div>
            <div>
                <h3 class="dashboard-section-title">المتون العلمية والمنظومات</h3>
                <p class="dashboard-section-sub">متابعة إنجاز المتون وحلقات المدارسة بمختلف الوحدات (أبيات، أسطر، صفحات، أحاديث، أبواب)</p>
            </div>
        </div>
        <div class="d-flex align-center gap-xs">
            <span class="badge" style="background: var(--admin-primary-surface); color: var(--admin-primary); font-weight: 600; padding: 6px 12px; border-radius: var(--admin-radius-full);">
                @Model.MatnsCount متن متاح بالمكتبة
            </span>
        </div>
    </div>
    <div class="dashboard-section-body">
        <div class="matn-metrics-grid">
            <div class="matn-metric-box">
                <div class="matn-metric-icon --green"><i class='bx bx-book-bookmark'></i></div>
                <div class="matn-metric-data">
                    <span class="label">حفظ المتون</span>
                    @{
                        var memActiveUnits = Model.MatnMemorizationUnits?.GetActiveUnits() ?? new List<(string Label, decimal Value)>();
                    }
                    @if (memActiveUnits.Count == 1)
                    {
                        var single = memActiveUnits[0];
                        <div class="val">@single.Value.ToString("0.#") <span class="sub">@single.Label</span></div>
                    }
                    else if (memActiveUnits.Count > 1)
                    {
                        <div class="val-chips-wrap">
                            @foreach (var u in memActiveUnits)
                            {
                                <span class="matn-unit-chip"><strong>@u.Value.ToString("0.#")</strong> @u.Label</span>
                            }
                        </div>
                    }
                    else if (Model.MatnMemorizationVerses > 0)
                    {
                        <div class="val">@Model.MatnMemorizationVerses.ToString("0.#") <span class="sub">بيت</span></div>
                    }
                    else
                    {
                        <div class="val">@Model.MatnMemorizationAssignments <span class="sub">ورد</span></div>
                    }
                    <span class="hint">@Model.MatnMemorizationAssignments ورد مسند</span>
                </div>
            </div>

            <div class="matn-metric-box">
                <div class="matn-metric-icon --gold"><i class='bx bx-refresh'></i></div>
                <div class="matn-metric-data">
                    <span class="label">مراجعة المتون</span>
                    @{
                        var revActiveUnits = Model.MatnRevisionUnits?.GetActiveUnits() ?? new List<(string Label, decimal Value)>();
                    }
                    @if (revActiveUnits.Count == 1)
                    {
                        var single = revActiveUnits[0];
                        <div class="val">@single.Value.ToString("0.#") <span class="sub">@single.Label</span></div>
                    }
                    else if (revActiveUnits.Count > 1)
                    {
                        <div class="val-chips-wrap">
                            @foreach (var u in revActiveUnits)
                            {
                                <span class="matn-unit-chip"><strong>@u.Value.ToString("0.#")</strong> @u.Label</span>
                            }
                        </div>
                    }
                    else if (Model.MatnRevisionVerses > 0)
                    {
                        <div class="val">@Model.MatnRevisionVerses.ToString("0.#") <span class="sub">بيت</span></div>
                    }
                    else
                    {
                        <div class="val">@Model.MatnRevisionAssignments <span class="sub">ورد</span></div>
                    }
                    <span class="hint">@Model.MatnRevisionAssignments ورد مراجع</span>
                </div>
            </div>

            <div class="matn-metric-box">
                <div class="matn-metric-icon --purple"><i class='bx bx-chalkboard'></i></div>
                <div class="matn-metric-data">
                    <span class="label">مدارسة وشرح</span>
                    <div class="val">@Model.MatnMudarasahAssignments <span class="sub">جلسة</span></div>
                    <span class="hint">جلسات إتقان وفهم</span>
                </div>
            </div>

            <div class="matn-metric-box">
                <div class="matn-metric-icon --blue"><i class='bx bx-check-double'></i></div>
                <div class="matn-metric-data">
                    <span class="label">إجمالي إنجاز المتون</span>
                    <div class="val">@Model.MatnCompletedAssignments <span class="sub">من @Model.MatnTotalAssignments</span></div>
                    <span class="hint">معدل إكمال @(Model.MatnTotalAssignments > 0 ? Math.Round((double)Model.MatnCompletedAssignments / Model.MatnTotalAssignments * 100, 0) : 0)%</span>
                </div>
            </div>
        </div>
    </div>
</div>
