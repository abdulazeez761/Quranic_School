@model Hafiz.DTOs.Dashboard.DashboardStatsDto

<div class="dashboard-kpi-grid">

    <div class="dashboard-stat --purple">
        <div class="dashboard-stat-icon"><i class='bx bx-group'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">عدد الحلقات</div>
            <div class="dashboard-stat-value">@Model.CirclesCount</div>
        </div>
    </div>

    <div class="dashboard-stat --sage">
        <div class="dashboard-stat-icon"><i class='bx bx-chalkboard'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">عدد المعلمين</div>
            <div class="dashboard-stat-value">@Model.TeachersCount</div>
        </div>
    </div>

    <div class="dashboard-stat --blue">
        <div class="dashboard-stat-icon"><i class='bx bx-male'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">الطلاب الذكور</div>
            <div class="dashboard-stat-value">@Model.MaleStudentsCount</div>
        </div>
    </div>

    <div class="dashboard-stat --pink">
        <div class="dashboard-stat-icon"><i class='bx bx-female'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">الطالبات الإناث</div>
            <div class="dashboard-stat-value">@Model.FemaleStudentsCount</div>
        </div>
    </div>

    <div class="dashboard-stat --gold">
        <div class="dashboard-stat-icon"><i class='bx bx-book-heart'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">صفحات الحفظ</div>
            <div class="dashboard-stat-value">@Model.MemorizationPages.ToString("0.##")</div>
            <div class="dashboard-stat-hint">صفحة محفوظة (تشمل ما يعادل الآيات بالصفحات)</div>
        </div>
    </div>

    <div class="dashboard-stat --teal">
        <div class="dashboard-stat-icon"><i class='bx bx-rotate-left'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">صفحات المراجعة</div>
            <div class="dashboard-stat-value">@Model.RevisionPages.ToString("0.##")</div>
            <div class="dashboard-stat-hint">صفحة مراجعة (تشمل ما يعادل الآيات بالصفحات)</div>
        </div>
    </div>

    <div class="dashboard-stat --brown">
        <div class="dashboard-stat-icon"><i class='bx bx-award'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">أجزاء الحفظ</div>
            <div class="dashboard-stat-value">@Model.MemorizationParts.ToString("0.##")</div>
            <div class="dashboard-stat-hint">إجمالي أجزاء الحفظ (صفحات + أجزاء مستقلة)</div>
        </div>
    </div>

    <div class="dashboard-stat --indigo">
        <div class="dashboard-stat-icon"><i class='bx bx-check-shield'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">الأجزاء المستقلة للمراجعة</div>
            <div class="dashboard-stat-value">@Model.RevisionJuzParts.ToString("0.##")</div>
            <div class="dashboard-stat-hint">من جزء إلى جزء</div>
        </div>
    </div>

    <div class="dashboard-stat --cyan">
        <div class="dashboard-stat-icon"><i class='bx bx-bar-chart-alt-2'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">إجمالي المراجعة</div>
            <div class="dashboard-stat-value">@Model.RevisionParts.ToString("0.##")</div>
            <div class="dashboard-stat-hint">أجزاء الصفحات + الأجزاء المستقلة</div>
        </div>
    </div>

    <div class="dashboard-stat --violet">
        <div class="dashboard-stat-icon"><i class='bx bx-microphone'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">صفحات التجويد</div>
            <div class="dashboard-stat-value">@Model.TajwidPages.ToString("0.##")</div>
            <div class="dashboard-stat-hint">صفحة تجويد وإتقان التلاوة</div>
        </div>
    </div>

    <div class="dashboard-stat --indigo">
        <div class="dashboard-stat-icon"><i class='bx bx-collection'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">أجزاء التجويد</div>
            <div class="dashboard-stat-value">@Model.TajwidParts.ToString("0.##")</div>
            <div class="dashboard-stat-hint">إجمالي أجزاء التجويد (صفحات + أجزاء مستقلة)</div>
        </div>
    </div>

    <!-- إحصائيات المتون والبرامج العلمية -->
    <div class="dashboard-stat --teal">
        <div class="dashboard-stat-icon"><i class='bx bx-library'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">مكتبة المتون</div>
            <div class="dashboard-stat-value">@Model.MatnsCount</div>
            <div class="dashboard-stat-hint">متن علمي متاح للتدريس بالمعهد</div>
        </div>
    </div>

    <div class="dashboard-stat --blue">
        <div class="dashboard-stat-icon"><i class='bx bx-book-open'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">البرامج التعليمية</div>
            <div class="dashboard-stat-value">@Model.StudyProgramsCount</div>
            <div class="dashboard-stat-hint">منها @Model.ActiveStudyProgramsCount برنامج نشط</div>
        </div>
    </div>

    <!-- إحصائيات أوراد المتون للفترة المختارة -->
    <div class="dashboard-stat --sage">
        <div class="dashboard-stat-icon"><i class='bx bx-book-bookmark'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">حفظ المتون</div>
            <div class="dashboard-stat-value">@Model.MatnMemorizationVerses.ToString("0.#")</div>
            <div class="dashboard-stat-hint">بيت محفوظ (@Model.MatnMemorizationAssignments ورد)</div>
        </div>
    </div>

    <div class="dashboard-stat --gold">
        <div class="dashboard-stat-icon"><i class='bx bx-refresh'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">مراجعة المتون</div>
            <div class="dashboard-stat-value">@Model.MatnRevisionVerses.ToString("0.#")</div>
            <div class="dashboard-stat-hint">بيت مراجع (@Model.MatnRevisionAssignments ورد)</div>
        </div>
    </div>

    <div class="dashboard-stat --purple">
        <div class="dashboard-stat-icon"><i class='bx bx-chalkboard'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">مدارسة المتون</div>
            <div class="dashboard-stat-value">@Model.MatnMudarasahAssignments</div>
            <div class="dashboard-stat-hint">جلسة مدارسة وشرح مسندة</div>
        </div>
    </div>

    <div class="dashboard-stat --cyan">
        <div class="dashboard-stat-icon"><i class='bx bx-check-double'></i></div>
        <div class="dashboard-stat-content">
            <div class="dashboard-stat-label">إجمالي أوراد المتون</div>
            <div class="dashboard-stat-value">@Model.MatnTotalAssignments</div>
            <div class="dashboard-stat-hint">منها @Model.MatnCompletedAssignments ورد مكتمل</div>
        </div>
    </div>
</div>
