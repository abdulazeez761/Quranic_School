@using Hafiz.DTOs.Dashboard
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer
@model Hafiz.DTOs.Dashboard.DashboardStatsDto
@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<div class="dashboard-header">
    <div>
        <h2 class="dashboard-header-title">
            <i class='bx bx-bar-chart-alt-2'></i>
            إحصائيات المركز
        </h2>
        <p class="dashboard-header-subtitle">إحصائيات الحفظ والمراجعة والتجويد محسوبة حسب وحدات الورد (صفحات / أجزاء / آيات).</p>
    </div>
    <div class="dashboard-period-group" role="tablist" aria-label="فترة الإحصائيات">
        <a asp-action="Index" asp-route-period="@DashboardPeriod.AllTime"
           class="btn @(Model.SelectedPeriod == DashboardPeriod.AllTime ? "btn-primary" : "btn-outline")">
            إجمالي تراكمي
        </a>
        <a asp-action="Index" asp-route-period="@DashboardPeriod.Month"
           class="btn @(Model.SelectedPeriod == DashboardPeriod.Month ? "btn-primary" : "btn-outline")">
            هذا الشهر
        </a>
        <a asp-action="Index" asp-route-period="@DashboardPeriod.Today"
           class="btn @(Model.SelectedPeriod == DashboardPeriod.Today ? "btn-primary" : "btn-outline")">
            اليوم
        </a>
    </div>
</div>

<partial name="_KpiCards" model="Model" />

@{
    var quranWirdsViewData = new ViewDataDictionary(ViewData)
    {
        ["Title"] = "أوراد القرآن الكريم",
        ["Subtitle"] = "أحدث أوراد الحفظ والمراجعة للقرآن الكريم اليوم",
        ["HeaderIcon"] = "bx bx-book-heart",
    };
    var matnsViewData = new ViewDataDictionary(ViewData)
    {
        ["Title"] = "أوراد المتون العلمية",
        ["Subtitle"] = "أحدث أوراد حفظ ومراجعة ومدارسة المتون اليوم",
        ["HeaderIcon"] = "bx bx-book-bookmark",
    };
    var sanadViewData = new ViewDataDictionary(ViewData)
    {
        ["Title"] = "أوراد السند والإجازة",
        ["Subtitle"] = "أحدث أوراد الإسناد بالسند المتصل والإجازة اليوم",
        ["HeaderIcon"] = "bx bx-award",
    };
    var attendanceCounter = Model.ExpectedAttendanceToday > 0 ?
               $"📊 الطلاب: {Model.AttendedToday} من {Model.ExpectedAttendanceToday} | المعلمون: {Model.AttendedTeachersToday} من {Model.ExpectedTeachersToday}" :
                 "لا حلقات مجدولة اليوم";
    var attendanceViewData = new ViewDataDictionary(ViewData)
    {
        ["Title"] = "الحضور والغياب",
        ["Subtitle"] = "تسجيل حضور الطلاب والمعلمين في الحلقات",
        ["HeaderIcon"] = "bx bx-user-check",
        ["CounterText"] = attendanceCounter,
    };
}

<div class="dashboard-secondary-grid">
    @await Html.PartialAsync("_ActivityFeed", Model.WirdsActivity, quranWirdsViewData)
    @await Html.PartialAsync("_ActivityFeed", Model.MatnsActivity, matnsViewData)
    @await Html.PartialAsync("_ActivityFeed", Model.SanadActivity, sanadViewData)
    @await Html.PartialAsync("_ActivityFeed", Model.AttendanceActivity, attendanceViewData)
</div>

@section Scripts {
    <script src="~/js/admin/dashboardActivity.js" asp-append-version="true"></script>
}
