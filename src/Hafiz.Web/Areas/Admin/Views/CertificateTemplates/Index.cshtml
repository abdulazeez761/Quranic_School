@model IEnumerable<Hafiz.Application.DTO.Certificate.CertificateTemplateSummaryDto>
@using Hafiz.Domain.Enums
@{
    ViewData["Title"] = "قوالب الشهادات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var selectedType = ViewBag.SelectedType as CertificateType?;
    var templates = Model.ToList();

    string TypeName(CertificateType type) => type switch
    {
        CertificateType.Quran => "قرآن كريم",
        CertificateType.Matn => "متن علمي",
        CertificateType.Sanad => "إجازة بسند",
        CertificateType.General => "تقديرية عامة",
        CertificateType.Custom => "مخصصة",
        _ => "شهادة"
    };
}

<link rel="stylesheet" href="~/css/admin/certificate-builder.css" asp-append-version="true" />

<div class="cert-admin-page" dir="rtl">
    <header class="cert-admin-header">
        <div>
            <h1><span class="cert-icon"><i class='bx bx-palette'></i></span>قوالب الشهادات</h1>
            <p>صمّم قوالب الشهادات التي تصدرها حلقات المركز، وحدّد القالب الافتراضي لكل نوع.</p>
        </div>
        <div style="display:flex; gap:9px; flex-wrap:wrap;">
            <a asp-controller="CertificatesManagement" asp-action="Index" class="btn btn-outline-secondary">
                <i class='bx bx-certification'></i> الشهادات الصادرة
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class='bx bx-plus-circle'></i> قالب جديد
            </a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success"><i class='bx bx-check-circle'></i> @TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger"><i class='bx bx-error-circle'></i> @TempData["ErrorMessage"]</div>
    }

    <nav class="filter-tabs" aria-label="تصفية حسب نوع الشهادة">
        <a asp-action="Index" class="@(selectedType is null ? "active" : "")">كل الأنواع</a>
        @foreach (var type in new[] { CertificateType.Quran, CertificateType.Matn, CertificateType.Sanad, CertificateType.General })
        {
            <a asp-action="Index" asp-route-type="@type" class="@(selectedType == type ? "active" : "")">@TypeName(type)</a>
        }
    </nav>

    @if (templates.Count == 0)
    {
        <div class="template-card" style="text-align:center; padding:46px 24px;">
            <div class="cert-icon" style="width:60px; height:60px; font-size:28px; margin-bottom:14px;">
                <i class='bx bx-palette'></i>
            </div>
            <h3 style="font-weight:800;">لا توجد قوالب بعد</h3>
            <p style="color:var(--cb-muted); max-width:520px; margin:8px auto 20px;">
                أنشئ قالباً جديداً لتبدأ تصميم شهادات المركز، أو استعد القوالب الافتراضية الجاهزة لشهادات القرآن والمتون.
            </p>
            <div style="display:flex; gap:10px; justify-content:center; flex-wrap:wrap;">
                <a asp-action="Create" class="btn btn-primary"><i class='bx bx-plus-circle'></i> قالب جديد</a>
                <form asp-action="SeedDefaults" method="post" class="d-inline">
                    @Html.AntiForgeryToken()
                    <button class="btn btn-outline-secondary"><i class='bx bx-magic-wand'></i> استعادة القوالب الافتراضية</button>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="templates-grid">
            @foreach (var template in templates)
            {
                <article class="template-card" style="--tc-primary:@template.PrimaryColor; --tc-secondary:@template.SecondaryColor">
                    <div class="template-card-top"></div>
                    <div class="template-card-body">
                        <div style="display:flex; align-items:start; justify-content:space-between; gap:10px;">
                            <h3 style="font-size:17px; font-weight:800; margin:0;">@template.Name</h3>
                            @if (template.IsDefault)
                            {
                                <span class="chip"><i class='bx bxs-star'></i> الافتراضي</span>
                            }
                        </div>
                        <p style="color:var(--cb-muted); font-size:13px; margin:8px 0 0; min-height:36px;">
                            @(string.IsNullOrWhiteSpace(template.Description) ? "بدون وصف." : template.Description)
                        </p>

                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:12px;">
                            <span class="chip">@TypeName(template.Type)</span>
                            @if (!template.IsActive)
                            {
                                <span class="chip" style="background:#fdeaea; color:#a52a2a;">معطّل</span>
                            }
                            @if (template.CertificatesIssuedCount > 0)
                            {
                                <span class="chip" style="background:#eef2fb; color:#2e4a86;">
                                    @template.CertificatesIssuedCount شهادة صادرة
                                </span>
                            }
                        </div>

                        <div class="template-meta">
                            <span title="ألوان القالب">
                                <span style="display:inline-flex; gap:3px; vertical-align:middle;">
                                    <span style="width:14px; height:14px; border-radius:4px; background:@template.PrimaryColor; display:inline-block;"></span>
                                    <span style="width:14px; height:14px; border-radius:4px; background:@template.SecondaryColor; display:inline-block;"></span>
                                    <span style="width:14px; height:14px; border-radius:4px; background:@template.AccentColor; display:inline-block;"></span>
                                </span>
                            </span>
                            <span>·</span>
                            <span>النسخة @template.CurrentVersion</span>
                            <span>·</span>
                            <span>آخر تحديث: @((template.UpdatedAt ?? template.CreatedAt).ToString("yyyy/MM/dd"))</span>
                        </div>
                    </div>
                    <div class="template-card-footer">
                        <a asp-action="Edit" asp-route-id="@template.Id" class="btn btn-primary btn-sm">
                            <i class='bx bx-edit'></i> محرر التصميم
                        </a>
                        @if (!template.IsDefault)
                        {
                            <form asp-action="SetDefault" asp-route-id="@template.Id" method="post" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-secondary btn-sm"><i class='bx bx-star'></i> تعيين كافتراضي</button>
                            </form>
                        }
                        @if (template.CertificatesIssuedCount == 0)
                        {
                            <form asp-action="Delete" asp-route-id="@template.Id" method="post" class="d-inline ms-auto"
                                  onsubmit="return confirm('حذف هذا القالب نهائياً؟');">
                                @Html.AntiForgeryToken()
                                <button class="btn btn-outline-danger btn-sm"><i class='bx bx-trash'></i></button>
                            </form>
                        }
                    </div>
                </article>
            }
        </div>
    }
</div>
