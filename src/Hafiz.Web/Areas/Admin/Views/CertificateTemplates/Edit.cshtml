@model Hafiz.Application.DTO.Certificate.UpdateTemplateConfigDto
@using Hafiz.Application.DTO.Certificate.TemplateConfiguration
@{
    ViewData["Title"] = "محرر الشهادات";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    var configuration = TemplateConfiguration.FromJson(Model.ConfigurationJson);
    var storedSections = configuration.Sections;

    int StoredOrder(string type) =>
        storedSections.FirstOrDefault(s => string.Equals(s.Type, type, StringComparison.OrdinalIgnoreCase))?.Order ?? int.MaxValue;

    var sectionInfo = new Dictionary<string, (string Label, string Icon, string Hint)>
    {
        ["header"] = ("رأس الشهادة", "bx-building", "الشعار واسم المركز والبسملة ورقم الشهادة"),
        ["title"] = ("العنوان", "bx-heading", "عنوان الشهادة الرئيسي"),
        ["verse"] = ("الآية", "bx-book-open", "نص قرآني يُطبع أعلى البيان"),
        ["statement"] = ("بيان الإنجاز", "bx-message-detail", "اسم الطالب والموضوع وتفاصيل الإنجاز"),
        ["quranScope"] = ("نطاق الحفظ", "bx-list-ol", "الأجزاء المحفوظة ونسبة الإنجاز والرواية"),
        ["evaluation"] = ("التقييم", "bx-star", "الدرجة والتقدير ونتيجة الاختبار"),
        ["signatures"] = ("التواقيع", "bx-pen", "أعمدة التوقيع والختم والتاريخ"),
        ["qrVerification"] = ("رمز التحقق", "bx-qr", "رمز QR لرابط التحقق الإلكتروني")
    };

    var sectionFields = new Dictionary<string, List<(string Key, string Label, string Kind, object Default, string[] Options)>>(StringComparer.OrdinalIgnoreCase)
    {
        ["header"] = new()
        {
            ("showInstituteName", "إظهار اسم المركز", "bool", true, Array.Empty<string>()),
            ("showInstituteLogo", "إظهار شعار المركز", "bool", true, Array.Empty<string>()),
            ("showSubInstitute", "إظهار السطر الفرعي", "bool", true, Array.Empty<string>()),
            ("subInstituteText", "نص السطر الفرعي", "text", "شؤون حلقات القرآن الكريم", Array.Empty<string>()),
            ("showBasmalah", "إظهار البسملة", "bool", true, Array.Empty<string>()),
            ("showCertificateNumber", "إظهار رقم الشهادة", "bool", true, Array.Empty<string>())
        },
        ["title"] = new()
        {
            ("text", "نص العنوان", "text", "{CertificateTitle}", Array.Empty<string>()),
            ("showDecorators", "الزخارف الجانبية (❖)", "bool", true, Array.Empty<string>()),
            ("showUnderline", "الخط الزخرفي أسفل العنوان", "bool", true, Array.Empty<string>())
        },
        ["verse"] = new()
        {
            ("text", "نص الآية", "textarea", "﴿ إِنَّ هَٰذَا الْقُرْآنَ يَهْدِي لِلَّتِي هِيَ أَقْوَمُ ﴾", Array.Empty<string>())
        },
        ["statement"] = new()
        {
            ("text", "نص بيان الإنجاز", "textarea", "تشهد إدارة المركز بأن {GenderedStudent} قد أتمّ بحمد الله وتوفيقه.", Array.Empty<string>()),
            ("showStudentName", "إظهار اسم الطالب", "bool", true, Array.Empty<string>()),
            ("showSubjectName", "إظهار الموضوع", "bool", true, Array.Empty<string>()),
            ("showAuthor", "إظهار المؤلف / الرواية", "bool", true, Array.Empty<string>()),
            ("showScopeDetails", "إظهار سطر تفاصيل النطاق", "bool", true, Array.Empty<string>())
        },
        ["quranScope"] = new()
        {
            ("showFromJuz", "إظهار «من الجزء»", "bool", true, Array.Empty<string>()),
            ("showToJuz", "إظهار «إلى الجزء»", "bool", true, Array.Empty<string>()),
            ("showJuzCount", "إظهار عدد الأجزاء", "bool", true, Array.Empty<string>()),
            ("showCompletionPercentage", "إظهار نسبة الإنجاز", "bool", true, Array.Empty<string>()),
            ("showRiwayah", "إظهار الرواية", "bool", true, Array.Empty<string>()),
            ("riwayahText", "نص الرواية", "text", "برواية حفص عن عاصم من طريق الشاطبية", Array.Empty<string>())
        },
        ["evaluation"] = new()
        {
            ("showScore", "إظهار الدرجة", "bool", true, Array.Empty<string>()),
            ("showRating", "إظهار التقدير", "bool", true, Array.Empty<string>()),
            ("showExamResult", "إظهار شارة نتيجة الاختبار", "bool", true, Array.Empty<string>())
        },
        ["qrVerification"] = new()
        {
            ("size", "حجم الرمز (بكسل)", "number", 80, Array.Empty<string>()),
            ("showLabel", "إظهار الوصف أسفل الرمز", "bool", true, Array.Empty<string>()),
            ("labelText", "نص الوصف", "text", "رمز التحقق الإلكتروني المعتمد", Array.Empty<string>())
        }
    };

    var tokens = new[]
    {
        "{StudentName}", "{GenderedStudent}", "{GenderedCompleted}", "{InstituteName}", "{ClassName}",
        "{TeacherName}", "{DirectorName}", "{CertificateNumber}", "{CertificateTitle}", "{SubjectName}",
        "{AuthorName}", "{FromJuz}", "{ToJuz}", "{JuzCount}", "{CompletionPercentage}", "{Riwayah}",
        "{ScopeDetails}", "{Score}", "{Rating}", "{HijriDate}", "{GregorianDate}"
    };
}

<link rel="stylesheet" href="~/css/certificates/certificate.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/admin/certificate-builder.css" asp-append-version="true" />

<div class="cert-admin-page" dir="rtl">
    <header class="cert-admin-header">
        <div>
            <h1><span class="cert-icon"><i class='bx bx-palette'></i></span>محرر قالب الشهادة</h1>
            <p>صمّم الشهادة بصرياً وشاهد النتيجة مباشرة قبل الحفظ. كل حفظ يُنشئ نسخة جديدة ومؤرشفة من القالب.</p>
        </div>
        <div style="display:flex; gap:9px; flex-wrap:wrap; align-items:center;">
            <button type="button" class="btn btn-outline-secondary" id="btnDesignerVersions" onclick="openDesignerVersionsModal()">
                <i class='bx bx-history'></i> سجل نسخ هذا القالب
            </button>
            <a asp-action="Index" class="btn btn-outline-secondary"><i class='bx bx-arrow-back'></i> كل القوالب</a>
        </div>
    </header>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class='bx bx-check-circle me-1'></i> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class='bx bx-error-circle me-1'></i> @TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="إغلاق"></button>
        </div>
    }

    <div id="versionNoticeBanner" class="alert alert-warning mb-3" style="display:none; align-items:center; justify-content:space-between; gap:12px;">
        <div style="display:flex; align-items:center; gap:8px;">
            <i class='bx bx-history' style="font-size:22px; color:#b45309;"></i>
            <div>
                <strong>تنبيه المعاينة التاريخية:</strong>
                أنت تشاهد حالياً إعدادات <span id="loadedVersionLabel" style="font-weight:800; color:#b45309;"></span> في المحرر.
                <div class="text-muted small">يمكنك تعديل هذه الإعدادات وحفظها لإنشاء إصدار جديد تماماً، أو العودة لإعدادات النسخة الأحدث.</div>
            </div>
        </div>
        <button type="button" class="btn btn-sm btn-outline-dark" id="btnResetToCurrentVersion" onclick="resetToCurrentVersion()">
            <i class='bx bx-undo'></i> العودة للإعدادات الحالية
        </button>
    </div>

    <form method="post" id="certificateBuilderForm">
        <input asp-for="TemplateId" id="templateIdInput" type="hidden" />
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

        <div class="cert-builder">
            <section class="builder-panel">
                <div class="builder-section">
                    <h3><i class='bx bx-file'></i> معلومات القالب</h3>
                    <div class="field-grid">
                        <div class="cb-field full">
                            <label asp-for="Name">اسم القالب</label>
                            <input asp-for="Name" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>
                        <div class="cb-field full">
                            <label asp-for="Description">وصف مختصر</label>
                            <input asp-for="Description" placeholder="وصف يساعد فريقك على اختيار القالب" />
                        </div>
                    </div>
                    <div class="section-row">
                        <i class='bx bx-check-shield'></i>
                        <span>القالب الافتراضي</span>
                        <small>يُستخدم تلقائياً عند إصدار شهادات هذا النوع</small>
                        <input asp-for="IsDefault" class="toggle" />
                    </div>
                    <div class="section-row">
                        <i class='bx bx-power-off'></i>
                        <span>متاح للإصدار</span>
                        <small>يمكن تعطيله دون فقدان الشهادات الصادرة سابقاً</small>
                        <input asp-for="IsActive" class="toggle" />
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-color-fill'></i> هوية الألوان</h3>
                    <div class="preset-grid mb-3">
                        <button type="button" class="preset-btn"
                                data-preset='{"preset":"classic_gold","primaryColor":"#C59B27","secondaryColor":"#064E3B","accentColor":"#DFBA69","backgroundColor":"#FDFBF7","borderColor":"#C59B27","frameStyle":"lines","cornerStyle":"arabesque","cornerSize":64,"backgroundPattern":"arabesque","backgroundPatternColor":"accent","backgroundPatternOpacity":0.05}'>
                            <div class="preset-swatches"><span style="background:#C59B27"></span><span style="background:#064E3B"></span><span style="background:#FDFBF7;border:1px solid #ddd"></span></div>
                            ذهبي كلاسيكي
                        </button>
                        <button type="button" class="preset-btn"
                                data-preset='{"preset":"royal_emerald","primaryColor":"#147D62","secondaryColor":"#0A3D32","accentColor":"#62B99D","backgroundColor":"#F4FBF7","borderColor":"#147D62","frameStyle":"ornate","cornerStyle":"floral","cornerSize":68,"backgroundPattern":"damask","backgroundPatternColor":"secondary","backgroundPatternOpacity":0.06}'>
                            <div class="preset-swatches"><span style="background:#147D62"></span><span style="background:#0A3D32"></span><span style="background:#F4FBF7;border:1px solid #ddd"></span></div>
                            زمردي ملكي
                        </button>
                        <button type="button" class="preset-btn"
                                data-preset='{"preset":"navy_sapphire","primaryColor":"#2E6EAA","secondaryColor":"#123F68","accentColor":"#82B9E8","backgroundColor":"#F7FBFF","borderColor":"#2E6EAA","frameStyle":"ornate","cornerStyle":"girih","cornerSize":60,"backgroundPattern":"geometric","backgroundPatternColor":"primary","backgroundPatternOpacity":0.05}'>
                            <div class="preset-swatches"><span style="background:#2E6EAA"></span><span style="background:#123F68"></span><span style="background:#F7FBFF;border:1px solid #ddd"></span></div>
                            أزرق هادئ
                        </button>
                    </div>
                    <div class="color-grid">
                        <label class="color-field"><input type="color" data-config="theme.primaryColor" /><span>الرئيسي</span></label>
                        <label class="color-field"><input type="color" data-config="theme.secondaryColor" /><span>الثانوي</span></label>
                        <label class="color-field"><input type="color" data-config="theme.accentColor" /><span>الزخرفة</span></label>
                        <label class="color-field"><input type="color" data-config="theme.borderColor" /><span>الإطار</span></label>
                        <label class="color-field"><input type="color" data-config="theme.backgroundColor" /><span>الخلفية</span></label>
                        <label class="color-field"><input type="color" data-config="theme.textColor" /><span>النص</span></label>
                    </div>
                    <div class="field-grid mt-3">
                        <div class="cb-field">
                            <label>نمط الإطار</label>
                            <select data-config="theme.borderStyle">
                                <option value="double">مزدوج</option>
                                <option value="solid">مستمر</option>
                                <option value="dashed">متقطع</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>سماكة الإطار (بكسل)</label>
                            <input type="number" min="1" max="10" step="1" data-config="theme.borderWidth" data-cast="number" />
                        </div>
                    </div>
                    <div class="section-row">
                        <i class='bx bx-water'></i>
                        <span>العلامة المائية</span>
                        <small>أيقونة باهتة في خلفية الشهادة</small>
                        <input type="checkbox" class="toggle" data-config="theme.watermarkEnabled" />
                    </div>
                    <div class="field-grid">
                        <div class="cb-field">
                            <label>أيقونة العلامة المائية</label>
                            <input data-config="theme.watermarkIcon" placeholder="bx-book-open" />
                        </div>
                        <div class="cb-field">
                            <label>شفافية العلامة المائية</label>
                            <input type="number" min="0.01" max="0.3" step="0.01" data-config="theme.watermarkOpacity" data-cast="number" />
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-certification'></i> الإطار والزوايا المزخرفة</h3>
                    <div class="cb-field mb-3">
                        <label>نمط الإطار</label>
                        <div class="ornament-grid ornament-grid--wide">
                            <button type="button" class="ornament-btn" data-frame-style="lines">
                                <span class="frame-swatch"></span>
                                <span>إطار بسيط</span>
                            </button>
                            <button type="button" class="ornament-btn" data-frame-style="ornate">
                                <span class="frame-swatch frame-swatch--ornate"></span>
                                <span>شريط مزخرف</span>
                            </button>
                        </div>
                        <small class="cb-hint">الشريط المزخرف يضيف حزاماً زخرفياً عريضاً حول الإطار الأساسي.</small>
                    </div>

                    <div class="cb-field">
                        <label>زوايا مزخرفة</label>
                        <div class="ornament-grid">
                            <button type="button" class="ornament-btn" data-corner-style="none">
                                <span class="ornament-swatch ornament-swatch--none"></span>
                                <span>بدون</span>
                            </button>
                            <button type="button" class="ornament-btn cert-corners--simple" data-corner-style="simple">
                                <span class="ornament-swatch"></span>
                                <span>بسيط</span>
                            </button>
                            <button type="button" class="ornament-btn cert-corners--arabesque" data-corner-style="arabesque">
                                <span class="ornament-swatch"></span>
                                <span>أرابيسك</span>
                            </button>
                            <button type="button" class="ornament-btn cert-corners--girih" data-corner-style="girih">
                                <span class="ornament-swatch"></span>
                                <span>جيريه</span>
                            </button>
                            <button type="button" class="ornament-btn cert-corners--floral" data-corner-style="floral">
                                <span class="ornament-swatch"></span>
                                <span>زهري</span>
                            </button>
                            <button type="button" class="ornament-btn cert-corners--medallion" data-corner-style="medallion">
                                <span class="ornament-swatch"></span>
                                <span>ميدالية</span>
                            </button>
                        </div>
                    </div>

                    <div class="cb-field mt-3">
                        <label>حجم الزاوية (بكسل)</label>
                        <input type="number" min="24" max="140" step="2" data-config="theme.cornerSize" data-cast="number" />
                        <small class="cb-hint">اختيار زاوية محددة يفعّل هذا الحجم؛ القوالب القديمة تحتفظ بحجمها الأصلي.</small>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-image'></i> خلفية الشهادة</h3>
                    <div class="cb-field">
                        <label>النقش</label>
                        <div class="ornament-grid">
                            <button type="button" class="ornament-btn" data-bg-pattern="none">
                                <span class="pattern-swatch pattern-swatch--none"></span>
                                <span>بدون</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="paper">
                                <span class="pattern-swatch cert-pattern--paper"></span>
                                <span>ورق</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="grid">
                                <span class="pattern-swatch cert-pattern--grid"></span>
                                <span>شبكة</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="arabesque">
                                <span class="pattern-swatch cert-pattern--arabesque"></span>
                                <span>أرابيسك</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="geometric">
                                <span class="pattern-swatch cert-pattern--geometric"></span>
                                <span>هندسي</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="damask">
                                <span class="pattern-swatch cert-pattern--damask"></span>
                                <span>دمشقي</span>
                            </button>
                            <button type="button" class="ornament-btn" data-bg-pattern="stars">
                                <span class="pattern-swatch cert-pattern--stars"></span>
                                <span>نجوم</span>
                            </button>
                        </div>
                    </div>

                    <div class="field-grid mt-3">
                        <div class="cb-field">
                            <label>لون النقش</label>
                            <select data-config="theme.backgroundPatternColor">
                                <option value="primary">الرئيسي</option>
                                <option value="secondary">الثانوي</option>
                                <option value="accent">الزخرفة</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>شدة النقش</label>
                            <input type="number" min="0" max="0.15" step="0.01" data-config="theme.backgroundPatternOpacity" data-cast="number" />
                            <small class="cb-hint" style="font-size:11px; margin:2px 0 0; display:block;">الموصى به: 0.03 إلى 0.08</small>
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-font'></i> الخطوط والأحجام</h3>
                    <div class="field-grid">
                        <div class="cb-field">
                            <label>خط العنوان</label>
                            <select data-config="typography.titleFont">
                                <option value="Reem Kufi">Reem Kufi</option>
                                <option value="Cairo">Cairo</option>
                                <option value="Amiri">Amiri</option>
                                <option value="Tajawal">Tajawal</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>خط النصوص</label>
                            <select data-config="typography.bodyFont">
                                <option value="Cairo">Cairo</option>
                                <option value="Amiri">Amiri</option>
                                <option value="Tajawal">Tajawal</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>الخط العربي (الآيات)</label>
                            <select data-config="typography.arabicFont">
                                <option value="Amiri">Amiri</option>
                                <option value="Reem Kufi">Reem Kufi</option>
                                <option value="Cairo">Cairo</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>تباعد الأسطر</label>
                            <input type="number" min="1" max="3" step="0.1" data-config="typography.lineHeight" data-cast="number" />
                        </div>
                        <div class="cb-field">
                            <label>حجم العنوان</label>
                            <input type="number" min="0.8" max="4" step="0.1" data-config="typography.titleSize" data-cast="rem" />
                        </div>
                        <div class="cb-field">
                            <label>حجم النص</label>
                            <input type="number" min="0.6" max="2.5" step="0.1" data-config="typography.bodySize" data-cast="rem" />
                        </div>
                        <div class="cb-field full">
                            <label>حجم اسم الطالب</label>
                            <input type="number" min="1" max="5" step="0.1" data-config="typography.studentNameSize" data-cast="rem" />
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-layout'></i> المقاس والهوامش</h3>
                    <div class="field-grid">
                        <div class="cb-field">
                            <label>مقاس الورق</label>
                            <select data-config="layout.pageSize">
                                <option value="A4">A4</option>
                                <option value="Letter">Letter</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>اتجاه الصفحة</label>
                            <select data-config="layout.orientation">
                                <option value="landscape">أفقي</option>
                                <option value="portrait">عمودي</option>
                            </select>
                        </div>
                        <div class="cb-field">
                            <label>الهامش العلوي (مم)</label>
                            <input type="number" min="0" max="40" step="1" data-config="layout.margins.top" data-cast="number" />
                        </div>
                        <div class="cb-field">
                            <label>الهامش السفلي (مم)</label>
                            <input type="number" min="0" max="40" step="1" data-config="layout.margins.bottom" data-cast="number" />
                        </div>
                        <div class="cb-field">
                            <label>الهامش الأيمن (مم)</label>
                            <input type="number" min="0" max="40" step="1" data-config="layout.margins.right" data-cast="number" />
                        </div>
                        <div class="cb-field">
                            <label>الهامش الأيسر (مم)</label>
                            <input type="number" min="0" max="40" step="1" data-config="layout.margins.left" data-cast="number" />
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-list-check'></i> أقسام الشهادة</h3>
                    <p class="cb-hint">رتّب الأقسام بالأسهم، وأوقف ما لا تحتاجه، ثم اضبط تفاصيل كل قسم من إعداداته.</p>

                    <div id="sectionList">
                        @foreach (var type in sectionInfo.Keys.OrderBy(StoredOrder))
                        {
                            var info = sectionInfo[type];
                            var fields = sectionFields.TryGetValue(type, out var f) ? f : new();
                            <div class="section-card" data-section-card="@type">
                                <div class="section-card-head">
                                    <i class='bx @info.Icon'></i>
                                    <span>@info.Label</span>
                                    <small>@info.Hint</small>
                                    <button type="button" class="icon-btn" data-move="up" data-move-target="@type" title="تحريك لأعلى"><i class='bx bx-chevron-up'></i></button>
                                    <button type="button" class="icon-btn" data-move="down" data-move-target="@type" title="تحريك لأسفل"><i class='bx bx-chevron-down'></i></button>
                                    <input type="checkbox" class="toggle" data-section="@type" />
                                </div>
                                @if (fields.Count > 0 || type == "signatures")
                                {
                                    <details class="section-card-body">
                                        <summary>إعدادات القسم</summary>
                                        <div class="field-grid mt-2">
                                            @foreach (var field in fields)
                                            {
                                                if (field.Kind == "bool")
                                                {
                                                    <div class="section-row">
                                                        <span>@field.Label</span>
                                                        <input type="checkbox" class="toggle"
                                                               data-section-config="@($"{type}:{field.Key}")"
                                                               data-default="@field.Default.ToString()!.ToLowerInvariant()" />
                                                    </div>
                                                }
                                                else if (field.Kind == "textarea")
                                                {
                                                    <div class="cb-field full">
                                                        <label>@field.Label</label>
                                                        <textarea rows="3" data-section-config="@($"{type}:{field.Key}")"
                                                                  data-default="@field.Default"></textarea>
                                                    </div>
                                                }
                                                else if (field.Kind == "number")
                                                {
                                                    <div class="cb-field">
                                                        <label>@field.Label</label>
                                                        <input type="number" data-section-config="@($"{type}:{field.Key}")"
                                                               data-default="@field.Default" data-cast="number" />
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="cb-field full">
                                                        <label>@field.Label</label>
                                                        <input data-section-config="@($"{type}:{field.Key}")"
                                                               data-default="@field.Default" />
                                                    </div>
                                                }
                                            }
                                        </div>
                                        @if (type == "signatures")
                                        {
                                            <div class="sig-editor">
                                                <div class="cb-label mt-3">أعمدة التوقيع</div>
                                                <div id="signatureColumns"></div>
                                                <button type="button" class="btn btn-light btn-sm mt-2" id="addSignatureColumn">
                                                    <i class='bx bx-plus'></i> إضافة عمود
                                                </button>
                                            </div>
                                        }
                                    </details>
                                }
                            </div>
                        }
                    </div>

                    <div class="token-panel">
                        <div class="cb-label"><i class='bx bx-code-alt'></i> رموز تُستبدل تلقائياً ببيانات الشهادة</div>
                        <div class="token-list">
                            @foreach (var token in tokens)
                            {
                                <button type="button" class="token-chip" data-token="@token">@token</button>
                            }
                        </div>
                    </div>
                </div>

                <div class="builder-section">
                    <h3><i class='bx bx-text'></i> النص الختامي</h3>
                    <div class="cb-field full">
                        <label>سطر يُطبع أسفل بيان الإنجاز</label>
                        <textarea rows="2" data-config="tokens.closingText" placeholder="اتركه فارغاً لإخفائه"></textarea>
                    </div>
                </div>

                <details class="advanced">
                    <summary>إعدادات متقدمة (JSON)</summary>
                    <p class="cb-hint">تعديل مباشر للإعدادات؛ أي تغيير هنا يُحدّث النموذج والمعاينة فوراً.</p>
                    <textarea asp-for="ConfigurationJson" id="configJson" spellcheck="false"></textarea>
                    <span asp-validation-for="ConfigurationJson" class="text-danger"></span>
                </details>

                <div class="builder-actions">
                    <a asp-action="Index" class="btn btn-light">إلغاء</a>
                    <button type="submit" class="btn btn-success"><i class='bx bx-save'></i> حفظ نسخة جديدة</button>
                </div>
            </section>

            <aside class="preview-panel">
                <div class="preview-top">
                    <strong><i class='bx bx-show'></i> معاينة مباشرة</strong>
                    <span class="live-dot">● يتم التحديث فورياً</span>
                </div>

                <div class="preview-controls-row">
                    <div class="preview-controls-group">
                        <label for="sampleDataSelect" style="font-size:12px; font-weight:700; margin:0;"><i class='bx bx-user'></i> النموذج:</label>
                        <select id="sampleDataSelect" class="preview-sample-select">
                            <option value="quran_male">طالب - قرآن كريم (أحمد العبدالله)</option>
                            <option value="quran_female">طالبة - قرآن كريم (فاطمة الزهراء)</option>
                            <option value="matn_male">طالب - متن علمي (تحفة الأطفال)</option>
                            <option value="sanad_male">طالب - إجازة بالسند المتصل</option>
                            <option value="general_appreciation">طالب - شهادة شكر وتقدير</option>
                        </select>
                    </div>
                    <div class="preview-controls-group">
                        <button type="button" class="icon-btn" id="btnZoomOut" title="تصغير المعاينة"><i class='bx bx-minus'></i></button>
                        <span class="zoom-indicator" id="zoomLevel">100%</span>
                        <button type="button" class="icon-btn" id="btnZoomIn" title="تكبير المعاينة"><i class='bx bx-plus'></i></button>
                        <button type="button" class="icon-btn" id="btnZoomReset" title="إعادة ضبط الحجم"><i class='bx bx-reset'></i></button>
                        <button type="button" class="icon-btn" id="btnFullscreenPreview" title="معاينة بملء الشاشة"><i class='bx bx-fullscreen'></i></button>
                        <button type="button" class="icon-btn" id="btnPrintTest" title="طباعة تجريبية"><i class='bx bx-printer'></i></button>
                    </div>
                </div>

                <div class="preview-stage" id="previewStage">
                    <div class="preview-scaler" id="previewScaler">
                        <div id="certificatePreview"></div>
                    </div>
                </div>
                <p class="cb-hint text-center mt-2 mb-0">المعاينة ببيانات تجريبية، وتُطبع الشهادة الفعلية ببيانات الطالب المعتمدة.</p>
            </aside>
        </div>
    </form>
</div>

<!-- نافذة سجل نسخ القالب داخل المحرر -->
<div class="modal fade" id="designerVersionsModal" tabindex="-1" aria-labelledby="designerVersionsModalLabel" aria-hidden="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered modal-lg modal-dialog-scrollable">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="designerVersionsModalLabel">
                    <span class="cert-icon" style="width:34px; height:34px; font-size:18px;"><i class='bx bx-history'></i></span>
                    سجل نسخ القالب والإصدارات السابقة
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
            </div>
            <div class="modal-body">
                <div id="designerVersionsLoading" class="text-center py-4">
                    <i class='bx bx-loader-alt bx-spin' style="font-size:32px; color:var(--cb-forest);"></i>
                    <p class="text-muted mt-2">جارٍ جلب النسخ التاريخية لهذا القالب...</p>
                </div>
                <div id="designerVersionsEmpty" class="text-center py-4" style="display:none;">
                    <i class='bx bx-info-circle' style="font-size:32px; color:var(--cb-muted);"></i>
                    <p class="text-muted mt-2">لا توجد نسخ مسجلة أخرى لهذا القالب.</p>
                </div>
                <div id="designerVersionsList" class="version-timeline" style="display:none;"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

<!-- نافذة المعاينة بملء الشاشة -->
<div class="modal fade modal-fullscreen-preview" id="fullscreenModal" tabindex="-1" aria-labelledby="fullscreenModalLabel" aria-hidden="true" role="dialog">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content" dir="rtl">
            <div class="modal-header">
                <h5 class="modal-title" id="fullscreenModalLabel">
                    <span class="cert-icon" style="width:34px; height:34px; font-size:18px;"><i class='bx bx-fullscreen'></i></span>
                    معاينة قالب الشهادة بالحجم الكامل
                </h5>
                <div style="display:flex; gap:8px; align-items:center;">
                    <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
                        <i class='bx bx-printer'></i> طباعة تجريبية
                    </button>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="إغلاق"></button>
                </div>
            </div>
            <div class="modal-body p-0">
                <div class="fullscreen-preview-container" id="fullscreenModalContainer">
                    <div id="fullscreenModalHost"></div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light" data-bs-dismiss="modal">إغلاق</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/admin/certificate-template-builder.js" asp-append-version="true"></script>
    <script>
        (() => {
            const templateId = document.getElementById('templateIdInput')?.value;
            const versionsUrl = '@Url.Action("Versions", "CertificateTemplates", new { area = "Admin" })';
            const versionConfigUrl = '@Url.Action("VersionConfig", "CertificateTemplates", new { area = "Admin" })';

            ['designerVersionsModal', 'fullscreenModal'].forEach((id) => {
                const el = document.getElementById(id);
                if (el && el.parentElement !== document.body) {
                    document.body.appendChild(el);
                }
            });

            const modalController = {
                open(el) {
                    if (!el) return;
                    this.closeAll();
                    el.style.display = 'flex';
                    void el.offsetHeight;
                    el.classList.add('show', 'is-open');
                    el.setAttribute('aria-hidden', 'false');
                    document.body.style.overflow = 'hidden';
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                },
                close(el) {
                    if (!el) return;
                    el.classList.remove('show', 'is-open');
                    el.setAttribute('aria-hidden', 'true');
                    el.style.display = 'none';
                    document.body.style.overflow = '';
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                },
                closeAll() {
                    document.querySelectorAll('.modal').forEach(m => {
                        m.classList.remove('show', 'is-open');
                        m.setAttribute('aria-hidden', 'true');
                        m.style.display = 'none';
                    });
                    document.body.style.overflow = '';
                    document.querySelectorAll('.modal-backdrop').forEach(b => b.remove());
                }
            };

            document.addEventListener('click', (e) => {
                const dismissBtn = e.target.closest('[data-bs-dismiss="modal"]');
                if (dismissBtn) {
                    e.preventDefault();
                    const modal = dismissBtn.closest('.modal');
                    if (modal) modalController.close(modal);
                } else if (e.target.classList.contains('modal')) {
                    modalController.close(e.target);
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') modalController.closeAll();
            });

            window.openDesignerVersionsModal = async function() {
                if (!templateId) return;
                const modal = document.getElementById('designerVersionsModal');
                const loading = document.getElementById('designerVersionsLoading');
                const empty = document.getElementById('designerVersionsEmpty');
                const list = document.getElementById('designerVersionsList');

                loading.style.display = 'block';
                empty.style.display = 'none';
                list.style.display = 'none';
                list.innerHTML = '';

                modalController.open(modal);

                try {
                    const res = await fetch(`${versionsUrl}?id=${encodeURIComponent(templateId)}`);
                    const data = await res.json();
                    loading.style.display = 'none';

                    if (!data.success || !data.versions || data.versions.length === 0) {
                        empty.style.display = 'block';
                        return;
                    }

                    list.style.display = 'flex';
                    list.innerHTML = data.versions.map(v => {
                        const isCurrent = v.isCurrent;
                        const issuedText = v.certificatesIssuedCount > 0 
                            ? `<span class="badge bg-light text-primary border"><i class='bx bx-award'></i> ${v.certificatesIssuedCount} شهادة صادرة</span>`
                            : `<span class="badge bg-light text-muted border">0 شهادة</span>`;

                        const creatorText = v.createdByName ? `بواسطة: ${v.createdByName}` : '';
                        const orientationText = v.orientation === 'portrait' ? 'عمودي' : 'أفقي';

                        return `
                            <div class="version-card ${isCurrent ? 'is-current' : ''}">
                                <div class="version-card-head">
                                    <div class="version-badge">
                                        <i class='bx bx-git-commit'></i>
                                        النسخة ${v.versionNumber}
                                        ${isCurrent ? '<span class="version-badge-pill version-badge-pill--current">الإصدار الحالي</span>' : '<span class="version-badge-pill">إصدار سابق</span>'}
                                    </div>
                                    <div class="version-actions">
                                        <button type="button" class="btn btn-primary btn-sm"
                                                onclick="loadVersionDirectly('${v.id}', ${v.versionNumber})">
                                            <i class='bx bx-download'></i> تحميل في المحرر
                                        </button>
                                    </div>
                                </div>
                                <div class="version-meta">
                                    <span><i class='bx bx-calendar'></i> ${v.createdAtFormatted}</span>
                                    ${creatorText ? `<span><i class='bx bx-user'></i> ${creatorText}</span>` : ''}
                                    ${issuedText}
                                </div>
                                <div class="version-card-details">
                                    <div class="version-badges-list">
                                        <span class="version-palette" title="هوية ألوان النسخة">
                                            <span class="version-palette-dot" style="background:${v.primaryColor}"></span>
                                            <span class="version-palette-dot" style="background:${v.secondaryColor}"></span>
                                            <span class="version-palette-dot" style="background:${v.accentColor}"></span>
                                        </span>
                                        <span class="badge bg-light text-dark border">${orientationText} (${v.pageSize})</span>
                                        <span class="badge bg-light text-dark border">${v.sectionCount} أقسام مفعّلة</span>
                                    </div>
                                </div>
                            </div>
                        `;
                    }).join('');
                } catch (err) {
                    loading.style.display = 'none';
                    empty.style.display = 'block';
                    empty.innerHTML = `<p class="text-danger"><i class='bx bx-error'></i> تعذّر جلب النسخ: ${err.message}</p>`;
                }
            };

            window.loadVersionDirectly = async function(versionId, versionNumber) {
                try {
                    const res = await fetch(`${versionConfigUrl}?id=${encodeURIComponent(templateId)}&versionId=${encodeURIComponent(versionId)}`);
                    const data = await res.json();
                    if (data.success && data.version) {
                        if (window.loadVersionConfigIntoBuilder) {
                            window.loadVersionConfigIntoBuilder(data.version.configurationJson, versionNumber);
                        }
                        modalController.close(document.getElementById('designerVersionsModal'));
                    }
                } catch (e) {
                    alert('تعذّر تحميل إعدادات النسخة: ' + e.message);
                }
            };

            window.resetToCurrentVersion = function() {
                if (window.resetToOriginalConfig) {
                    window.resetToOriginalConfig();
                }
            };

            // Fullscreen preview handler
            document.getElementById('btnFullscreenPreview')?.addEventListener('click', () => {
                const sheet = document.querySelector('#certificatePreview .certificate-sheet');
                if (!sheet) return;
                const modal = document.getElementById('fullscreenModal');
                const host = document.getElementById('fullscreenModalHost');
                host.replaceChildren(sheet.cloneNode(true));
                modalController.open(modal);
            });
        })();
    </script>
}
