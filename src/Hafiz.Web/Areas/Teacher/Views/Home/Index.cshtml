@using Hafiz.DTOs
@using Hafiz.Models
@using Hafiz.Models.enums
@using Hafiz.Common.Helper
@model List<Class>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var teacherName = User.FindFirst(System.Security.Claims.ClaimTypes.Name)?.Value ?? "المعلم";
    var totalStudents = Model?.Sum(c => c.Students?.Count ?? 0) ?? 0;
    var totalClasses = Model?.Count ?? 0;
    var quranClassesCount = Model?.Count(c => c.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Quran) ?? 0;
    var matnClassesCount = Model?.Count(c => c.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn) ?? 0;

    // Calculate Today's Day of Week
    var currentDay = (ClassDaysEnum)((int)DateTime.Now.DayOfWeek + 1);
    var todayClassesCount = Model?.Count(c => c.ClassDays != null && c.ClassDays.Contains(currentDay)) ?? 0;
}

<link rel="stylesheet" href="~/css/teacher/Index_Classes.css" asp-append-version="true" />

<div class="teacher-dashboard">

    <!-- Teacher Welcome & Today's Overview Banner -->
    <div class="teacher-hero-banner">
        <div class="hero-content">
            <div class="hero-greeting">
                <span class="hero-badge">
                    <i class='bx bx-calendar-star'></i>
                    @(System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar") ? DateTime.Now.ToString("dddd، d MMMM yyyy", new System.Globalization.CultureInfo("ar-SA")) : DateTime.Now.ToString("dddd, MMMM d, yyyy"))
                </span>
                <h1 class="hero-title">مرحباً بك، @teacherName</h1>
                <p class="hero-subtitle">
                    مساحة عملك اليومية لمتابعة حلقات التحفيظ، رصد الأوراد والمتون، وتسجيل حضور الطلاب بكل يسر وسرعة.
                </p>
            </div>

            <!-- Quick Metrics Overview -->
            <div class="hero-metrics">
                <div class="hero-metric-item @(todayClassesCount > 0 ? "today-highlight" : "")">
                    <div class="metric-icon gold">
                        <i class='bx bxs-calendar-check'></i>
                    </div>
                    <div class="metric-text">
                        <span class="metric-value">@todayClassesCount</span>
                        <span class="metric-label">دوام اليوم</span>
                    </div>
                </div>

                <div class="hero-metric-item">
                    <div class="metric-icon green">
                        <i class='bx bx-chalkboard'></i>
                    </div>
                    <div class="metric-text">
                        <span class="metric-value">@totalClasses</span>
                        <span class="metric-label">@Localizer["MyClasses"]</span>
                    </div>
                </div>

                <div class="hero-metric-item">
                    <div class="metric-icon blue">
                        <i class='bx bx-group'></i>
                    </div>
                    <div class="metric-text">
                        <span class="metric-value">@totalStudents</span>
                        <span class="metric-label">إجمالي الطلاب</span>
                    </div>
                </div>

                @if (matnClassesCount > 0)
                {
                    <div class="hero-metric-item">
                        <div class="metric-icon amber">
                            <i class='bx bx-bookmarks'></i>
                        </div>
                        <div class="metric-text">
                            <span class="metric-value">@matnClassesCount</span>
                            <span class="metric-label">حلقات المتون</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Section Title & Filter Tabs -->
    <div class="t-section-header mt-4">
        <div>
            <h2 class="t-section-title">
                <i class='bx bx-grid-alt'></i>
                <span>حلقاتي الدراسية</span>
            </h2>
            <p class="t-section-desc">اختر الحلقة للدخول المباشر إلى قائمة الطلاب ورصد التسميع اليومي</p>
        </div>

        @if (totalClasses > 0)
        {
            <div class="class-filter-pills" id="classFilterTabs">
                <button type="button" class="class-filter-btn active" data-class-filter="all">
                    جميع الحلقات <span class="filter-count">@totalClasses</span>
                </button>
                @if (todayClassesCount > 0)
                {
                    <button type="button" class="class-filter-btn btn-today-filter" data-class-filter="today">
                        <span class="pulse-dot-sm"></span>
                        <i class='bx bxs-calendar-check'></i> دوام اليوم <span class="filter-count">@todayClassesCount</span>
                    </button>
                }
            </div>
        }
    </div>

    <!-- Classes Grid -->
    @if (Model != null && Model.Any())
    {
        <div class="classes-grid" id="classesContainer">
            @foreach (var classItem in Model)
            {
                var genderClass = classItem.Gender.ToString().ToLower();
                var isMatn = classItem.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn;
                var studentCount = classItem.Students?.Count ?? 0;
                var isToday = classItem.ClassDays != null && classItem.ClassDays.Contains(currentDay);

                <div class="class-card @(isMatn ? "is-matn-card" : "is-quran-card") @(isToday ? "is-today-class" : "")" 
                     data-class-id="@classItem.Id" 
                     data-class-name="@classItem.Name"
                     data-today="@(isToday ? "true" : "false")"
                     role="button"
                     tabindex="0"
                     aria-label="الحلقة @classItem.Name">
                    
                    <span class="status-badge" style="display:none">
                        <i class='bx bx-check-circle me-1'></i> @Localizer["Active"]
                    </span>

                    <div class="class-card-content">
                        <div class="class-card-top">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <div class="class-program-badge">
                                    @if (isMatn)
                                    {
                                        <span class="t-badge t-badge-matn">
                                            <i class='bx bx-bookmarks'></i> @(classItem.StudyProgram?.Name ?? "متون علمية")
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="t-badge t-badge-quran">
                                            <i class='bx bx-book-open'></i> @(classItem.StudyProgram?.Name ?? "قرآن كريم")
                                        </span>
                                    }
                                </div>

                                @if (isToday)
                                {
                                    <span class="today-live-chip">
                                        <span class="pulse-dot"></span>
                                        <i class='bx bxs-calendar-check'></i> دوام اليوم
                                    </span>
                                }
                            </div>

                            <span class="gender-pill gender-@genderClass">
                                <i class='bx @(genderClass == "female" ? "bx-female-sign" : "bx-male-sign")'></i>
                                @classItem.Gender
                            </span>
                        </div>

                        <h3 class="class-name">@classItem.Name</h3>

                        <div class="class-info-list">
                            <div class="class-info-item">
                                <div class="info-icon-box">
                                    <i class='bx bx-time-five'></i>
                                </div>
                                <div class="info-details">
                                    <span class="info-label">الوقت المحدد</span>
                                    <span class="info-val">@GetFormattedTime(classItem.ClassTime)</span>
                                </div>
                            </div>

                            <div class="class-info-item align-items-start">
                                <div class="info-icon-box mt-1">
                                    <i class='bx bx-calendar'></i>
                                </div>
                                <div class="info-details flex-column align-items-start gap-1">
                                    <span class="info-label">أيام الحلقة</span>
                                    <div class="class-days-chips">
                                        @if (classItem.ClassDays != null && classItem.ClassDays.Any())
                                        {
                                            @foreach (var d in classItem.ClassDays)
                                            {
                                                var isThisDayToday = (d == currentDay);
                                                <span class="day-chip @(isThisDayToday ? "is-current-day" : "")" 
                                                      title="@(isThisDayToday ? "اليوم الحالي - يوجد دوام" : "")">
                                                    @Formatting.GetLocalizedDayName(d)
                                                    @if (isThisDayToday)
                                                    {
                                                        <i class='bx bx-check-circle ms-1'></i>
                                                    }
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@Localizer["NoDaysSet"].Value</span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <div class="class-info-item">
                                <div class="info-icon-box">
                                    <i class='bx bx-user'></i>
                                </div>
                                <div class="info-details">
                                    <span class="info-label">عدد المقيدين</span>
                                    <span class="info-val"><strong>@studentCount</strong> @Localizer["Students"]</span>
                                </div>
                            </div>
                        </div>

                        <div class="class-footer">
                            <a asp-area="Teacher" asp-controller="Student" asp-action="Index" 
                               class="t-btn @(isMatn ? "t-btn-matn" : "t-btn-primary") w-100" 
                               onclick="event.stopPropagation(); document.cookie='selectedClassId=@classItem.Id; path=/; max-age=2592000'; document.cookie='selectedClassName=@classItem.Name; path=/; max-age=2592000';">
                                <i class='bx @(isMatn ? "bx-bookmarks" : "bx-book-reader") me-1'></i>
                                <span>@(isMatn ? "دخول حلقة المتون" : "دخول حلقة القرآن")</span>
                                <i class='bx bx-left-arrow-alt ms-auto arrow-icon'></i>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="t-empty-state mt-4">
            <div class="t-empty-icon">
                <i class='bx bx-chalkboard'></i>
            </div>
            <h3 class="t-empty-title">لا توجد حلقات مسندة إليك حالياً</h3>
            <p class="t-empty-text">
                لم يتم إسناد أي حلقة دراسية إلى حسابك حتى الآن. يرجى التواصل مع إدارة المركز لإسناد الحلقات لك.
            </p>
        </div>
    }

</div>

@functions {
    private string GetFormattedTime(DateTime classTime)
    {
        var startTime = classTime.ToString("h:mm tt");
        var endTime = classTime.AddHours(2).ToString("h:mm tt");
        return $"{startTime} - {endTime}";
    }
}

@section Scripts {
    <script src="~/js/teacher_portal/Index.js" asp-append-version="true"></script>
    <script>
        // Class Filtering by Today's Schedule
        (function () {
            const filterButtons = document.querySelectorAll('#classFilterTabs .class-filter-btn');
            const classCards = document.querySelectorAll('#classesContainer .class-card');

            if (!filterButtons.length || !classCards.length) return;

            filterButtons.forEach(btn => {
                btn.addEventListener('click', function () {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    this.classList.add('active');

                    const filter = this.getAttribute('data-class-filter');
                    classCards.forEach(card => {
                        const isToday = card.getAttribute('data-today') === 'true';
                        if (filter === 'today') {
                            card.style.display = isToday ? '' : 'none';
                        } else {
                            card.style.display = '';
                        }
                    });
                });
            });
        })();
    </script>
}