@using Hafiz.DTOs.Attendance
@using Microsoft.Extensions.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@model IEnumerable<StudentAttendanceDto>

@{
    Layout = (ViewData["Role"]?.ToString() == "Admin")
        ? "~/Views/Shared/_AdminLayout.cshtml"
        : "~/Views/Shared/_TeacherLayout.cshtml";
    ViewData["Title"] = Localizer["PageTitle"];
    ViewData["UseSelect2"] = true;
}

<link rel="stylesheet" href="~/css/teacher/attendance-modern.css" asp-append-version="true" />

<div class="attendance-page-container">

    <!-- Page Header -->
    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
        <div>
            <h2 class="t-section-title mb-1">
                <i class='bx bx-calendar-check text-primary'></i>
                <span>@Localizer["PageHeader"]</span>
            </h2>
            <p class="t-section-desc">@Localizer["PageDescription"]</p>
        </div>
        <div class="attendance-actions">
            <button class="t-btn t-btn-primary" id="saveAllBtn">
                <i class='bx bx-save'></i>
                <span>@Localizer["SaveAll"]</span>
            </button>
            <button class="t-btn t-btn-outline" id="exportBtn">
                <i class='bx bx-download'></i>
                <span>@Localizer["Export"]</span>
            </button>
        </div>
    </div>

    <!-- Floating Save Indicator -->
    <div id="saveIndicator" class="save-indicator"></div>

    @* Anti-forgery token for AJAX calls *@
    @Html.AntiForgeryToken()

    <!-- Statistics Cards -->
    <div class="attendance-stats-grid">
        <div class="att-stat-card present">
            <div class="att-stat-icon">
                <i class='bx bx-check-circle'></i>
            </div>
            <div>
                <div class="att-stat-val" id="presentCount">0</div>
                <div class="att-stat-lbl">@Localizer["Present"]</div>
            </div>
        </div>

        <div class="att-stat-card late">
            <div class="att-stat-icon">
                <i class='bx bx-time-five'></i>
            </div>
            <div>
                <div class="att-stat-val" id="lateCount">0</div>
                <div class="att-stat-lbl">@Localizer["Late"]</div>
            </div>
        </div>

        <div class="att-stat-card absent">
            <div class="att-stat-icon">
                <i class='bx bx-x-circle'></i>
            </div>
            <div>
                <div class="att-stat-val" id="absentCount">0</div>
                <div class="att-stat-lbl">@Localizer["Absent"]</div>
            </div>
        </div>

        <div class="att-stat-card excuse">
            <div class="att-stat-icon">
                <i class='bx bx-message-square-dots'></i>
            </div>
            <div>
                <div class="att-stat-val" id="excuseCount">0</div>
                <div class="att-stat-lbl">@Localizer["Excuse"]</div>
            </div>
        </div>
    </div>

    <!-- Filters Card -->
    <div class="att-filters-card">
        <div class="att-filters-grid">
            <div class="att-filter-item">
                <label for="attendanceDate">
                    <i class='bx bx-calendar text-primary'></i> @Localizer["Date"]
                </label>
                <input type="text" class="form-input" id="attendanceDate" value="@TimeZoneHelper.GetUserToday(Context).ToString("yyyy-MM-dd")"
                       placeholder="@Localizer["SelectDate"]">
            </div>

            <div class="att-filter-item">
                <label for="classSession">
                    <i class='bx bx-group text-primary'></i> @Localizer["Class"]
                </label>
                <select class="form-select select2-classes" id="classSession" asp-items="ViewBag.Classes">
                </select>
            </div>
        </div>
    </div>

    <!-- Attendance Table & Search -->
    <div class="att-table-toolbar">
        <div class="att-search-box">
            <input type="text" id="studentSearch" placeholder="@Localizer["SearchStudent"]">
            <i class='bx bx-search'></i>
        </div>
        <div class="text-muted small fw-bold">
            @Localizer["TotalStudents"]: <strong id="totalStudents" class="text-primary">@(Model?.Count() ?? 0)</strong>
        </div>
    </div>

    <div class="table-attendance-card">
        <table class="table table-attendance">
            <thead>
                <tr>
                    <th style="width: 50px;">#</th>
                    <th>
                        <i class='bx bx-user me-1'></i> @Localizer["StudentName"]
                    </th>
                    <th class="text-center" style="width: 110px;">
                        <i class='bx bx-check-circle text-success me-1'></i>
                        <span>@Localizer["Present"]</span>
                    </th>
                    <th class="text-center" style="width: 110px;">
                        <i class='bx bx-time-five text-warning me-1'></i>
                        <span>@Localizer["Late"]</span>
                    </th>
                    <th class="text-center" style="width: 110px;">
                        <i class='bx bx-x-circle text-danger me-1'></i>
                        <span>@Localizer["Absent"]</span>
                    </th>
                    <th class="text-center" style="width: 110px;">
                        <i class='bx bx-message-square-dots text-info me-1'></i>
                        <span>@Localizer["Excuse"]</span>
                    </th>
                </tr>
            </thead>

            <tbody id="studentsTable">
                @if (Model != null && Model.Any())
                {
                    int index = 1;
                    foreach (var student in Model)
                    {
                        if (student is null)
                        {
                            continue;
                        }

                        var studentId = student.Id;

                        var presentChecked = "";
                        var lateChecked = "";
                        var absentChecked = "";
                        var excuseChecked = "";
                        var rowClass = "";

                        if (student.PrevAttendance != null)
                        {
                            rowClass = "has-attendance";
                            switch (student.PrevAttendance.Status)
                            {
                                case 0:
                                    presentChecked = "checked";
                                    rowClass += " status-present";
                                    break;
                                case 1:
                                    lateChecked = "checked";
                                    rowClass += " status-late";
                                    break;
                                case 2:
                                    absentChecked = "checked";
                                    rowClass += " status-absent";
                                    break;
                                case 3:
                                    excuseChecked = "checked";
                                    rowClass += " status-excuse";
                                    break;
                            }
                        }

                        <tr data-student-id="@student.Id" class="@rowClass">
                            <td class="text-center text-muted fw-bold">@index</td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <div class="row-avatar avatar-male">
                                        @(student?.FirstName?.Substring(0, 1) ?? "?")
                                    </div>
                                    <span class="fw-bold">@student?.FirstName @student?.SecondName</span>
                                </div>
                            </td>
                            <td class="text-center">
                                <label class="attendance-radio" title="@Localizer["Present"]">
                                    <input type="radio" name="attendance_@studentId" class="attendance-checkbox status-present"
                                           data-student-id="@studentId" data-status="0" @presentChecked>
                                    <span class="radio-custom present"></span>
                                    <span class="d-inline d-md-none ms-1 small fw-bold">حاضر</span>
                                </label>
                            </td>
                            <td class="text-center">
                                <label class="attendance-radio" title="@Localizer["Late"]">
                                    <input type="radio" name="attendance_@studentId" class="attendance-checkbox status-late"
                                           data-student-id="@studentId" data-status="1" @lateChecked>
                                    <span class="radio-custom late"></span>
                                    <span class="d-inline d-md-none ms-1 small fw-bold">متأخر</span>
                                </label>
                            </td>
                            <td class="text-center">
                                <label class="attendance-radio" title="@Localizer["Absent"]">
                                    <input type="radio" name="attendance_@studentId" class="attendance-checkbox status-absent"
                                           data-student-id="@studentId" data-status="2" @absentChecked>
                                    <span class="radio-custom absent"></span>
                                    <span class="d-inline d-md-none ms-1 small fw-bold">غائب</span>
                                </label>
                            </td>
                            <td class="text-center">
                                <label class="attendance-radio" title="@Localizer["Excuse"]">
                                    <input type="radio" name="attendance_@studentId" class="attendance-checkbox status-excuse"
                                           data-student-id="@studentId" data-status="3" @excuseChecked>
                                    <span class="radio-custom excuse"></span>
                                    <span class="d-inline d-md-none ms-1 small fw-bold">معذور</span>
                                </label>
                            </td>
                        </tr>
                        index++;
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="t-empty-state py-4">
                                <div class="t-empty-icon"><i class='bx bx-user-x'></i></div>
                                <h4 class="t-empty-title">@Localizer["NoData"]</h4>
                                <p class="t-empty-text">@Localizer["NoStudentsFound"]</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

</div>

<!-- Load Required Libraries -->
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

@section Scripts {
    <script src="~/js/student/utils.js" asp-append-version="true"></script>
    <script src="~/js/student/api.js" asp-append-version="true"></script>
    <script src="~/js/student/events.js" asp-append-version="true"></script>
    <script src="~/js/student/init.js" asp-append-version="true"></script>
}