@model IEnumerable<Hafiz.Models.Class>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
    var classes = Model ?? new List<Hafiz.Models.Class>();
    var totalClasses = classes.Count();
    var activeMeetings = classes.Count(c => c.IsMeetingActive);
    var quranClassesCount = classes.Count(c => c.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Quran);
    var matnClassesCount = classes.Count(c => c.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn);
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher/meeting.css" asp-append-version="true" />
}

<div class="meetings-page">

    <!-- Top Hero Header -->
    <div class="meetings-hero-banner">
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-3">
            <div>
                <div class="d-flex align-items-center gap-2 mb-1">
                    <h2 class="t-section-title m-0">
                        <i class='bx bx-video'></i>
                        <span>@Localizer["PageTitle"]</span>
                    </h2>
                    @if (activeMeetings > 0)
                    {
                        <span class="live-broadcast-pill">
                            <span class="live-pulse-dot"></span>
                            <span>@activeMeetings بث مباشر نشط</span>
                        </span>
                    }
                </div>
                <p class="t-section-desc m-0">@Localizer["PageSubtitle"]</p>
            </div>

            <div class="d-flex align-items-center gap-2">
                <span class="t-badge t-badge-quran fs-6 py-2 px-3">
                    <i class='bx bx-chalkboard'></i>
                    <span>@totalClasses @Localizer["TotalClasses"]</span>
                </span>
            </div>
        </div>
    </div>

    <!-- Toast Alerts -->
    @if (TempData["Success"] != null)
    {
        <div class="t-toast t-toast-success alert-dismissible" role="alert" id="meetingSuccessAlert">
            <i class="bx bx-check-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert" id="meetingErrorAlert">
            <i class="bx bx-error-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert" style="background: #fffbeb; color: #92400e; border: 1px solid #fde68a;">
            <i class="bx bx-error" style="font-size: 1.3rem;"></i>
            <span>@TempData["Warning"]</span>
        </div>
    }

    <!-- Active Live Broadcast Alert Banner -->
    @if (activeMeetings > 0)
    {
        <div class="active-broadcast-alert">
            <div class="broadcast-icon-box">
                <i class='bx bx-broadcast'></i>
            </div>
            <div class="broadcast-text">
                <strong>يوجد حالياً (@activeMeetings) اجتماع وغرفة درس مباشر قيد البث</strong>
                <span>يمكنك الانضمام مباشرة إلى الغرفة أو إنهاء الجلسة عند اكتمال الحلقة.</span>
            </div>
        </div>
    }

    @if (classes.Any())
    {
        <!-- Actionable Toolbar & Filters -->
        <div class="meetings-toolbar">
            <div class="search-wrapper">
                <i class='bx bx-search search-icon'></i>
                <input id="meetingSearch" type="text" class="search-input" placeholder="ابحث باسم الحلقة..."
                       autocomplete="off" />
            </div>

            <div class="meetings-filter-tabs">
                <button type="button" class="meeting-filter-tab active" data-filter="all">
                    جميع الحلقات <span class="filter-count">@totalClasses</span>
                </button>
                @if (activeMeetings > 0)
                {
                    <button type="button" class="meeting-filter-tab tab-live" data-filter="live">
                        <span class="live-pulse-dot"></span> بث نشط الآن <span class="filter-count">@activeMeetings</span>
                    </button>
                }
                @if (quranClassesCount > 0)
                {
                    <button type="button" class="meeting-filter-tab" data-filter="quran">
                        حلقات القرآن
                    </button>
                }
                @if (matnClassesCount > 0)
                {
                    <button type="button" class="meeting-filter-tab" data-filter="matn">
                        حلقات المتون
                    </button>
                }
            </div>
        </div>

        <!-- Mobile / Tablet Meeting Record Cards -->
        <div class="meeting-records-mobile" id="meetingRecordsMobile">
            @foreach (var cls in classes)
            {
                var isMatn = cls.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn;
                var programType = isMatn ? "matn" : "quran";
                var isLive = cls.IsMeetingActive;
                var genderClass = cls.Gender.ToString().ToLower();

                <div class="meeting-record-card @(isLive ? "is-live" : "")"
                     data-name="@cls.Name.ToLower()"
                     data-type="@programType"
                     data-live="@(isLive ? "true" : "false")">

                    <div class="meeting-record-main">
                        <div class="meeting-avatar @(isLive ? "avatar-live" : (isMatn ? "avatar-matn" : "avatar-quran"))">
                            <i class='bx @(isLive ? "bx-broadcast" : (isMatn ? "bx-bookmarks" : "bx-book-reader"))'></i>
                        </div>

                        <div class="meeting-info">
                            <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                                <span class="meeting-name">@cls.Name</span>
                                @if (isLive)
                                {
                                    <span class="live-status-badge">
                                        <span class="live-pulse-dot"></span> مباشر
                                    </span>
                                }
                            </div>

                            <div class="meeting-meta-row">
                                @if (isMatn)
                                {
                                    <span class="t-badge t-badge-matn">
                                        @(cls.StudyProgram?.Name ?? "متون علمية")
                                    </span>
                                }
                                else
                                {
                                    <span class="t-badge t-badge-quran">
                                        @(cls.StudyProgram?.Name ?? "قرآن كريم")
                                    </span>
                                }

                                <span class="gender-pill gender-@genderClass">
                                    @cls.Gender
                                </span>

                                <span class="enrolled-pill">
                                    <i class='bx bx-group'></i> @(cls.Students?.Count ?? 0) طالب
                                </span>
                            </div>
                        </div>
                    </div>

                    <div class="meeting-actions">
                        @if (isLive)
                        {
                            <a asp-area="Teacher" asp-controller="Meeting" asp-action="Room"
                               asp-route-classId="@cls.Id" class="t-btn t-btn-primary t-btn-sm flex-grow-1">
                                <i class="bx bx-log-in-circle"></i>
                                <span>دخول البث المباشر</span>
                            </a>
                            <button type="button" class="t-btn t-btn-danger t-btn-sm"
                                    onclick="showEndMeetingModal('@cls.Id')">
                                <i class="bx bx-stop-circle"></i>
                                <span>إنهاء</span>
                            </button>
                        }
                        else
                        {
                            <form asp-action="StartMeeting" asp-route-classId="@cls.Id" method="post" class="w-100">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="t-btn t-btn-primary t-btn-sm w-100">
                                    <i class="bx bx-play-circle"></i>
                                    <span>بدء الاجتماع والانضمام</span>
                                </button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>

        <!-- Desktop High-Density Records Table -->
        <div class="meetings-table-wrap" id="meetingsTableWrap">
            <table class="meetings-table">
                <thead>
                    <tr>
                        <th>الحلقة الدراسية</th>
                        <th>المسار التعليمي</th>
                        <th>الجنس والطلاب</th>
                        <th>حالة البث المباشر</th>
                        <th class="text-center">إجراءات البث</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var cls in classes)
                    {
                        var isMatn = cls.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn;
                        var programType = isMatn ? "matn" : "quran";
                        var isLive = cls.IsMeetingActive;
                        var genderClass = cls.Gender.ToString().ToLower();

                        <tr class="meeting-table-row @(isLive ? "is-live-row" : "")"
                            data-name="@cls.Name.ToLower()"
                            data-type="@programType"
                            data-live="@(isLive ? "true" : "false")">

                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="meeting-avatar @(isLive ? "avatar-live" : (isMatn ? "avatar-matn" : "avatar-quran"))">
                                        <i class='bx @(isLive ? "bx-broadcast" : (isMatn ? "bx-bookmarks" : "bx-book-reader"))'></i>
                                    </div>
                                    <div>
                                        <span class="meeting-name d-block">@cls.Name</span>
                                    </div>
                                </div>
                            </td>

                            <td>
                                @if (isMatn)
                                {
                                    <span class="t-badge t-badge-matn">
                                        <i class='bx bx-bookmarks'></i> @(cls.StudyProgram?.Name ?? "متون علمية")
                                    </span>
                                }
                                else
                                {
                                    <span class="t-badge t-badge-quran">
                                        <i class='bx bx-book-open'></i> @(cls.StudyProgram?.Name ?? "قرآن كريم")
                                    </span>
                                }
                            </td>

                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="gender-pill gender-@genderClass">
                                        @cls.Gender
                                    </span>
                                    <span class="enrolled-pill">
                                        <i class='bx bx-group'></i> @(cls.Students?.Count ?? 0) طالب
                                    </span>
                                </div>
                            </td>

                            <td>
                                @if (isLive)
                                {
                                    <span class="live-status-badge">
                                        <span class="live-pulse-dot"></span>
                                        <span>بث مباشر نشط الآن</span>
                                    </span>
                                }
                                else
                                {
                                    <span class="offline-status-badge">
                                        <i class="bx bx-circle me-1"></i> غير مفعل
                                    </span>
                                }
                            </td>

                            <td class="text-center">
                                <div class="d-flex justify-content-center gap-2">
                                    @if (isLive)
                                    {
                                        <a asp-area="Teacher" asp-controller="Meeting" asp-action="Room"
                                           asp-route-classId="@cls.Id" class="t-btn t-btn-sm t-btn-primary">
                                            <i class="bx bx-log-in-circle"></i>
                                            <span>دخول البث</span>
                                        </a>
                                        <button type="button" class="t-btn t-btn-sm t-btn-danger"
                                                onclick="showEndMeetingModal('@cls.Id')">
                                            <i class="bx bx-stop-circle"></i>
                                            <span>إنهاء</span>
                                        </button>
                                    }
                                    else
                                    {
                                        <form asp-action="StartMeeting" asp-route-classId="@cls.Id" method="post"
                                              class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="t-btn t-btn-sm t-btn-primary">
                                                <i class="bx bx-play-circle"></i>
                                                <span>بدء الاجتماع والانضمام</span>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <!-- No Matching Classes State -->
        <div class="meetings-empty-state" id="meetingsNoMatch" style="display: none;">
            <div class="empty-icon"><i class='bx bx-search-alt'></i></div>
            <h3>لا توجد حلقات مطابقة للبحث</h3>
            <p>يرجى تعديل نص البحث أو الفلتر للعثور على الحلقة المطلوبة</p>
        </div>
    }
    else
    {
        <div class="t-empty-state mt-4">
            <div class="t-empty-icon"><i class="bx bx-video-off"></i></div>
            <h4 class="t-empty-title">@Localizer["NoClassesFound"]</h4>
            <p class="t-empty-text">@Localizer["NoClassesAssigned"]</p>
        </div>
    }
</div>

<!-- End Meeting Confirmation Modal -->
<div id="endMeetingModal" class="modal-overlay" role="dialog" aria-modal="true" aria-labelledby="endModalTitle">
    <div class="modal-content t-card" style="max-width: 440px; margin: auto; padding: 1.75rem; text-align: center;">
        <div class="t-empty-icon mx-auto mb-3" style="background: var(--t-absent-bg); color: var(--t-absent); width: 56px; height: 56px; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 1.8rem;">
            <i class="bx bx-error-circle"></i>
        </div>
        <h3 class="modal-title h5 fw-bold mb-2" id="endModalTitle">@Localizer["EndMeeting"]</h3>
        <p class="modal-description text-muted small mb-4">
            @Localizer["EndMeetingConfirm"]
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="t-btn t-btn-outline" onclick="closeEndMeetingModal()">
                <i class="bx bx-arrow-back"></i>
                <span>@Localizer["Cancel"]</span>
            </button>
            <form id="endMeetingForm" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="t-btn t-btn-danger">
                    <i class="bx bx-stop-circle"></i>
                    <span>@Localizer["EndMeeting"]</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    let currentClassId = null;

    function showEndMeetingModal(classId) {
        currentClassId = classId;
        const modal = document.getElementById('endMeetingModal');
        const form = document.getElementById('endMeetingForm');

        form.action = '@Url.Action("EndMeeting", "TeacherClasses", new { area = "Teacher" })' + '?classId=' + classId;

        if (modal) {
            modal.classList.add('active');
        }
    }

    function closeEndMeetingModal() {
        const modal = document.getElementById('endMeetingModal');
        if (modal) {
            modal.classList.remove('active');
        }
        currentClassId = null;
    }

    document.addEventListener('click', function (e) {
        const modal = document.getElementById('endMeetingModal');
        if (e.target === modal) {
            closeEndMeetingModal();
        }
    });

    // Auto-dismiss alerts
    setTimeout(function () {
        const s = document.getElementById('meetingSuccessAlert');
        const err = document.getElementById('meetingErrorAlert');
        if (s) { s.style.opacity = '0'; setTimeout(() => s.style.display = 'none', 500); }
        if (err) { err.style.opacity = '0'; setTimeout(() => err.style.display = 'none', 500); }
    }, 5000);

    // Meetings Search & Filter
    (function () {
        const searchInput = document.getElementById('meetingSearch');
        const filterTabs = document.querySelectorAll('.meetings-filter-tabs .meeting-filter-tab');
        const cards = document.querySelectorAll('#meetingRecordsMobile .meeting-record-card');
        const rows = document.querySelectorAll('#meetingsTableWrap .meeting-table-row');
        const noMatch = document.getElementById('meetingsNoMatch');
        const mobileWrap = document.getElementById('meetingRecordsMobile');
        const tableWrap = document.getElementById('meetingsTableWrap');

        let query = '';
        let filter = 'all';

        function checkMatch(el) {
            const name = el.getAttribute('data-name') || '';
            const type = el.getAttribute('data-type') || '';
            const isLive = el.getAttribute('data-live') === 'true';

            const matchQuery = query === '' || name.indexOf(query) !== -1;
            let matchFilter = true;

            if (filter === 'live') {
                matchFilter = isLive;
            } else if (filter === 'quran') {
                matchFilter = (type === 'quran');
            } else if (filter === 'matn') {
                matchFilter = (type === 'matn');
            }

            return matchQuery && matchFilter;
        }

        function filterMeetings() {
            let visibleCount = 0;
            cards.forEach(card => {
                const show = checkMatch(card);
                card.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });
            rows.forEach(row => {
                const show = checkMatch(row);
                row.style.display = show ? '' : 'none';
            });

            const total = cards.length || rows.length;
            const isEmpty = visibleCount === 0 && total > 0;
            if (noMatch) noMatch.style.display = isEmpty ? 'flex' : 'none';
            if (mobileWrap) mobileWrap.style.display = isEmpty ? 'none' : '';
            if (tableWrap) tableWrap.style.display = isEmpty ? 'none' : '';
        }

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                query = this.value.trim().toLowerCase();
                filterMeetings();
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', function () {
                filterTabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                filter = this.getAttribute('data-filter') || 'all';
                filterMeetings();
            });
        });
    })();
</script>