@model IEnumerable<Hafiz.Models.Class>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

@section Styles {
    <link rel="stylesheet" href="~/css/teacher/meeting.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/teacher/modal.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css">
}

<div class="meetings-page">
    <!-- Header Section -->
    <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
        <div>
            <h2 class="t-section-title mb-1">
                <i class='bx bx-video text-primary'></i>
                <span>@Localizer["PageTitle"]</span>
            </h2>
            <p class="t-section-desc">@Localizer["PageSubtitle"]</p>
        </div>
        <div>
            <span class="t-badge t-badge-quran fs-6 py-2 px-3">
                <i class='bx bx-chalkboard'></i>
                <span>@Model.Count() @Localizer["TotalClasses"]</span>
            </span>
        </div>
    </div>

    <!-- Alert Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="t-toast t-toast-success alert-dismissible" role="alert">
            <i class="bx bx-check-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["Success"]</span>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert">
            <i class="bx bx-error-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["Error"]</span>
        </div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert" style="background: #fffbeb; color: #92400e; border: 1px solid #fde68a;">
            <i class="bx bx-error" style="font-size: 1.3rem;"></i>
            <span>@TempData["Warning"]</span>
        </div>
    }

    <!-- Active Meetings Summary -->
    @{
        var activeMeetings = Model.Count(c => c.IsMeetingActive);
        if (activeMeetings > 0)
        {
            <div class="active-meetings-alert mb-4">
                <div class="d-flex align-items-center gap-3">
                    <div class="pulse-indicator">
                        <i class='bx bx-broadcast'></i>
                    </div>
                    <div>
                        <strong class="d-block text-success">@activeMeetings @Localizer["ActiveMeetings"]</strong>
                        <span class="small text-muted">@Localizer["ActiveMeetingsNote"]</span>
                    </div>
                </div>
            </div>
        }
    }

    <!-- Classes Table & Responsive Cards -->
    @if (Model.Any())
    {
        <div class="classes-card t-card">
            <div class="table-responsive">
                <table class="classes-table table mb-0">
                    <thead>
                        <tr>
                            <th>
                                <i class="bx bx-book-open me-1"></i> @Localizer["ClassName"]
                            </th>
                            <th>
                                <i class="bx bx-user me-1"></i> @Localizer["Gender"]
                            </th>
                            <th>
                                <i class="bx bx-group me-1"></i> @Localizer["Students"]
                            </th>
                            <th>
                                <i class="bx bx-pulse me-1"></i> @Localizer["Status"]
                            </th>
                            <th class="text-center">
                                <i class="bx bx-cog me-1"></i> @Localizer["Actions"]
                            </th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var cls in Model)
                        {
                            var isMatn = cls.StudyProgram?.Type == Hafiz.Domain.Enums.ProgramType.Matn;
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div class="row-avatar @(isMatn ? "avatar-matn" : "avatar-male")">
                                            @cls.Name.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@cls.Name</div>
                                            @if (cls.StudyProgram != null)
                                            {
                                                <span class="t-badge @(isMatn ? "t-badge-matn" : "t-badge-quran")" style="font-size: 0.72rem; padding: 2px 6px;">
                                                    @cls.StudyProgram.Name
                                                </span>
                                            }
                                        </div>
                                    </div>
                                </td>

                                <td>
                                    <span class="gender-pill gender-@(cls.Gender.ToString().ToLower())">
                                        @cls.Gender
                                    </span>
                                </td>

                                <td>
                                    <span class="fw-bold text-muted">
                                        @(cls.Students?.Count ?? 0) @Localizer["Enrolled"]
                                    </span>
                                </td>

                                <td>
                                    @if (cls.IsMeetingActive)
                                    {
                                        <span class="t-badge t-badge-present">
                                            <i class="bx bx-broadcast me-1"></i> @Localizer["Active"]
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="t-badge" style="background: var(--t-surface-muted); color: var(--t-text-subtle);">
                                            <i class="bx bx-circle me-1"></i> @Localizer["Inactive"]
                                        </span>
                                    }
                                </td>

                                <td class="text-center">
                                    <div class="action-buttons justify-content-center">
                                        @if (cls.IsMeetingActive)
                                        {
                                            <a asp-area="Teacher" asp-controller="Meeting" asp-action="Room"
                                               asp-route-classId="@cls.Id" class="t-btn t-btn-sm t-btn-primary">
                                                <i class="bx bx-log-in-circle"></i>
                                                <span>@Localizer["Join"]</span>
                                            </a>
                                            <button type="button" class="t-btn t-btn-sm t-btn-danger"
                                                    onclick="showEndMeetingModal('@cls.Id')">
                                                <i class="bx bx-stop-circle"></i>
                                                <span>@Localizer["End"]</span>
                                            </button>
                                        }
                                        else
                                        {
                                            <form asp-action="StartMeeting" asp-route-classId="@cls.Id" method="post"
                                                  class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="t-btn t-btn-sm t-btn-primary">
                                                    <i class="bx bx-play-circle"></i>
                                                    <span>@Localizer["StartAndJoin"]</span>
                                                </button>
                                            </form>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <div class="t-empty-state mt-4">
            <div class="t-empty-icon"><i class="bx bx-video-off"></i></div>
            <h4 class="t-empty-title">@Localizer["NoClassesFound"]</h4>
            <p class="t-empty-text">@Localizer["NoClassesAssigned"]</p>
        </div>
    }
</div>

<!-- End Meeting Modal -->
<div id="endMeetingModal" class="modal-overlay">
    <div class="modal-content t-card" style="max-width: 440px; margin: auto; padding: 1.75rem; text-align: center;">
        <div class="t-empty-icon mx-auto mb-3" style="background: var(--t-absent-bg); color: var(--t-absent);">
            <i class="bx bx-error-circle"></i>
        </div>
        <h3 class="modal-title h5 fw-bold mb-2">@Localizer["EndMeeting"]</h3>
        <p class="modal-description text-muted small mb-4">
            @Localizer["EndMeetingConfirm"]
        </p>
        <div class="d-flex gap-2 justify-content-center">
            <button type="button" class="t-btn t-btn-outline" onclick="closeEndMeetingModal()">
                <i class="bx bx-arrow-back"></i>
                <span>@Localizer["Cancel"]</span>
            </button>
            <form id="endMeetingForm" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="t-btn t-btn-danger">
                    <i class="bx bx-stop-circle"></i>
                    <span>@Localizer["EndMeeting"]</span>
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    let currentClassId = null;

    function showEndMeetingModal(classId) {
        currentClassId = classId;
        const modal = document.getElementById('endMeetingModal');
        const form = document.getElementById('endMeetingForm');

        // Set the form action
        form.action = '@Url.Action("EndMeeting", "TeacherClasses", new { area = "Teacher" })' + '?classId=' + classId;

        if (modal) {
            modal.classList.add('active');
        }
    }

    function closeEndMeetingModal() {
        const modal = document.getElementById('endMeetingModal');
        if (modal) {
            modal.classList.remove('active');
        }
        currentClassId = null;
    }

    // Close modal when clicking outside
    document.addEventListener('click', function (e) {
        const modal = document.getElementById('endMeetingModal');
        if (e.target === modal) {
            closeEndMeetingModal();
        }
    });
</script>