@using Hafiz.Common.Helper
@using Hafiz.DTOs.Matn
@using Hafiz.Domain.Enums
@using Hafiz.Models
@model Hafiz.Application.Common.PagedResult<Hafiz.Models.WirdAssignment>
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;

    var isMatnClass = (ViewBag.IsMatnClass as bool?) == true;
    var className = ViewBag.ClassName as string ?? "الشعبة";
    var studyProgramName = ViewBag.StudyProgramName as string;
    var totalCount = (int)(ViewBag.TotalCount ?? 0);
    var todayCount = (int)(ViewBag.TodayCount ?? 0);
    var unratedCount = (int)(ViewBag.UnratedCount ?? 0);
    var completedCount = (int)(ViewBag.CompletedCount ?? 0);
    var upcomingCount = (int)(ViewBag.UpcomingCount ?? 0);

    var matnAssignments = ViewBag.MatnAssignments as Hafiz.Application.Common.PagedResult<MatnAssignmentDto>;
    var matnItems = matnAssignments?.Items ?? new List<MatnAssignmentDto>();
}

<link rel="stylesheet" href="~/css/teacher/shared.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/drawer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/Wirds.css" asp-append-version="true" />

@* Token for fetch requests *@
@Html.AntiForgeryToken()

<div class="wirds-page-wrapper">

    <!-- HERO BANNER -->
    <div class="wird-hero-banner">
        <div class="wird-hero-left">
            <div class="wird-hero-icon @(isMatnClass ? "matn-theme" : "quran-theme")">
                <i class='bx @(isMatnClass ? "bx-bookmarks" : "bx-book-open")'></i>
            </div>
            <div class="wird-hero-details">
                <div class="d-flex align-items-center gap-2 flex-wrap mb-1">
                    <h2>@className</h2>
                    @if (isMatnClass)
                    {
                        <span class="t-badge t-badge-matn">
                            <i class='bx bx-bookmark-alt'></i>
                            @(studyProgramName ?? "حلقة متون علمية")
                        </span>
                    }
                    else if (!string.IsNullOrEmpty(studyProgramName))
                    {
                        <span class="t-badge t-badge-quran">
                            <i class='bx bx-check-double'></i>
                            @studyProgramName
                        </span>
                    }
                </div>
                <div class="wird-hero-stats">
                    <span class="wird-stat-chip total" title="إجمالي التسميعات المسجلة">
                        <i class='bx bx-list-check'></i>
                        <span>إجمالي التسميع: <strong>@totalCount</strong></span>
                    </span>
                    <span class="wird-stat-chip today @(todayCount > 0 ? "has-data" : "")" title="التسميعات المسجلة اليوم">
                        <i class='bx bx-calendar-check'></i>
                        <span>تسميع اليوم: <strong>@todayCount</strong></span>
                    </span>
                    <span class="wird-stat-chip unrated @(unratedCount > 0 ? "has-unrated" : "")" title="تسميعات بانتظار رصد التقييم">
                        <i class='bx bx-time-five'></i>
                        <span>بانتظار التقييم: <strong>@unratedCount</strong></span>
                    </span>
                    <span class="wird-stat-chip completed" title="تسميعات تم تقييمها بنجاح">
                        <i class='bx bx-check-circle'></i>
                        <span>المكتملة: <strong>@completedCount</strong></span>
                    </span>
                    @if (upcomingCount > 0)
                    {
                        <span class="wird-stat-chip upcoming" title="أوراد قادمة ومجدولة">
                            <i class='bx bx-alarm'></i>
                            <span>قادمة: <strong>@upcomingCount</strong></span>
                        </span>
                    }
                </div>
            </div>
        </div>

        <div class="wird-hero-actions">
            @if (isMatnClass)
            {
                <button type="button" class="t-btn t-btn-matn" onclick="openAssignMatnModal('', '')">
                    <i class='bx bx-plus'></i>
                    <span>تسميع متن جديد</span>
                </button>
            }
            else
            {
                <button type="button" class="t-btn t-btn-primary" onclick="openWirdModal('', '')">
                    <i class='bx bx-plus'></i>
                    <span>إضافة ورد قرآني</span>
                </button>
            }
            <a class="t-btn t-btn-outline t-btn-change-class" asp-action="Index" asp-controller="Home" title="التبديل إلى حلقة أخرى">
                <i class='bx bx-transfer-alt'></i>
                <span>تغيير الحلقة</span>
            </a>
        </div>
    </div>

    <!-- WORKFLOW QUICK-FILTER TABS -->
    <div class="wird-tabs-segmented" role="tablist">
        <button type="button" class="wird-tab-pill active" data-filter="all" onclick="filterWirdByWorkflow('all', this)">
            <i class='bx bx-grid-alt'></i>
            <span>الكل</span>
            <span class="wird-tab-count">@totalCount</span>
        </button>

        <button type="button" class="wird-tab-pill tab-unrated @(unratedCount > 0 ? "has-unrated" : "")" data-filter="unrated" onclick="filterWirdByWorkflow('unrated', this)">
            <i class='bx bx-time-five'></i>
            <span>بانتظار التقييم</span>
            <span class="wird-tab-count unrated-count">@unratedCount</span>
        </button>

        <button type="button" class="wird-tab-pill tab-today @(todayCount > 0 ? "has-today" : "")" data-filter="today" onclick="filterWirdByWorkflow('today', this)">
            <i class='bx bx-calendar-check'></i>
            <span>مسجلة اليوم</span>
            <span class="wird-tab-count today-count">@todayCount</span>
        </button>

        <button type="button" class="wird-tab-pill tab-completed" data-filter="completed" onclick="filterWirdByWorkflow('completed', this)">
            <i class='bx bx-check-circle'></i>
            <span>المكتملة</span>
            <span class="wird-tab-count completed-count">@completedCount</span>
        </button>

        @if (upcomingCount > 0)
        {
            <button type="button" class="wird-tab-pill tab-upcoming" data-filter="upcoming" onclick="filterWirdByWorkflow('upcoming', this)">
                <i class='bx bx-alarm'></i>
                <span>أوراد قادمة</span>
                <span class="wird-tab-count upcoming-count">@upcomingCount</span>
            </button>
        }
    </div>

    <!-- FILTER BAR -->
    <div class="filter-bar">
        <div class="filter-bar-header">
            <div class="filter-bar-left">
                <i class='bx bx-filter-alt'></i>
                <div class="filter-search-wrapper">
                    <i class='bx bx-search'></i>
                    <input type="text" id="filterStudent" class="filter-search-input" placeholder="ابحث باسم الطالب...">
                </div>
            </div>
            <div class="filter-bar-right">
                <div class="results-count" id="resultsCount">
                    <strong>@totalCount</strong> تسميع
                </div>
                <button class="filter-toggle" id="filterToggle" title="خيارات الفلترة">
                    <i class='bx bx-chevron-down'></i>
                </button>
            </div>
        </div>

        <div class="filter-content" id="filterContent" style="display: none;">
            <div class="filter-row">
                <div class="filter-group">
                    <label class="filter-label" for="filterType">نوع التسميع</label>
                    <select id="filterType" class="filter-select">
                        <option value="">كل الأنواع</option>
                        @if (isMatnClass)
                        {
                            <option value="حفظ جديد">حفظ جديد (متن)</option>
                            <option value="مراجعة">مراجعة (متن)</option>
                            <option value="مدارسة">مدارسة (متن)</option>
                        }
                        else
                        {
                            <option value="Hafiz">@Localizer["Hafiz"]</option>
                            <option value="Wird">@Localizer["Wird"]</option>
                            <option value="Revision">@Localizer["Revision"]</option>
                            <option value="Memorization">@Localizer["Memorization"]</option>
                            <option value="Tajwid">@Localizer["Tajwid"]</option>
                        }
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label" for="filterStatus">التقييم</label>
                    <select id="filterStatus" class="filter-select">
                        <option value="">كل التقييمات</option>
                        <option value="notset">لم يُقيّم بعد</option>
                        <option value="poor">@Localizer["Poor"]</option>
                        <option value="fair">@Localizer["Fair"]</option>
                        <option value="good">@Localizer["Good"]</option>
                        <option value="verygood">@Localizer["VeryGood"]</option>
                        <option value="excellent">@Localizer["Excellent"]</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label" for="filterUpcoming">حالة الورد</label>
                    <select id="filterUpcoming" class="filter-select">
                        <option value="">الكل</option>
                        <option value="true">أوراد قادمة فقط</option>
                        <option value="false">أوراد حالية ومسجلة</option>
                    </select>
                </div>

                <div class="filter-group">
                    <label class="filter-label" for="filterDateFrom">من تاريخ</label>
                    <input type="date" id="filterDateFrom" class="filter-input" value="@ViewBag.FromDate">
                </div>

                <div class="filter-group">
                    <label class="filter-label" for="filterDateTo">إلى تاريخ</label>
                    <input type="date" id="filterDateTo" class="filter-input" value="@ViewBag.ToDate">
                </div>

                <div class="filter-actions">
                    <button class="t-btn t-btn-primary btn-apply" id="applyFilters">@Localizer["ApplyFilters"]</button>
                    <button class="t-btn t-btn-outline btn-reset" id="resetFilters">@Localizer["Reset"]</button>
                </div>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="t-toast t-toast-success alert-dismissible" role="alert" id="successAlert">
            <i class="bx bx-check-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert" id="errorAlert">
            <i class="bx bx-error-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (isMatnClass)
    {
        <!-- MATN ASSIGNMENTS TAB CONTENT -->
        <div id="matnCardsContainer">
            @if (matnItems.Any())
            {
                <div class="wird-cards-grid" id="wirdCardsGrid">
                    @foreach (var item in matnItems)
                    {
                        @await Html.PartialAsync("_MatnCard", item)
                    }
                </div>

                <div id="noCardsMatchFilter" class="t-empty-state" style="display: none; margin-top: 1.5rem;">
                    <div class="t-empty-icon" style="background: var(--t-surface-muted); color: var(--t-text-muted);">
                        <i class='bx bx-filter-alt'></i>
                    </div>
                    <h4 class="t-empty-title">لا توجد تسميعات تطابق هذا الفلتر</h4>
                    <p class="t-empty-text">جرّب اختيار فلتر آخر أو إعادة ضبط خيارات البحث.</p>
                    <button type="button" class="t-btn t-btn-outline" onclick="document.getElementById('resetFilters').click()">
                        <i class='bx bx-reset'></i>
                        <span>عرض الكل</span>
                    </button>
                </div>

                @if (matnAssignments != null)
                {
                    <div id="paginationWrap">
                        @await Html.PartialAsync("_Pagination", matnAssignments)
                    </div>
                }
            }
            else
            {
                <div class="t-empty-state">
                    <div class="t-empty-icon" style="background: var(--t-matn-light); color: var(--t-matn);">
                        <i class='bx bx-bookmarks'></i>
                    </div>
                    <h4 class="t-empty-title">لا توجد تسميعات متون مسجلة لهذه الحلقة</h4>
                    <p class="t-empty-text">
                        يمكنك استخدام زر "تسميع متن جديد" لرصد حفظ أو مراجعة المتون العلمية لطلاب هذه الحلقة بسهولة.
                    </p>
                    <button type="button" class="t-btn t-btn-matn" onclick="openAssignMatnModal('', '')">
                        <i class='bx bx-plus'></i>
                        <span>رصد أول تسميع متن</span>
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <!-- QURAN ASSIGNMENTS TAB CONTENT -->
        <div id="quranCardsContainer">
            @if (Model != null && Model.Items.Any())
            {
                <div class="wird-cards-grid" id="wirdCardsGrid">
                    @foreach (var item in Model.Items)
                    {
                        @await Html.PartialAsync("_WirdCard", item)
                    }
                </div>

                <div id="noCardsMatchFilter" class="t-empty-state" style="display: none; margin-top: 1.5rem;">
                    <div class="t-empty-icon" style="background: var(--t-surface-muted); color: var(--t-text-muted);">
                        <i class='bx bx-filter-alt'></i>
                    </div>
                    <h4 class="t-empty-title">لا توجد أوراد تطابق هذا الفلتر</h4>
                    <p class="t-empty-text">جرّب اختيار فلتر آخر أو إعادة ضبط خيارات البحث.</p>
                    <button type="button" class="t-btn t-btn-outline" onclick="document.getElementById('resetFilters').click()">
                        <i class='bx bx-reset'></i>
                        <span>عرض الكل</span>
                    </button>
                </div>

                <div id="paginationWrap">
                    @await Html.PartialAsync("_Pagination", Model)
                </div>
            }
            else
            {
                <div class="t-empty-state">
                    <div class="t-empty-icon">
                        <i class='bx bx-book-open'></i>
                    </div>
                    <h4 class="t-empty-title">لا توجد أوراد قرآنية مسجلة لهذه الحلقة</h4>
                    <p class="t-empty-text">
                        لم يتم رصد أي أوراد حفظ أو مراجعة للقرآن الكريم في هذه الحلقة بعد.
                    </p>
                    <button type="button" class="t-btn t-btn-primary" onclick="openWirdModal('', '')">
                        <i class='bx bx-plus'></i>
                        <span>إضافة أول ورد قرآني</span>
                    </button>
                </div>
            }
        </div>
    }

</div>

<script>
    window.allClassStudents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllClassStudents ?? new List<object>()));
    window.currentWorkflowFilter = 'all';

    function filterWirdByWorkflow(filterType, pillBtn) {
        window.currentWorkflowFilter = filterType;

        // 1. Update active tab UI
        document.querySelectorAll('.wird-tabs-segmented .wird-tab-pill').forEach(btn => btn.classList.remove('active'));
        if (pillBtn) {
            pillBtn.classList.add('active');
        } else {
            const matchBtn = document.querySelector(`.wird-tabs-segmented [data-filter="${filterType}"]`);
            if (matchBtn) matchBtn.classList.add('active');
        }

        // 2. Trigger filter execution
        const applyBtn = document.getElementById('applyFilters');
        if (applyBtn) {
            applyBtn.click();
        }
    }
</script>

@section scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/teacher_portal/wirds.js" asp-append-version="true"></script>
    <script src="~/js/teacher_portal/wirdFIlter.js" asp-append-version="true"></script>
    <script src="~/js/wird/wirdDeletionConfirm.js" asp-append-version="true"></script>
    <script src="~/js/wird/updateStatusCard.js" asp-append-version="true"></script>
}

<!-- Include the modals -->
@await Html.PartialAsync("_EditWirdModal", new WirdAssignment())
@await Html.PartialAsync("_EditMatnModal")
@await Html.PartialAsync("_AssignMatnModal")
@await Html.PartialAsync("_AssignWirdModal", new WirdAssignment())