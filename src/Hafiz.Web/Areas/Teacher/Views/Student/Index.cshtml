@using Hafiz.Models
@using Hafiz.Models.enums
@using Hafiz.Common.Helper
@model Hafiz.Application.Common.PagedResult<Student>

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var pageTitle = Localizer["PageTitle"].Value;

    var classId = ViewBag.ClassId != null ? Guid.Parse(ViewBag.ClassId.ToString()) : Guid.Empty;
    var className = ViewBag.ClassName as string ?? Localizer["Students"].Value;

    var students = Model?.Items ?? new List<Student>();
    var totalStudents = ViewBag.TotalStudents ?? Model?.TotalCount ?? 0;
    var boysCount = ViewBag.BoysCount ?? 0;
    var girlsCount = ViewBag.GirlsCount ?? 0;
    var isArabic = System.Threading.Thread.CurrentThread.CurrentCulture.Name.StartsWith("ar");
    var matnCounts = ViewBag.MatnCountsByStudent as Dictionary<Guid, (int active, int completed)>;
    var matnTodayCounts = ViewBag.MatnTodayCountsByStudent as Dictionary<Guid, int>;
    var matnUnratedCounts = ViewBag.MatnUnratedCountsByStudent as Dictionary<Guid, int>;
    var quranTodayCounts = ViewBag.QuranTodayCountsByStudent as Dictionary<Guid, int>;
    var quranUnratedCounts = ViewBag.QuranUnratedCountsByStudent as Dictionary<Guid, int>;
    var isMatnClass = ViewBag.IsMatnClass == true;
    var userToday = TimeZoneHelper.GetUserToday(Context);
}

<link rel="stylesheet" href="~/css/teacher/Students.css" asp-append-version="true" />

<div class="students-page">

    <!-- Class Header Banner -->
    <div class="class-header">
        <div class="class-header-left">
            <div class="class-header-title">
                <div class="class-header-icon-box @(isMatnClass ? "matn-icon" : "quran-icon")">
                    <i class='bx @(isMatnClass ? "bx-bookmarks" : "bx-book-reader")'></i>
                </div>
                <div>
                    <div class="class-title-row">
                        <h2>@className</h2>
                        @if (isMatnClass)
                        {
                            <span class="t-badge t-badge-matn">
                                <i class='bx bx-bookmarks'></i>
                                @(ViewBag.StudyProgramName ?? "حلقة متون علمية")
                            </span>
                        }
                        else
                        {
                            <span class="t-badge t-badge-quran">
                                <i class='bx bx-book-open'></i>
                                @(ViewBag.StudyProgramName ?? "حلقة قرآن كريم")
                            </span>
                        }
                    </div>
                    <div class="class-meta-row">
                        <span class="meta-pill total">
                            <i class='bx bx-group'></i> @totalStudents @Localizer["Students"]
                        </span>
                        @if (totalStudents > 0)
                        {
                            @if (boysCount > 0)
                            {
                                <span class="meta-pill boy">
                                    <i class='bx bx-male'></i> @boysCount @Localizer["Boys"]
                                </span>
                            }
                            @if (girlsCount > 0)
                            {
                                <span class="meta-pill girl">
                                    <i class='bx bx-female'></i> @girlsCount @Localizer["Girls"]
                                </span>
                            }
                        }
                    </div>
                </div>
            </div>
        </div>
        <a class="change-class-btn t-btn t-btn-outline" asp-action="Index" asp-controller="Home">
            <i class='bx bx-transfer-alt'></i>
            <span>@Localizer["ChangeClass"]</span>
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="t-toast t-toast-success alert-dismissible" role="alert" id="successAlert">
            <i class="bx bx-check-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="t-toast t-toast-error alert-dismissible" role="alert" id="errorAlert">
            <i class="bx bx-error-circle" style="font-size: 1.3rem;"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    @if (totalStudents > 0)
    {
        <!-- Actionable Records Toolbar -->
        <div class="students-toolbar">
            <div class="toolbar-top-row">
                <div class="search-wrapper">
                    <i class='bx bx-search search-icon'></i>
                    <input id="studentSearch" type="text" class="search-input" placeholder="@Localizer["SearchPlaceholder"]"
                           autocomplete="off" />
                </div>
                @if (students.Any())
                {
                    <button type="button" class="t-btn @(isMatnClass ? "t-btn-matn" : "t-btn-primary") quick-recite-btn"
                            onclick="startSequentialRecitation()" title="بدء جلسة تسميع متتابعة تبدأ بأول طالب">
                        <i class='bx bx-play-circle'></i>
                        <span>بدء التسميع السريع</span>
                    </button>
                }
            </div>

            <!-- Quick Filter Chips by Today's Status -->
            <div class="records-filter-tabs">
                <button type="button" class="filter-tab active" data-filter="all">
                    الكل <span class="filter-count">@totalStudents</span>
                </button>
                <button type="button" class="filter-tab tab-recorded-today" data-filter="recorded">
                    <i class='bx bx-check-circle'></i> مسجلة اليوم
                </button>
                <button type="button" class="filter-tab tab-pending-today" data-filter="pending">
                    <i class='bx bx-time-five'></i> لم تسجل اليوم
                </button>
                @if (students.Any(s => WirdPageCalculator.IsHafiz(s)))
                {
                    <button type="button" class="filter-tab" data-filter="hafiz">
                        الحفّاظ ⭐
                    </button>
                }
            </div>
        </div>
    }

    <!-- High-Efficiency Records View (Mobile / Tablet Cards) -->
    <div class="students-records-list" id="studentsGrid">
        @{
            int mobileIdx = 0;
        }
        @foreach (Student student in students)
        {
            if (student == null) continue;
            mobileIdx++;
            var isMatn = isMatnClass;
            int mActive = 0, mCompleted = 0, mUnrated = 0;
            if (isMatn && matnCounts != null && matnCounts.ContainsKey(student.UserId))
            {
                var mc = matnCounts[student.UserId];
                mActive = mc.active;
                mCompleted = mc.completed;
            }
            if (isMatn && matnUnratedCounts != null && matnUnratedCounts.ContainsKey(student.UserId))
            {
                mUnrated = matnUnratedCounts[student.UserId];
            }
            else if (isMatn)
            {
                mUnrated = mActive;
            }

            // Calculate ONLY Today's Recorded Wirds safely across timezones
            var todayWirdsCount = isMatn
                ? (matnTodayCounts != null && matnTodayCounts.ContainsKey(student.UserId) ? matnTodayCounts[student.UserId] : 0)
                : (quranTodayCounts != null && quranTodayCounts.ContainsKey(student.UserId)
                    ? quranTodayCounts[student.UserId]
                    : (student.wirds?.Count(w => 
                        w.AssignedDate.Date == userToday 
                        || w.AssignedDate.Date == DateTime.Today 
                        || w.AssignedDate.Date == DateTime.UtcNow.Date 
                        || w.AssignedDate.ToLocalTime().Date == userToday 
                        || w.AssignedDate.ToLocalTime().Date == DateTime.Today) ?? 0));
            var hasRecordedToday = todayWirdsCount > 0;

            var firstName = student.StudentInfo?.FirstName ?? string.Empty;
            var secondName = student.StudentInfo?.SecondName ?? string.Empty;
            var studentFullName = $"{firstName} {secondName}".Trim();
            var initials = ((firstName.Length > 0 ? firstName[0].ToString() : "")
                            + (secondName.Length > 0 ? secondName[0].ToString() : "")).ToUpper();
            var genderClass = student.sex == Sex.female ? "female" : "male";
            var tajwidClass = student.TajwidLevel.ToString().ToLower();
            var totalMemPages = WirdPageCalculator.TotalMemorizedPages(student);
            var (memJuzDisplay, memPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(totalMemPages);
            var isHafizCard = WirdPageCalculator.IsHafiz(student);
            var searchKey = studentFullName.ToLower();
            var hasTajwid = student.TajwidLevel != TajwidLevel.none;

            <div class="student-card student-record-row"
                 data-id="@student.UserId"
                 data-name="@searchKey"
                 data-full-name="@studentFullName"
                 data-level="@student.TajwidLevel"
                 data-today-recorded="@(hasRecordedToday ? "true" : "false")"
                 data-active="@(hasRecordedToday ? "true" : "false")"
                 data-hafiz="@(isHafizCard ? "true" : "false")">

                <div class="record-stripe stripe-@genderClass"></div>

                <div class="record-body">
                    <!-- Avatar & Primary Info -->
                    <div class="record-main-block">
                        <div class="record-avatar avatar-@genderClass" aria-hidden="true">
                            @if (!string.IsNullOrWhiteSpace(initials))
                            {
                                <span>@initials</span>
                            }
                            else
                            {
                                <i class='bx bx-user'></i>
                            }
                        </div>
                        <div class="record-identity">
                            <div class="record-name-wrap">
                                <a asp-action="Details" asp-route-id="@student.UserId" class="record-name" title="@studentFullName">
                                    @studentFullName
                                </a>
                                @if (isHafizCard)
                                {
                                    <span class="record-badge badge-hafiz" title="@Localizer["Hafiz"]">
                                        <i class='bx bxs-award'></i> حافظ
                                    </span>
                                }
                                @if (hasTajwid)
                                {
                                    <span class="record-badge badge-tajwid tajwid-@tajwidClass">
                                        @Localizer[student.TajwidLevel.ToString()]
                                    </span>
                                }
                            </div>

                            <div class="record-subline">
                                @if (!isMatnClass)
                                {
                                    <span class="record-stat-pill" title="مقدار الحفظ">
                                        <i class='bx bx-book-bookmark'></i>
                                        <strong>@memJuzDisplay/30</strong> جزء
                                        @if (memPagesRemainder > 0)
                                        {
                                            <small>(+@memPagesRemainder.ToString("0.#") ص)</small>
                                        }
                                    </span>
                                }
                                else
                                {
                                    @if (mUnrated > 0)
                                    {
                                        <span class="unrated-wird-pill warning" title="@mUnrated أوراد بانتظار التقييم">
                                            <i class='bx bx-time-five'></i> @mUnrated بانتظار التقييم
                                        </span>
                                    }
                                    else if (mCompleted > 0)
                                    {
                                        <span class="unrated-wird-pill success" title="تم تقييم جميع الأوراد (@mCompleted منجز)">
                                            <i class='bx bx-check-double'></i> الكل مقيّم (@mCompleted)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="unrated-wird-pill muted" title="لا توجد أوراد معلقة">
                                            <i class='bx bx-minus'></i> لا توجد أوراد
                                        </span>
                                    }
                                }

                                @if (hasRecordedToday)
                                {
                                    <span class="record-status-pill status-recorded-today" title="تم تسجيل @todayWirdsCount ورد لهذا الطالب اليوم">
                                        <i class='bx bx-check-circle'></i> @todayWirdsCount مسجلة اليوم
                                    </span>
                                }
                                else
                                {
                                    <span class="record-status-pill status-not-recorded" title="لم يتم تسجيل أي ورد لهذا الطالب اليوم">
                                        <i class='bx bx-time-five'></i> لم يُسجّل اليوم
                                    </span>
                                }
                            </div>
                        </div>
                    </div>

                    <!-- Direct Action Buttons -->
                    <div class="record-actions-block">
                        @if (!isMatnClass)
                        {
                            <button type="button" class="rec-btn rec-btn-primary"
                                    onclick="openWirdModal('@student.UserId', '@studentFullName')"
                                    title="@Localizer["AddWird"]">
                                <i class='bx bx-plus'></i>
                                <span>تسميع ورد</span>
                            </button>
                            <button type="button" class="rec-btn rec-btn-plan"
                                    onclick="openStudentPlanModal('@student.UserId', '@studentFullName', '@student.TajwidLevel')"
                                    title="@Localizer["StudentRoutinePlan"]">
                                <i class='bx bx-calendar-star'></i>
                                <span>الخطة</span>
                            </button>
                        }
                        else
                        {
                            <button type="button" class="rec-btn rec-btn-matn"
                                    onclick="openAssignMatnModal('@student.UserId', '@studentFullName')"
                                    title="تسميع أو إسناد المتن">
                                <i class='bx bx-bookmarks'></i>
                                <span>تسميع المتن</span>
                            </button>
                        }

                        <a asp-action="Details" asp-route-id="@student.UserId"
                           class="rec-btn-icon"
                           title="@Localizer["ViewDetails"]">
                            <i class='bx bx-show'></i>
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>

    <!-- Desktop High-Density Records Table -->
    <div class="students-table-wrap" id="studentsTableWrap">
        <table class="students-table">
            <thead>
                <tr>
                    <th class="col-num">#</th>
                    <th class="col-student">@Localizer["Students"]</th>
                    <th class="col-juz">@(isMatnClass ? "أوراد بانتظار التقييم" : "مقدار الحفظ")</th>
                    <th class="col-active">تسميع اليوم</th>
                    <th class="col-actions">الإجراءات المباشرة</th>
                </tr>
            </thead>
            <tbody>
                @{
                    int rowIdx = 0;
                }
                @foreach (Student student in students)
                {
                    if (student == null) continue;
                    rowIdx++;
                    var isMatnRow = isMatnClass;
                    int rActiveCount = 0, rCompletedCount = 0, rUnratedCount = 0;
                    if (isMatnRow && matnCounts != null && matnCounts.ContainsKey(student.UserId))
                    {
                        var mc = matnCounts[student.UserId];
                        rActiveCount = mc.active;
                        rCompletedCount = mc.completed;
                    }
                    if (isMatnRow && matnUnratedCounts != null && matnUnratedCounts.ContainsKey(student.UserId))
                    {
                        rUnratedCount = matnUnratedCounts[student.UserId];
                    }
                    else if (isMatnRow)
                    {
                        rUnratedCount = rActiveCount;
                    }

                    // Calculate ONLY Today's Recorded Wirds safely across timezones
                    var rTodayWirdsCount = isMatnRow
                        ? (matnTodayCounts != null && matnTodayCounts.ContainsKey(student.UserId) ? matnTodayCounts[student.UserId] : 0)
                        : (quranTodayCounts != null && quranTodayCounts.ContainsKey(student.UserId)
                            ? quranTodayCounts[student.UserId]
                            : (student.wirds?.Count(w => 
                                w.AssignedDate.Date == userToday 
                                || w.AssignedDate.Date == DateTime.Today 
                                || w.AssignedDate.Date == DateTime.UtcNow.Date 
                                || w.AssignedDate.ToLocalTime().Date == userToday 
                                || w.AssignedDate.ToLocalTime().Date == DateTime.Today) ?? 0));
                    var rHasRecordedToday = rTodayWirdsCount > 0;

                    var rFirstName = student.StudentInfo?.FirstName ?? string.Empty;
                    var rSecondName = student.StudentInfo?.SecondName ?? string.Empty;
                    var rFullName = $"{rFirstName} {rSecondName}".Trim();
                    var rInitials = ((rFirstName.Length > 0 ? rFirstName[0].ToString() : "")
                                     + (rSecondName.Length > 0 ? rSecondName[0].ToString() : "")).ToUpper();
                    var rGenderClass = student.sex == Sex.female ? "female" : "male";
                    var rTajwidClass = student.TajwidLevel.ToString().ToLower();
                    var rTotalMemPages = WirdPageCalculator.TotalMemorizedPages(student);
                    var (rMemJuzDisplay, rMemPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(rTotalMemPages);
                    var rJuzPercent = Math.Min(100, (int)((double)rTotalMemPages / WirdPageCalculator.TotalQuranPages * 100));
                    var rIsHafiz = WirdPageCalculator.IsHafiz(student);
                    var rSearchKey = rFullName.ToLower();
                    var rHasTajwid = student.TajwidLevel != TajwidLevel.none;

                    <tr class="student-row"
                        data-id="@student.UserId"
                        data-name="@rSearchKey"
                        data-full-name="@rFullName"
                        data-level="@student.TajwidLevel"
                        data-today-recorded="@(rHasRecordedToday ? "true" : "false")"
                        data-active="@(rHasRecordedToday ? "true" : "false")"
                        data-hafiz="@(rIsHafiz ? "true" : "false")">
                        <td class="col-num">
                            <span class="row-index">@rowIdx</span>
                        </td>
                        <td class="col-student">
                            <div class="row-student">
                                <div class="row-avatar avatar-@rGenderClass" aria-hidden="true">
                                    @if (!string.IsNullOrWhiteSpace(rInitials))
                                    {
                                        <span>@rInitials</span>
                                    }
                                    else
                                    {
                                        <i class='bx bx-user'></i>
                                    }
                                </div>
                                <div class="row-identity">
                                    <div class="row-name-line">
                                        <a asp-action="Details" asp-route-id="@student.UserId" class="row-name" title="@rFullName">
                                            @rFullName
                                        </a>
                                        @if (rIsHafiz)
                                        {
                                            <span class="record-badge badge-hafiz" title="@Localizer["Hafiz"]">
                                                <i class='bx bxs-award'></i> حافظ
                                            </span>
                                        }
                                        @if (rHasTajwid)
                                        {
                                            <span class="record-badge badge-tajwid tajwid-@rTajwidClass">
                                                @Localizer[student.TajwidLevel.ToString()]
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>
                        </td>
                        <td class="col-juz">
                            @if (!isMatnRow)
                            {
                                <div class="row-juz">
                                    <div class="row-juz-meta">
                                        <span class="row-juz-value">@rMemJuzDisplay <span class="row-juz-total">/ 30 جزء</span></span>
                                        @if (rMemPagesRemainder > 0)
                                        {
                                            <small class="row-juz-extra">(+@rMemPagesRemainder.ToString("0.#") ص)</small>
                                        }
                                    </div>
                                    <div class="row-juz-bar" role="progressbar"
                                         aria-valuenow="@rMemJuzDisplay" aria-valuemin="0" aria-valuemax="30">
                                        <div class="row-juz-fill" style="width: @rJuzPercent%"></div>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="row-matn-meta">
                                    @if (rUnratedCount > 0)
                                    {
                                        <span class="unrated-wird-pill warning" title="@rUnratedCount أوراد بانتظار التقييم">
                                            <i class='bx bx-time-five'></i> @rUnratedCount بانتظار التقييم
                                        </span>
                                    }
                                    else if (rCompletedCount > 0)
                                    {
                                        <span class="unrated-wird-pill success" title="تم تقييم جميع الأوراد (@rCompletedCount منجز)">
                                            <i class='bx bx-check-double'></i> الكل مقيّم (@rCompletedCount)
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="unrated-wird-pill muted" title="لا توجد أوراد معلقة">
                                            <i class='bx bx-minus'></i> لا توجد أوراد
                                        </span>
                                    }
                                </div>
                            }
                        </td>
                        <td class="col-active">
                            @if (rHasRecordedToday)
                            {
                                <span class="record-status-pill status-recorded-today" title="تم تسجيل @rTodayWirdsCount أوراد لهذا الطالب اليوم">
                                    <i class='bx bx-check-circle'></i> @rTodayWirdsCount مسجلة اليوم
                                </span>
                            }
                            else
                            {
                                <span class="record-status-pill status-not-recorded" title="لم يتم تسجيل أي ورد لهذا الطالب اليوم">
                                    <i class='bx bx-time-five'></i> لم يُسجّل اليوم
                                </span>
                            }
                        </td>
                        <td class="col-actions">
                            <div class="row-actions">
                                @if (!isMatnRow)
                                {
                                    <button type="button" class="rec-btn rec-btn-primary rec-btn-sm"
                                            title="@Localizer["AddWird"]"
                                            onclick="openWirdModal('@student.UserId', '@rFullName')">
                                        <i class='bx bx-plus'></i>
                                        <span>تسميع ورد</span>
                                    </button>
                                    <button type="button" class="rec-btn rec-btn-plan rec-btn-sm"
                                            title="@Localizer["StudentRoutinePlan"]"
                                            onclick="openStudentPlanModal('@student.UserId', '@rFullName', '@student.TajwidLevel')">
                                        <i class='bx bx-calendar-star'></i>
                                        <span>الخطة</span>
                                    </button>
                                }
                                else
                                {
                                    <button type="button" class="rec-btn rec-btn-matn rec-btn-sm"
                                            title="تسميع أو إسناد المتن"
                                            onclick="openAssignMatnModal('@student.UserId', '@rFullName')">
                                        <i class='bx bx-bookmarks'></i>
                                        <span>تسميع المتن</span>
                                    </button>
                                }
                                <a asp-action="Details" asp-route-id="@student.UserId"
                                   class="rec-btn-icon"
                                   title="@Localizer["ViewDetails"]">
                                    <i class='bx bx-show'></i>
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    @await Html.PartialAsync("_Pagination", Model)

    <!-- Empty States -->
    <div class="students-empty" id="studentsEmpty" style="display: @(totalStudents == 0 ? "flex" : "none");">
        <div class="empty-icon"><i class='bx bx-user-x'></i></div>
        <h3>@Localizer["NoStudents"]</h3>
        <p>@Localizer["NoStudentsSubtitle"]</p>
    </div>

    <div class="students-empty no-match" id="studentsNoMatch" style="display: none;">
        <div class="empty-icon"><i class='bx bx-search-alt'></i></div>
        <h3>@Localizer["NoMatch"]</h3>
        <p class="text-muted small">لم يتم العثور على طالب يطابق البحث أو الفلتر المحدد</p>
    </div>

</div>

<script>
    const lingeringPill = document.getElementById('mobileOpenPillBtn');
    if (lingeringPill) lingeringPill.remove();

    setTimeout(function () {
        const successAlert = document.getElementById('successAlert');
        const errorAlert = document.getElementById('errorAlert');

        if (successAlert) {
            successAlert.style.opacity = '0';
            setTimeout(() => successAlert.style.display = 'none', 500);
        }
        if (errorAlert) {
            errorAlert.style.opacity = '0';
            setTimeout(() => errorAlert.style.display = 'none', 500);
        }
    }, 5000);

    // Filter and Search System for Records (Today's Recitation Status)
    (function () {
        const searchInput = document.getElementById('studentSearch');
        const filterTabs = document.querySelectorAll('.records-filter-tabs .filter-tab');
        const cards = document.querySelectorAll('#studentsGrid .student-card');
        const rows = document.querySelectorAll('#studentsTableWrap .student-row');
        const noMatch = document.getElementById('studentsNoMatch');
        const grid = document.getElementById('studentsGrid');
        const tableWrap = document.getElementById('studentsTableWrap');

        let activeQuery = '';
        let activeFilter = 'all';

        function matches(el) {
            const name = el.getAttribute('data-name') || '';
            const isRecorded = el.getAttribute('data-today-recorded') === 'true';
            const isHafiz = el.getAttribute('data-hafiz') === 'true';

            const matchesSearch = activeQuery === '' || name.indexOf(activeQuery) !== -1;
            let matchesTab = true;

            if (activeFilter === 'recorded') {
                matchesTab = isRecorded;
            } else if (activeFilter === 'pending') {
                matchesTab = !isRecorded;
            } else if (activeFilter === 'hafiz') {
                matchesTab = isHafiz;
            }

            return matchesSearch && matchesTab;
        }

        function applyFilters() {
            let visible = 0;
            cards.forEach(card => {
                const show = matches(card);
                card.style.display = show ? '' : 'none';
                if (show) visible++;
            });
            rows.forEach(row => {
                const show = matches(row);
                row.style.display = show ? '' : 'none';
            });

            const total = cards.length || rows.length;
            const empty = visible === 0 && total > 0;
            if (noMatch) noMatch.style.display = empty ? 'flex' : 'none';
            if (grid) grid.style.display = empty ? 'none' : '';
            if (tableWrap) tableWrap.style.display = empty ? 'none' : '';
        }

        if (searchInput) {
            searchInput.addEventListener('input', function () {
                activeQuery = this.value.trim().toLowerCase();
                applyFilters();
            });
        }

        filterTabs.forEach(tab => {
            tab.addEventListener('click', function () {
                filterTabs.forEach(t => t.classList.remove('active'));
                this.classList.add('active');
                activeFilter = this.getAttribute('data-filter') || 'all';
                applyFilters();
            });
        });

        // Expose function to start sequential recitation with first visible student
        window.startSequentialRecitation = function () {
            // Find first visible card or row
            let firstVisible = null;
            for (let i = 0; i < cards.length; i++) {
                if (cards[i].style.display !== 'none') {
                    firstVisible = cards[i];
                    break;
                }
            }
            if (!firstVisible) {
                for (let i = 0; i < rows.length; i++) {
                    if (rows[i].style.display !== 'none') {
                        firstVisible = rows[i];
                        break;
                    }
                }
            }

            if (firstVisible) {
                const studentId = firstVisible.getAttribute('data-id');
                const studentName = firstVisible.getAttribute('data-full-name');
                const isMatn = @(isMatnClass ? "true" : "false");

                if (isMatn && typeof window.openAssignMatnModal === 'function') {
                    window.openAssignMatnModal(studentId, studentName);
                } else if (typeof window.openWirdModal === 'function') {
                    window.openWirdModal(studentId, studentName);
                }
            } else {
                alert('لا يوجد طلاب مطابقين للفلتر الحالي');
            }
        };
    })();
</script>

<script>
    window.allClassStudents = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.AllClassStudents ?? new List<object>()));
</script>

<!-- Include Wird, Matn, and Routine Plan Modals -->
