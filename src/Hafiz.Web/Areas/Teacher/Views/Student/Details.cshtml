<!-- موديل الاختبار وتحديد الحالة للطالب (بتصميم أنيق وسهل الاستخدام)       -->
<!-- =================================================================== -->
<div class="teacher-matn-modal-overlay" id="teacherMatnModal" tabindex="-1" aria-hidden="true" dir="rtl" style="display: none;" onclick="if(event.target === this) closeTeacherMatnModal()">
    <div class="teacher-matn-modal-dialog">
        <div class="teacher-matn-modal-card">
            <div class="teacher-matn-modal-header">
                <h5 class="teacher-matn-modal-title">
                    <i class='bx bx-award fs-5'></i>
                    <span>تحديد حالة المتن ورصد درجة الاختبار</span>
                </h5>
                <button type="button" class="teacher-matn-modal-close" aria-label="Close" onclick="closeTeacherMatnModal()">
                    <i class='bx bx-x'></i>
                </button>
            </div>
            <form id="teacherMatnForm" onsubmit="saveTeacherMatnProgress(event)">
                @Html.AntiForgeryToken()
                <div class="teacher-matn-modal-body">
                    <input type="hidden" id="tModalStudentId" name="studentId" value="@Model.Student.UserId" />
                    <input type="hidden" id="tModalMatnId" name="matnId" />

                    <!-- بطاقة سياق الطالب والمتن ودرجة النجاح -->
                    <div class="matn-context-banner mb-3">
                        <div class="matn-context-row">
                            <span class="matn-context-label">اسم الطالب:</span>
                            <span class="matn-context-val fw-bold" id="tModalStudentName">@studentFullName</span>
                        </div>
                        <div class="matn-context-row">
                            <span class="matn-context-label">المتن المقرر:</span>
                            <span class="matn-context-val text-primary fw-bold" id="tModalMatnTitle">-</span>
                        </div>
                        <div class="matn-context-row">
                            <span class="matn-context-label">علامة النجاح المعتمدة:</span>
                            <span class="matn-context-val badge bg-info text-white" id="tModalPassingGrade">60%</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="matn-label fw-bold mb-1 d-flex align-items-center gap-1">
                                <i class='bx bx-book-open text-success'></i>
                                <span>حالة المدارسة</span>
                            </label>
                            <select id="tModalStudyStatus" name="studyStatus" class="form-select form-select-sm">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد الدراسة</option>
                                <option value="2">مكتمل</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="matn-label fw-bold mb-1 d-flex align-items-center gap-1">
                                <i class='bx bx-bookmarks text-primary'></i>
                                <span>حالة الحفظ</span>
                            </label>
                            <select id="tModalMemorizationStatus" name="memorizationStatus" class="form-select form-select-sm">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد الحفظ</option>
                                <option value="2">تم الحفظ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="matn-label fw-bold mb-1 d-flex align-items-center gap-1">
                                <i class='bx bx-check-shield text-warning'></i>
                                <span>نتيجة الاختبار</span>
                            </label>
                            <select id="tModalExamStatus" name="examStatus" class="form-select form-select-sm" onchange="onTeacherExamStatusChanged(this.value)">
                                <option value="0">لم يختبر بعد</option>
                                <option value="1">اجتاز بنجاح (ناجح)</option>
                                <option value="2">لم يجتز (راسب)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <label class="matn-label fw-bold mb-0 d-flex align-items-center gap-1">
                                    <i class='bx bx-calendar-event text-secondary'></i>
                                    <span>تاريخ الاختبار</span>
                                </label>
                                <button type="button" class="btn-today-date" onclick="setTeacherExamToday()">اليوم</button>
                            </div>
                            <input type="date" id="tModalExamDate" name="examDate" class="form-control form-control-sm" />
                        </div>

                        <!-- عنصر تفاعلي لرصد درجة الاختبار -->
                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="matn-label fw-bold mb-0 d-flex align-items-center gap-1">
                                        <i class='bx bx-award text-primary'></i>
                                        <span>درجة الاختبار (من 100)</span>
                                    </label>
                                    <span id="tScoreRatingPill" class="score-rating-pill" style="display: none;">
                                        <i class='bx bx-award'></i> <span id="tScoreRatingText">-</span>
                                    </span>
                                </div>
                                <div class="input-group">
                                    <input type="number" id="tModalScore" name="score" class="form-control"
                                           min="0" max="100" step="0.5" placeholder="مثال: 95.5"
                                           oninput="updateTeacherScoreFeedback(this.value)" />
                                    <span class="input-group-text bg-white fw-bold">%</span>
                                </div>
                                <div class="score-presets mt-2 d-flex flex-wrap gap-1 align-items-center">
                                    <span class="small text-muted me-1">درجات سريعة:</span>
                                    <button type="button" class="score-preset-btn" onclick="setTeacherScorePreset(100)">100% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setTeacherScorePreset(95)">95% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setTeacherScorePreset(85)">85% ج.جداً</button>
                                    <button type="button" class="score-preset-btn" onclick="setTeacherScorePreset(75)">75% جيد</button>
                                    <button type="button" class="score-preset-btn" onclick="setTeacherScorePreset(60)">60% مقبول</button>
                                    <button type="button" class="score-preset-btn" style="border-color: #fca5a5; color: #b91c1c; background: #fff5f5;" onclick="setTeacherScorePreset(40)">40% راسب</button>
                                    <button type="button" class="score-preset-btn preset-clear" onclick="clearTeacherScore()">مسح الدرجة</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="matn-label fw-bold mb-1 d-flex align-items-center gap-1">
                                <i class='bx bx-comment-detail text-muted'></i>
                                <span>ملاحظات المعلم / الإدارة</span>
                            </label>
                            <textarea id="tModalTeacherNotes" name="teacherNotes" class="form-control form-control-sm" rows="2"
                                      placeholder="ملاحظات حول مستوى الطالب، الإتقان، أو الاستدراك..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="teacher-matn-modal-footer">
                    <button type="button" class="matn-control-btn" onclick="closeTeacherMatnModal()">إلغاء</button>
                    <button type="submit" class="btn-grade-action px-4" id="saveTeacherProgressBtn" style="background: #16a34a;">
                        <i class='bx bx-save'></i>
                        <span>حفظ التعديلات والدرجة</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    let currentTeacherPassingGrade = 60;
    const defaultStudentName = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(studentFullName));

    function decodeHtmlEntities(str) {
        if (!str) return '';
        const txt = document.createElement('textarea');
        txt.innerHTML = str;
        return txt.value;
    }

    function setTeacherExamToday() {
        const today = new Date().toISOString().split('T')[0];
        const dateInput = document.getElementById('tModalExamDate');
        if (dateInput) dateInput.value = today;
    }

    function clearTeacherScore() {
        const scoreInput = document.getElementById('tModalScore');
        if (scoreInput) scoreInput.value = '';
        updateTeacherScoreFeedback('');
    }

    function updateTeacherScoreFeedback(val) {
        const pill = document.getElementById('tScoreRatingPill');
        const txt = document.getElementById('tScoreRatingText');
        const examStatus = document.getElementById('tModalExamStatus');
        if (!pill || !txt) return;

        if (!val || isNaN(val) || val === '') {
            pill.style.display = 'none';
            return;
        }

        const s = parseFloat(val);
        pill.style.display = 'inline-flex';

        if (s < currentTeacherPassingGrade) {
            pill.style.background = '#fef2f2';
            pill.style.borderColor = '#fecaca';
            pill.style.color = '#991b1b';
            txt.textContent = `راسب (${s}%)`;
            if (examStatus) examStatus.value = '2';
        } else {
            if (examStatus && examStatus.value !== '1') examStatus.value = '1';

            if (s >= 90) {
                pill.style.background = '#ecfdf5';
                pill.style.borderColor = '#86efac';
                pill.style.color = '#065f46';
                txt.textContent = `ممتاز 🌟 (${s}%)`;
            } else if (s >= 80) {
                pill.style.background = '#eff6ff';
                pill.style.borderColor = '#bfdbfe';
                pill.style.color = '#1e40af';
                txt.textContent = `جيد جداً (${s}%)`;
            } else if (s >= 70) {
                pill.style.background = '#f0fdf4';
                pill.style.borderColor = '#bbf7d0';
                pill.style.color = '#166534';
                txt.textContent = `جيد (${s}%)`;
            } else {
                pill.style.background = '#fffbeb';
                pill.style.borderColor = '#fde68a';
                pill.style.color = '#92400e';
                txt.textContent = `مقبول (${s}%)`;
            }
        }
    }

    function setTeacherScorePreset(val) {
        const scoreInput = document.getElementById('tModalScore');
        if (scoreInput) {
            scoreInput.value = val;
            updateTeacherScoreFeedback(val);
        }
    }

    function onTeacherExamStatusChanged(statusVal) {
        const scoreInput = document.getElementById('tModalScore');
        if (!scoreInput) return;
        if (statusVal === '1' && (!scoreInput.value || parseFloat(scoreInput.value) < currentTeacherPassingGrade)) {
            scoreInput.value = Math.max(85, currentTeacherPassingGrade);
            updateTeacherScoreFeedback(scoreInput.value);
        } else if (statusVal === '2' && (!scoreInput.value || parseFloat(scoreInput.value) >= currentTeacherPassingGrade)) {
            scoreInput.value = Math.max(0, currentTeacherPassingGrade - 15);
            updateTeacherScoreFeedback(scoreInput.value);
        }
    }

    function openTeacherRowMatnModal(el) {
        const row = el.closest('tr');
        if (!row) return;

        const studentId = row.getAttribute('data-student-id');
        const studentName = decodeHtmlEntities(row.getAttribute('data-student-name')) || defaultStudentName;
        const matnId = row.getAttribute('data-matn-id');
        const matnTitle = row.getAttribute('data-matn-title');
        const studyStatus = parseInt(row.getAttribute('data-study-status')) || 0;
        const memStatus = parseInt(row.getAttribute('data-mem-status')) || 0;
        const examStatus = parseInt(row.getAttribute('data-exam-status')) || 0;
        const score = row.getAttribute('data-score');
        const examDate = row.getAttribute('data-exam-date');
        const notes = row.getAttribute('data-notes');
        const passingGrade = parseFloat(row.getAttribute('data-passing-grade')) || 60;

        openTeacherMatnModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade);
    }

    function openTeacherMatnModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade = 60) {
        const modalEl = document.getElementById('teacherMatnModal');
        if (!modalEl) return;

        currentTeacherPassingGrade = parseFloat(passingGrade) || 60;
        document.getElementById('tModalStudentId').value = studentId || '';
        document.getElementById('tModalMatnId').value = matnId || '';
        document.getElementById('tModalStudentName').textContent = decodeHtmlEntities(studentName) || defaultStudentName || '-';
        document.getElementById('tModalMatnTitle').textContent = matnTitle || '-';
        const passEl = document.getElementById('tModalPassingGrade');
        if (passEl) passEl.textContent = currentTeacherPassingGrade + '%';

        document.getElementById('tModalStudyStatus').value = (studyStatus !== undefined && studyStatus !== null) ? studyStatus : 0;
        document.getElementById('tModalMemorizationStatus').value = (memStatus !== undefined && memStatus !== null) ? memStatus : 0;
        document.getElementById('tModalExamStatus').value = (examStatus !== undefined && examStatus !== null) ? examStatus : 0;
        document.getElementById('tModalScore').value = score || '';
        document.getElementById('tModalExamDate').value = examDate || '';
        document.getElementById('tModalTeacherNotes').value = notes || '';

        updateTeacherScoreFeedback(score);

        modalEl.classList.add('show', 'is-open');
        modalEl.style.setProperty('display', 'flex', 'important');
        document.body.style.overflow = 'hidden';
    }

    function closeTeacherMatnModal() {
        const modalEl = document.getElementById('teacherMatnModal');
        if (!modalEl) return;

        modalEl.classList.remove('show', 'is-open');
        modalEl.style.setProperty('display', 'none', 'important');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeTeacherMatnModal();
        }
    });

    async function saveTeacherMatnProgress(e) {
        e.preventDefault();
        const btn = document.getElementById('saveTeacherProgressBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin"></i> جارٍ الحفظ...';

        const payload = {
            studentId: document.getElementById('tModalStudentId').value,
            matnId: document.getElementById('tModalMatnId').value,
            studyStatus: parseInt(document.getElementById('tModalStudyStatus').value),
            memorizationStatus: parseInt(document.getElementById('tModalMemorizationStatus').value),
            examStatus: parseInt(document.getElementById('tModalExamStatus').value),
            score: document.getElementById('tModalScore').value ? parseFloat(document.getElementById('tModalScore').value) : null,
            examDate: document.getElementById('tModalExamDate').value ? document.getElementById('tModalExamDate').value : null,
            teacherNotes: document.getElementById('tModalTeacherNotes').value
        };

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('@Url.Action("CreateOrUpdate", "StudentMatnProgress", new { area = "Teacher" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'تعذر حفظ البيانات.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-save"></i> <span>حفظ التعديلات والدرجة</span>';
            }
        } catch (err) {
            alert('حدث خطأ في الاتصال بالخادم.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bx bx-save"></i> <span>حفظ التعديلات والدرجة</span>';
        }
    }
</script>
