@using Hafiz.Models
@using Hafiz.Domain.Enums
@using Hafiz.DTOs.Student
@using Hafiz.Common.Helper
@using System.Security.Claims
@model StudentDetailsViewModel

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["StudentDetails"].Value;
    var studentFullName = $"{Model.Student.StudentInfo.FirstName} {Model.Student.StudentInfo.SecondName}";
    var age = DateTime.UtcNow.Year - Model.Student.DateOfBirth.Year;

    var totalMemorizedPages = WirdPageCalculator.TotalMemorizedPages(Model.Student);
    var (memorizedJuzDisplay, memorizedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(totalMemorizedPages);
    var memorizationPercent = (int)Math.Round((double)totalMemorizedPages / WirdPageCalculator.TotalQuranPages * 100);
    if (memorizationPercent > 100) memorizationPercent = 100;
    var isHafiz = WirdPageCalculator.IsHafiz(Model.Student);
    var reviewedPages = Model.Student.ReviewedPages;
    var (reviewedJuzDisplay, reviewedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(reviewedPages);
    var totalTajwidPages = WirdPageCalculator.TotalTajwidPages(Model.Student);
}

<link rel="stylesheet" href="~/css/teacher/Students.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/student-details.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/matn-progress.css" asp-append-version="true" />

<div class="student-details-page">

    <!-- Top Navigation Bar -->
    <div class="details-top-bar">
        <a href="@Url.Action("Index", "Student")" class="t-btn t-btn-outline">
            <i class='bx bx-right-arrow-alt'></i>
            <span>@Localizer["BackToStudents"]</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="t-btn t-btn-outline"
                    onclick="openStudentPlanModal('@Model.Student.UserId', '@studentFullName', '@Model.Student.TajwidLevel')">
                <i class='bx bx-calendar-star text-primary'></i>
                <span>خطة الطالب المعتادة</span>
            </button>
        </div>
    </div>

    <!-- Student Details Header Hero -->
    <div class="details-header">
        <div class="details-header-content">
            <div class="student-avatar">
                @(Model.Student.StudentInfo.FirstName.Length > 0 ? Model.Student.StudentInfo.FirstName[0] : "S")
            </div>
            <div class="student-basic-info">
                <h1>
                    @studentFullName
                    @if (isHafiz)
                    {
                        <span class="hafiz-badge" title="@Localizer["HafizTitle"]">
                            <i class='bx bxs-award'></i> @Localizer["Hafiz"]
                        </span>
                    }
                </h1>
                <div class="student-meta-chips">
                    <span class="meta-chip"><i class='bx bx-cake'></i> @age @Localizer["Years"]</span>
                    <span class="meta-chip"><i class='bx bx-medal'></i> @Localizer[Model.Student.TajwidLevel.ToString()]</span>
                    @if (!string.IsNullOrEmpty(Model.Student.StudentInfo.PhoneNumber))
                    {
                        <span class="meta-chip"><i class='bx bx-phone'></i> @Model.Student.StudentInfo.PhoneNumber</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Student.StudentInfo.Email))
                    {
                        <span class="meta-chip"><i class='bx bx-envelope'></i> @Model.Student.StudentInfo.Email</span>
                    }
                </div>
            </div>

            <!-- Memorization Progress Card -->
            <div class="student-progress-card">
                <div class="progress-card-label">
                    <i class='bx bx-book-bookmark'></i>
                    <span>@Localizer["MemorizedJuz"]</span>
                </div>
                <div class="progress-card-value">
                    <span class="progress-current">@memorizedJuzDisplay</span>
                    <span class="progress-total">/ 30</span>
                </div>
                @if (memorizedPagesRemainder > 0)
                {
                    <div class="progress-card-subtext">
                        + @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]
                    </div>
                }
                <div class="progress-card-bar">
                    <div class="progress-card-fill" style="width: @memorizationPercent%"></div>
                </div>
                <div class="progress-card-percent">@memorizationPercent%</div>
            </div>
        </div>
    </div>

    <!-- Memorization & Review Stats Grid -->
    <div class="progress-stats-row">
        <div class="progress-stat-card stat-memorized">
            <div class="progress-stat-icon"><i class='bx bx-bookmark-check'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["MemorizedPages"]</div>
                <div class="progress-stat-value">@totalMemorizedPages.ToString("0.##")</div>
                <div class="progress-stat-sub">
                    @memorizedJuzDisplay @Localizer["JuzShort"]
                    @if (memorizedPagesRemainder > 0)
                    {
                        <text>+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                    }
                </div>
            </div>
        </div>
        <div class="progress-stat-card stat-reviewed">
            <div class="progress-stat-icon"><i class='bx bx-sync'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["ReviewedPages"]</div>
                <div class="progress-stat-value">@reviewedPages.ToString("0.##")</div>
                <div class="progress-stat-sub">
                    @reviewedJuzDisplay @Localizer["JuzShort"]
                    @if (reviewedPagesRemainder > 0)
                    {
                        <text>+ @reviewedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                    }
                </div>
            </div>
        </div>
        <div class="progress-stat-card stat-reviewed-juz">
            <div class="progress-stat-icon"><i class='bx bx-layer'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["ReviewedJuz"]</div>
                <div class="progress-stat-value">@reviewedJuzDisplay</div>
                <div class="progress-stat-sub">@Localizer["CompletedJuzReviews"]</div>
            </div>
        </div>
        <div class="progress-stat-card stat-tajwid">
            <div class="progress-stat-icon"><i class='bx bx-microphone'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["TajwidPages"]</div>
                <div class="progress-stat-value">@totalTajwidPages.ToString("0.##")</div>
                <div class="progress-stat-sub">@Localizer["CompletedTajwidWirds"]</div>
            </div>
        </div>
    </div>

    <!-- Information Cards Grid -->
    <div class="details-container">
        <!-- Academic Info -->
        <div class="info-card">
            <h3 class="info-card-header">
                <span class="info-card-icon"><i class='bx bx-book'></i></span>
                <span>@Localizer["AcademicInformation"]</span>
            </h3>
            <div class="info-row">
                <span class="info-label">@Localizer["MemorizedJuz"]:</span>
                <span class="info-value">
                    @memorizedJuzDisplay / 30
                    @if (memorizedPagesRemainder > 0)
                    {
                        <small>(+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"])</small>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["TajwidLevel"]:</span>
                <span class="info-value">@Localizer[Model.Student.TajwidLevel.ToString()]</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["Gender"]:</span>
                <span class="info-value">@Localizer[Model.Student.sex.ToString()]</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["DateOfBirth"]:</span>
                <span class="info-value">@Model.Student.DateOfBirth.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        <!-- Contact & Family Info -->
        <div class="info-card">
            <h3 class="info-card-header">
                <span class="info-card-icon"><i class='bx bx-user-pin'></i></span>
                <span>@Localizer["ContactInformation"]</span>
            </h3>
            <div class="info-row">
                <span class="info-label">@Localizer["Phone"]:</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.Student.StudentInfo.PhoneNumber) ? "-" : Model.Student.StudentInfo.PhoneNumber)</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["Email"]:</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.Student.StudentInfo.Email) ? "-" : Model.Student.StudentInfo.Email)</span>
            </div>
            @if (Model.Student.Parent != null)
            {
                <div class="info-row">
                    <span class="info-label">@Localizer["Parent"]:</span>
                    <span class="info-value">@Model.Student.Parent.ParentInfo?.FirstName @Model.Student.Parent.ParentInfo?.SecondName</span>
                </div>
            }
            <div class="info-row">
                <span class="info-label">@Localizer["ClassesEnrolled"]:</span>
                <span class="info-value">@(Model.Student.Classes?.Count ?? 0)</span>
            </div>
        </div>
    </div>

    <!-- Wirds Section -->
    <div class="wirds-section">
        <div class="t-section-header">
            <h3 class="t-section-title">
                <i class='bx bx-list-check'></i>
                <span>@Localizer["AssignedWirds"]</span>
                <span class="t-badge t-badge-quran">@Model.TotalWirds</span>
            </h3>
        </div>

        @if (Model.PaginatedWirds != null && Model.PaginatedWirds.Any())
        {
            <div class="wirds-list">
                @foreach (var wird in Model.PaginatedWirds)
                {
                    var fromSurahName = wird.FromSurah != null && wird.FromSurah != Surah.NONE
                        ? Formatting.GetLocalizedSurahName(wird.FromSurah.Value)
                        : null;
                    var toSurahName = wird.ToSurah != null && wird.ToSurah != Surah.NONE
                        ? Formatting.GetLocalizedSurahName(wird.ToSurah.Value)
                        : null;

                    var hasFromData = fromSurahName != null || wird.FromJuz != null || wird.FromPage != null || !string.IsNullOrEmpty(wird.FromAyah);
                    var hasToData = toSurahName != null || wird.ToJuz != null || wird.ToPage != null || wird.ToAyah != null;

                    <div class="wird-item @(wird.IsUpcoming ? "is-upcoming" : "")">
                        <div class="wird-header">
                            <h4>@Localizer[wird.Type.ToString()]</h4>
                            <div class="d-flex align-items-center gap-1">
                                @if (wird.IsUpcoming)
                                {
                                    @await Html.PartialAsync("_UpcomingBadge")
                                }
                                <span class="wird-status-badge @(wird.IsCompleted ? "status-completed" : wird.Status == AssignmentStatus.notSet ? "status-pending" : "")">
                                    @Localizer[wird.Status.ToString()]
                                </span>
                            </div>
                        </div>

                        <div class="wird-meta-row">
                            <span><i class='bx bx-calendar'></i> @Localizer["Assigned"] @wird.AssignedDate.ToString("MMM dd, yyyy")</span>
                            @if (wird.IsCompleted)
                            {
                                <span class="wird-completed-badge"><i class='bx bx-check-circle'></i> @Localizer["Completed"]</span>
                            }
                        </div>

                        @if (hasFromData || hasToData)
                        {
                            <div class="wird-range-compact">
                                @if (hasFromData)
                                {
                                    <div class="wird-range-line">
                                        <strong>@Localizer["From"]</strong>
                                        <span class="wird-range-values">
                                            @if (fromSurahName != null)
                                            {
                                                <span>@Localizer["Surah"] <b>@fromSurahName</b></span>
                                            }
                                            @if (wird.FromJuz != null)
                                            {
                                                <span>@Localizer["Juz"] <b>@wird.FromJuz</b></span>
                                            }
                                            @if (wird.FromPage != null)
                                            {
                                                <span>@Localizer["Page"] <b>@wird.FromPage</b></span>
                                            }
                                            @if (!string.IsNullOrEmpty(wird.FromAyah))
                                            {
                                                <span>@Localizer["Ayah"] <b>@wird.FromAyah</b></span>
                                            }
                                        </span>
                                    </div>
                                }
                                @if (hasToData)
                                {
                                    <div class="wird-range-line">
                                        <strong>@Localizer["To"]</strong>
                                        <span class="wird-range-values">
                                            @if (toSurahName != null)
                                            {
                                                <span>@Localizer["Surah"] <b>@toSurahName</b></span>
                                            }
                                            @if (wird.ToJuz != null)
                                            {
                                                <span>@Localizer["Juz"] <b>@wird.ToJuz</b></span>
                                            }
                                            @if (wird.ToPage != null)
                                            {
                                                <span>@Localizer["Page"] <b>@wird.ToPage</b></span>
                                            }
                                            @if (wird.ToAyah != null)
                                            {
                                                <span>@Localizer["Ayah"] <b>@wird.ToAyah</b></span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="wird-range-compact">
                                <span class="wird-not-specified">@Localizer["NotSpecified"]</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(wird.Note))
                        {
                            <div class="wird-note-compact">
                                <strong>@Localizer["Notes"]:</strong>
                                <span>@wird.Note</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination-controls">
                    @if (Model.HasPrevious)
                    {
                        <a href="@Url.Action("Details", "Student", new { id = Model.Student.UserId, page = Model.CurrentPage - 1 })"
                           class="pagination-btn">
                            <i class='bx bx-chevron-right'></i>
                            @Localizer["Previous"]
                        </a>
                    }

                    <span class="pagination-info">
                        @string.Format(Localizer["PageOf"].Value, Model.CurrentPage, Model.TotalPages)
                    </span>

                    @if (Model.HasNext)
                    {
                        <a href="@Url.Action("Details", "Student", new { id = Model.Student.UserId, page = Model.CurrentPage + 1 })"
                           class="pagination-btn">
                            @Localizer["Next"]
                            <i class='bx bx-chevron-left'></i>
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-book-open'></i></div>
                <h4 class="t-empty-title">@Localizer["NoWirdsYet"]</h4>
                <p class="t-empty-text">لم يتم تسجيل أي أوراد قرآنية لهذا الطالب حتى الآن.</p>
            </div>
        }
    </div>

    <!-- سجل إنجاز واختبارات المتون المقررة -->
    <div class="matn-matrix-card mb-4">
        <div class="matn-matrix-header d-flex align-items-center justify-content-between flex-wrap gap-2">
            <h4 class="matn-matrix-title mb-0">
                <i class='bx bx-book-reader'></i>
                <span>سجل إنجاز واختبارات المتون العلمية المقررة</span>
            </h4>
            <div class="d-flex align-items-center gap-2">
                @if (Model.MatnProgresses != null && Model.MatnProgresses.Any())
                {
                    <span class="badge bg-primary rounded-pill">@Model.MatnProgresses.Count() متون مقررة</span>
                }
                <button type="button" class="t-btn t-btn-primary t-btn-sm" onclick="openAssignMatnModal('@Model.Student.UserId', '@studentFullName')">
                    <i class='bx bx-plus-circle'></i>
                    <span>رصد تسميع متن جديد</span>
                </button>
            </div>
        </div>

        @if (Model.MatnProgresses != null && Model.MatnProgresses.Any())
        {
            <div class="table-responsive">
                <table class="matn-matrix-table">
                    <thead>
                        <tr>
                            <th style="min-width: 180px;">المتن المقرر</th>
                            <th style="min-width: 130px;" class="text-center">حالة المدارسة</th>
                            <th style="min-width: 130px;" class="text-center">حالة الحفظ</th>
                            <th style="min-width: 150px;" class="text-center">الاختبار والدرجة</th>
                            <th style="min-width: 150px;">ملاحظات المعلم</th>
                            <th style="min-width: 160px;" class="text-center">الإجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prog in Model.MatnProgresses)
                        {
                            <tr>
                                <td>
                                    <div class="matn-title-pill">
                                        <span class="matn-order-badge">#@prog.MatnOrder</span>
                                        <span>@prog.MatnTitle</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(prog.MatnAuthor))
                                    {
                                        <div class="text-muted small mt-1" style="font-size: 11px;">@prog.MatnAuthor</div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (prog.StudyStatus == StudyStatus.Completed)
                                    {
                                        <span class="status-pill status-study-completed">
                                            <i class='bx bx-check-circle'></i> مكتمل
                                        </span>
                                        @if (prog.StudyCompletedAt.HasValue)
                                        {
                                            <div class="text-muted small mt-1" style="font-size: 10px;">@prog.StudyCompletedAt.Value.ToString("yyyy-MM-dd")</div>
                                        }
                                    }
                                    else if (prog.StudyStatus == StudyStatus.InProgress)
                                    {
                                        <span class="status-pill status-study-inprogress">
                                            <i class='bx bx-loader-circle'></i> قيد الدراسة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-study-notstarted">
                                            <i class='bx bx-circle'></i> لم يبدأ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (prog.MemorizationStatus == MemorizationStatus.Memorized)
                                    {
                                        <span class="status-pill status-mem-memorized">
                                            <i class='bx bx-check-double'></i> تم الحفظ
                                        </span>
                                        @if (prog.MemorizationCompletedAt.HasValue)
                                        {
                                            <div class="text-muted small mt-1" style="font-size: 10px;">@prog.MemorizationCompletedAt.Value.ToString("yyyy-MM-dd")</div>
                                        }
                                    }
                                    else if (prog.MemorizationStatus == MemorizationStatus.InProgress)
                                    {
                                        <span class="status-pill status-mem-inprogress">
                                            <i class='bx bx-bookmarks'></i> قيد الحفظ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-mem-notstarted">
                                            <i class='bx bx-circle'></i> لم يبدأ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @{
                                        var passGrade = prog.PassingGrade > 0 ? prog.PassingGrade : 60m;
                                        var isActuallyPassed = prog.ExamStatus == ExamStatus.Passed && (!prog.Score.HasValue || prog.Score.Value >= passGrade);
                                        var isActuallyFailed = prog.ExamStatus == ExamStatus.Failed || (prog.Score.HasValue && prog.Score.Value < passGrade);
                                    }
                                    @if (isActuallyPassed)
                                    {
                                        <span class="status-pill status-exam-passed @(prog.Score >= 90 ? "high-score" : "")">
                                            <i class='bx @(prog.Score >= 90 ? "bxs-star text-warning" : "bx-check")'></i>
                                            <span>ناجح</span>
                                            @if (prog.Score.HasValue)
                                            {
                                                <span class="score-badge">@(prog.Score.Value.ToString("0.##"))%</span>
                                            }
                                        </span>
                                    }
                                    else if (isActuallyFailed)
                                    {
                                        <span class="status-pill status-exam-failed">
                                            <i class='bx bx-x'></i>
                                            <span>راسب</span>
                                            @if (prog.Score.HasValue)
                                            {
                                                <span class="score-badge">@(prog.Score.Value.ToString("0.##"))%</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill status-exam-none">
                                            <i class='bx bx-minus'></i> لم يختبر
                                        </span>
                                    }
                                    @if (prog.ExamDate.HasValue)
                                    {
                                        <div class="text-muted small mt-1" style="font-size: 10px;">
                                            <i class='bx bx-calendar'></i> @prog.ExamDate.Value.ToString("yyyy-MM-dd")
                                        </div>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(string.IsNullOrEmpty(prog.TeacherNotes) ? "—" : prog.TeacherNotes)
                                </td>
                                <td class="text-center">
                                    <div class="d-flex align-items-center justify-content-center gap-1 flex-wrap">
                                        <button type="button" class="btn-matn-action"
                                                onclick="openProgressModal('@Model.Student.UserId', '@studentFullName', '@prog.MatnId', '@prog.MatnTitle', @((int)prog.StudyStatus), @((int)prog.MemorizationStatus), @((int)prog.ExamStatus), '@(prog.Score?.ToString() ?? "")', '@(prog.ExamDate?.ToString("yyyy-MM-dd") ?? "")', '@((prog.TeacherNotes ?? "").Replace("'", "\\'").Replace("\n", " "))')">
                                            <i class='bx bx-edit-alt'></i>
                                            <span>تحديد الحالة</span>
                                        </button>
                                        <button type="button" class="t-btn t-btn-sm t-btn-outline p-1" title="رصد تسميع لهذا المتن"
                                                onclick="openAssignMatnModal('@Model.Student.UserId', '@studentFullName', '@prog.MatnTitle', '@prog.MatnId')">
                                            <i class='bx bx-plus text-primary'></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-book-open'></i></div>
                <h4 class="t-empty-title">لا توجد سجلات متون مسجلة لهذا الطالب</h4>
                <p class="t-empty-text">لم يتم تسجيل حالة الطالب في أي متن بعد. يمكنك رصد تقدم الطالب وتحديد درجاته من واجهة المتون العلمية.</p>
                <a asp-controller="Matn" asp-action="Index" class="btn btn-outline-primary btn-sm mt-2">
                    <i class='bx bx-bookmarks me-1'></i> الانتقال لصفحة المتون
                </a>
            </div>
        }
    </div>

    <!-- Matn Assignments Section -->
    <div class="wirds-section matn-assignments-section">
        <div class="t-section-header">
            <h3 class="t-section-title">
                <i class='bx bx-bookmarks text-primary'></i>
                <span>سجل تسميع المتون العلمية</span>
                <span class="t-badge t-badge-matn">@Model.TotalMatnAssignments</span>
            </h3>
           
        </div>

        @if (Model.MatnAssignments != null && Model.MatnAssignments.Any())
        {
            <div class="wirds-list">
                @foreach (var matn in Model.MatnAssignments)
                {
                    <div class="wird-item matn-item @(matn.IsUpcoming ? "is-upcoming" : "")">
                        <div class="wird-header">
                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                <span class="t-badge t-badge-matn">
                                    @matn.PerformanceTypeName
                                </span>
                                @if (!string.IsNullOrEmpty(matn.ClassName))
                                {
                                    <span class="t-chip">
                                        <i class='bx bx-group'></i> @matn.ClassName
                                    </span>
                                }
                            </div>
                            <div class="d-flex align-items-center gap-1">
                                @if (matn.IsUpcoming)
                                {
                                    @await Html.PartialAsync("_UpcomingBadge")
                                }
                                <span class="wird-status-badge @(matn.IsCompleted ? "status-completed" : "")">
                                    @Localizer[matn.Status.ToString()]
                                </span>
                            </div>
                        </div>

                        <div class="wird-meta-row">
                            <span><i class='bx bx-calendar'></i> @matn.AssignedDate.ToString("yyyy-MM-dd")</span>
                            @if (matn.Amount.HasValue)
                            {
                                <span class="t-chip"><i class='bx bx-layer'></i> @matn.Amount.Value.ToString("0.##") @matn.UnitName</span>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(matn.ChapterName) || matn.FromNumber.HasValue || matn.ToNumber.HasValue)
                        {
                            <div class="wird-range-compact matn-range-box">
                                @if (!string.IsNullOrEmpty(matn.ChapterName))
                                {
                                    <div class="fw-bold mb-1">
                                        <i class='bx bx-book-bookmark text-primary me-1'></i> @matn.ChapterName
                                    </div>
                                }
                                @if (matn.FromNumber.HasValue && matn.ToNumber.HasValue)
                                {
                                    <div class="small text-muted">
                                        <strong>الموضع:</strong> من @matn.UnitName @matn.FromNumber إلى @matn.ToNumber
                                    </div>
                                }
                                else if (matn.FromNumber.HasValue)
                                {
                                    <div class="small text-muted">
                                        <strong>الموضع:</strong> من @matn.UnitName @matn.FromNumber
                                    </div>
                                }
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(matn.Note))
                        {
                            <div class="wird-note-compact">
                                <strong>@Localizer["Notes"]:</strong>
                                <span>@matn.Note</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Matn Pagination Controls -->
            <div id="matnPaginationControls" class="pagination-controls mt-3" style="display: none;">
                <button type="button" class="pagination-btn" id="matnPrevBtn" onclick="changeMatnPage(-1)">
                    <i class='bx bx-chevron-right'></i>
                    <span>@Localizer["Previous"]</span>
                </button>
                <span class="pagination-info" id="matnPageInfo"></span>
                <button type="button" class="pagination-btn" id="matnNextBtn" onclick="changeMatnPage(1)">
                    <span>@Localizer["Next"]</span>
                    <i class='bx bx-chevron-left'></i>
                </button>
            </div>
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-bookmarks'></i></div>
                <h4 class="t-empty-title">لا توجد تسميعات متون مسجلة</h4>
                <p class="t-empty-text">لا توجد تسميعات متون مسجلة لهذا الطالب حتى الآن.</p>
            </div>
        }
    </div>

    <!-- Parent Notes Section -->
    <div class="wirds-section notes-section">
        <div class="t-section-header">
            <h3 class="t-section-title">
                <i class='bx bx-message-square-detail'></i>
                <span>@Localizer["ParentNotes"]</span>
                @if (ViewBag.ParentNotes is IEnumerable<Hafiz.Models.ParentNote> notesForCount)
                {
                    <span class="t-badge t-badge-gold">@notesForCount.Count()</span>
                }
            </h3>
        </div>

        @{
            var parentNotes = ViewBag.ParentNotes as IEnumerable<Hafiz.Models.ParentNote> ?? new List<Hafiz.Models.ParentNote>();
        }

        <!-- Add New Note Form -->
        <div class="note-form-container">
            <h4><i class='bx bx-edit-alt me-1'></i> @Localizer["AddNewNote"]</h4>
            <form asp-area="Teacher" asp-controller="ParentNotes" asp-action="Create" method="post">
                <input type="hidden" name="studentId" value="@Model.Student.UserId" />
                <div class="note-form-field">
                    <textarea name="content" rows="2"
                              class="note-textarea"
                              placeholder="@Localizer["WritePlaceholder"]" required></textarea>
                </div>
                <button type="submit" class="t-btn t-btn-primary">
                    <i class='bx bx-plus-circle'></i> <span>@Localizer["AddNote"]</span>
                </button>
            </form>
        </div>

        <!-- Display Existing Notes -->
        @if (parentNotes.Any())
        {
            <div class="wirds-list">
                @foreach (var note in parentNotes)
                {
                    <div class="note-item">
                        <div class="note-header">
                            <div>
                                <div class="note-author">
                                    <i class='bx bx-user-circle'></i> @Localizer["By"] @note.CreatedByUser.FirstName @note.CreatedByUser.SecondName
                                </div>
                                <div class="note-date">
                                    <i class='bx bx-calendar'></i> @note.CreatedAt.ToUserTime(Context).ToString("MMM dd, yyyy 'at' h:mm tt")
                                    @if (note.UpdatedAt != null)
                                    {
                                        <span> · @Localizer["Updated"] @note.UpdatedAt.Value.ToUserTime(Context).ToString("MMM dd, yyyy")</span>
                                    }
                                </div>
                            </div>
                            @if (note.CreatedBy == Guid.Parse(User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)!))
                            {
                                <form asp-area="Teacher" asp-controller="ParentNotes" asp-action="Delete" method="post"
                                      style="display: inline;" onsubmit="return confirm('@Localizer["ConfirmDeleteNote"]');">
                                    <input type="hidden" name="noteId" value="@note.Id" />
                                    <input type="hidden" name="studentId" value="@Model.Student.UserId" />
                                    <button type="submit" class="note-delete-btn" title="حذف الملاحظة">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="note-content">
                            <p>@note.Content</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-message-square-x'></i></div>
                <h4 class="t-empty-title">@Localizer["NoNotesYet"]</h4>
                <p class="t-empty-text">لا توجد ملاحظات مرسلة لولي الأمر لهذا الطالب حتى الآن.</p>
            </div>
        }
    </div>

</div>

<!-- Include Modals -->
@await Html.PartialAsync("_StudentRoutinePlanModal")
@await Html.PartialAsync("_AssignMatnModal")

<!-- Modal: تحديد حالة الطالب مع المتن ورصد الدرجة بتصميم عصري -->
<div class="modal fade" id="matnProgressModal" tabindex="-1" aria-labelledby="matnProgressModalLabel" aria-hidden="true" dir="rtl">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content matn-modal-content">
            <div class="modal-header matn-modal-header">
                <h5 class="modal-title" id="matnProgressModalLabel">
                    <i class='bx bx-award'></i>
                    <span>تحديد حالة المتن ورصد الدرجة للطالب</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form id="matnProgressForm" onsubmit="saveMatnProgress(event)">
                <div class="modal-body matn-modal-body">
                    <input type="hidden" id="modalStudentId" name="studentId" />
                    <input type="hidden" id="modalMatnId" name="matnId" />

                    <!-- بطاقة سياق الطالب والمتن -->
                    <div class="matn-context-banner">
                        <div class="matn-context-row">
                            <span class="matn-context-label">اسم الطالب:</span>
                            <span class="matn-context-val" id="modalStudentName">-</span>
                        </div>
                        <div class="matn-context-row">
                            <span class="matn-context-label">المتن المقرر:</span>
                            <span class="matn-context-val text-primary" id="modalMatnTitle">-</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="matn-form-label">
                                <i class='bx bx-book-open text-success'></i>
                                <span>حالة المدارسة</span>
                            </label>
                            <select id="modalStudyStatus" name="studyStatus" class="matn-form-select">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد الدراسة</option>
                                <option value="2">مكتمل</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="matn-form-label">
                                <i class='bx bx-bookmarks text-primary'></i>
                                <span>حالة الحفظ</span>
                            </label>
                            <select id="modalMemorizationStatus" name="memorizationStatus" class="matn-form-select">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد الحفظ</option>
                                <option value="2">تم الحفظ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="matn-form-label">
                                <i class='bx bx-check-shield text-warning'></i>
                                <span>نتيجة الاختبار</span>
                            </label>
                            <select id="modalExamStatus" name="examStatus" class="matn-form-select" onchange="onExamStatusChanged(this.value)">
                                <option value="0">لم يختبر بعد</option>
                                <option value="1">اجتاز بنجاح (ناجح)</option>
                                <option value="2">لم يجتز (راسب)</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="matn-form-label">
                                <i class='bx bx-calendar text-secondary'></i>
                                <span>تاريخ الاختبار</span>
                            </label>
                            <input type="date" id="modalExamDate" name="examDate" class="matn-form-input" />
                        </div>

                        <!-- عنصر تفاعلي لرصد درجة الاختبار -->
                        <div class="col-12">
                            <div class="matn-score-widget">
                                <div class="score-widget-top">
                                    <label class="matn-form-label mb-0">
                                        <i class='bx bx-certification text-success'></i>
                                        <span>درجة الاختبار (من 100)</span>
                                    </label>
                                    <span id="scoreRatingPill" class="score-rating-pill" style="display: none;">
                                        <i class='bx bx-award'></i> <span id="scoreRatingText">-</span>
                                    </span>
                                </div>
                                <div class="input-group">
                                    <input type="number" id="modalScore" name="score" class="matn-form-input" min="0" max="100" step="0.5" placeholder="مثال: 95.5" oninput="updateScoreFeedback(this.value)" />
                                    <span class="input-group-text bg-white border-start-0 fw-bold">%</span>
                                </div>
                                <div class="score-presets">
                                    <span class="small text-muted me-1">درجات سريعة:</span>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(100)">100% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(95)">95% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(85)">85% ج.جداً</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(75)">75% جيد</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(60)">60% مقبول</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="matn-form-label">
                                <i class='bx bx-comment-detail text-muted'></i>
                                <span>ملاحظات المعلم / الإدارة</span>
                            </label>
                            <textarea id="modalTeacherNotes" name="teacherNotes" class="matn-form-input" rows="2" placeholder="ملاحظات حول مستوى الطالب، الإتقان، أو الاستدراك..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer matn-modal-footer">
                    <button type="button" class="t-btn t-btn-outline" data-bs-dismiss="modal">إلغاء</button>
                    <button type="submit" class="btn-matn-action px-4" id="saveProgressBtn">
                        <i class='bx bx-save'></i>
                        <span>حفظ التعديلات والدرجة</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    function updateScoreFeedback(scoreVal) {
        const pill = document.getElementById('scoreRatingPill');
        const txt = document.getElementById('scoreRatingText');
        if (!scoreVal || isNaN(scoreVal)) {
            pill.style.display = 'none';
            return;
        }
        const s = parseFloat(scoreVal);
        pill.style.display = 'inline-flex';
        if (s >= 90) {
            pill.style.background = '#ecfdf5';
            pill.style.borderColor = '#86efac';
            pill.style.color = '#065f46';
            txt.textContent = 'ممتاز (Excellent)';
        } else if (s >= 80) {
            pill.style.background = '#eff6ff';
            pill.style.borderColor = '#bfdbfe';
            pill.style.color = '#1e40af';
            txt.textContent = 'جيد جداً (Very Good)';
        } else if (s >= 65) {
            pill.style.background = '#f0fdf4';
            pill.style.borderColor = '#bbf7d0';
            pill.style.color = '#166534';
            txt.textContent = 'جيد (Good)';
        } else if (s >= 50) {
            pill.style.background = '#fffbeb';
            pill.style.borderColor = '#fde68a';
            pill.style.color = '#92400e';
            txt.textContent = 'مقبول (Fair)';
        } else {
            pill.style.background = '#fef2f2';
            pill.style.borderColor = '#fecaca';
            pill.style.color = '#991b1b';
            txt.textContent = 'راسب (Failed)';
        }
    }

    function setScorePreset(val) {
        const input = document.getElementById('modalScore');
        input.value = val;
        updateScoreFeedback(val);
        const examStatus = document.getElementById('modalExamStatus');
        if (val >= 60) {
            examStatus.value = '1';
        } else {
            examStatus.value = '2';
        }
    }

    function onExamStatusChanged(statusVal) {
        const scoreInput = document.getElementById('modalScore');
        if (statusVal === '1' && (!scoreInput.value || parseFloat(scoreInput.value) < 60)) {
            scoreInput.value = 85;
            updateScoreFeedback(85);
        } else if (statusVal === '2' && (!scoreInput.value || parseFloat(scoreInput.value) >= 60)) {
            scoreInput.value = 45;
            updateScoreFeedback(45);
        }
    }

    function openProgressModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes) {
        document.getElementById('modalStudentId').value = studentId;
        document.getElementById('modalMatnId').value = matnId;
        document.getElementById('modalStudentName').textContent = studentName;
        document.getElementById('modalMatnTitle').textContent = matnTitle;
        document.getElementById('modalStudyStatus').value = studyStatus !== undefined ? studyStatus : 0;
        document.getElementById('modalMemorizationStatus').value = memStatus !== undefined ? memStatus : 0;
        document.getElementById('modalExamStatus').value = examStatus !== undefined ? examStatus : 0;
        document.getElementById('modalScore').value = score || '';
        document.getElementById('modalExamDate').value = examDate || '';
        document.getElementById('modalTeacherNotes').value = notes || '';

        updateScoreFeedback(score);

        var modalEl = document.getElementById('matnProgressModal');
        var modal = bootstrap.Modal.getInstance(modalEl) || new bootstrap.Modal(modalEl);
        modal.show();
    }

    async function saveMatnProgress(e) {
        e.preventDefault();
        const btn = document.getElementById('saveProgressBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> جارٍ الحفظ...';

        const payload = {
            studentId: document.getElementById('modalStudentId').value,
            matnId: document.getElementById('modalMatnId').value,
            studyStatus: parseInt(document.getElementById('modalStudyStatus').value),
            memorizationStatus: parseInt(document.getElementById('modalMemorizationStatus').value),
            examStatus: parseInt(document.getElementById('modalExamStatus').value),
            score: document.getElementById('modalScore').value ? parseFloat(document.getElementById('modalScore').value) : null,
            examDate: document.getElementById('modalExamDate').value ? document.getElementById('modalExamDate').value : null,
            teacherNotes: document.getElementById('modalTeacherNotes').value
        };

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('@Url.Action("CreateOrUpdate", "StudentMatnProgress", new { area = "Teacher" })', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                location.reload();
            } else {
                alert(data.message || 'تعذر حفظ البيانات.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
            }
        } catch (err) {
            alert('حدث خطأ في الاتصال بالخادم.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
        }
    }

    window.currentStudentMatuns = @Html.Raw(System.Text.Json.JsonSerializer.Serialize((Model.MatnProgresses ?? Enumerable.Empty<Hafiz.DTOs.Matn.StudentMatnProgressDto>()).Select(p => new {
        matnId = p.MatnId.ToString(),
        matnTitle = p.MatnTitle,
        matnAuthor = p.MatnAuthor ?? "",
        matnOrder = p.MatnOrder
    })));

    (function initMatnPagination() {
        const items = document.querySelectorAll('.matn-assignments-section .matn-item');
        if (!items || items.length === 0) return;
        const perPage = 5;
        const totalPages = Math.ceil(items.length / perPage);
        const controls = document.getElementById('matnPaginationControls');
        const info = document.getElementById('matnPageInfo');
        const prev = document.getElementById('matnPrevBtn');
        const next = document.getElementById('matnNextBtn');

        if (items.length > perPage && controls) {
            controls.style.display = 'flex';
        }

        let curPage = 1;
        window.changeMatnPage = function(delta) {
            curPage += delta;
            if (curPage < 1) curPage = 1;
            if (curPage > totalPages) curPage = totalPages;

            items.forEach((item, idx) => {
                const visible = (idx >= (curPage - 1) * perPage && idx < curPage * perPage);
                item.style.display = visible ? 'block' : 'none';
            });

            if (info) info.textContent = `صفحة ${curPage} من ${totalPages} (${items.length} تسميع)`;
            if (prev) prev.disabled = (curPage === 1);
            if (next) next.disabled = (curPage === totalPages);
        };

        if (items.length > perPage) {
            window.changeMatnPage(0);
        }
    })();
</script>
