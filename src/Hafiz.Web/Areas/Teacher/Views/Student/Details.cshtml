@using Hafiz.Models
@using Hafiz.Domain.Enums
@using Hafiz.DTOs.Student
@using Hafiz.Common.Helper
@using System.Security.Claims
@model StudentDetailsViewModel

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["StudentDetails"].Value;
    var studentFullName = $"{Model.Student.StudentInfo.FirstName} {Model.Student.StudentInfo.SecondName}";
    var age = DateTime.UtcNow.Year - Model.Student.DateOfBirth.Year;

    var totalMemorizedPages = WirdPageCalculator.TotalMemorizedPages(Model.Student);
    var (memorizedJuzDisplay, memorizedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(totalMemorizedPages);
    var memorizationPercent = (int)Math.Round((double)totalMemorizedPages / WirdPageCalculator.TotalQuranPages * 100);
    if (memorizationPercent > 100) memorizationPercent = 100;
    var isHafiz = WirdPageCalculator.IsHafiz(Model.Student);
    var reviewedPages = Model.Student.ReviewedPages;
    var (reviewedJuzDisplay, reviewedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(reviewedPages);
    var totalTajwidPages = WirdPageCalculator.TotalTajwidPages(Model.Student);
}

<link rel="stylesheet" href="~/css/teacher/Students.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/student-details.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/matn-progress.css" asp-append-version="true" />

<div class="student-details-page">

    <!-- Top Navigation Bar -->
    <div class="details-top-bar">
        <a href="@Url.Action("Index", "Student")" class="t-btn t-btn-outline">
            <i class='bx bx-right-arrow-alt'></i>
            <span>@Localizer["BackToStudents"]</span>
        </a>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="t-btn t-btn-outline"
                    onclick="openStudentPlanModal('@Model.Student.UserId', '@studentFullName', '@Model.Student.TajwidLevel')">
                <i class='bx bx-calendar-star text-primary'></i>
                <span>خطة الطالب المعتادة</span>
            </button>
        </div>
    </div>

    <!-- Student Details Header Hero -->
    <div class="details-header">
        <div class="details-header-content">
            <div class="student-avatar">
                @(Model.Student.StudentInfo.FirstName.Length > 0 ? Model.Student.StudentInfo.FirstName[0] : "S")
            </div>
            <div class="student-basic-info">
                <h1>
                    @studentFullName
                    @if (isHafiz)
                    {
                        <span class="hafiz-badge" title="@Localizer["HafizTitle"]">
                            <i class='bx bxs-award'></i> @Localizer["Hafiz"]
                        </span>
                    }
                </h1>
                <div class="student-meta-chips">
                    <span class="meta-chip"><i class='bx bx-cake'></i> @age @Localizer["Years"]</span>
                    <span class="meta-chip"><i class='bx bx-medal'></i> @Localizer[Model.Student.TajwidLevel.ToString()]</span>
                    @if (!string.IsNullOrEmpty(Model.Student.StudentInfo.PhoneNumber))
                    {
                        <span class="meta-chip"><i class='bx bx-phone'></i> @Model.Student.StudentInfo.PhoneNumber</span>
                    }
                    @if (!string.IsNullOrEmpty(Model.Student.StudentInfo.Email))
                    {
                        <span class="meta-chip"><i class='bx bx-envelope'></i> @Model.Student.StudentInfo.Email</span>
                    }
                </div>
            </div>

            <!-- Memorization Progress Card -->
            <div class="student-progress-card">
                <div class="progress-card-label">
                    <i class='bx bx-book-bookmark'></i>
                    <span>@Localizer["MemorizedJuz"]</span>
                </div>
                <div class="progress-card-value">
                    <span class="progress-current">@memorizedJuzDisplay</span>
                    <span class="progress-total">/ 30</span>
                </div>
                @if (memorizedPagesRemainder > 0)
                {
                    <div class="progress-card-subtext">
                        + @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]
                    </div>
                }
                <div class="progress-card-bar">
                    <div class="progress-card-fill" style="width: @memorizationPercent%"></div>
                </div>
                <div class="progress-card-percent">@memorizationPercent%</div>
            </div>
        </div>
    </div>

    <!-- Memorization & Review Stats Grid -->
    <div class="progress-stats-row">
        <div class="progress-stat-card stat-memorized">
            <div class="progress-stat-icon"><i class='bx bx-bookmark-check'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["MemorizedPages"]</div>
                <div class="progress-stat-value">@totalMemorizedPages.ToString("0.##")</div>
                <div class="progress-stat-sub">
                    @memorizedJuzDisplay @Localizer["JuzShort"]
                    @if (memorizedPagesRemainder > 0)
                    {
                        <text>+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                    }
                </div>
            </div>
        </div>
        <div class="progress-stat-card stat-reviewed">
            <div class="progress-stat-icon"><i class='bx bx-sync'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["ReviewedPages"]</div>
                <div class="progress-stat-value">@reviewedPages.ToString("0.##")</div>
                <div class="progress-stat-sub">
                    @reviewedJuzDisplay @Localizer["JuzShort"]
                    @if (reviewedPagesRemainder > 0)
                    {
                        <text>+ @reviewedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                    }
                </div>
            </div>
        </div>
        <div class="progress-stat-card stat-reviewed-juz">
            <div class="progress-stat-icon"><i class='bx bx-layer'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["ReviewedJuz"]</div>
                <div class="progress-stat-value">@reviewedJuzDisplay</div>
                <div class="progress-stat-sub">@Localizer["CompletedJuzReviews"]</div>
            </div>
        </div>
        <div class="progress-stat-card stat-tajwid">
            <div class="progress-stat-icon"><i class='bx bx-microphone'></i></div>
            <div class="progress-stat-body">
                <div class="progress-stat-label">@Localizer["TajwidPages"]</div>
                <div class="progress-stat-value">@totalTajwidPages.ToString("0.##")</div>
                <div class="progress-stat-sub">@Localizer["CompletedTajwidWirds"]</div>
            </div>
        </div>
    </div>

    <!-- Information Cards Grid -->
    <div class="details-container">
        <!-- Academic Info -->
        <div class="info-card">
            <h3 class="info-card-header">
                <span class="info-card-icon"><i class='bx bx-book'></i></span>
                <span>@Localizer["AcademicInformation"]</span>
            </h3>
            <div class="info-row">
                <span class="info-label">@Localizer["MemorizedJuz"]:</span>
                <span class="info-value">
                    @memorizedJuzDisplay / 30
                    @if (memorizedPagesRemainder > 0)
                    {
                        <small>(+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"])</small>
                    }
                </span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["TajwidLevel"]:</span>
                <span class="info-value">@Localizer[Model.Student.TajwidLevel.ToString()]</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["Gender"]:</span>
                <span class="info-value">@Localizer[Model.Student.sex.ToString()]</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["DateOfBirth"]:</span>
                <span class="info-value">@Model.Student.DateOfBirth.ToString("yyyy-MM-dd")</span>
            </div>
        </div>

        <!-- Contact & Family Info -->
        <div class="info-card">
            <h3 class="info-card-header">
                <span class="info-card-icon"><i class='bx bx-user-pin'></i></span>
                <span>@Localizer["ContactInformation"]</span>
            </h3>
            <div class="info-row">
                <span class="info-label">@Localizer["Phone"]:</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.Student.StudentInfo.PhoneNumber) ? "-" : Model.Student.StudentInfo.PhoneNumber)</span>
            </div>
            <div class="info-row">
                <span class="info-label">@Localizer["Email"]:</span>
                <span class="info-value">@(string.IsNullOrEmpty(Model.Student.StudentInfo.Email) ? "-" : Model.Student.StudentInfo.Email)</span>
            </div>
            @if (Model.Student.Parent != null)
            {
                <div class="info-row">
                    <span class="info-label">@Localizer["Parent"]:</span>
                    <span class="info-value">@Model.Student.Parent.ParentInfo?.FirstName @Model.Student.Parent.ParentInfo?.SecondName</span>
                </div>
            }
            <div class="info-row">
                <span class="info-label">@Localizer["ClassesEnrolled"]:</span>
                <span class="info-value">@(Model.Student.Classes?.Count ?? 0)</span>
            </div>
        </div>
    </div>

    <!-- Wirds Section -->
    <div class="wirds-section">
        <div class="t-section-header">
            <h3 class="t-section-title">
                <i class='bx bx-list-check'></i>
                <span>@Localizer["AssignedWirds"]</span>
                <span class="t-badge t-badge-quran">@Model.TotalWirds</span>
            </h3>
        </div>

        @if (Model.PaginatedWirds != null && Model.PaginatedWirds.Any())
        {
            <div class="wirds-list">
                @foreach (var wird in Model.PaginatedWirds)
                {
                    var fromSurahName = wird.FromSurah != null && wird.FromSurah != Surah.NONE
                        ? Formatting.GetLocalizedSurahName(wird.FromSurah.Value)
                        : null;
                    var toSurahName = wird.ToSurah != null && wird.ToSurah != Surah.NONE
                        ? Formatting.GetLocalizedSurahName(wird.ToSurah.Value)
                        : null;

                    var hasFromData = fromSurahName != null || wird.FromJuz != null || wird.FromPage != null || !string.IsNullOrEmpty(wird.FromAyah);
                    var hasToData = toSurahName != null || wird.ToJuz != null || wird.ToPage != null || wird.ToAyah != null;

                    <div class="wird-item @(wird.IsUpcoming ? "is-upcoming" : "")">
                        <div class="wird-header">
                            <h4>@Localizer[wird.Type.ToString()]</h4>
                            <div class="d-flex align-items-center gap-1">
                                @if (wird.IsUpcoming)
                                {
                                    @await Html.PartialAsync("_UpcomingBadge")
                                }
                                <span class="wird-status-badge @(wird.IsCompleted ? "status-completed" : wird.Status == AssignmentStatus.notSet ? "status-pending" : "")">
                                    @Localizer[wird.Status.ToString()]
                                </span>
                            </div>
                        </div>

                        <div class="wird-meta-row">
                            <span><i class='bx bx-calendar'></i> @Localizer["Assigned"] @wird.AssignedDate.ToString("MMM dd, yyyy")</span>
                            @if (wird.IsCompleted)
                            {
                                <span class="wird-completed-badge"><i class='bx bx-check-circle'></i> @Localizer["Completed"]</span>
                            }
                        </div>

                        @if (hasFromData || hasToData)
                        {
                            <div class="wird-range-compact">
                                @if (hasFromData)
                                {
                                    <div class="wird-range-line">
                                        <strong>@Localizer["From"]</strong>
                                        <span class="wird-range-values">
                                            @if (fromSurahName != null)
                                            {
                                                <span>@Localizer["Surah"] <b>@fromSurahName</b></span>
                                            }
                                            @if (wird.FromJuz != null)
                                            {
                                                <span>@Localizer["Juz"] <b>@wird.FromJuz</b></span>
                                            }
                                            @if (wird.FromPage != null)
                                            {
                                                <span>@Localizer["Page"] <b>@wird.FromPage</b></span>
                                            }
                                            @if (!string.IsNullOrEmpty(wird.FromAyah))
                                            {
                                                <span>@Localizer["Ayah"] <b>@wird.FromAyah</b></span>
                                            }
                                        </span>
                                    </div>
                                }
                                @if (hasToData)
                                {
                                    <div class="wird-range-line">
                                        <strong>@Localizer["To"]</strong>
                                        <span class="wird-range-values">
                                            @if (toSurahName != null)
                                            {
                                                <span>@Localizer["Surah"] <b>@toSurahName</b></span>
                                            }
                                            @if (wird.ToJuz != null)
                                            {
                                                <span>@Localizer["Juz"] <b>@wird.ToJuz</b></span>
                                            }
                                            @if (wird.ToPage != null)
                                            {
                                                <span>@Localizer["Page"] <b>@wird.ToPage</b></span>
                                            }
                                            @if (wird.ToAyah != null)
                                            {
                                                <span>@Localizer["Ayah"] <b>@wird.ToAyah</b></span>
                                            }
                                        </span>
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="wird-range-compact">
                                <span class="wird-not-specified">@Localizer["NotSpecified"]</span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(wird.Note))
                        {
                            <div class="wird-note-compact">
                                <strong>@Localizer["Notes"]:</strong>
                                <span>@wird.Note</span>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Pagination Controls -->
            @if (Model.TotalPages > 1)
            {
                <div class="pagination-controls">
                    @if (Model.HasPrevious)
                    {
                        <a href="@Url.Action("Details", "Student", new { id = Model.Student.UserId, page = Model.CurrentPage - 1 })"
                           class="pagination-btn">
                            <i class='bx bx-chevron-right'></i>
                            @Localizer["Previous"]
                        </a>
                    }

                    <span class="pagination-info">
                        @string.Format(Localizer["PageOf"].Value, Model.CurrentPage, Model.TotalPages)
                    </span>

                    @if (Model.HasNext)
                    {
                        <a href="@Url.Action("Details", "Student", new { id = Model.Student.UserId, page = Model.CurrentPage + 1 })"
                           class="pagination-btn">
                            @Localizer["Next"]
                            <i class='bx bx-chevron-left'></i>
                        </a>
                    }
                </div>
            }
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-book-open'></i></div>
                <h4 class="t-empty-title">@Localizer["NoWirdsYet"]</h4>
                <p class="t-empty-text">لم يتم تسجيل أي أوراد قرآنية لهذا الطالب حتى الآن.</p>
            </div>
        }
    </div>

    <!-- سجل إنجاز واختبارات المتون المقررة -->
    <div class="matn-matrix-card mb-4">
        <div class="matn-matrix-header">
            <div class="matn-matrix-header-title">
                <div class="matn-title-icon">
                    <i class='bx bx-award'></i>
                </div>
                <div>
                    <h4 class="matn-matrix-title">سجل إنجاز واختبارات المتون العلمية المقررة</h4>
                    <span class="matn-matrix-subtitle">متابعة إتمام المدارسة والحفظ وتحديد الحالة ورصد نتائج ودرجات الاختبارات</span>
                </div>
            </div>
            <div class="d-flex align-items-center gap-2 flex-wrap">
                @if (Model.MatnProgresses != null && Model.MatnProgresses.Any())
                {
                    <span class="matn-count-badge">
                        <i class='bx bx-book-bookmark'></i>
                        <span>@Model.MatnProgresses.Count() متون مقررة</span>
                    </span>
                }
            </div>
        </div>

        @if (Model.MatnProgresses != null && Model.MatnProgresses.Any())
        {
            <div class="table-responsive">
                <table class="matn-matrix-table">
                    <thead>
                        <tr>
                            <th style="min-width: 200px;">المتن المقرر</th>
                            <th style="min-width: 140px;" class="text-center">حالة المدارسة</th>
                            <th style="min-width: 140px;" class="text-center">حالة الحفظ</th>
                            <th style="min-width: 160px;" class="text-center">الاختبار والدرجة</th>
                            <th style="min-width: 150px;">الملاحظات</th>
                            <th style="min-width: 130px;" class="text-center">تحديد ورصد</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prog in Model.MatnProgresses)
                        {
                            var passGrade = prog.PassingGrade > 0 ? prog.PassingGrade : 60m;
                            var isActuallyPassed = prog.ExamStatus == ExamStatus.Passed && (!prog.Score.HasValue || prog.Score.Value >= passGrade);
                            var isActuallyFailed = prog.ExamStatus == ExamStatus.Failed || (prog.Score.HasValue && prog.Score.Value < passGrade);

                            <tr class="teacher-matn-row"
                                data-student-id="@Model.Student.UserId"
                                data-student-name="@studentFullName"
                                data-matn-id="@prog.MatnId"
                                data-matn-title="@prog.MatnTitle"
                                data-study-status="@((int)prog.StudyStatus)"
                                data-mem-status="@((int)prog.MemorizationStatus)"
                                data-exam-status="@((int)prog.ExamStatus)"
                                data-score="@(prog.Score?.ToString() ?? "")"
                                data-exam-date="@(prog.ExamDate?.ToString("yyyy-MM-dd") ?? "")"
                                data-notes="@(prog.TeacherNotes ?? "")"
                                data-passing-grade="@passGrade">
                                <td>
                                    <div class="matn-cell-title">
                                        <span class="matn-num-tag">#@prog.MatnOrder</span>
                                        <span class="matn-name-text">@prog.MatnTitle</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(prog.MatnAuthor))
                                    {
                                        <div class="matn-cell-author">
                                            <i class='bx bx-feather text-muted'></i>
                                            <span>@prog.MatnAuthor</span>
                                        </div>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (prog.StudyStatus == StudyStatus.Completed)
                                    {
                                        <span class="matn-status-badge status-done clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-check-circle'></i> مكتمل
                                        </span>
                                        @if (prog.StudyCompletedAt.HasValue)
                                        {
                                            <div class="matn-date-sub">@prog.StudyCompletedAt.Value.ToString("yyyy-MM-dd")</div>
                                        }
                                    }
                                    else if (prog.StudyStatus == StudyStatus.InProgress)
                                    {
                                        <span class="matn-status-badge status-inprogress clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-loader-circle'></i> قيد الدراسة
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="matn-status-badge status-notstarted clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-minus'></i> لم يبدأ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (prog.MemorizationStatus == MemorizationStatus.Memorized)
                                    {
                                        <span class="matn-status-badge status-hifz-done clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-check-double'></i> تم الحفظ
                                        </span>
                                        @if (prog.MemorizationCompletedAt.HasValue)
                                        {
                                            <div class="matn-date-sub">@prog.MemorizationCompletedAt.Value.ToString("yyyy-MM-dd")</div>
                                        }
                                    }
                                    else if (prog.MemorizationStatus == MemorizationStatus.InProgress)
                                    {
                                        <span class="matn-status-badge status-hifz-inprogress clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-bookmarks'></i> قيد الحفظ
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="matn-status-badge status-notstarted clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل الحالة أو الدرجة">
                                            <i class='bx bx-minus'></i> لم يبدأ
                                        </span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (isActuallyPassed)
                                    {
                                        <span class="matn-status-badge status-exam-pass clickable-badge @(prog.Score >= 90 ? "high-score" : "")"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل نتيجة أو درجة الاختبار">
                                            <i class='bx @(prog.Score >= 90 ? "bxs-star text-warning" : "bx-award")'></i>
                                            <span>ناجح</span>
                                            @if (prog.Score.HasValue)
                                            {
                                                <span class="score-pill">@(prog.Score.Value.ToString("0.##"))%</span>
                                            }
                                        </span>
                                    }
                                    else if (isActuallyFailed)
                                    {
                                        <span class="matn-status-badge status-exam-fail clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لتعديل نتيجة أو درجة الاختبار">
                                            <i class='bx bx-x'></i>
                                            <span>راسب</span>
                                            @if (prog.Score.HasValue)
                                            {
                                                <span class="score-pill">@(prog.Score.Value.ToString("0.##"))%</span>
                                            }
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="matn-status-badge status-exam-none clickable-badge"
                                              onclick="openTeacherRowMatnModal(this)" title="انقر لرصد نتيجة الاختبار والدرجة">
                                            <i class='bx bx-minus'></i> لم يختبر
                                        </span>
                                    }
                                    @if (prog.ExamDate.HasValue)
                                    {
                                        <div class="matn-date-sub">
                                            <i class='bx bx-calendar'></i> @prog.ExamDate.Value.ToString("yyyy-MM-dd")
                                        </div>
                                    }
                                </td>
                                <td class="matn-notes-cell">
                                    @(string.IsNullOrEmpty(prog.TeacherNotes) ? "—" : prog.TeacherNotes)
                                </td>
                                <td class="text-center">
                                    <button type="button" class="btn-grade-action" onclick="openTeacherRowMatnModal(this)" title="تحديد حالة المتن ورصد درجة الاختبار">
                                        <i class='bx bx-slider-alt'></i>
                                        <span>تحديد ورصد</span>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="t-empty-state py-5">
                <div class="t-empty-icon"><i class='bx bx-book-open'></i></div>
                <h4 class="t-empty-title">لا توجد متون علمية مقررة مسجلة لهذا الطالب</h4>
                <p class="t-empty-text">يتم اعتماد المتون المقررة ورصد نتائج الاختبارات الرسمية من قبل إدارة المعهد.</p>
            </div>
        }
    </div>

    <!-- Parent Notes Section -->
    <div class="wirds-section notes-section">
        <div class="t-section-header">
            <h3 class="t-section-title">
                <i class='bx bx-message-square-detail'></i>
                <span>@Localizer["ParentNotes"]</span>
                @if (ViewBag.ParentNotes is IEnumerable<Hafiz.Models.ParentNote> notesForCount)
                {
                    <span class="t-badge t-badge-gold">@notesForCount.Count()</span>
                }
            </h3>
        </div>

        @{
            var parentNotes = ViewBag.ParentNotes as IEnumerable<Hafiz.Models.ParentNote> ?? new List<Hafiz.Models.ParentNote>();
        }

        <!-- Add New Note Form -->
        <div class="note-form-container">
            <h4><i class='bx bx-edit-alt me-1'></i> @Localizer["AddNewNote"]</h4>
            <form asp-area="Teacher" asp-controller="ParentNotes" asp-action="Create" method="post">
                <input type="hidden" name="studentId" value="@Model.Student.UserId" />
                <div class="note-form-field">
                    <textarea name="content" rows="2"
                              class="note-textarea"
                              placeholder="@Localizer["WritePlaceholder"]" required></textarea>
                </div>
                <button type="submit" class="t-btn t-btn-primary">
                    <i class='bx bx-plus-circle'></i> <span>@Localizer["AddNote"]</span>
                </button>
            </form>
        </div>

        <!-- Display Existing Notes -->
        @if (parentNotes.Any())
        {
            <div class="wirds-list">
                @foreach (var note in parentNotes)
                {
                    <div class="note-item">
                        <div class="note-header">
                            <div>
                                <div class="note-author">
                                    <i class='bx bx-user-circle'></i> @Localizer["By"] @note.CreatedByUser.FirstName @note.CreatedByUser.SecondName
                                </div>
                                <div class="note-date">
                                    <i class='bx bx-calendar'></i> @note.CreatedAt.ToUserTime(Context).ToString("MMM dd, yyyy 'at' h:mm tt")
                                    @if (note.UpdatedAt != null)
                                    {
                                        <span> · @Localizer["Updated"] @note.UpdatedAt.Value.ToUserTime(Context).ToString("MMM dd, yyyy")</span>
                                    }
                                </div>
                            </div>
                            @if (note.CreatedBy == Guid.Parse(User.FindFirstValue(System.Security.Claims.ClaimTypes.NameIdentifier)!))
                            {
                                <form asp-area="Teacher" asp-controller="ParentNotes" asp-action="Delete" method="post"
                                      style="display: inline;" onsubmit="return confirm('@Localizer["ConfirmDeleteNote"]');">
                                    <input type="hidden" name="noteId" value="@note.Id" />
                                    <input type="hidden" name="studentId" value="@Model.Student.UserId" />
                                    <button type="submit" class="note-delete-btn" title="حذف الملاحظة">
                                        <i class='bx bx-trash'></i>
                                    </button>
                                </form>
                            }
                        </div>
                        <div class="note-content">
                            <p>@note.Content</p>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="t-empty-state">
                <div class="t-empty-icon"><i class='bx bx-message-square-x'></i></div>
                <h4 class="t-empty-title">@Localizer["NoNotesYet"]</h4>
                <p class="t-empty-text">لا توجد ملاحظات مرسلة لولي الأمر لهذا الطالب حتى الآن.</p>
            </div>
        }
    </div>

</div>

<!-- Include Modals -->
@await Html.PartialAsync("_StudentRoutinePlanModal")

