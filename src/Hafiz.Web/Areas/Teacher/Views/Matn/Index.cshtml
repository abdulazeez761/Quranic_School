@model IEnumerable<Hafiz.DTOs.Matn.MatnAssignmentDto>
@using Hafiz.Domain.Enums
@using Hafiz.Models
@{
    var cls = ViewBag.Class as Hafiz.DTOs.ClassDto;
    var teacherClasses = (ViewBag.TeacherClasses as IEnumerable<Hafiz.Models.Class>) ?? Enumerable.Empty<Hafiz.Models.Class>();
    var noClasses = (ViewBag.NoClasses as bool?) == true || cls == null;
    var targetDate = (DateTime)(ViewBag.TargetDate ?? DateTime.Today);
    var matnProgresses = (ViewBag.MatnProgresses as IEnumerable<Hafiz.DTOs.Matn.StudentMatnProgressDto>) ?? Enumerable.Empty<Hafiz.DTOs.Matn.StudentMatnProgressDto>();
    var classMatuns = (ViewBag.ClassMatuns as IEnumerable<Hafiz.DTOs.StudyProgram.MatnSummaryDto>) ?? Enumerable.Empty<Hafiz.DTOs.StudyProgram.MatnSummaryDto>();
    var studentsList = (ViewBag.Students as List<SelectListItem>) ?? new List<SelectListItem>();

    ViewData["Title"] = cls != null ? $"المتون العلمية - {cls.Name}" : "المتون العلمية";
    Layout = "~/Views/Shared/_TeacherLayout.cshtml";
}

<link rel="stylesheet" href="~/css/teacher/matn-progress.css" asp-append-version="true" />

<div class="container-fluid py-2" dir="rtl">
    @if (noClasses)
    {
        <div class="t-empty-state py-5 mt-4">
            <div class="t-empty-icon" style="background: var(--t-matn-light, #e0f2fe); color: var(--t-matn, #0284c7);">
                <i class='bx bx-bookmarks'></i>
            </div>
            <h4 class="t-empty-title">لا توجد حلقات مسندة إليك حالياً</h4>
            <p class="t-empty-text">
                لم يتم إسناد أي حلقة إلى حسابك حتى الآن. يرجى مراجعة إدارة المركز لإسناد حلقة لك لتتمكن من رصد تسميع المتون العلمية ومتابعة إنجاز الطلاب.
            </p>
            <a asp-controller="Home" asp-action="Index" class="t-btn t-btn-outline mt-2">
                <i class='bx bx-right-arrow-alt me-1'></i> العودة للرئيسية
            </a>
        </div>
    }
    else
    {
        <!-- Header Hub Banner -->
        <div class="matn-hub-header">
            <div class="matn-hub-info">
                <div class="matn-hub-title-row">
                    <span class="matn-program-tag">
                        <i class='bx bx-bookmarks'></i> شعبة متون علمية
                    </span>
                    <h2 class="matn-hub-title">@cls!.Name</h2>
                </div>
                <div class="matn-hub-meta">
                    <span>البرنامج العلمي: <strong>@(cls.StudyProgramName ?? "المتون العلمية")</strong></span>
                    <span>·</span>
                    <span>المتون المقررة: <strong>@classMatuns.Count()</strong></span>
                    <span>·</span>
                    <span>الطلاب: <strong>@studentsList.Count</strong></span>
                </div>
            </div>

            <div class="matn-hub-controls">
                @if (teacherClasses.Count() > 1)
                {
                    <form method="get" class="d-inline-flex align-items-center">
                        <input type="hidden" name="date" value="@targetDate.ToString("yyyy-MM-dd")" />
                        <select name="classId" class="matn-control-select" onchange="this.form.submit()">
                            @foreach (var c in teacherClasses)
                            {
                                <option value="@c.Id" selected="@(c.Id == cls.Id ? "selected" : null)">
                                    حلقة: @c.Name @(c.StudyProgram != null ? $"({c.StudyProgram.Name})" : "")
                                </option>
                            }
                        </select>
                    </form>
                }
                <form method="get" class="d-inline-flex">
                    <input type="hidden" name="classId" value="@cls.Id" />
                    <input type="date" name="date" class="matn-control-date"
                           value="@targetDate.ToString("yyyy-MM-dd")" onchange="this.form.submit()" />
                </form>
                <a asp-action="ExportExcel" asp-route-classId="@cls.Id" asp-route-date="@targetDate.ToString("yyyy-MM-dd")"
                   class="matn-control-btn">
                    <i class='bx bx-file'></i> <span>Excel</span>
                </a>
                <a asp-controller="Home" asp-action="Index" class="matn-control-btn">
                    <i class='bx bx-grid-alt'></i> <span>الحلقات</span>
                </a>
            </div>
        </div>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                <i class='bx bx-check-circle me-1 fs-5 align-middle'></i>
                <span>@TempData["SuccessMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                <i class='bx bx-error-circle me-1 fs-5 align-middle'></i>
                <span>@TempData["ErrorMessage"]</span>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }

        <!-- Segmented Tab Navigation -->
        <ul class="nav matn-nav-pills" id="matnTabs" role="tablist">
            <li class="nav-item" role="presentation">
                <button class="nav-link active" id="daily-tab" type="button"
                        onclick="switchMatnTab('daily')">
                    <i class='bx bx-calendar-check fs-5'></i>
                    <span>الورد والتسميع اليومي</span>
                </button>
            </li>
            <li class="nav-item" role="presentation">
                <button class="nav-link" id="progress-tab" type="button"
                        onclick="switchMatnTab('progress')">
                    <i class='bx bx-award fs-5'></i>
                    <span>متابعة إنجاز المتون وحالات الطلاب ورصد الدرجات</span>
                    @if (matnProgresses.Any())
                    {
                        <span class="matn-tab-badge">@matnProgresses.Count()</span>
                    }
                </button>
            </li>
        </ul>

        <!-- =================================================================== -->
        <!-- TAB 1: الورد والتسميع اليومي                                        -->
        <!-- =================================================================== -->
        <div id="matnDailySection" style="display: block;">
            <div class="matn-table-card">
                <div class="matn-table-card-header">
                    <h5 class="matn-form-card-title">
                        <i class='bx bx-list-check text-primary fs-5'></i>
                        <span>سجل تسميع المتون لليوم (@targetDate.ToString("yyyy-MM-dd"))</span>
                    </h5>
                    <span class="badge bg-primary fs-6 fw-bold">@Model.Count() تسميع</span>
                </div>
                        <div class="table-responsive">
                            <table class="matn-table">
                                <thead>
                                    <tr>
                                        <th>الطالب</th>
                                        <th>نوع الأداء</th>
                                        <th>المتن والموضع</th>
                                        <th>التقييم</th>
                                        <th>ملاحظات</th>
                                        <th class="text-center" style="width: 70px;">حذف</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (!Model.Any())
                                    {
                                        <tr>
                                            <td colspan="6" class="text-center py-5 text-muted">
                                                <i class='bx bx-calendar-x fs-1 d-block mb-2 text-secondary'></i>
                                                لا توجد تسميعات مسجلة لهذا اليوم (@targetDate.ToString("yyyy-MM-dd")).
                                                <div class="small mt-1 text-muted">استخدم النموذج على اليمين لتسجيل تسميع جديد للطلاب.</div>
                                            </td>
                                        </tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in Model)
                                        {
                                            <tr>
                                                <td>
                                                    <div class="matn-student-cell">
                                                        <div class="matn-student-avatar">
                                                            @(!string.IsNullOrEmpty(item.StudentName) ? item.StudentName.Substring(0, 1) : "ط")
                                                        </div>
                                                        <div>
                                                            <div class="matn-student-name">@item.StudentName</div>
                                                            @if (item.AssignedDate != default)
                                                            {
                                                                <div class="text-muted small" style="font-size: 11px;">
                                                                    <i class='bx bx-time-five'></i> @item.AssignedDate.ToLocalTime().ToString("hh:mm tt")
                                                                </div>
                                                            }
                                                        </div>
                                                    </div>
                                                </td>
                                                <td>
                                                    @{
                                                        var pColor = item.PerformanceType switch
                                                        {
                                                            MatnPerformanceType.Memorization => "#2563eb",
                                                            MatnPerformanceType.Revision => "#059669",
                                                            _ => "#d97706"
                                                        };
                                                        var pBg = item.PerformanceType switch
                                                        {
                                                            MatnPerformanceType.Memorization => "#eff6ff",
                                                            MatnPerformanceType.Revision => "#ecfdf5",
                                                            _ => "#fffbeb"
                                                        };
                                                    }
                                                    <span class="status-pill" style="background: @pBg; color: @pColor; border-color: @pColor;">
                                                        @item.PerformanceTypeName
                                                    </span>
                                                </td>
                                                <td>
                                                    <div class="fw-bold text-dark">@item.MatnTitle</div>
                                                    @if (item.FromNumber.HasValue && item.ToNumber.HasValue)
                                                    {
                                                        <span class="text-muted small">من @item.FromNumber إلى @item.ToNumber (@item.UnitName)</span>
                                                    }
                                                    else if (item.Amount.HasValue)
                                                    {
                                                        <span class="text-muted small">@item.Amount @item.UnitName</span>
                                                    }
                                                    @if (!string.IsNullOrEmpty(item.ChapterName))
                                                    {
                                                        <span class="text-muted small d-block">(@item.ChapterName)</span>
                                                    }
                                                </td>
                                                <td>
                                                    @{
                                                        var (rateClass, rateText) = item.Status switch
                                                        {
                                                            AssignmentStatus.excellent => ("rate-excellent", "ممتاز 🌟"),
                                                            AssignmentStatus.veryGood => ("rate-verygood", "جيد جداً"),
                                                            AssignmentStatus.good => ("rate-good", "جيد"),
                                                            AssignmentStatus.fair => ("rate-fair", "مقبول"),
                                                            AssignmentStatus.poor => ("rate-poor", "ضعيف"),
                                                            _ => ("rate-notset", "لم يحدد")
                                                        };
                                                    }
                                                    <span class="rating-chip-label @rateClass d-inline-block py-1 px-2" style="pointer-events: none;">
                                                        @rateText
                                                    </span>
                                                </td>
                                                <td class="small text-muted" style="max-width: 140px;">
                                                    @(string.IsNullOrEmpty(item.Note) ? "—" : item.Note)
                                                </td>
                                                <td class="text-center">
                                                    <form asp-action="Delete" asp-route-id="@item.Id"
                                                          asp-route-classId="@cls?.Id"
                                                          asp-route-date="@targetDate.ToString("yyyy-MM-dd")" method="post"
                                                          class="d-inline" onsubmit="return confirm('هل تريد بالتأكيد حذف هذا التسميع؟');">
                                                        @Html.AntiForgeryToken()
                                                        <button type="submit" class="btn btn-sm btn-outline-danger p-1 border-0" title="حذف">
                                                            <i class='bx bx-trash fs-5'></i>
                                                        </button>
                                                    </form>
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>

        <!-- =================================================================== -->
        <!-- TAB 2: متابعة إنجاز المتون وحالات الطلاب ورصد الدرجات                  -->
        <!-- =================================================================== -->
        <div id="matnProgressSection" style="display: none;">
            <!-- بطاقات مؤشرات الأداء الإحصائية (KPIs) -->
            <div class="matn-kpi-grid">
                <div class="matn-kpi-card kpi-blue">
                    <div class="matn-kpi-icon"><i class='bx bx-bookmarks'></i></div>
                    <div class="matn-kpi-content">
                        <span class="matn-kpi-label">المتون المقررة في المنهج</span>
                        <span class="matn-kpi-value">@classMatuns.Count()</span>
                    </div>
                </div>
                <div class="matn-kpi-card kpi-emerald">
                    <div class="matn-kpi-icon"><i class='bx bx-book-open'></i></div>
                    <div class="matn-kpi-content">
                        <span class="matn-kpi-label">سجلات المدارسة المكتملة</span>
                        <span class="matn-kpi-value">@matnProgresses.Count(p => p.StudyStatus == StudyStatus.Completed)</span>
                    </div>
                </div>
                <div class="matn-kpi-card kpi-violet">
                    <div class="matn-kpi-icon"><i class='bx bx-check-double'></i></div>
                    <div class="matn-kpi-content">
                        <span class="matn-kpi-label">سجلات الحفظ التام</span>
                        <span class="matn-kpi-value">@matnProgresses.Count(p => p.MemorizationStatus == MemorizationStatus.Memorized)</span>
                    </div>
                </div>
                <div class="matn-kpi-card kpi-amber">
                    <div class="matn-kpi-icon"><i class='bx bx-award'></i></div>
                    <div class="matn-kpi-content">
                        <span class="matn-kpi-label">الاختبارات المجتازة بنجاح</span>
                        <span class="matn-kpi-value">@matnProgresses.Count(p => p.ExamStatus == ExamStatus.Passed)</span>
                    </div>
                </div>
            </div>

            <!-- شريط الفلترة الذكي حسب المتن والبحث بالاسم -->
            <div class="matn-filter-bar">
                <div class="matn-pills-filter">
                    <span class="small fw-bold text-muted me-1">عرض المتن:</span>
                    <button type="button" class="filter-chip active" onclick="filterByMatn('all', this)">
                        <i class='bx bx-layer'></i> جميع المتون
                    </button>
                    @foreach (var m in classMatuns)
                    {
                        <button type="button" class="filter-chip" onclick="filterByMatn('@m.Id', this)">
                            <span>#@m.Order</span> @m.Title
                        </button>
                    }
                </div>
                <div class="filter-search-box">
                    <i class='bx bx-search filter-search-icon'></i>
                    <input type="text" id="studentSearchInput" placeholder="بحث باسم الطالب..." oninput="filterStudents(this.value)" />
                </div>
            </div>

            <!-- جدول مصفوفة تقدم الطلاب في المتون بتصميم واضح ومرتب -->
            <div class="matn-table-card">
                <div class="table-responsive">
                    <table class="matn-table" id="matrixTable">
                        <thead>
                            <tr>
                                <th style="min-width: 170px;">الطالب</th>
                                <th style="min-width: 160px;">المتن المقرر</th>
                                <th class="text-center" style="min-width: 120px;">حالة المدارسة</th>
                                <th class="text-center" style="min-width: 120px;">حالة الحفظ</th>
                                <th class="text-center" style="min-width: 150px;">الاختبار والدرجة</th>
                                <th style="min-width: 140px;">ملاحظات المعلم</th>
                                <th class="text-center" style="min-width: 170px;">إجراءات ورصد الدرجة</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!studentsList.Any())
                            {
                                <tr>
                                    <td colspan="7" class="text-center py-5 text-muted">
                                        <i class='bx bx-user-x fs-1 d-block mb-2 text-secondary'></i>
                                        لا يوجد طلاب مسجلون في هذه الحلقة حالياً.
                                    </td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var student in studentsList)
                                {
                                    var sGuid = Guid.TryParse(student.Value, out var parsedGuid) ? parsedGuid : Guid.Empty;
                                    var firstLetter = !string.IsNullOrEmpty(student.Text) ? student.Text.Substring(0, 1) : "ط";
                                    @foreach (var matn in classMatuns)
                                    {
                                        var prog = matnProgresses.FirstOrDefault(p => p.StudentId == sGuid && p.MatnId == matn.Id);
                                        var studySt = prog?.StudyStatus ?? StudyStatus.NotStarted;
                                        var memSt = prog?.MemorizationStatus ?? MemorizationStatus.NotStarted;
                                        var examSt = prog?.ExamStatus ?? ExamStatus.NotTested;
                                        var score = prog?.Score;
                                        var notes = prog?.TeacherNotes ?? "";
                                        var examDateStr = prog?.ExamDate?.ToString("yyyy-MM-dd") ?? "";

                                        var matnPassingGrade = matn.PassingGrade > 0 ? matn.PassingGrade : (prog?.PassingGrade > 0 ? prog.PassingGrade : 60m);
                                        var isActuallyPassed = examSt == ExamStatus.Passed && (!score.HasValue || score.Value >= matnPassingGrade);
                                        var isActuallyFailed = examSt == ExamStatus.Failed || (score.HasValue && score.Value < matnPassingGrade);

                                        <tr class="matrix-student-row"
                                            data-student-id="@student.Value"
                                            data-student-name="@student.Text"
                                            data-matn-id="@matn.Id"
                                            data-matn-title="@matn.Title"
                                            data-study-status="@((int)studySt)"
                                            data-mem-status="@((int)memSt)"
                                            data-exam-status="@((int)examSt)"
                                            data-score="@(score?.ToString() ?? "")"
                                            data-exam-date="@examDateStr"
                                            data-notes="@notes"
                                            data-passing-grade="@matnPassingGrade">
                                            <td>
                                                <div class="matn-student-cell">
                                                    <div class="matn-student-avatar">@firstLetter</div>
                                                    <div>
                                                        <a asp-controller="Student" asp-action="Details"
                                                           asp-route-id="@student.Value" class="matn-student-name">
                                                            @student.Text
                                                        </a>
                                                    </div>
                                                </div>
                                            </td>
                                            <td>
                                                <div class="matn-title-pill">
                                                    <span class="matn-order-badge">#@matn.Order</span>
                                                    <span>@matn.Title</span>
                                                </div>
                                                @if (!string.IsNullOrEmpty(matn.Author))
                                                {
                                                    <div class="text-muted small mt-1" style="font-size: 11px;">@matn.Author</div>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (studySt == StudyStatus.Completed)
                                                {
                                                    <span class="status-pill status-study-completed" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-check-circle'></i> مكتمل
                                                    </span>
                                                }
                                                else if (studySt == StudyStatus.InProgress)
                                                {
                                                    <span class="status-pill status-study-inprogress" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-book-open'></i> قيد المدارسة
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill status-study-notstarted" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-circle'></i> لم يبدأ
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (memSt == MemorizationStatus.Memorized)
                                                {
                                                    <span class="status-pill status-mem-done" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-check-double'></i> تم الحفظ
                                                    </span>
                                                }
                                                else if (memSt == MemorizationStatus.InProgress)
                                                {
                                                    <span class="status-pill status-mem-inprogress" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-time'></i> قيد الحفظ
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill status-mem-notstarted" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-circle'></i> لم يبدأ
                                                    </span>
                                                }
                                            </td>
                                            <td class="text-center">
                                                @if (isActuallyPassed)
                                                {
                                                    <span class="status-pill status-exam-pass" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-award'></i>
                                                        <span>ناجح</span>
                                                        @if (score.HasValue)
                                                        {
                                                            <span class="score-badge">@(score.Value.ToString("0.##"))%</span>
                                                        }
                                                    </span>
                                                }
                                                else if (isActuallyFailed)
                                                {
                                                    <span class="status-pill status-exam-fail" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-x'></i>
                                                        <span>راسب</span>
                                                        @if (score.HasValue)
                                                        {
                                                            <span class="score-badge">@(score.Value.ToString("0.##"))%</span>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-pill status-exam-none" style="cursor: pointer;" title="انقر لتعديل ورصد الدرجة" onclick="openRowProgressModal(this)">
                                                        <i class='bx bx-minus'></i> لم يختبر
                                                    </span>
                                                }
                                                @if (!string.IsNullOrEmpty(examDateStr))
                                                {
                                                    <div class="text-muted small mt-1" style="font-size: 10px;">
                                                        <i class='bx bx-calendar'></i> @examDateStr
                                                    </div>
                                                }
                                            </td>
                                            <td class="small text-muted">
                                                @(string.IsNullOrEmpty(notes) ? "—" : (notes.Length > 25 ? notes.Substring(0, 25) + "..." : notes))
                                            </td>
                                            <td class="text-center">
                                                <button type="button" class="btn-grade-action" onclick="openRowProgressModal(this)">
                                                    <i class='bx bx-slider-alt'></i>
                                                    <span>تحديد الحالة ورصد الدرجة</span>
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        @await Html.PartialAsync("_MatnProgressModal")
    }
</div>

@section Scripts {
    <script>
        function switchMatnTab(tabKey) {
            const dailyTab = document.getElementById('daily-tab');
            const progressTab = document.getElementById('progress-tab');
            const dailySec = document.getElementById('matnDailySection');
            const progressSec = document.getElementById('matnProgressSection');

            if (!dailyTab || !progressTab || !dailySec || !progressSec) return;

            if (tabKey === 'progress') {
                dailyTab.classList.remove('active');
                dailyTab.setAttribute('aria-selected', 'false');
                progressTab.classList.add('active');
                progressTab.setAttribute('aria-selected', 'true');

                dailySec.style.setProperty('display', 'none', 'important');
                progressSec.style.setProperty('display', 'block', 'important');

                if (history.replaceState) {
                    history.replaceState(null, '', window.location.pathname + window.location.search + '#progress');
                }
            } else {
                progressTab.classList.remove('active');
                progressTab.setAttribute('aria-selected', 'false');
                dailyTab.classList.add('active');
                dailyTab.setAttribute('aria-selected', 'true');

                progressSec.style.setProperty('display', 'none', 'important');
                dailySec.style.setProperty('display', 'block', 'important');

                if (history.replaceState) {
                    history.replaceState(null, '', window.location.pathname + window.location.search + '#daily');
                }
            }
        }

        // Filter Matrix Table by Matn
        function filterByMatn(matnId, chipEl) {
            document.querySelectorAll('.filter-chip').forEach(c => c.classList.remove('active'));
            chipEl.classList.add('active');

            const rows = document.querySelectorAll('.matrix-student-row');
            rows.forEach(row => {
                const rowMatnId = row.getAttribute('data-matn-id');
                if (matnId === 'all' || rowMatnId === matnId) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        // Live Search Filter by Student Name
        function filterStudents(searchVal) {
            const term = (searchVal || '').trim().toLowerCase();
            const rows = document.querySelectorAll('.matrix-student-row');
            const activeMatnChip = document.querySelector('.filter-chip.active');
            const activeMatnId = activeMatnChip ? activeMatnChip.getAttribute('onclick').match(/'([^']+)'/)[1] : 'all';

            rows.forEach(row => {
                const studentName = (row.getAttribute('data-student-name') || '').toLowerCase();
                const rowMatnId = row.getAttribute('data-matn-id');
                const matchesMatn = (activeMatnId === 'all' || rowMatnId === activeMatnId);
                const matchesSearch = !term || studentName.indexOf(term) !== -1;

                if (matchesMatn && matchesSearch) {
                    row.style.display = '';
                } else {
                    row.style.display = 'none';
                }
            });
        }

        function openRowProgressModal(el) {
            const row = el.closest('tr');
            if (!row) return;
            const studentId = row.getAttribute('data-student-id');
            const studentName = row.getAttribute('data-student-name');
            const matnId = row.getAttribute('data-matn-id');
            const matnTitle = row.getAttribute('data-matn-title');
            const studyStatus = parseInt(row.getAttribute('data-study-status')) || 0;
            const memStatus = parseInt(row.getAttribute('data-mem-status')) || 0;
            const examStatus = parseInt(row.getAttribute('data-exam-status')) || 0;
            const score = row.getAttribute('data-score');
            const examDate = row.getAttribute('data-exam-date');
            const notes = row.getAttribute('data-notes');
            const passingGrade = parseFloat(row.getAttribute('data-passing-grade')) || 60;
            openProgressModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade);
        }

        // Auto-activate tab based on URL hash or query parameter
        function initMatnTabs() {
            const hash = (window.location.hash || '').toLowerCase();
            const urlParams = new URLSearchParams(window.location.search);
            const tabParam = (urlParams.get('tab') || '').toLowerCase();

            if (hash.indexOf('progress') !== -1 || tabParam === 'progress') {
                switchMatnTab('progress');
            } else {
                switchMatnTab('daily');
            }
        }

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', initMatnTabs);
        } else {
            initMatnTabs();
        }

        window.addEventListener('hashchange', initMatnTabs);
    </script>
}
