@model Hafiz.DTOs.Matn.MatnAssignmentDto
@using Hafiz.Domain.Enums
@using Hafiz.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var statusClass = Model.Status.ToString().ToLower();
    var statusArabic = Model.Status switch
    {
        AssignmentStatus.excellent => "ممتاز",
        AssignmentStatus.veryGood => "جيد جداً",
        AssignmentStatus.good => "جيد",
        AssignmentStatus.fair => "مقبول",
        AssignmentStatus.poor => "ضعيف",
        _ => "لم يُحدد"
    };

    var stripeClass = Model.PerformanceType switch
    {
        MatnPerformanceType.Memorization => "memorization",
        MatnPerformanceType.Revision => "revision",
        MatnPerformanceType.Mudarasah => "mudarasah",
        _ => "memorization"
    };

    var perfIcon = Model.PerformanceType switch
    {
        MatnPerformanceType.Memorization => "bx-plus-circle",
        MatnPerformanceType.Revision => "bx-sync",
        MatnPerformanceType.Mudarasah => "bx-book-reader",
        _ => "bx-bookmarks"
    };

    var initials = (Model.StudentName ?? string.Empty)
        .Split(' ', StringSplitOptions.RemoveEmptyEntries)
        .Take(2)
        .Select(s => s[0].ToString())
        .Aggregate("", (a, b) => a + b);

    var isToday = Model.AssignedDate.Date == DateTime.UtcNow.Date 
        || Model.AssignedDate.ToLocalTime().Date == DateTime.Today
        || Model.AssignedDate.Date == DateTime.Today;
    var isUnrated = Model.Status == AssignmentStatus.notSet && !Model.IsUpcoming;
    var isCompleted = (Model.Status != AssignmentStatus.notSet) || Model.IsCompleted;
}

<div id="wird-card-@Model.Id" class="wird-card matn-card @statusClass @(Model.IsUpcoming ? "is-upcoming" : "")"
     data-student="@Model.StudentName" data-type="@Model.PerformanceTypeName"
     data-status="@statusClass" data-upcoming="@(Model.IsUpcoming ? "true" : "false")"
     data-date="@Model.AssignedDate.ToString("yyyy-MM-dd")"
     data-is-today="@(isToday ? "true" : "false")"
     data-is-unrated="@(isUnrated ? "true" : "false")"
     data-is-completed="@(isCompleted ? "true" : "false")">

    <!-- Top Accent Stripe -->
    <div class="matn-card-stripe @stripeClass"></div>

    <!-- CARD HEADER: Student Profile & Status -->
    <div class="wird-card-header">
        <div class="wird-header-title">
            <div class="d-flex align-items-center gap-2">
                <div class="matn-student-avatar">
                    @(string.IsNullOrEmpty(initials) ? "ط" : initials)
                </div>
                <h3 class="student-name mb-0">@Model.StudentName</h3>
            </div>
            <div class="d-flex align-items-center gap-1">
                @if (Model.IsUpcoming)
                {
                    @await Html.PartialAsync("_UpcomingBadge")
                }
                else
                {
                    <span class="wird-status-badge status-@statusClass">@statusArabic</span>
                }
            </div>
        </div>
        <div class="wird-meta">
            <span class="wird-type-badge matn-badge">
                <i class='bx @perfIcon'></i>
                @Model.PerformanceTypeName
            </span>
            <span class="wird-date-badge">
                <i class='bx bx-calendar'></i>
                @Model.AssignedDate.ToString("MMM dd")
            </span>
        </div>
    </div>

    <!-- RECITATION DETAILS BOX -->
    @{
        var hasChapter = !string.IsNullOrWhiteSpace(Model.ChapterName);
        var hasRange = Model.FromNumber.HasValue || Model.ToNumber.HasValue;
        var hasAmount = Model.Amount.HasValue;
    }
    @if (hasChapter || hasRange || hasAmount)
    {
        <div class="matn-recitation-box">
            @if (hasChapter)
            {
                <div class="matn-chapter-badge">
                    <i class='bx bx-book-bookmark'></i>
                    <span class="matn-chapter-text">@Model.ChapterName</span>
                </div>
            }

            <div class="matn-range-flow">
                @if (hasRange)
                {
                    <div class="matn-range-pills">
                        <span class="matn-unit-label">@Model.UnitName:</span>
                        @if (Model.FromNumber.HasValue && Model.ToNumber.HasValue)
                        {
                            <span class="matn-range-pill">@Model.FromNumber</span>
                            <span class="matn-range-arrow"><i class='bx bx-left-arrow-alt'></i></span>
                            <span class="matn-range-pill">@Model.ToNumber</span>
                        }
                        else if (Model.FromNumber.HasValue)
                        {
                            <span class="matn-range-pill">من @Model.FromNumber</span>
                        }
                        else if (Model.ToNumber.HasValue)
                        {
                            <span class="matn-range-pill">إلى @Model.ToNumber</span>
                        }
                    </div>
                }

                @if (hasAmount)
                {
                    <div class="matn-amount-pill">
                        <i class='bx bx-layer'></i>
                        <span>@(Model.Amount?.ToString("0.##")) @Model.UnitName</span>
                    </div>
                }
            </div>
        </div>
    }

    <!-- TEACHER NOTE (if exists) -->
    @if (!string.IsNullOrEmpty(Model.Note))
    {
        <div class="wird-note">
            <i class='bx bx-note'></i>
            <p>@Model.Note</p>
        </div>
    }

    <!-- NOTES EDIT SECTION (Hidden by default) -->
    <div class="notes-edit" id="notes-edit-@Model.Id" style="display: none;">
        <textarea class="notes-textarea" id="notes-textarea-@Model.Id"
                  placeholder="@Localizer["AddNotes"]">@Model.Note</textarea>
        <div class="notes-edit-actions">
            <button class="btn btn-success btn-sm save-note-btn"
                    data-assignment-id="@Model.Id">@Localizer["Save"]</button>
            <button class="btn btn-secondary btn-sm cancel-note-btn"
                    data-assignment-id="@Model.Id">@Localizer["Cancel"]</button>
        </div>
    </div>

    <!-- FOOTER: Segmented Rating + Actions -->
    <div class="card-footer">
        <div class="rating-segmented">
            <button type="button" class="seg-btn seg-excellent status-button @(!Model.IsUpcoming && Model.Status == AssignmentStatus.excellent ? "active" : "")"
                    data-status="@AssignmentStatus.excellent" data-id="@Model.Id" title="ممتاز">
                ممتاز
            </button>
            <button type="button" class="seg-btn seg-verygood status-button @(!Model.IsUpcoming && Model.Status == AssignmentStatus.veryGood ? "active" : "")"
                    data-status="@AssignmentStatus.veryGood" data-id="@Model.Id" title="جيد جداً">
                جيد جداً
            </button>
            <button type="button" class="seg-btn seg-good status-button @(!Model.IsUpcoming && Model.Status == AssignmentStatus.good ? "active" : "")"
                    data-status="@AssignmentStatus.good" data-id="@Model.Id" title="جيد">
                جيد
            </button>
            <button type="button" class="seg-btn seg-fair status-button @(!Model.IsUpcoming && Model.Status == AssignmentStatus.fair ? "active" : "")"
                    data-status="@AssignmentStatus.fair" data-id="@Model.Id" title="مقبول">
                مقبول
            </button>
            <button type="button" class="seg-btn seg-poor status-button @(!Model.IsUpcoming && Model.Status == AssignmentStatus.poor ? "active" : "")"
                    data-status="@AssignmentStatus.poor" data-id="@Model.Id" title="ضعيف">
                ضعيف
            </button>
        </div>

        <div class="card-actions">
            <button type="button" class="card-action-btn" data-assignment-id="@Model.Id" title="إضافة ملاحظات">
                <i class='bx bx-note'></i>
            </button>
            <button type="button" class="card-action-btn"
                    onclick="openEditMatnModal('@Model.Id', '@Model.StudentId', '@Model.StudentName')"
                    title="تعديل">
                <i class='bx bx-edit'></i>
            </button>
            <form method="post" asp-controller="Wird" asp-action="Delete" asp-route-id="@Model.Id"
                  class="d-inline delete-form">
                @Html.AntiForgeryToken()
                <button type="submit" class="card-action-btn danger"
                        data-confirm-delete="@Localizer["ConfirmDelete"] @Model.StudentName"
                        title="حذف">
                    <i class='bx bx-trash'></i>
                </button>
            </form>
        </div>
    </div>

</div>
