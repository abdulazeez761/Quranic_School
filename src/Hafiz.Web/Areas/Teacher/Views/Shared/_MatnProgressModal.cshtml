<!-- =================================================================== -->
<!-- النافذة المنبثقة: تحديد حالة الطالب مع المتن ورصد الدرجة                -->
<!-- =================================================================== -->
<div class="matn-modal-overlay" id="matnProgressModal" tabindex="-1" aria-labelledby="matnProgressModalLabel" aria-hidden="true" dir="rtl" style="display: none;" onclick="if(event.target === this) closeProgressModal()">
    <div class="matn-modal-dialog">
        <div class="matn-modal-card">
            <div class="matn-modal-header">
                <h5 class="matn-modal-title" id="matnProgressModalLabel">
                    <i class='bx bx-award fs-5'></i>
                    <span>تحديد حالة المتن ورصد الدرجة</span>
                </h5>
                <button type="button" class="matn-modal-close" aria-label="Close" onclick="closeProgressModal()">
                    <i class='bx bx-x'></i>
                </button>
            </div>
            <form id="matnProgressForm" onsubmit="saveMatnProgress(event)">
                <div class="matn-modal-body">
                    <input type="hidden" id="modalStudentId" name="studentId" />
                    <input type="hidden" id="modalMatnId" name="matnId" />

                    <!-- بطاقة سياق الطالب والمتن ودرجة النجاح -->
                    <div class="matn-context-banner">
                        <div class="matn-context-row">
                            <span class="matn-context-label">اسم الطالب:</span>
                            <span class="matn-context-val" id="modalStudentName">-</span>
                        </div>
                        <div class="matn-context-row">
                            <span class="matn-context-label">المتن المقرر:</span>
                            <span class="matn-context-val text-primary" id="modalMatnTitle">-</span>
                        </div>
                        <div class="matn-context-row">
                            <span class="matn-context-label">علامة النجاح المعتمدة:</span>
                            <span class="matn-context-val badge bg-info text-white" id="modalPassingGrade">60%</span>
                        </div>
                    </div>

                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="matn-label">
                                <i class='bx bx-book-open text-success'></i>
                                <span>حالة المدارسة</span>
                            </label>
                            <select id="modalStudyStatus" name="studyStatus" class="matn-select">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد المدارسة</option>
                                <option value="2">مكتمل</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="matn-label">
                                <i class='bx bx-bookmarks text-primary'></i>
                                <span>حالة الحفظ</span>
                            </label>
                            <select id="modalMemorizationStatus" name="memorizationStatus" class="matn-select">
                                <option value="0">لم يبدأ</option>
                                <option value="1">قيد الحفظ</option>
                                <option value="2">تم الحفظ</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="matn-label">
                                <i class='bx bx-check-shield text-warning'></i>
                                <span>نتيجة الاختبار</span>
                            </label>
                            <select id="modalExamStatus" name="examStatus" class="matn-select" onchange="onExamStatusChanged(this.value)">
                                <option value="0">لم يختبر بعد</option>
                                <option value="1">اجتاز بنجاح (ناجح)</option>
                                <option value="2">لم يجتز (راسب)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="matn-label">
                                <i class='bx bx-calendar-event text-secondary'></i>
                                <span>تاريخ الاختبار</span>
                            </label>
                            <input type="date" id="modalExamDate" name="examDate" class="matn-input" />
                        </div>

                        <div class="col-12">
                            <div class="p-3 bg-light rounded-3 border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <label class="matn-label mb-0">
                                        <i class='bx bx-award text-primary'></i>
                                        <span>درجة الاختبار (من 100)</span>
                                    </label>
                                    <span id="scoreRatingPill" class="score-rating-pill" style="display: none;">
                                        <i class='bx bx-award'></i> <span id="scoreRatingText">-</span>
                                    </span>
                                </div>
                                <div class="input-group">
                                    <input type="number" id="modalScore" name="score" class="form-control"
                                           min="0" max="100" step="0.5" placeholder="مثال: 95.5"
                                           oninput="updateScoreFeedback(this.value)" />
                                    <span class="input-group-text bg-white fw-bold">%</span>
                                </div>
                                <div class="score-presets mt-2">
                                    <span class="small text-muted me-1">درجات سريعة:</span>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(100)">100% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(95)">95% ممتاز</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(85)">85% ج.جداً</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(75)">75% جيد</button>
                                    <button type="button" class="score-preset-btn" onclick="setScorePreset(60)">60% مقبول</button>
                                </div>
                            </div>
                        </div>

                        <div class="col-12">
                            <label class="matn-label">
                                <i class='bx bx-comment-detail text-muted'></i>
                                <span>ملاحظات المعلم / الإدارة</span>
                            </label>
                            <textarea id="modalTeacherNotes" name="teacherNotes" class="matn-input" rows="2"
                                      placeholder="ملاحظات حول مستوى الطالب، الإتقان، أو الاستدراك..."></textarea>
                        </div>
                    </div>
                </div>
                <div class="matn-modal-footer">
                    <button type="button" class="matn-control-btn" onclick="closeProgressModal()">إلغاء</button>
                    <button type="submit" class="btn-grade-action px-4" id="saveProgressBtn">
                        <i class='bx bx-save'></i>
                        <span>حفظ التعديلات والدرجة</span>
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<script>
    var currentMatnPassingGrade = 60;

    function updateScoreFeedback(scoreVal) {
        const pill = document.getElementById('scoreRatingPill');
        const txt = document.getElementById('scoreRatingText');
        if (!pill || !txt) return;
        if (!scoreVal || isNaN(scoreVal)) {
            pill.style.display = 'none';
            return;
        }
        const s = parseFloat(scoreVal);
        pill.style.display = 'inline-flex';
        const examStatus = document.getElementById('modalExamStatus');

        if (s < currentMatnPassingGrade) {
            pill.style.background = '#fef2f2';
            pill.style.borderColor = '#fecaca';
            pill.style.color = '#991b1b';
            txt.textContent = `راسب (أقل من علامة النجاح ${currentMatnPassingGrade}%)`;
            if (examStatus) examStatus.value = '2'; // Failed
        } else {
            if (examStatus) examStatus.value = '1'; // Passed
            if (s >= 90) {
                pill.style.background = '#ecfdf5';
                pill.style.borderColor = '#86efac';
                pill.style.color = '#065f46';
                txt.textContent = 'ناجح - ممتاز 🌟';
            } else if (s >= 80) {
                pill.style.background = '#eff6ff';
                pill.style.borderColor = '#bfdbfe';
                pill.style.color = '#1e40af';
                txt.textContent = 'ناجح - جيد جداً';
            } else if (s >= 65) {
                pill.style.background = '#f0fdf4';
                pill.style.borderColor = '#bbf7d0';
                pill.style.color = '#166534';
                txt.textContent = 'ناجح - جيد';
            } else {
                pill.style.background = '#fffbeb';
                pill.style.borderColor = '#fde68a';
                pill.style.color = '#92400e';
                txt.textContent = 'ناجح - مقبول';
            }
        }
    }

    function setScorePreset(val) {
        const input = document.getElementById('modalScore');
        if (input) {
            input.value = val;
            updateScoreFeedback(val);
        }
    }

    function onExamStatusChanged(statusVal) {
        const scoreInput = document.getElementById('modalScore');
        if (!scoreInput) return;
        if (statusVal === '1' && (!scoreInput.value || parseFloat(scoreInput.value) < currentMatnPassingGrade)) {
            scoreInput.value = Math.max(85, currentMatnPassingGrade);
            updateScoreFeedback(scoreInput.value);
        } else if (statusVal === '2' && (!scoreInput.value || parseFloat(scoreInput.value) >= currentMatnPassingGrade)) {
            scoreInput.value = Math.max(0, currentMatnPassingGrade - 15);
            updateScoreFeedback(scoreInput.value);
        }
    }

    function openProgressModal(studentId, studentName, matnId, matnTitle, studyStatus, memStatus, examStatus, score, examDate, notes, passingGrade = 60) {
        const modalEl = document.getElementById('matnProgressModal');
        if (!modalEl) return;

        currentMatnPassingGrade = parseFloat(passingGrade) || 60;
        document.getElementById('modalStudentId').value = studentId || '';
        document.getElementById('modalMatnId').value = matnId || '';
        document.getElementById('modalStudentName').textContent = studentName || '-';
        document.getElementById('modalMatnTitle').textContent = matnTitle || '-';
        const passEl = document.getElementById('modalPassingGrade');
        if (passEl) passEl.textContent = currentMatnPassingGrade + '%';

        document.getElementById('modalStudyStatus').value = (studyStatus !== undefined && studyStatus !== null) ? studyStatus : 0;
        document.getElementById('modalMemorizationStatus').value = (memStatus !== undefined && memStatus !== null) ? memStatus : 0;
        document.getElementById('modalExamStatus').value = (examStatus !== undefined && examStatus !== null) ? examStatus : 0;
        document.getElementById('modalScore').value = score || '';
        document.getElementById('modalExamDate').value = examDate || '';
        document.getElementById('modalTeacherNotes').value = notes || '';

        updateScoreFeedback(score);

        modalEl.classList.add('show', 'is-open');
        modalEl.style.setProperty('display', 'flex', 'important');
        document.body.style.overflow = 'hidden';
    }

    function closeProgressModal() {
        const modalEl = document.getElementById('matnProgressModal');
        if (!modalEl) return;

        modalEl.classList.remove('show', 'is-open');
        modalEl.style.setProperty('display', 'none', 'important');
        document.body.style.overflow = '';
    }

    document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') {
            closeProgressModal();
        }
    });

    async function saveMatnProgress(e) {
        e.preventDefault();
        const btn = document.getElementById('saveProgressBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> جارٍ الحفظ...';

        const payload = {
            studentId: document.getElementById('modalStudentId').value,
            matnId: document.getElementById('modalMatnId').value,
            studyStatus: parseInt(document.getElementById('modalStudyStatus').value),
            memorizationStatus: parseInt(document.getElementById('modalMemorizationStatus').value),
            examStatus: parseInt(document.getElementById('modalExamStatus').value),
            score: document.getElementById('modalScore').value ? parseFloat(document.getElementById('modalScore').value) : null,
            examDate: document.getElementById('modalExamDate').value ? document.getElementById('modalExamDate').value : null,
            teacherNotes: document.getElementById('modalTeacherNotes').value
        };

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]')?.value || '';
            const res = await fetch('/Teacher/StudentMatnProgress/CreateOrUpdate', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'RequestVerificationToken': token
                },
                body: JSON.stringify(payload)
            });

            const data = await res.json();
            if (data.success) {
                if (window.location.hash.indexOf('progress') === -1) {
                    window.location.hash = 'progress';
                }
                location.reload();
            } else {
                alert(data.message || 'تعذر حفظ البيانات.');
                btn.disabled = false;
                btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
            }
        } catch (err) {
            alert('حدث خطأ في الاتصال بالخادم.');
            btn.disabled = false;
            btn.innerHTML = '<i class="bx bx-save me-1"></i> حفظ التعديلات والدرجة';
        }
    }
</script>
