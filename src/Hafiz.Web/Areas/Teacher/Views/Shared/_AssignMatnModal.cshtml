@using Hafiz.Domain.Enums
@using Hafiz.Models
@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

<!-- Load Shared, Drawer & Matn Styles -->
<link rel="stylesheet" href="~/css/teacher/shared.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/drawer.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/upcoming.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/teacher/modals/assignMatnModal.css" asp-append-version="true" />

<!-- Backdrop overlay for Matn Drawer & Mobile Modal -->
<div class="drawer-backdrop" id="matnDrawerBackdrop" onclick="closeAssignMatnDrawer()"></div>

<div class="drawer-panel" id="matnDrawerPanel" role="dialog" aria-modal="true" aria-labelledby="matnDrawerStudentName"
     data-assigned-matn="@(ViewBag.AssignedMatnTitle ?? "")"
     data-program-name="@(ViewBag.StudyProgramName ?? "المتون العلمية")">

    <!-- Touch Grab Handle for Mobile Phones -->
    <div class="drawer-mobile-handle" onclick="closeAssignMatnDrawer()" title="سحب أو نقر للإغلاق"></div>

    <!-- Drawer Header: Student Identity Profile -->
    <div class="drawer-header">
        <div class="drawer-student-profile">
            <div class="drawer-student-avatar" id="matnDrawerAvatar" style="background: linear-gradient(135deg, var(--matn-primary), var(--matn-primary-dark));">
                <i class='bx bxs-book-reader'></i>
            </div>
            <div class="drawer-student-meta">
                <h3 id="matnDrawerStudentName">اسم الطالب</h3>
                <span class="drawer-student-subtitle">
                    <span id="matnDrawerSubtitle">طالب 1 من 1</span>
                    <span class="header-dot text-muted">•</span>
                    <span class="badge" id="matnDrawerProgramBadge" style="background: rgba(111, 161, 90, 0.12); color: #436b32; font-size: 0.74rem; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(111, 161, 90, 0.25); font-weight: 600;">
                        <i class='bx bx-book-bookmark' style="font-size: 0.85rem; vertical-align: middle; margin-left: 2px;"></i>
                        <span id="matnDrawerProgramBadgeText">@(ViewBag.StudyProgramName ?? "المتون العلمية")</span>
                    </span>
                    <span class="badge" id="matnDrawerMatnBadge" style="background: rgba(191, 145, 59, 0.12); color: #8c6418; font-size: 0.74rem; padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(191, 145, 59, 0.28); font-weight: 700;">
                        <i class='bx bxs-book-open' style="font-size: 0.85rem; vertical-align: middle; margin-left: 2px;"></i>
                        <span id="matnDrawerMatnBadgeText">@(ViewBag.AssignedMatnTitle ?? "المتن المقرر")</span>
                    </span>
                </span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-2">
            <!-- Close Button -->
            <button type="button" class="drawer-close-btn" onclick="closeAssignMatnDrawer()" title="إغلاق (Esc)">
                <i class='bx bx-x'></i>
            </button>
        </div>
    </div>

    <!-- Segmented Navigation for Matn Types (All 3 Types Shown on "الكل") -->
    <div class="segmented-nav" id="matnSegmentedNav" role="tablist" aria-label="أقسام أوراد المتون">
        <button type="button" class="segmented-btn active" data-tab="all" onclick="setMatnFilterTab('all', this)">الكل</button>
        <button type="button" class="segmented-btn" data-tab="memorization" onclick="setMatnFilterTab('memorization', this)">
            <span class="tab-text-full">حفظ المتن</span>
            <span class="tab-text-short">حفظ</span>
        </button>
        <button type="button" class="segmented-btn" data-tab="revision" onclick="setMatnFilterTab('revision', this)">
            <span class="tab-text-full">مراجعة المتن</span>
            <span class="tab-text-short">مراجعة</span>
        </button>
        <button type="button" class="segmented-btn" data-tab="mudarasah" onclick="setMatnFilterTab('mudarasah', this)">
            <span class="tab-text-full">مدارسة وضبط</span>
            <span class="tab-text-short">مدارسة</span>
        </button>
    </div>

    <!-- Form container -->
    <form id="matnAssignmentForm" onsubmit="event.preventDefault(); submitMatnAssignment(false);"
          style="display: flex; flex-direction: column; flex: 1; min-height: 0; overflow: hidden;">

        <input type="hidden" id="matnStudentId" name="StudentId" />
        <input type="hidden" id="matnClassId" name="ClassId" value="@Context.Request.Cookies["selectedClassId"]" />

        <!-- Drawer Body containing all 3 Wird Cards -->
        <div class="drawer-body" id="matnDrawerBody">

            <!-- Student Selection (When Opened Globally) -->
            <div id="matnStudentSelectContainer" style="display: none; background: #f8fafc; border: 1.5px solid #cbd5e1; border-radius: var(--radius-md); padding: 12px 14px; margin-bottom: 6px;">
                <label class="compact-label mb-1 d-block" style="font-size: 0.82rem;">
                    <i class='bx bx-user me-1 text-primary'></i> اختر الطالب من الحلقة: <span class="text-danger">*</span>
                </label>
                <select id="matnStudentSelectDropdown" class="form-select form-control" onchange="onMatnStudentDropdownChange(this)"
                        style="border-radius: var(--radius-md); font-weight: 600;">
                    <option value="">-- اختر الطالب من القائمة --</option>
                </select>
            </div>

            <!-- ===================================================================
                 CARD 1: حفظ المتن الجديد (Memorization) - Soft Sage Theme
                 =================================================================== -->
            <div class="drawer-wird-box type-memorization" id="matn-wbox-memorization" data-type="memorization">
                <!-- Header -->
                <div class="drawer-wird-header">
                    <div class="drawer-wird-title">
                        <i class='bx bxs-book-bookmark' style="font-size: 1.25rem;"></i>
                        <span>حفظ المتن الجديد</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="wird-status-label" id="matn-wstatus-memorization" style="font-size: 0.74rem; font-weight: 700; color: #16a34a;">مفعل</span>
                        <label class="switch" style="transform: scale(0.8); transform-origin: left center;">
                            <input type="checkbox" id="matn-wtoggle-memorization" checked onchange="toggleMatnCard('memorization', this.checked)">
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- المعرف المخفي للمتن المحدد للبرنامج التعليمي -->
                <input type="hidden" id="matnTitle-memorization" value="" />

                <!-- الباب أو الموضع من المتن (واجهة واضحة للاختيار أو الكتابة اليدوية) -->
                <div class="chapter-selection-section mb-3" id="matnChapterSection-memorization">
                    <div class="chapter-selection-header d-flex align-items-center justify-content-between mb-1">
                        <label class="compact-label mb-0" for="matnChapterSelect-memorization">
                            <i class='bx bx-book-open text-muted'></i> <span class="label-text-full">الباب أو الموضع من المتن:</span><span class="label-text-short">الباب أو الموضع:</span>
                        </label>
                        <div class="chapter-mode-toggle" id="matnChapterModeToggle-memorization">
                            <button type="button" class="chapter-mode-btn active" id="btnModeSelect-memorization"
                                    onclick="setChapterInputMode('memorization', 'select')" title="اختيار الباب من قائمة أبواب المتن">
                                <i class='bx bx-list-ul'></i> <span class="mode-text-full">اختيار الباب</span><span class="mode-text-short">اختيار</span>
                            </button>
                            <button type="button" class="chapter-mode-btn" id="btnModeManual-memorization"
                                    onclick="setChapterInputMode('memorization', 'manual')" title="كتابة اسم الباب أو الموضع يدوياً">
                                <i class='bx bx-edit'></i> <span class="mode-text-full">كتابة يدوية</span><span class="mode-text-short">يدوي</span>
                            </button>
                        </div>
                    </div>

                    <!-- وضع الاختيار من القائمة -->
                    <div id="matnChapterSelectWrap-memorization" class="chapter-control-wrap">
                        <select id="matnChapterSelect-memorization" class="form-select form-control matn-chapter-select"
                                onchange="onMatnChapterSelectChange('memorization', this.value)">
                        </select>
                    </div>

                    <!-- وضع الإدخال اليدوي -->
                    <div id="matnChapterInputWrap-memorization" class="chapter-control-wrap" style="display: none;">
                        <input type="text" id="matnChapterName-memorization" class="form-control matn-chapter-input"
                                placeholder="اكتب اسم الباب أو موضع التسميع (مثال: باب الإعراب)..." />
                    </div>
                </div>

                <!-- المقدار والوحدة مع أزرار الزيادة والنقصان اللمسية والشرائح السريعة -->
                <div class="drawer-fields-grid">
                    <div class="field-item">
                        <label class="compact-label" for="matn-amount-memorization">المقدار المحدد:</label>
                        <div class="matn-amount-control-row">
                            <div class="stepper-input-container">
                                <button type="button" class="stepper-btn stepper-btn-minus" onclick="stepMatnAmount('memorization', -1)" title="نقصان المقدار">
                                    <i class='bx bx-minus'></i>
                                </button>
                                <input type="number" step="1" min="1" class="form-control form-control-prominent text-center stepper-input"
                                       id="matn-amount-memorization" value="1" placeholder="المقدار" oninput="onMatnAmountInput('memorization', this.value)">
                                <button type="button" class="stepper-btn stepper-btn-plus" onclick="stepMatnAmount('memorization', 1)" title="زيادة المقدار">
                                    <i class='bx bx-plus'></i>
                                </button>
                            </div>
                            <div class="amount-quick-chips" id="matn-amountChips-memorization">
                                <button type="button" class="amount-chip" onclick="setQuickAmount('memorization', 1)">1</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('memorization', 2)">2</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('memorization', 3)">3</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('memorization', 5)">5</button>
                            </div>
                        </div>
                    </div>
                    <div class="field-item">
                        <label class="compact-label">الوحدة المقررة:</label>
                        <div class="unit-radio-group" id="matn-unitGroup-memorization" role="radiogroup">
                            <label class="unit-radio-option" id="matn-unitOpt-memorization-1" onclick="setMatnUnit('memorization', 1, 'أبيات', 'بيت')">
                                <input type="radio" name="matn-unit-memorization" value="1">
                                <span class="unit-radio-circle"></span>
                                <span>أبيات</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-memorization-5" onclick="setMatnUnit('memorization', 5, 'أحاديث', 'حديث')">
                                <input type="radio" name="matn-unit-memorization" value="5">
                                <span class="unit-radio-circle"></span>
                                <span>أحاديث</span>
                            </label>
                            <label class="unit-radio-option is-selected" id="matn-unitOpt-memorization-4" onclick="setMatnUnit('memorization', 4, 'أبواب', 'باب')">
                                <input type="radio" name="matn-unit-memorization" value="4" checked>
                                <span class="unit-radio-circle"></span>
                                <span>أبواب</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-memorization-3" onclick="setMatnUnit('memorization', 3, 'صفحات', 'ص')">
                                <input type="radio" name="matn-unit-memorization" value="3">
                                <span class="unit-radio-circle"></span>
                                <span>صفحات</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-memorization-2" onclick="setMatnUnit('memorization', 2, 'سطور', 'سطر')">
                                <input type="radio" name="matn-unit-memorization" value="2">
                                <span class="unit-radio-circle"></span>
                                <span>سطور</span>
                            </label>
                        </div>
                    </div>
                </div>

                <!-- نطاق المتن المتصل (من ← إلى) مع شارة المجموع التلقائية -->
                <div class="drawer-range-connected">
                    <div class="range-box">
                        <label class="compact-label" id="matn-fromLabel-memorization">من (باب):</label>
                        <input type="number" class="form-control form-control-prominent text-center" id="matn-fromNumber-memorization"
                               value="1" placeholder="من" oninput="calculateMatnAmount('memorization')">
                    </div>
                    <div class="range-connector-indicator">
                        <i class='bx bx-left-arrow-alt'></i>
                        <span class="range-total-pill" id="matn-rangeBadge-memorization">1 باب</span>
                    </div>
                    <div class="range-box">
                        <label class="compact-label" id="matn-toLabel-memorization">إلى (باب):</label>
                        <input type="number" class="form-control form-control-prominent text-center" id="matn-toNumber-memorization"
                               value="1" placeholder="إلى" oninput="calculateMatnAmount('memorization')">
                    </div>
                </div>

                <!-- التقييم الخماسي اللمسي -->
                <div class="wird-rating-group" id="matn-ratingGroup-memorization">
                    <div class="wird-rating-header">
                        <div class="wird-rating-title">
                            <i class='bx bxs-award'></i>
                            <span>تقييم تسميع المتن وإتقانه:</span>
                        </div>
                        <div class="wird-rating-header-actions">
                            <span class="wird-rating-badge rate-excellent" id="matn-ratingBadge-memorization">متقن تماماً</span>
                            <button type="button" class="btn-rating-clear" id="matn-ratingClear-memorization"
                                    style="display: none;" onclick="clearMatnRating('memorization')" title="إلغاء التقييم">
                                <i class='bx bx-x'></i> مسح
                            </button>
                        </div>
                    </div>
                    <div class="wird-rating-options-grid" role="radiogroup">
                        <button type="button" class="rating-pill-btn rate-excellent is-selected" data-status="5"
                                onclick="setMatnRating('memorization', 5, 'excellent', 'متقن تماماً')">
                            <span class="rating-icon"><i class='bx bxs-star'></i></span>
                            <span class="rating-text">ممتاز</span>
                            <span class="rating-hint">إتقان تام</span>
                        </button>
                        <button type="button" class="rating-pill-btn rate-very_good" data-status="4"
                                onclick="setMatnRating('memorization', 4, 'very_good', 'أخطاء يسيرة')">
                            <span class="rating-icon"><i class='bx bxs-like'></i></span>
                            <span class="rating-text">جيد جداً</span>
                            <span class="rating-hint">أخطاء يسيرة</span>
                        </button>
                        <button type="button" class="rating-pill-btn rate-good" data-status="3"
                                onclick="setMatnRating('memorization', 3, 'good', 'يحتاج ضبطاً')">
                            <span class="rating-icon"><i class='bx bx-check-circle'></i></span>
                            <span class="rating-text">جيد</span>
                            <span class="rating-hint">يحتاج ضبطاً</span>
                        </button>
                        <button type="button" class="rating-pill-btn rate-acceptable" data-status="2"
                                onclick="setMatnRating('memorization', 2, 'acceptable', 'تنبيهات')">
                            <span class="rating-icon"><i class='bx bx-minus-circle'></i></span>
                            <span class="rating-text">مقبول</span>
                            <span class="rating-hint">تنبيهات</span>
                        </button>
                        <button type="button" class="rating-pill-btn rate-weak" data-status="1"
                                onclick="setMatnRating('memorization', 1, 'weak', 'إعادة')">
                            <span class="rating-icon"><i class='bx bx-error-circle'></i></span>
                            <span class="rating-text">ضعيف</span>
                            <span class="rating-hint">إعادة</span>
                        </button>
                    </div>
                </div>

                <!-- الملاحظات والورد القادم -->
                <div class="drawer-bottom-row">
                    <div style="flex: 1; min-width: 0;">
                        <input type="text" class="form-control" id="matnNote-memorization"
                               placeholder="ملاحظة أو توجيه للطالب (اختياري)..." style="font-size: 0.82rem; height: 38px; border-radius: var(--radius-md);">
                    </div>
                    <div class="upcoming-badge-toggle">
                        <span style="font-size: 0.74rem; color: #6b21a8; font-weight: 700; white-space: nowrap;">
                            <i class='bx bx-calendar-star'></i> ورد قادم
                        </span>
                        <label class="switch" style="transform: scale(0.68); transform-origin: left center;">
                            <input type="checkbox" id="matn-isUpcoming-memorization" onchange="toggleUpcomingMatn('memorization', this.checked)">
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ===================================================================
                 CARD 2: مراجعة المتن وتثبيته (Revision) - Soft Amber/Gold Theme
                 =================================================================== -->
            <div class="drawer-wird-box type-revision" id="matn-wbox-revision" data-type="revision">
                <!-- Header -->
                <div class="drawer-wird-header">
                    <div class="drawer-wird-title">
                        <i class='bx bx-refresh' style="font-size: 1.25rem;"></i>
                        <span>مراجعة المتن وتثبيته</span>
                    </div>
                    <div style="display: flex; align-items: center; gap: 8px;">
                        <span class="wird-status-label" id="matn-wstatus-revision" style="font-size: 0.74rem; font-weight: 700; color: #16a34a;">مفعل</span>
                        <label class="switch" style="transform: scale(0.8); transform-origin: left center;">
                            <input type="checkbox" id="matn-wtoggle-revision" checked onchange="toggleMatnCard('revision', this.checked)">
                            <span class="switch-slider"></span>
                        </label>
                    </div>
                </div>

                <!-- المعرف المخفي للمتن المحدد للبرنامج التعليمي -->
                <input type="hidden" id="matnTitle-revision" value="" />

                <!-- الباب أو الموضع من المتن (واجهة واضحة للاختيار أو الكتابة اليدوية) -->
                <div class="chapter-selection-section mb-3" id="matnChapterSection-revision">
                    <div class="chapter-selection-header d-flex align-items-center justify-content-between mb-1">
                        <label class="compact-label mb-0" for="matnChapterSelect-revision">
                            <i class='bx bx-book-open text-muted'></i> <span class="label-text-full">الباب أو الموضع من المتن:</span><span class="label-text-short">الباب أو الموضع:</span>
                        </label>
                        <div class="chapter-mode-toggle" id="matnChapterModeToggle-revision">
                            <button type="button" class="chapter-mode-btn active" id="btnModeSelect-revision"
                                    onclick="setChapterInputMode('revision', 'select')" title="اختيار الباب من قائمة أبواب المتن">
                                <i class='bx bx-list-ul'></i> <span class="mode-text-full">اختيار الباب</span><span class="mode-text-short">اختيار</span>
                            </button>
                            <button type="button" class="chapter-mode-btn" id="btnModeManual-revision"
                                    onclick="setChapterInputMode('revision', 'manual')" title="كتابة اسم الباب أو الموضع يدوياً">
                                <i class='bx bx-edit'></i> <span class="mode-text-full">كتابة يدوية</span><span class="mode-text-short">يدوي</span>
                            </button>
                        </div>
                    </div>

                    <!-- وضع الاختيار من القائمة -->
                    <div id="matnChapterSelectWrap-revision" class="chapter-control-wrap">
                        <select id="matnChapterSelect-revision" class="form-select form-control matn-chapter-select"
                                onchange="onMatnChapterSelectChange('revision', this.value)">
                        </select>
                    </div>

                    <!-- وضع الإدخال اليدوي -->
                    <div id="matnChapterInputWrap-revision" class="chapter-control-wrap" style="display: none;">
                        <input type="text" id="matnChapterName-revision" class="form-control matn-chapter-input"
                                placeholder="اكتب اسم الباب أو موضع التسميع (مثال: باب أحكام النون)..." />
                    </div>
                </div>

                <!-- المقدار والوحدة مع أزرار الزيادة والنقصان والشرائح -->
                <div class="drawer-fields-grid">
                    <div class="field-item">
                        <label class="compact-label" for="matn-amount-revision">المقدار المحدد:</label>
                        <div class="matn-amount-control-row">
                            <div class="stepper-input-container">
                                <button type="button" class="stepper-btn stepper-btn-minus" onclick="stepMatnAmount('revision', -1)" title="نقصان المقدار">
                                    <i class='bx bx-minus'></i>
                                </button>
                                <input type="number" step="1" min="1" class="form-control form-control-prominent text-center stepper-input"
                                       id="matn-amount-revision" value="5" placeholder="المقدار" oninput="onMatnAmountInput('revision', this.value)">
                                <button type="button" class="stepper-btn stepper-btn-plus" onclick="stepMatnAmount('revision', 1)" title="زيادة المقدار">
                                    <i class='bx bx-plus'></i>
                                </button>
                            </div>
                            <div class="amount-quick-chips" id="matn-amountChips-revision">
                                <button type="button" class="amount-chip" onclick="setQuickAmount('revision', 3)">3</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('revision', 5)">5</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('revision', 10)">10</button>
                                <button type="button" class="amount-chip" onclick="setQuickAmount('revision', 15)">15</button>
                            </div>
                        </div>
                    </div>
                    <div class="field-item">
                        <label class="compact-label">الوحدة المقررة:</label>
                        <div class="unit-radio-group" id="matn-unitGroup-revision" role="radiogroup">
                            <label class="unit-radio-option is-selected" id="matn-unitOpt-revision-1" onclick="setMatnUnit('revision', 1, 'أبيات', 'بيت')">
                                <input type="radio" name="matn-unit-revision" value="1" checked>
                                <span class="unit-radio-circle"></span>
                                <span>أبيات</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-revision-5" onclick="setMatnUnit('revision', 5, 'أحاديث', 'حديث')">
                                <input type="radio" name="matn-unit-revision" value="5">
                                <span class="unit-radio-circle"></span>
                                <span>أحاديث</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-revision-4" onclick="setMatnUnit('revision', 4, 'أبواب', 'باب')">
                                <input type="radio" name="matn-unit-revision" value="4">
                                <span class="unit-radio-circle"></span>
                                <span>أبواب</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-revision-3" onclick="setMatnUnit('revision', 3, 'صفحات', 'ص')">
                                <input type="radio" name="matn-unit-revision" value="3">
                                <span class="unit-radio-circle"></span>
                                <span>صفحات</span>
                            </label>
                            <label class="unit-radio-option" id="matn-unitOpt-revision-2" onclick="setMatnUnit('revision', 2, 'سطور', 'سطر')">
