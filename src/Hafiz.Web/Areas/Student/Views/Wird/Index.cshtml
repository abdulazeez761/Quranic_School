@using Hafiz.Common.Helper
@using Hafiz.DTOs.Matn
@using Hafiz.Domain.Enums
@using Hafiz.Models
@using StudentModel = Hafiz.Models.Student
@model Hafiz.DTOs.Wird.PaginatedWirdsResponse

@{
    ViewData["Title"] = Localizer["PageTitle"].Value;
}

<link rel="stylesheet" href="~/css/student/wird.css" asp-append-version="true" />

@inject Microsoft.AspNetCore.Mvc.Localization.IViewLocalizer Localizer

@{
    var isArabic = System.Globalization.CultureInfo.CurrentUICulture.Name.StartsWith("ar");
    var currentStatus = ViewBag.Status as string;
    var currentType = ViewBag.Type as string;
    int pageSize = ViewBag.PageSize is int size ? size : 10;
    var student = ViewBag.Student as StudentModel;
    var studentMatns = ViewBag.MatnAssignments as List<MatnAssignmentDto> ?? new List<MatnAssignmentDto>();
    var activeStudentTab = ViewBag.ActiveTab as string ?? (Model.TotalCount == 0 && studentMatns.Any() ? "matn" : "quran");
    decimal totalMemorizedPages = 0m;
    int memorizedJuzDisplay = 0;
    decimal memorizedPagesRemainder = 0m;
    decimal reviewedPages = 0m;
    int reviewedJuzDisplay = 0;
    decimal reviewedPagesRemainder = 0m;
    decimal totalTajwidPages = 0m;
    bool isHafiz = false;
    if (student != null)
    {
        totalMemorizedPages = WirdPageCalculator.TotalMemorizedPages(student);
        (memorizedJuzDisplay, memorizedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(totalMemorizedPages);
        reviewedPages = student.ReviewedPages;
        (reviewedJuzDisplay, reviewedPagesRemainder) = WirdPageCalculator.SplitJuzAndPages(reviewedPages);
        totalTajwidPages = WirdPageCalculator.TotalTajwidPages(student);
        isHafiz = WirdPageCalculator.IsHafiz(student);
    }
}

<div class="wird-container" dir="@(isArabic ? "rtl" : "ltr")">
    <div class="wird-header">
        <div class="header-left">
            <i class='bx bx-book-open header-icon'></i>
            <h1 class="wird-title">
                @Localizer["MyWirds"]
                @if (isHafiz)
                {
                    <span class="hafiz-badge" title="@Localizer["HafizTitle"]">
                        <i class='bx bxs-award'></i> @Localizer["Hafiz"]
                    </span>
                }
            </h1>
        </div>
    </div>

    @if (student != null)
    {
        <div class="progress-summary">
            <div class="progress-summary-card progress-memorized">
                <i class='bx bx-bookmark-heart'></i>
                <div class="progress-summary-body">
                    <div class="progress-summary-label">@Localizer["MemorizedPages"]</div>
                    <div class="progress-summary-value">@totalMemorizedPages.ToString("0.##")</div>
                    <div class="progress-summary-sub">
                        @memorizedJuzDisplay @Localizer["JuzShort"]
                        @if (memorizedPagesRemainder > 0)
                        {
                            <text>+ @memorizedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                        }
                    </div>
                </div>
            </div>
            <div class="progress-summary-card progress-reviewed">
                <i class='bx bx-revision'></i>
                <div class="progress-summary-body">
                    <div class="progress-summary-label">@Localizer["ReviewedPages"]</div>
                    <div class="progress-summary-value">@reviewedPages.ToString("0.##")</div>
                    <div class="progress-summary-sub">
                        @reviewedJuzDisplay @Localizer["JuzShort"]
                        @if (reviewedPagesRemainder > 0)
                        {
                            <text>+ @reviewedPagesRemainder.ToString("0.##") @Localizer["UnitPages"]</text>
                        }
                    </div>
                </div>
            </div>
            <div class="progress-summary-card progress-reviewed-juz">
                <i class='bx bx-collection'></i>
                <div class="progress-summary-body">
                    <div class="progress-summary-label">@Localizer["ReviewedJuz"]</div>
                    <div class="progress-summary-value">@reviewedJuzDisplay</div>
                    <div class="progress-summary-sub">@Localizer["CompletedJuzReviews"]</div>
                </div>
            </div>
            <div class="progress-summary-card progress-tajwid">
                <i class='bx bx-microphone'></i>
                <div class="progress-summary-body">
                    <div class="progress-summary-label">@Localizer["TajwidPages"]</div>
                    <div class="progress-summary-value">@totalTajwidPages.ToString("0.##")</div>
                    <div class="progress-summary-sub">@Localizer["CompletedTajwidWirds"]</div>
                </div>
            </div>
        </div>
    }

    @if (studentMatns.Any())
    {
        <div class="wird-tabs-segmented mb-4 mt-3" style="display: inline-flex; background: #f1f5f9; padding: 4px; border-radius: 14px; border: 1px solid #e2e8f0; gap: 4px;">
            <button type="button" class="tab-btn wird-tab-pill tab-quran @(activeStudentTab == "quran" ? "active" : "")" id="studentQuranTabBtn" onclick="toggleStudentTab('quran')"
                    style="border-radius: 10px; padding: 8px 20px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; transition: all 0.2s ease;">
                <i class='bx bx-book-open'></i>
                <span>أوراد القرآن الكريم</span>
                <span class="wird-tab-count" style="background: rgba(16, 185, 129, 0.12); color: #059669; padding: 2px 8px; border-radius: 9999px; font-size: 0.75rem;">@Model.TotalCount</span>
            </button>
            <button type="button" class="tab-btn wird-tab-pill tab-matn @(activeStudentTab == "matn" ? "active" : "")" id="studentMatnTabBtn" onclick="toggleStudentTab('matn')"
                    style="border-radius: 10px; padding: 8px 20px; font-weight: 700; border: none; cursor: pointer; display: inline-flex; align-items: center; gap: 8px; font-size: 0.88rem; transition: all 0.2s ease;">
                <i class='bx bx-bookmarks'></i>
                <span>تسميع المتون العلمية</span>
                <span class="wird-tab-count" style="background: rgba(37, 99, 235, 0.12); color: #2563eb; padding: 2px 8px; border-radius: 9999px; font-size: 0.75rem;">@studentMatns.Count</span>
            </button>
        </div>
    }

    <!-- QURAN WIRDS CONTAINER -->
    <div id="studentQuranContainer" style="display: @(activeStudentTab == "quran" ? "block" : "none");">

    <!-- Filter Section -->
    <div class="filter-section">
        <div class="filter-group">
            <label>@Localizer["Status"]:</label>
            <div class="filter-tabs">
                <a href="@Url.Action("Index", "Wird", new { area = "Student", status = (string?)null, type = (string?)null, page = 1, pageSize })"
                   class="filter-tab @(string.IsNullOrEmpty(currentStatus) && string.IsNullOrEmpty(currentType) ? "active" : "")">
                    <i class='bx bx-list-ul'></i>
                    @Localizer["All"]
                </a>
                <a href="@Url.Action("Index", "Wird", new { area = "Student", status = "pending", type = currentType, page = 1, pageSize })"
                   class="filter-tab @(currentStatus == "pending" ? "active" : "")">
                    <i class='bx bx-time'></i>
                    @Localizer["Pending"]
                </a>
                <a href="@Url.Action("Index", "Wird", new { area = "Student", status = "completed", type = currentType, page = 1, pageSize })"
                   class="filter-tab @(currentStatus == "completed" ? "active" : "")">
                    <i class='bx bx-check-circle'></i>
                    @Localizer["Completed"]
                </a>
                <a href="@Url.Action("Index", "Wird", new { area = "Student", status = "upcoming", type = currentType, page = 1, pageSize })"
                   class="filter-tab filter-tab-upcoming @(currentStatus == "upcoming" ? "active" : "")">
                    <i class='bx bx-calendar-star'></i>
                    @Localizer["Upcoming"]
                </a>
            </div>
        </div>

        <div class="filter-group"
             style="margin-top: 1rem; border-top: 1px solid var(--border-color); padding-top: 1rem;">
            <label>@Localizer["Type"]:</label>
            <div class="filter-tabs">
                <a href="@Url.Action("Index", "Wird", new { area = "Student", status = currentStatus, type = (string?)null, page = 1, pageSize })"
                   class="filter-tab @(string.IsNullOrEmpty(currentType) ? "active" : "")">
                    @Localizer["AllTypes"]
                </a>
                @foreach (var type in Enum.GetValues(typeof(AssignmentType)))
                {
                    var typeName = type.ToString();
                    if (string.IsNullOrWhiteSpace(typeName))
                    {
                        continue;
                    }

                    <a href="@Url.Action("Index", "Wird", new { area = "Student", status = currentStatus, type = typeName, page = 1, pageSize })"
                       class="filter-tab @(currentType == typeName ? "active" : "")">
                        @Localizer[typeName]
                    </a>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(ViewBag.Status) || !string.IsNullOrEmpty(ViewBag.Type))
        {
            <div class="filter-actions"
                 style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid var(--border-color);">
                <a href="@Url.Action("Index", "Wird", new { area = "Student", page = 1, pageSize })"
                   class="clear-filter-btn">
                    <i class='bx bx-x'></i>
                    @Localizer["Clear"]
                </a>
            </div>
        }
    </div>

    <!-- Statistics Section -->
    <div class="stats-grid">
        <div class="stat-card stat-total">
            <i class='bx bx-book-bookmark'></i>
            <div class="stat-info">
                <h3>@Localizer["TotalWirds"]</h3>
                <p class="stat-value">@Model.TotalCount</p>
            </div>
        </div>
        <div class="stat-card stat-pending">
            <i class='bx bx-time-five'></i>
            <div class="stat-info">
                <h3>@Localizer["Pending"]</h3>
                <p class="stat-value">@Model.PendingCount</p>
            </div>
        </div>
        <div class="stat-card stat-completed">
            <i class='bx bx-check-double'></i>
            <div class="stat-info">
                <h3>@Localizer["Completed"]</h3>
                <p class="stat-value">@Model.CompletedCount</p>
            </div>
        </div>
        <div class="stat-card stat-upcoming">
            <i class='bx bx-calendar-star'></i>
            <div class="stat-info">
                <h3>@Localizer["Upcoming"]</h3>
                <p class="stat-value">@Model.UpcomingCount</p>
            </div>
        </div>
    </div>

    <!-- Wirds List -->
    <div class="wirds-list">
        @if (Model.Wirds.Any())
        {
            @foreach (var wird in Model.Wirds)
            {
                var isCompleted = wird.Status != AssignmentStatus.notSet;
                var statusClass = isCompleted ? "completed" : "pending";
                var localizedStatus = isCompleted ? Localizer["Completed"] : Localizer["Pending"];

                var hasFromRange = (wird.FromSurah.HasValue && wird.FromSurah != Surah.NONE)
                                   || !string.IsNullOrEmpty(wird.FromAyah)
                                   || wird.FromJuz.HasValue
                                   || wird.FromPage.HasValue;
                var hasToRange = (wird.ToSurah.HasValue && wird.ToSurah != Surah.NONE)
                                 || wird.ToAyah.HasValue
                                 || wird.ToJuz.HasValue
                                 || wird.ToPage.HasValue;

                <div class="wird-card @statusClass @(wird.IsUpcoming ? "is-upcoming" : "")">
                    <div class="wird-card-top-stripe"></div>

                    <div class="wird-card-header">
                        <div class="wird-header-title">
                            <h3 class="wird-title-text">@Localizer[wird.Type.ToString()]</h3>
                            @if (wird.IsUpcoming)
                            {
                                @await Html.PartialAsync("_UpcomingBadge")
                            }
                            <span class="wird-status-badge status-@statusClass">@localizedStatus</span>
                        </div>
                        <div class="wird-meta">
                            @if (wird.Amount.HasValue && wird.AmountUnit.HasValue)
                            {
                                var unitKey = wird.AmountUnit.Value switch
                                {
                                    WirdUnit.Pages => "UnitPages",
                                    WirdUnit.Ayahs => "UnitAyahs",
                                    WirdUnit.Juz => "UnitJuz",
                                    _ => ""
                                };
                                <span class="wird-amount-badge">
                                    <i class='bx bx-collection'></i>
                                    @wird.Amount.Value.ToString("0.##") @Localizer[unitKey]
                                </span>
                            }
                            <span class="wird-date-badge">
                                <i class='bx bx-calendar'></i>
                                @wird.AssignedDate.ToString("MMM dd")
                            </span>
                        </div>
                    </div>

                    @if (hasFromRange || hasToRange)
                    {
                        <div class="wird-range-compact">
                            <div class="range-item">
                                <span class="range-label">@Localizer["From"]</span>
                                <span class="range-value">
                                    @if (wird.FromSurah.HasValue && wird.FromSurah != Surah.NONE)
                                    {
                                        @Formatting.GetLocalizedSurahName(wird.FromSurah.Value)
                                        if (!string.IsNullOrEmpty(wird.FromAyah))
                                        {
                                            <text> · </text>
                                        }
                                    }
                                    @if (!string.IsNullOrEmpty(wird.FromAyah))
                                    {
                                        @Localizer["Ayah"] @wird.FromAyah
                                    }
                                </span>
                                @if (wird.FromJuz.HasValue || wird.FromPage.HasValue)
                                {
                                    <span class="range-detail">
                                        @if (wird.FromJuz.HasValue)
                                        {
                                            @Localizer["Juz"] @wird.FromJuz
                                        }
                                        @if (wird.FromJuz.HasValue && wird.FromPage.HasValue)
                                        {
                                            <text> · </text>
                                        }
                                        @if (wird.FromPage.HasValue)
                                        {
                                            @Localizer["Page"] @wird.FromPage
                                        }
                                    </span>
                                }
                            </div>
                            <div class="range-divider">
                                <i class='bx bx-right-arrow-alt'></i>
                            </div>
                            <div class="range-item">
                                <span class="range-label">@Localizer["To"]</span>
                                <span class="range-value">
                                    @if (wird.ToSurah.HasValue && wird.ToSurah != Surah.NONE)
                                    {
                                        @Formatting.GetLocalizedSurahName(wird.ToSurah.Value)
                                        if (wird.ToAyah.HasValue)
                                        {
                                            <text> · </text>
                                        }
                                    }
                                    @if (wird.ToAyah.HasValue)
                                    {
                                        @Localizer["Ayah"] @wird.ToAyah
                                    }
                                </span>
                                @if (wird.ToJuz.HasValue || wird.ToPage.HasValue)
                                {
                                    <span class="range-detail">
                                        @if (wird.ToJuz.HasValue)
                                        {
                                            @Localizer["Juz"] @wird.ToJuz
                                        }
                                        @if (wird.ToJuz.HasValue && wird.ToPage.HasValue)
                                        {
                                            <text> · </text>
                                        }
                                        @if (wird.ToPage.HasValue)
                                        {
                                            @Localizer["Page"] @wird.ToPage
                                        }
                                    </span>
                                }
                            </div>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(wird.Note))
                    {
                        <div class="wird-note">
                            <i class='bx bx-note'></i>
                            <p>@wird.Note</p>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="no-data-message">
                <i class='bx bx-book-alt'></i>
                <p>@Localizer["NoWirdAssignmentsFound"]</p>
            </div>
        }
    </div>

    @if (Model.TotalPages > 1)
    {
        <div class="pagination-controls">
            <div class="pagination-info">
                <span>
                    @Localizer["Page"] @Model.PageNumber @Localizer["Of"] @Model.TotalPages
                    (@Model.TotalCount @Localizer["TotalRecords"])
                </span>
            </div>
            <div class="pagination-buttons">
                @if (Model.HasPreviousPage)
                {
                    <a class="pagination-btn prev-btn"
                       href="@Url.Action("Index", "Wird", new { area = "Student", status = currentStatus, type = currentType, page = Model.PageNumber - 1, pageSize })">
                        <i class='bx bx-chevron-left'></i>
                        @Localizer["Previous"]
                    </a>
                }
                else
                {
                    <button class="pagination-btn prev-btn" disabled>
                        <i class='bx bx-chevron-left'></i>
                        @Localizer["Previous"]
                    </button>
                }

                <div class="page-numbers">
                    @for (int i = 1; i <= Model.TotalPages; i++)
                    {
                        if (i == Model.PageNumber)
                        {
                            <span class="page-num active">@i</span>
                        }
                        else if (i == 1 || i == Model.TotalPages || (i >= Model.PageNumber - 1 && i <= Model.PageNumber + 1))
                        {
                            <a class="page-num"
                               href="@Url.Action("Index", "Wird", new { area = "Student", status = currentStatus, type = currentType, page = i, pageSize })">@i</a>
                        }
                        else if (i == 2 || i == Model.TotalPages - 1)
                        {
                            <span class="page-num dots">...</span>
                        }
                    }
                </div>

                @if (Model.HasNextPage)
                {
                    <a class="pagination-btn next-btn"
                       href="@Url.Action("Index", "Wird", new { area = "Student", status = currentStatus, type = currentType, page = Model.PageNumber + 1, pageSize })">
                        @Localizer["Next"]
                        <i class='bx bx-chevron-right'></i>
                    </a>
                }
                else
                {
                    <button class="pagination-btn next-btn" disabled>
                        @Localizer["Next"]
                        <i class='bx bx-chevron-right'></i>
                    </button>
                }
            </div>
        </div>
    }

    </div> <!-- End studentQuranContainer -->

    <!-- MATN RECITATIONS CONTAINER -->
    <div id="studentMatnContainer" style="display: @(activeStudentTab == "matn" ? "block" : "none");">
        @if (studentMatns.Any())
        {
            <div class="wirds-list" style="display: flex; flex-direction: column; gap: 14px;">
                @foreach (var matn in studentMatns)
                {
                    var isCompleted = matn.IsCompleted;
                    var statusClass = isCompleted ? "completed" : "pending";
                    var stripeGrad = matn.PerformanceType switch
                    {
                        MatnPerformanceType.Memorization => "linear-gradient(90deg, #10b981, #059669)",
                        MatnPerformanceType.Revision => "linear-gradient(90deg, #3b82f6, #1d4ed8)",
                        _ => "linear-gradient(90deg, #8b5cf6, #6d28d9)"
                    };
                    var perfBadgeStyle = matn.PerformanceType switch
                    {
                        MatnPerformanceType.Memorization => "background: rgba(16, 185, 129, 0.1); color: #059669; border: 1px solid rgba(16, 185, 129, 0.2);",
                        MatnPerformanceType.Revision => "background: rgba(37, 99, 235, 0.1); color: #2563eb; border: 1px solid rgba(37, 99, 235, 0.2);",
                        _ => "background: rgba(139, 92, 246, 0.1); color: #7c3aed; border: 1px solid rgba(139, 92, 246, 0.2);"
                    };

                    <div class="wird-card @statusClass @(matn.IsUpcoming ? "is-upcoming" : "")" style="border: 1px solid #e2e8f0; border-radius: 14px; box-shadow: 0 2px 8px rgba(0,0,0,0.04); overflow: hidden; background: #ffffff;">
                        <div class="wird-card-top-stripe" style="background: @stripeGrad; height: 5px;"></div>

                        <div class="wird-card-header" style="padding: 14px 16px 6px;">
                            <div class="wird-header-title d-flex align-items-center justify-content-between w-100 flex-wrap gap-2">
                                <div class="d-flex align-items-center gap-2">
                                    <span class="badge" style="@perfBadgeStyle font-size: 0.78rem; padding: 4px 10px; border-radius: 6px; font-weight: 700;">
                                        @matn.PerformanceTypeName
                                    </span>
                                    <h3 class="wird-title-text mb-0" style="font-size: 1rem; font-weight: 800; color: #0f172a;">
                                        @(string.IsNullOrEmpty(matn.ChapterName) ? matn.ClassName : matn.ChapterName)
                                    </h3>
                                </div>
                                <div class="d-flex align-items-center gap-1">
                                    @if (matn.IsUpcoming)
                                    {
                                        @await Html.PartialAsync("_UpcomingBadge")
                                    }
                                    <span class="wird-status-badge status-@statusClass" style="font-weight: 700; font-size: 0.76rem;">
                                        @Localizer[matn.Status.ToString()]
                                    </span>
                                </div>
                            </div>
                            <div class="wird-meta d-flex align-items-center gap-3 mt-2" style="font-size: 0.8rem; color: #64748b;">
                                @if (matn.Amount.HasValue)
                                {
                                    <span class="badge bg-light text-dark border" style="font-size: 0.78rem;">
                                        <i class='bx bx-layer me-1'></i>
                                        @matn.Amount.Value.ToString("0.##") @matn.UnitName
                                    </span>
                                }
                                <span class="wird-date-badge">
                                    <i class='bx bx-calendar me-1'></i>
                                    @matn.AssignedDate.ToString("MMM dd, yyyy")
                                </span>
                            </div>
                        </div>

                        @if (matn.FromNumber.HasValue || matn.ToNumber.HasValue)
                        {
                            <div class="wird-range-compact" style="background: linear-gradient(135deg, #f8fafc 0%, #f1f5f9 100%); border-radius: 8px; padding: 8px 14px; margin: 8px 16px 0; border: 1px solid #e2e8f0; font-size: 0.84rem; color: #334155; font-weight: 600;">
                                <i class='bx bx-book-bookmark text-primary me-1'></i>
                                <span>الموضع: من @matn.UnitName <strong>@matn.FromNumber</strong> إلى <strong>@matn.ToNumber</strong></span>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(matn.Note))
                        {
                            <div class="wird-note" style="margin: 8px 16px 14px; background: #fffbeb; border: 1px solid #fef3c7; border-radius: 8px; padding: 8px 12px; font-size: 0.82rem; color: #92400e;">
                                <div class="d-flex align-items-start gap-2">
                                    <i class='bx bx-comment-detail text-warning mt-1'></i>
                                    <p class="mb-0"><strong>ملاحظات المعلم:</strong> @matn.Note</p>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5" style="background: #ffffff; border-radius: 16px; border: 1px dashed #cbd5e1; margin-top: 15px; padding: 40px 20px;">
                <div style="width: 70px; height: 70px; border-radius: 50%; background: rgba(37, 99, 235, 0.08); color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 2.2rem; margin: 0 auto 14px;">
                    <i class='bx bx-bookmarks'></i>
                </div>
                <h4 class="fw-bold" style="color: #0f172a;">لا توجد تسميعات متون مسجلة</h4>
                <p class="text-muted small mb-0" style="max-width: 380px; margin: 0 auto;">لم يتم رصد أي تسميع متون علمية لحسابك حتى الآن.</p>
            </div>
        }
    </div>

    <script>
        function toggleStudentTab(tab) {
            const quranCont = document.getElementById('studentQuranContainer');
            const matnCont = document.getElementById('studentMatnContainer');
            const quranBtn = document.getElementById('studentQuranTabBtn');
            const matnBtn = document.getElementById('studentMatnTabBtn');

            if (tab === 'matn') {
                if (quranCont) quranCont.style.display = 'none';
                if (matnCont) matnCont.style.display = 'block';
                if (matnBtn) {
                    matnBtn.style.background = '#ffffff';
                    matnBtn.style.color = '#2563eb';
                    matnBtn.style.boxShadow = '0 2px 8px rgba(0,0,0,0.08)';
                }
                if (quranBtn) {
                    quranBtn.style.background = 'transparent';
                    quranBtn.style.color = '#64748b';
                    quranBtn.style.boxShadow = 'none';
                }
            } else {
                if (quranCont) quranCont.style.display = 'block';
                if (matnCont) matnCont.style.display = 'none';
                if (quranBtn) {
                    quranBtn.style.background = '#ffffff';
                    quranBtn.style.color = '#059669';
                    quranBtn.style.boxShadow = '0 2px 8px rgba(0,0,0,0.08)';
                }
                if (matnBtn) {
                    matnBtn.style.background = 'transparent';
                    matnBtn.style.color = '#64748b';
                    matnBtn.style.boxShadow = 'none';
                }
            }
        }
    </script>
</div>